+import { LinearGradient } from 'expo-linear-gradient';
+import type { ReactNode } from 'react';
+import { StyleSheet, View } from 'react-native';
+import Svg, { Circle, Path } from 'react-native-svg';
+
+import { FotoSinFondo } from '@/components/foto-sin-fondo';
+import { PressableScale } from '@/components/pressable-scale';
+import { PulseDot } from '@/components/pulse-dot';
+import { TextoVivo } from '@/components/texto-vivo';
+import { ThemedText } from '@/components/themed-text';
+import { textoSinSenal } from '@/lib/sin-senal';
+import { useTheme, type ColorTokens } from '@/theme';
+import type { Vehicle } from '@/types';
+import { miles } from '@/utils/numero';
+
+/*
+ * PIEZAS DE «MI UNIDAD» (T-170): la franja oscura con la identidad y lo de hoy,
+ * la hoja «Resumen» con sus casillas y la acción de la inspección, la lista de
+ * telemetría y la franja compacta que queda fija al desplazar. La hoja que las
+ * mueve vive en `mi-unidad-hoja.tsx`; los datos los trae la pantalla.
+ */
+
+/** La franja va SIEMPRE oscura, en los dos temas: es el escaparate de la foto. */
+export const FRANJA_COLORES = ['#06090D', '#080B10'] as const;
+const FRANJA_BORDE = '#1F2732';
+const FRANJA_TEXTO = '#F3F5F8';
+const FRANJA_TEXTO_2 = '#ABB3BF';
+const FRANJA_TEXTO_3 = '#8C97A7';
+
+/** Alto de la franja; la hoja se monta sobre sus últimos `SOLAPE` px. */
+export const ALTO_FRANJA = 190;
+export const SOLAPE = 50;
+/**
+ * La foto sin fondo, montada entre la franja y la hoja. El lienzo (8:5) deja
+ * aire alrededor del vehículo: con 220 de ancho el vehículo mide ~175, como la
+ * maqueta, y su suelo (92 % del alto) cae sobre la hoja.
+ */
+const FOTO_ANCHO = 220;
+
+// ── Íconos de la maqueta (trazos de 24×24) ──────────────────────────────────
+
+type NombreIcono = 'camion' | 'pin' | 'odo' | 'escudo' | 'llave' | 'flecha';
+
+const TRAZOS: Record<NombreIcono, ReactNode> = {
+  camion: (
+    <>
+      <Path d="M3 6h11v10H3z" />
+      <Path d="M14 9h4l3 3v4h-7" />
+      <Circle cx={7} cy={17.5} r={1.8} />
+      <Circle cx={17} cy={17.5} r={1.8} />
+    </>
+  ),
+  pin: (
+    <>
+      <Path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
+      <Circle cx={12} cy={9.5} r={2.5} />
+    </>
+  ),
+  odo: (
+    <>
+      <Path d="M4 17a8 8 0 1 1 16 0" />
+      <Path d="M12 17l4-5" />
+      <Circle cx={12} cy={17} r={1.2} />
+    </>
+  ),
+  escudo: (
+    <>
+      <Path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6z" />
+      <Path d="M9 12l2 2 4-4" />
+    </>
+  ),
+  llave: (
