@@ -0,0 +1,531 @@
+import { useMemo, useState, type ReactNode } from 'react';
+import { StyleSheet, View } from 'react-native';
+
+import { Avatar } from '@/components/avatar';
+import {
+  CalendarioInspecciones,
+  VISTA_DIA,
+  type DiaCalendario,
+  type EstadoDia,
+} from '@/components/calendario-inspecciones';
+import { Card } from '@/components/card';
+import { ErrorState } from '@/components/error-state';
+import { PressableScale } from '@/components/pressable-scale';
+import { ProgressBar } from '@/components/progress-bar';
+import { SearchBar, normalizar } from '@/components/search-bar';
+import { Skeleton } from '@/components/skeleton';
+import { TabIcon } from '@/components/tab-icon';
+import { ThemedText } from '@/components/themed-text';
+import type { AsyncEstado } from '@/hooks/use-async-data';
+import { useAsyncData } from '@/hooks/use-async-data';
+import { etiquetaCortaDeUnidad } from '@/lib/vehiculos';
+import { getUsuariosDeEmpresa, type InspeccionResumen } from '@/services';
+// Directo del servicio: las asignaciones no están en el barril.
+import { getAsignacionesFom } from '@/services/fomConduccion';
+import { useTheme, type ColorTokens } from '@/theme';
+import type { DriverProfile, InspeccionEstado, UnidadFlota } from '@/types';
+import { formatFecha } from '@/utils/date';
+
+/**
+ * POR PERSONA: quién hace la diaria y quién no, mes a mes.
+ *
+ * Es el modo «Por persona» del Historial. La lista va del peor cumplimiento al
+ * mejor —lo que hay que mirar, arriba— y al tocar a alguien se abre su
+ * calendario y, debajo, sus inspecciones del mes. Todo sale de UNA lectura de
+ * las inspecciones del mes de la empresa —la misma que usa «Todas»—, repartida
+ * aquí por persona: pedirlas por persona o por día serían cientos de viajes.
+ *
+ * La regla es la misma de la web (ver `juzgarMes`).
+ */
+
+/** Desde aquí el cumplimiento va en verde; desde `REGULAR`, en ámbar; debajo, en rojo. */
+const BUENO = 90;
+const REGULAR = 70;
+
+/** El tono de un porcentaje de cumplimiento. */
+export function tonoCumplimiento(pct: number | null): keyof ColorTokens {
+  if (pct === null) return 'textMuted';
+  return pct >= BUENO ? 'success' : pct >= REGULAR ? 'warning' : 'danger';
+}
+
+/** Lo más grave primero: si hubo dos diarias el mismo día, se enseña la peor. */
+const PESO: Record<InspeccionEstado, number> = {
+  bloqueada: 0,
+  aprobada_con_observaciones: 1,
+  aprobada: 2,
+  pendiente: 3,
+};
+
+/** De dónde sale qué día debía hacerla. */
+export type ReglaDias = 'jornada' | 'semana';
+
+/** Cómo se explica la regla en pantalla (igual que en la web). */
+export const TEXTO_REGLA: Record<ReglaDias, string> = {
+  jornada: 'Se cuentan los días con jornada.',
+  semana: 'Se cuentan todos los días desde que tiene unidad asignada, hasta hoy.',
+};
+
+/** Un mes juzgado: sus días y las cuentas. */
+export interface MesJuzgado {
+  dias: DiaCalendario[];
+  /** Días que debía hacerla (los que hizo cuentan siempre). */
+  debidos: number;
+  /** Días que la hizo, salga como salga. */
+  hechos: number;
+  /** 0-100, o `null` si no había ningún día que contar. */
+  pct: number | null;
+  cuenta: Record<EstadoDia, number>;
+  regla: ReglaDias;
+}
+
+/** AAAA-MM-DD de un año, mes (1-12) y día. */
+function aFecha(a: number, m: number, d: number): string {
+  return `${a}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
+}
+
+/** El último día de un mes AAAA-MM, como AAAA-MM-DD. */
+export function finDeMes(mes: string): string {
+  const [a, m] = mes.split('-').map(Number);
+  return aFecha(a, m, new Date(a, m, 0).getDate());
+}
+
+/** El mes de al lado (AAAA-MM), `paso` meses adelante o atrás. */
+export function moverMes(mes: string, paso: number): string {
+  const [a, m] = mes.split('-').map(Number);
+  const d = new Date(a, m - 1 + paso, 1);
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
+}
+
+/**
+ * LA REGLA de «día que debía hacerla», igual que la web:
+ *
+ * - Si hay dato de jornada (o km) por día de la persona, cuentan SOLO esos días.
+ * - Si no, cuentan todos los días (de lunes a domingo), hasta hoy, si tiene unidad.
+ * - En los dos casos, nunca antes del día en que recibió la unidad (`desde`):
+ *   antes no le tocaba hacerla. Sin ese dato se cuenta desde el día 1.
+ *
+ * Un día en que la hizo cuenta siempre, aunque fuera domingo: si no, se
+ * pasaría del 100 %. Hoy, mientras no la haya hecho, no cuenta todavía: aún
+ * está a tiempo. Una programada que quedó de antes no cuenta como diaria (sin
+ * clase —servidor viejo— todas eran diarias).
+ */
+export function juzgarMes({
+  mes,
+  hoy,
+  inspecciones,
+  conUnidad,
+  desde,
+  diasConJornada,
+}: {
+  /** AAAA-MM. */
+  mes: string;
+  /** AAAA-MM-DD. */
+  hoy: string;
+  /** Las de esta persona en el mes. */
+  inspecciones: InspeccionResumen[];
+  conUnidad: boolean;
+  /** AAAA-MM-DD en que recibió su unidad vigente, si FOM lo dice. */
+  desde?: string;
+  /** Los días con jornada o km de la persona, si se tienen. Sin dato, `undefined`. */
+  diasConJornada?: ReadonlySet<string>;
+}): MesJuzgado {
+  const [a, m] = mes.split('-').map(Number);
+  const total = new Date(a, m, 0).getDate();
+  const regla: ReglaDias = diasConJornada ? 'jornada' : 'semana';
+  const cuenta: Record<EstadoDia, number> = {
+    hecha: 0,
+    observaciones: 0,
+    bloqueada: 0,
+    no_hecha: 0,
+    hoy: 0,
+    no_cuenta: 0,
+  };
+  const porDia = new Map<string, InspeccionResumen[]>();
+  for (const i of inspecciones) porDia.set(i.fecha, [...(porDia.get(i.fecha) ?? []), i]);
+
+  const dias: DiaCalendario[] = [];
+  for (let d = 1; d <= total; d++) {
+    const fecha = aFecha(a, m, d);
+    const deEseDia = porDia.get(fecha) ?? [];
+    const diaria = deEseDia
+      .filter((i) => i.clase !== 'programada')
+      .sort((x, y) => PESO[x.resultado] - PESO[y.resultado])[0];
+
+    let estado: EstadoDia;
+    if (diaria) {
+      estado =
+        diaria.resultado === 'bloqueada'
+          ? 'bloqueada'
+          : diaria.resultado === 'aprobada_con_observaciones'
+            ? 'observaciones'
+            : 'hecha';
+    } else if (fecha > hoy) {
+      estado = 'no_cuenta';
+    } else {
+      // Todos los días cuentan, domingos incluidos (lo pidió Marco), pero solo
+      // desde que tiene la unidad.
+      const debia =
+        (!desde || fecha >= desde) && (diasConJornada ? diasConJornada.has(fecha) : conUnidad);
+      estado = !debia ? 'no_cuenta' : fecha === hoy ? 'hoy' : 'no_hecha';
+    }
+    cuenta[estado] += 1;
+    dias.push({ fecha, estado, ...(diaria ? { diaria } : {}) });
+  }
+  const hechos = cuenta.hecha + cuenta.observaciones + cuenta.bloqueada;
+  const debidos = hechos + cuenta.no_hecha;
+  return {
+    dias,
+    debidos,
+    hechos,
+    pct: debidos > 0 ? Math.round((hechos * 100) / debidos) : null,
+    cuenta,
+    regla,
+  };
+}
+
+/** «18 de 20 días · 90 %», o lo que toque si no había días que contar. */
+export function textoCumplimiento(j: Pick<MesJuzgado, 'hechos' | 'debidos' | 'pct'>): string {
+  if (j.pct === null) return 'Sin días que contar';
+  return `${j.hechos} de ${j.debidos} ${j.debidos === 1 ? 'día' : 'días'} · ${j.pct} %`;
+}
+
+/** Una persona de la lista, con su unidad y su mes. */
+interface Persona {
+  clave: string;
+  nombre: string;
+  fotoUrl?: string;
+  /** «Unidad 01 · Z69FC7W», o nada si no tiene. */
+  unidad?: string;
+  /** AAAA-MM-DD en que recibió su unidad vigente, si FOM lo dice. */
+  desde?: string;
+  mes: MesJuzgado;
+  /** Las suyas del mes: la lista bajo el calendario. */
+  inspecciones: InspeccionResumen[];
+}
+
+/** ¿Es alguien que conduce? Sin rol (perfil viejo) se cuenta como conductor. */
+const conduce = (u: DriverProfile) => !u.role || u.role === 'conductor' || u.role === 'driver';
+
+/** Fila de la lista: avatar, nombre, unidad y su cumplimiento con barra. */
+function FilaPersona({ p, primera, onAbrir }: { p: Persona; primera: boolean; onAbrir: () => void }) {
+  const { colors, spacing, borderWidths } = useTheme();
+  const tono = tonoCumplimiento(p.mes.pct);
+  return (
+    <PressableScale
+      onPress={onAbrir}
+      accessibilityRole="button"
+      accessibilityLabel={`${p.nombre}, ${textoCumplimiento(p.mes)}. Ver su calendario`}
+      style={[
+        styles.fila,
+        {
+          gap: spacing.md,
+          paddingVertical: spacing.md,
+          borderTopWidth: primera ? 0 : borderWidths.hairline,
+          borderTopColor: colors.border,
+        },
+      ]}>
+      <Avatar uri={p.fotoUrl || undefined} nombre={p.nombre} size={40} tono="neutral" />
+      <View style={[styles.flex1, { gap: 2 }]}>
+        <ThemedText variant="button" numberOfLines={1}>
+          {p.nombre}
+        </ThemedText>
+        <ThemedText variant="caption" color="textMuted" numberOfLines={1}>
+          {p.unidad ?? 'Sin unidad asignada'}
+        </ThemedText>
+        <View style={[styles.fila, { gap: spacing.sm, marginTop: spacing.xs }]}>
+          <View style={styles.flex1}>
+            <ProgressBar value={p.mes.pct ?? 0} color={colors[tono]} height={6} />
+          </View>
+          <ThemedText variant="caption" color={tono} tabular style={styles.fuerte}>
+            {textoCumplimiento(p.mes)}
+          </ThemedText>
+        </View>
+      </View>
+      <TabIcon name="chevron" color={colors.textMuted} size={18} />
+    </PressableScale>
+  );
+}
+
+/** Una cifra de los totales: el icono y color del estado, su nombre y el número. */
+function Total({ estado, valor }: { estado: EstadoDia; valor: number }) {
+  const { colors, spacing } = useTheme();
+  const v = VISTA_DIA[estado];
+  return (
+    <View style={[styles.total, styles.fila, { gap: spacing.xs + 2 }]}>
+      {v.icono ? <TabIcon name={v.icono} color={colors[v.tono]} size={15} /> : null}
+      <ThemedText variant="caption" color="textSecondary" numberOfLines={1} style={styles.flex1}>
+        {v.label}
+      </ThemedText>
+      <ThemedText variant="button" tabular>
+        {`${valor}`}
+      </ThemedText>
+    </View>
+  );
+}
+
+/**
+ * El modo «Por persona» del Historial de Inspecciones.
+ *
+ * El mes y sus inspecciones los pone la pantalla: el selector de mes es el
+ * mismo para «Por persona» y «Todas». Recibe también la flota que ya leyó —de
+ * ahí sale la unidad de cada uno— y pide aparte, con memoria, el personal.
+ */
+export function InspeccionesPorPersona({
+  cid,
+  hoy,
+  mes,
+  delMes,
+  estadoDelMes,
+  recargarDelMes,
+  flota,
+  estadoFlota,
+  recargarFlota,
+  onAbrir,
+  listaDelMes,
+}: {
+  cid: string;
+  /** AAAA-MM-DD. */
+  hoy: string;
+  /** AAAA-MM: el que marca el selector de la pantalla. */
+  mes: string;
+  /** Las inspecciones del mes de toda la empresa, o `null` mientras llegan. */
+  delMes: InspeccionResumen[] | null;
+  estadoDelMes: AsyncEstado;
+  recargarDelMes: () => void;
+  flota: UnidadFlota[] | null;
+  estadoFlota: AsyncEstado;
+  recargarFlota: () => void;
+  onAbrir: (i: InspeccionResumen) => void;
+  /** La lista de las inspecciones de una persona, con la fila e impresión de la pantalla. */
+  listaDelMes: (lista: InspeccionResumen[]) => ReactNode;
+}) {
+  const { colors, spacing, radii } = useTheme();
+  const [q, setQ] = useState('');
+  const [elegida, setElegida] = useState<string | null>(null);
+
+  const personal = useAsyncData(() => getUsuariosDeEmpresa(cid), [cid], {
+    clave: `inspecciones-personal:${cid}`,
+  });
+  /*
+   * Desde cuándo tiene cada uno su unidad: los días de antes no cuentan. Es un
+   * extra: si no llega, se cuenta desde el día 1 como antes, sin tumbar la vista.
+   */
+  const asignaciones = useAsyncData(() => getAsignacionesFom().catch(() => []), [cid], {
+    clave: `inspecciones-asignaciones:${cid}`,
+  });
+
+  const personas = useMemo<Persona[]>(() => {
+    const roster = personal.data ?? [];
+    const inspecciones = delMes ?? [];
+    // La primera de sus asignaciones vigentes: desde ahí ya tenía unidad.
+    const desdeDe = new Map<string, string>();
+    for (const a of asignaciones.data ?? []) {
+      const previa = desdeDe.get(a.userId);
+      if (a.desde && (!previa || a.desde < previa)) desdeDe.set(a.userId, a.desde);
+    }
+    // La unidad de cada uno: la que la flota le pone como conductor.
+    const unidadDe = new Map<string, string>();
+    for (const u of flota ?? []) {
+      if (u.conductorId && !unidadDe.has(u.conductorId)) {
+        unidadDe.set(u.conductorId, [etiquetaCortaDeUnidad(u.vehicle), u.vehicle.placa].filter(Boolean).join(' · '));
+      }
+    }
+    const porId = new Map(roster.map((u) => [u.id, u]));
+    const porNombre = new Map(roster.map((u) => [normalizar(u.nombre), u]));
+    // Cada inspección a su persona: por id si FOM lo manda; si no, por el nombre.
+    const suyas = new Map<string, InspeccionResumen[]>();
+    const nombreSuelto = new Map<string, string>();
+    for (const i of inspecciones) {
+      const dueño = (i.conductorId ? porId.get(i.conductorId) : undefined) ?? porNombre.get(normalizar(i.conductor));
+      let clave = dueño?.id;
+      if (!clave) {
+        // Alguien que no está en el personal (o ya salió): igual se enseña.
+        if (i.conductor === 'Sin conductor') continue;
+        clave = i.conductorId ?? `nombre:${normalizar(i.conductor)}`;
+        nombreSuelto.set(clave, i.conductor);
+      }
+      suyas.set(clave, [...(suyas.get(clave) ?? []), i]);
+    }
+    /** Una persona con su unidad, desde cuándo la tiene y su mes juzgado. */
+    const armar = (clave: string, nombre: string, fotoUrl?: string): Persona => {
+      const desde = desdeDe.get(clave);
+      const deEl = suyas.get(clave) ?? [];
+      return {
+        clave,
+        nombre,
+        ...(fotoUrl ? { fotoUrl } : {}),
+        ...(unidadDe.has(clave) ? { unidad: unidadDe.get(clave) } : {}),
+        ...(desde ? { desde } : {}),
+        mes: juzgarMes({ mes, hoy, inspecciones: deEl, conUnidad: unidadDe.has(clave), desde }),
+        inspecciones: deEl,
+      };
+    };
+    const lista: Persona[] = [];
+    for (const u of roster) {
+      if (!conduce(u) && !unidadDe.has(u.id) && !suyas.has(u.id)) continue;
+      lista.push(armar(u.id, u.nombre, u.fotoUrl || undefined));
+    }
+    for (const [clave, nombre] of nombreSuelto) lista.push(armar(clave, nombre));
+    // Del peor al mejor; quien no tenía días que contar, al final.
+    return lista.sort(
+      (x, y) =>
+        (x.mes.pct ?? 101) - (y.mes.pct ?? 101) ||
+        y.mes.cuenta.no_hecha - x.mes.cuenta.no_hecha ||
+        x.nombre.localeCompare(y.nombre),
+    );
+  }, [personal.data, asignaciones.data, delMes, flota, mes, hoy]);
+
+  const nq = normalizar(q);
+  const visibles = useMemo(
+    () => personas.filter((p) => !nq || normalizar(`${p.nombre} ${p.unidad ?? ''}`).includes(nq)),
+    [personas, nq],
+  );
+  const persona = elegida ? personas.find((p) => p.clave === elegida) : undefined;
+
+  if (personal.estado === 'error' || estadoDelMes === 'error' || estadoFlota === 'error') {
+    return (
+      <Card>
+        <ErrorState
+          description="Sin el personal, la flota y las inspecciones del mes no podemos armar el cumplimiento."
+          onRetry={() => {
+            if (personal.estado === 'error') personal.recargar();
+            if (estadoDelMes === 'error') recargarDelMes();
+            if (estadoFlota === 'error') recargarFlota();
+          }}
+        />
+      </Card>
+    );
+  }
+  const cargando = !personal.data || !delMes || !flota;
+
+  // ── El calendario de una persona y, debajo, sus inspecciones del mes ──
+  if (persona) {
+    const j = persona.mes;
+    const tono = tonoCumplimiento(j.pct);
+    return (
+      <>
+        <PressableScale
+          onPress={() => setElegida(null)}
+          hitSlop={8}
+          accessibilityRole="button"
+          accessibilityLabel="Volver a todas las personas"
+          style={[styles.fila, styles.volver, { gap: spacing.xs }]}>
+          <View style={styles.girado}>
+            <TabIcon name="chevron" color={colors.primary} size={16} />
+          </View>
+          <ThemedText variant="caption" color="primary" style={styles.fuerte}>
+            Todas las personas
+          </ThemedText>
+        </PressableScale>
+
+        <Card style={[styles.fila, { gap: spacing.md, padding: spacing.md + 2 }]}>
+          <Avatar uri={persona.fotoUrl || undefined} nombre={persona.nombre} size={48} tono="neutral" />
+          <View style={styles.flex1}>
+            <ThemedText variant="subtitle" style={styles.tituloTarjeta} numberOfLines={2}>
+              {persona.nombre}
+            </ThemedText>
+            <ThemedText variant="caption" color="textMuted" numberOfLines={1}>
+              {persona.unidad ?? 'Sin unidad asignada'}
+            </ThemedText>
+          </View>
+        </Card>
+
+        {/* Padding corto: así cada celda pasa de 44 de ancho hasta en un teléfono de 360. */}
+        <Card style={{ padding: spacing.sm }}>
+          {cargando ? (
+            <Skeleton height={300} radius={radii.md} />
+          ) : (
+            <CalendarioInspecciones mes={mes} dias={j.dias} hoy={hoy} onAbrir={onAbrir} />
+          )}
+        </Card>
+
+        {cargando ? null : (
+          <Card style={{ gap: spacing.md }}>
+            <View style={{ gap: spacing.sm }}>
+              <ThemedText variant="subtitle" style={styles.tituloTarjeta}>
+                Cumplimiento del mes
+              </ThemedText>
+              <ThemedText tabular style={[styles.cifra, { color: colors[tono] }]}>
+                {textoCumplimiento(j)}
+              </ThemedText>
+              <ProgressBar value={j.pct ?? 0} color={colors[tono]} />
+            </View>
+            <View style={[styles.totales, { rowGap: spacing.sm, columnGap: spacing.md }]}>
+              <Total estado="hecha" valor={j.cuenta.hecha} />
+              <Total estado="observaciones" valor={j.cuenta.observaciones} />
+              <Total estado="bloqueada" valor={j.cuenta.bloqueada} />
+              <Total estado="no_hecha" valor={j.cuenta.no_hecha} />
+            </View>
+            <ThemedText variant="caption" color="textSecondary">
+              {persona.unidad
+                ? TEXTO_REGLA[j.regla]
+                : 'Sin unidad asignada: solo cuentan los días en que la hizo.'}
+            </ThemedText>
+            {/* Si la recibió dentro de este mes o después, se dice por qué esos días van en gris. */}
+            {persona.desde && persona.desde > `${mes}-01` ? (
+              <ThemedText variant="caption" color="textSecondary">
+                {`Tiene su unidad desde el ${formatFecha(persona.desde)}: los días de antes no cuentan.`}
+              </ThemedText>
+            ) : null}
+            {j.cuenta.hoy > 0 ? (
+              <ThemedText variant="caption" color="textMuted">
+                Hoy todavía no la hace: no cuenta hasta mañana.
+              </ThemedText>
+            ) : null}
+          </Card>
+        )}
+
+        {cargando ? null : (
+          <View style={{ gap: spacing.sm }}>
+            <ThemedText variant="subtitle" style={styles.tituloTarjeta}>
+              Sus inspecciones del mes
+            </ThemedText>
+            {listaDelMes(persona.inspecciones)}
+          </View>
+        )}
+      </>
+    );
+  }
+
+  // ── La lista de personas ──
+  return (
+    <>
+      <ThemedText variant="caption" color="textSecondary">
+        {TEXTO_REGLA.semana}
+      </ThemedText>
+      <SearchBar value={q} onChangeText={setQ} placeholder="Buscar por nombre o unidad…" />
+      {cargando ? (
+        <View style={{ gap: spacing.md }}>
+          {[0, 1, 2].map((n) => (
+            <Skeleton key={n} height={72} radius={radii.lg} />
+          ))}
+        </View>
+      ) : visibles.length === 0 ? (
+        <Card>
+          <ThemedText variant="caption" color="textMuted">
+            {personas.length === 0 ? 'Todavía no hay conductores en esta empresa.' : 'Nadie coincide.'}
+          </ThemedText>
+        </Card>
+      ) : (
+        <Card style={styles.grupo}>
+          {visibles.map((p, n) => (
+            <FilaPersona key={p.clave} p={p} primera={n === 0} onAbrir={() => setElegida(p.clave)} />
+          ))}
+        </Card>
+      )}
+    </>
+  );
+}
+
+const styles = StyleSheet.create({
+  fila: { flexDirection: 'row', alignItems: 'center' },
+  flex1: { flex: 1, minWidth: 0 },
+  fuerte: { fontWeight: '700' },
+  girado: { transform: [{ rotate: '180deg' }] },
+  volver: { alignSelf: 'flex-start', minHeight: 44 },
+  tituloTarjeta: { fontSize: 17, lineHeight: 22 },
+  cifra: { fontSize: 24, lineHeight: 30, fontWeight: '700', letterSpacing: -0.5 },
+  grupo: { paddingVertical: 0, paddingHorizontal: 14 },
+  totales: { flexDirection: 'row', flexWrap: 'wrap' },
+  total: { width: '46%', flexGrow: 1 },
+});
