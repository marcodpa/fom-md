diff --git a/src/hooks/use-recorrido-hoy.ts b/src/hooks/use-recorrido-hoy.ts
new file mode 100644
index 0000000..94448df
--- /dev/null
+++ b/src/hooks/use-recorrido-hoy.ts
@@ -0,0 +1,134 @@
+import { useMemo } from 'react';
+
+import { useAsyncData } from '@/hooks/use-async-data';
+import { useRefrescoVivo } from '@/hooks/use-refresco';
+import {
+  analizar,
+  compactarQuietud,
+  distanciaM,
+  quitarSaltos,
+  type PuntoRuta,
+} from '@/lib/recorrido';
+import { getRecorridoVehiculoFom } from '@/services';
+import type { LatLng, PosicionVehiculo } from '@/types';
+
+/** Lo más que FOM entrega por pedido (más, y contesta 400). */
+const POR_PAGINA = 200;
+/** Tope de páginas: 1.600 puntos alcanzan para un día de trabajo. */
+const MAX_PAGINAS = 8;
+/** El día entero se vuelve a pedir cada 5 minutos: la cifra de km no cambia de un minuto a otro. */
+const REFRESCO_DIA = 5 * 60_000;
+/** La cola del mapa: los últimos minutos de camino (como `COLA_MIN` de la web). */
+const COLA_MIN = 5;
+
+/** Medianoche de hoy en la hora del teléfono. */
+function inicioDeHoy(): string {
+  const d = new Date();
+  d.setHours(0, 0, 0, 0);
+  return d.toISOString();
+}
+
+const tiempo = (p: { hora: string }) => Date.parse(p.hora);
+
+/**
+ * La cola de los últimos minutos, como `colaReciente` del Centro de control de
+ * la web: si en esos minutos casi no se movió, se amplía hacia atrás hasta su
+ * último trayecto (120 m de camino o una hora como mucho). Sin camino, vacía.
+ */
+function colaReciente(puntos: PuntoRuta[], { min = COLA_MIN, minM = 120, maxMin = 60 } = {}): PuntoRuta[] {
+  const p = compactarQuietud(puntos);
+  if (p.length < 2) return [];
+  const ultimo = p[p.length - 1];
+  const fin = tiempo(ultimo);
+  const lejos = (tramo: PuntoRuta[]) => tramo.reduce((m, x) => Math.max(m, distanciaM(x, ultimo)), 0);
+  const base = p.filter((x) => tiempo(x) >= fin - min * 60000);
+  if (base.length >= 2 && lejos(base) >= minM) return base;
+  let i = p.length - 1;
+  while (i > 0 && lejos(p.slice(i)) < minM && fin - tiempo(p[i - 1]) <= maxMin * 60000) i--;
+  const amplia = p.slice(i);
+  return amplia.length < 2 || lejos(amplia) < 20 ? [] : amplia;
+}
+
+/**
+ * EL DÍA de la unidad del conductor: cuántos km lleva hoy, cuánto tiempo en
+ * marcha y por dónde vino en los últimos minutos.
+ *
+ * Sale de las posiciones de hoy con el MISMO análisis del recorrido que usa el
+ * supervisor (`analizar`): los km son la suma de los viajes y el tiempo en
+ * marcha, lo que duraron. Así el conductor y su supervisor ven la misma cifra.
+ *
+ * Si FOM no deja leer las posiciones (o falla), `km` y `minutos` quedan en
+ * `null`: la pantalla dice «—» en vez de un cero que nadie midió.
+ *
+ * `pos` es la posición en vivo: si es más nueva que el último punto del día,
+ * la cola llega hasta ella, así la línea termina en el marcador.
+ */
+export function useRecorridoHoy(vehicleId: string | null, pos: PosicionVehiculo | null) {
+  const { data, estado, recargar } = useAsyncData(
+    async () => {
+      if (!vehicleId) return null;
+      const desde = inicioDeHoy();
+      // Por tandas, de la más reciente a la más vieja (como `useRecorrido`).
+      const filas: Awaited<ReturnType<typeof getRecorridoVehiculoFom>> = [];
+      const vistos = new Set<string>();
+      let hasta: string | undefined;
+      for (let pagina = 0; pagina < MAX_PAGINAS; pagina++) {
+        const tanda = await getRecorridoVehiculoFom(vehicleId, { from: desde, to: hasta, limit: POR_PAGINA, fondo: true });
+        let nuevos = 0;
+        for (const p of tanda) {
+          const k = `${p.reportadaEn ?? p.recibidaEn}|${p.lat}|${p.lng}`;
+          if (vistos.has(k)) continue;
+          vistos.add(k);
+          filas.push(p);
+          nuevos++;
+        }
+        if (tanda.length < POR_PAGINA || nuevos === 0) break;
+        const masVieja = tanda[tanda.length - 1];
+        const hora = masVieja.reportadaEn ?? masVieja.recibidaEn;
+        if (!hora) break;
+        hasta = new Date(Date.parse(hora) - 1).toISOString();
+      }
+      const puntos: PuntoRuta[] = filas
+        .map((p) => ({
+          lat: p.lat,
+          lng: p.lng,
+          hora: p.reportadaEn ?? p.recibidaEn ?? '',
+          velocidadKmh: p.velocidadKmh ?? null,
+          ignition: p.contacto ?? null,
+        }))
+        .filter((p) => p.hora)
+        .sort((a, b) => tiempo(a) - tiempo(b));
+      const limpios = quitarSaltos(puntos);
+      const { viajes } = analizar(limpios);
+      return {
+        vehicleId,
+        puntos: limpios,
+        km: viajes.reduce((s, v) => s + v.distanciaM, 0) / 1000,
+        minutos: viajes.reduce((s, v) => s + v.minutos, 0),
+      };
+    },
+    [vehicleId],
+    { onFocus: true },
+  );
+  useRefrescoVivo(recargar, REFRESCO_DIA);
+
+  const actual = data && data.vehicleId === vehicleId ? data : null;
+  const horaPos = pos ? (pos.reportadaEn ?? pos.recibidaEn ?? null) : null;
+
+  const cola = useMemo<LatLng[]>(() => {
+    if (!actual) return [];
+    let puntos = actual.puntos;
+    const ultimo = puntos[puntos.length - 1];
+    if (pos && horaPos && (!ultimo || Date.parse(horaPos) > tiempo(ultimo))) {
+      puntos = [...puntos, { lat: pos.lat, lng: pos.lng, hora: horaPos, velocidadKmh: pos.velocidadKmh ?? null }];
+    }
+    return colaReciente(puntos).map((p) => ({ lat: p.lat, lng: p.lng }));
+  }, [actual, pos, horaPos]);
+
+  return {
+    km: actual ? actual.km : null,
+    minutos: actual ? actual.minutos : null,
+    cola,
+    estado,
+  };
+}
