+
+/**
+ * El anterior del estadístico, solo si es el MISMO informe. El tipo del
+ * documento todavía admite el reporte de flota; ese ya no se compara: contaba
+ * km y unidades de otra manera y las flechas mezclaban dos cuentas.
+ */
+function anteriorEstadistico(a: FormatoPredefReporte | FleetReport | undefined): FormatoPredefReporte | undefined {
+  return a && 'alertasPorVehiculo' in a ? a : undefined;
+}
+
+/** La sección de un formato, numerada como va en el índice. */
+export function seccionDe(d: DatosFormato, numero: number): SeccionInforme {
+  if (d.tipo === 'vehiculos') return seccionVehiculos(d.reporte, d.anterior, numero);
+  if (d.tipo === 'usuarios') return seccionUsuarios(d.reporte, d.anterior, numero);
+  if (d.tipo === 'costos') return seccionCostos(d.reporte, d.anterior, numero);
+  return seccionEstadistico(d.reporte, anteriorEstadistico(d.anterior), numero);
+}
+
+// ───────────────────────── Resumen ejecutivo ─────────────────────────
+
+/** Lo que trae el documento, por formato (el primero de cada uno). */
+interface Fuentes {
+  veh?: { r: FleetReport; a?: FleetReport };
+  usr?: { r: UserReport; a?: UserReport };
+  cos?: { r: ReporteCostos; a?: ReporteCostos };
+  est?: { r: FormatoPredefReporte; a?: FormatoPredefReporte };
+}
+
+export function fuentesDe(datos: DatosInforme[]): Fuentes {
+  const f: Fuentes = {};
+  for (const d of datos) {
+    if (d.tipo === 'vehiculos' && !f.veh) f.veh = { r: d.reporte, a: d.anterior };
+    if (d.tipo === 'usuarios' && !f.usr) f.usr = { r: d.reporte, a: d.anterior };
+    if (d.tipo === 'costos' && !f.cos) f.cos = { r: d.reporte, a: d.anterior };
+    if (d.tipo === 'estadistico' && !f.est) f.est = { r: d.reporte, a: anteriorEstadistico(d.anterior) };
+  }
+  return f;
+}
+
+/** ¿Algún formato trae el período anterior? Entonces hay flechas. */
+export function hayComparacion(f: Fuentes): boolean {
+  return !!(f.veh?.a || f.usr?.a || f.cos?.a || f.est?.a);
+}
+
+/** Km y eventos del período, del reporte que mejor los tenga. */
+function kmYEventos(f: Fuentes, previo: boolean): { km: number; eventos: number } | null {
+  if (f.est) {
+    if (previo) {
+      const a = antesEstadistico(f.est.a);
+      return a ? { km: a.km, eventos: a.eventos } : null;
+    }
+    return f.est.r.alertasPorVehiculo.reduce(
+      (a, v) => ({ km: a.km + v.km, eventos: a.eventos + v.aceleraciones + v.frenadas + v.excesos }),
+      { km: 0, eventos: 0 },
+    );
+  }
+  if (f.veh) {
+    const r = previo ? f.veh.a : f.veh.r;
+    if (!r) return null;
+    return { km: r.metrics.kmRecorridos, eventos: eventosDe(r.metrics) };
+  }
+  if (f.usr) {
+    const r = previo ? f.usr.a : f.usr.r;
+    return r ? { km: r.metrics.kmRecorridos, eventos: Number.NaN } : null;
+  }
+  return null;
+}
+
+/** % de los km con conductor identificado (del estadístico). */
+function pctIdentificado(r: FormatoPredefReporte | undefined): number | null {
+  if (!r) return null;
+  const km = r.conductores.reduce((a, c) => a + c.km, 0);
+  if (km <= 0) return null;
+  const con = r.conductores.filter((c) => c.identificado).reduce((a, c) => a + c.km, 0);
+  return Math.round((con / km) * 1000) / 10;
+}
+
+interface Tarjeta {
+  icono: Icono;
+  etiqueta: string;
+  valor: string;
+  unidad?: string;
+  cmp: Comparacion | null;
+  pie: string;
+}
+
+function tarjetaHtml(t: Tarjeta): string {
+  return `<div class="kp"><span class="l">${icono(t.icono, 16)}${esc(t.etiqueta)}</span><span class="v">${esc(t.valor)}${
+    t.unidad ? `<small>${esc(t.unidad)}</small>` : ''
+  }</span>${t.cmp ? comparacionHtml(t.cmp) : ''}<span class="p">${esc(t.pie)}</span></div>`;
+}
+
+/** Un punto de atención: su gravedad, qué pasa y el detalle. */
+interface Punto {
+  tono: 'rojo' | 'amarillo';
+  titulo: string;
+  detalle: string;
+}
+
+function puntosDeAtencion(f: Fuentes): Punto[] {
+  const p: Punto[] = [];
+  if (f.veh) {
+    const filas = f.veh.r.porVehiculo;
+    const ids = (xs: VehicleReportRow[]): string => listaCorta(xs.map((v) => idEnPapel(v.vehicle.numero)));
+    const vencidos = filas.filter((v) => v.papeles === 'vencido');
+    if (vencidos.length > 0) {
+      p.push({
+        tono: 'rojo',
+        titulo: `Papeles vencidos en ${vencidos.length} ${vencidos.length === 1 ? 'unidad' : 'unidades'}`,
+        detalle: `${ids(vencidos)}. Renovar antes de circular.`,
+      });
+    }
+    const rojos = filas.filter((v) => v.km > 0 && v.rango === 'rojo').sort((a, b) => a.indiceSeguro - b.indiceSeguro);
+    if (rojos.length > 0) {
+      const peor = rojos[0];
+      p.push({
+        tono: 'rojo',
+        titulo:
+          rojos.length === 1
+            ? `${idEnPapel(peor.vehicle.numero)}: índice de manejo en Atención`
+            : `${rojos.length} unidades con índice de manejo en Atención`,
+        detalle: `La más baja: ${idEnPapel(peor.vehicle.numero)}, índice ${entero(peor.indiceSeguro)} con ${entero(eventosDe(peor))} eventos en ${entero(peor.km)} km.`,
+      });
+    }
+    const odt = f.veh.r.metrics.reportesAbiertos;
+    if (odt > 0) {
+      const con = filas.filter((v) => v.otAbiertas > 0);
+      p.push({
+        tono: 'amarillo',
+        titulo: `${odt} ${odt === 1 ? 'orden de trabajo abierta' : 'órdenes de trabajo abiertas'}`,
+        detalle: `En ${con.length} ${con.length === 1 ? 'unidad' : 'unidades'}: ${listaCorta(con.map((v) => idEnPapel(v.vehicle.numero)))}.`,
+      });
+    }
+    const sinTitular = filas.filter((v) => !v.titular);
+    if (sinTitular.length > 0) {
+      const km = sinTitular.reduce((a, v) => a + v.km, 0);
+      p.push({
+        tono: 'amarillo',
+        titulo: `${sinTitular.length} ${sinTitular.length === 1 ? 'unidad sin conductor titular' : 'unidades sin conductor titular'}`,
+        detalle: `${ids(sinTitular)}${km > 0 ? `: ${entero(km)} km en el período` : ''}.`,
+      });
+    }
+    const porVencer = filas.filter((v) => v.papeles === 'por_vencer');
+    if (porVencer.length > 0) {
+      p.push({
+        tono: 'amarillo',
+        titulo: `Papeles por vencer en ${porVencer.length} ${porVencer.length === 1 ? 'unidad' : 'unidades'}`,
+        detalle: `${ids(porVencer)}.`,
+      });
+    }
+  }
+  if (f.usr) {
+    const lic = f.usr.r.filas.filter((x) => x.licencia?.estado === 'vencido');
+    if (lic.length > 0) {
+      p.push({
+        tono: 'rojo',
+        titulo: `${lic.length} ${lic.length === 1 ? 'persona con la licencia vencida' : 'personas con la licencia vencida'}`,
+        detalle: `${listaCorta(lic.map((x) => x.persona.nombre), 3)}.`,
+      });
+    }
+  }
+  if (f.est && !f.veh) {
+    const rojos = f.est.r.alertasPorVehiculo.filter((v) => v.km > 0 && v.rango === 'rojo');
+    if (rojos.length > 0) {
+      p.push({
+        tono: 'rojo',
+        titulo: `${rojos.length} ${rojos.length === 1 ? 'unidad' : 'unidades'} con score en Atención`,
+        detalle: `${listaCorta(rojos.map((v) => idEnPapel(v.unidadLabel)))}: 3,5 o más eventos por cada 100 km.`,
+      });
+    }
+  }
+  // Lo grave primero; dentro de cada grupo, el orden en que se armó.
+  return [...p.filter((x) => x.tono === 'rojo'), ...p.filter((x) => x.tono === 'amarillo')].slice(0, 5);
+}
+
+/** «En pocas palabras», con las cifras que hay (si no la escribió nadie). */
+function conclusionAuto(f: Fuentes): string {
+  const partes: string[] = [];
+  const ke = kmYEventos(f, false);
+  const keA = kmYEventos(f, true);
+  const frases: string[] = [];
+  if (ke) {
+    let s = `La flota recorrió <b>${entero(ke.km)} km</b>`;
+    const c = comparar(ke.km, keA?.km, { modo: 'pct', altoEsBueno: null });
+    if (c && c.flecha !== '=') s += ` (${c.texto} que el período anterior)`;
+    if (Number.isFinite(ke.eventos)) {
+      const sc = por100(ke.eventos, ke.km);
+      s += ` con <b>${entero(ke.eventos)} eventos de manejo</b>${sc === null ? '' : ` (${decimal(sc)} por cada 100 km)`}`;
+    }
+    partes.push(s);
+  }
+  if (f.cos) {
+    let s = `${partes.length ? 'un gasto de' : 'Se gastaron'} <b>${usd(f.cos.r.total.costo)}</b>`;
+    const c = comparar(f.cos.r.total.costo, f.cos.a?.total.costo, { modo: 'pct', altoEsBueno: false });
+    if (c && c.flecha !== '=') s += ` (${c.texto} que el período anterior)`;
+    partes.push(s);
+  }
+  if (partes.length) frases.push(`${partes.join(' y ')}.`);
+  if (f.veh) {
+    const m = f.veh.r.metrics;
+    frases.push(
+      `Hay <b>${entero(m.reportesAbiertos)} ODT abiertas</b>${
+        m.papelesVencidos > 0 ? ` y ${entero(m.papelesVencidos)} ${m.papelesVencidos === 1 ? 'unidad' : 'unidades'} con papeles vencidos` : ''
+      }.`,
+    );
+  }
+  if (f.usr && !f.veh) {
+    const m = f.usr.r.metrics;
+    frases.push(
+      `${entero(m.conducen)} de ${entero(m.usuarios)} personas conducen; sumaron ${entero(m.horasConducidas)} h al volante.`,
+    );
+  }
+  return frases.join(' ') || 'Sin cifras del período en este informe.';
+}
+
+/** Las cifras clave del resumen (hasta seis), de lo que traiga el documento. */
+function tarjetasResumen(f: Fuentes): Tarjeta[] {
+  const t: Tarjeta[] = [];
+  const ke = kmYEventos(f, false);
+  const keA = kmYEventos(f, true);
+  if (ke) {
+    t.push({
+      icono: 'mapa',
+      etiqueta: 'Km recorridos',
+      valor: entero(ke.km),
+      unidad: 'km',
+      cmp: comparar(ke.km, keA?.km, { modo: 'pct', altoEsBueno: null }),
+      pie: keA ? `Antes ${entero(keA.km)} km` : 'En el período',
+    });
+    const sc = Number.isFinite(ke.eventos) ? por100(ke.eventos, ke.km) : null;
+    const scA = keA && Number.isFinite(keA.eventos) ? por100(keA.eventos, keA.km) : null;
+    if (sc !== null) {
+      t.push({
+        icono: 'velocimetro',
+        etiqueta: 'Score de conducción',
+        valor: decimal(sc),
+        unidad: 'ev./100 km',
+        cmp: comparar(sc, scA, { modo: 'abs', altoEsBueno: false, decimales: 2 }),
+        pie: `${scA !== null ? `Antes ${decimal(scA)} · ` : ''}óptimo menor a 1,5`,
+      });
+    }
+  }
+  const pid = pctIdentificado(f.est?.r);
+  if (pid !== null) {
+    const pidA = antesEstadistico(f.est?.a)?.pctIdentificado ?? null;
+    t.push({
+      icono: 'usuarios',
+      etiqueta: 'Identificación',
+      valor: decimal(pid, 1),
+      unidad: '%',
+      cmp: comparar(pid, pidA, { modo: 'pts', altoEsBueno: true, decimales: 1 }),
+      pie: pidA !== null ? `Antes ${porcentaje(pidA, 1)}` : 'Km con conductor',
+    });
+  } else if (f.veh && f.veh.r.porVehiculo.length > 0) {
+    const filas = f.veh.r.porVehiculo;
+    const con = filas.filter((v) => v.titular).length;
+    t.push({
+      icono: 'usuarios',
+      etiqueta: 'Con conductor',
+      valor: entero(Math.round((con / filas.length) * 100)),
+      unidad: '%',
+      cmp: null,
+      pie: `${con} de ${filas.length} unidades · vista actual`,
+    });
+  }
+  if (f.veh) {
+    const filas = f.veh.r.porVehiculo;
+    const con = filas.filter((v) => v.otAbiertas > 0).length;
+    t.push({
+      icono: 'llave',
+      etiqueta: 'ODT abiertas',
+      valor: entero(f.veh.r.metrics.reportesAbiertos),
+      cmp: null,
+      pie: `En ${con} ${con === 1 ? 'unidad' : 'unidades'} · vista actual`,
+    });
+  }
+  if (f.cos) {
+    const g = f.cos.r.total.costo;
+    const gA = f.cos.a?.total.costo;
+    t.push({
+      icono: 'dinero',
+      etiqueta: 'Gasto del período',
+      valor: usd(g),
+      cmp: comparar(g, gA, { modo: 'pct', altoEsBueno: false }),
+      pie: `${gA !== undefined ? `Antes ${usd(gA)} · ` : ''}${entero(f.cos.r.total.cantidad)} gastos`,
+    });
+    if (ke && ke.km > 0) {
+      const ck = g / ke.km;
+      const ckA = gA !== undefined && keA && keA.km > 0 ? gA / keA.km : null;
+      t.push({
+        icono: 'grafica',
+        etiqueta: 'Costo por km',
+        valor: usd(ck, 3),
+        cmp: comparar(ck, ckA, { modo: 'abs', altoEsBueno: false, decimales: 3, moneda: true }),
+        pie: ckA !== null ? `Antes ${usd(ckA, 3)}` : 'Gasto ÷ km del período',
+      });
+    }
+  }
+  if (f.usr) {
+    const m = f.usr.r.metrics;
+    t.push({
+      icono: 'documento',
+      etiqueta: 'Papeles al día',
+      valor: m.papelesAlDia === null ? '—' : entero(m.papelesAlDia),
+      unidad: m.papelesAlDia === null ? undefined : '%',
+      cmp: null,
+      pie: `${entero(m.usuarios)} personas · vista actual`,
+    });
+    t.push({
+      icono: 'reloj',
+      etiqueta: 'Horas al volante',
+      valor: entero(m.horasConducidas),
+      unidad: 'h',
+      cmp: comparar(m.horasConducidas, f.usr.a?.metrics.horasConducidas, { modo: 'pct', altoEsBueno: null }),
+      pie: f.usr.a ? `Antes ${entero(f.usr.a.metrics.horasConducidas)} h` : `${entero(m.conducen)} conducen`,
+    });
+  }
+  return t.slice(0, 6);
+}
+
+/** Las piezas del resumen ejecutivo. */
+/** El icono de una cifra de la pantalla, por lo que dice. */
+function iconoDe(label: string): Icono {
+  const q = label.toLowerCase();
+  if (q.includes('índice') || q.includes('score') || q.includes('evento')) return 'velocimetro';
+  if (q.includes('km')) return 'mapa';
+  if (q.includes('gasto') || q.includes('costo')) return 'dinero';
+  if (q.includes('odt') || q.includes('mantenim')) return 'llave';
+  if (q.includes('hora')) return 'reloj';
+  if (q.includes('papel') || q.includes('document')) return 'documento';
+  if (q.includes('persona') || q.includes('conduct') || q.includes('usuario')) return 'usuarios';
+  return 'grafica';
+}
+
+/** Una cifra que calculó la pantalla, como tarjeta del papel. */
+function tarjetaDePantalla(c: CifraPdf): string {
+  const tono: Semaforo | null = c.tono === 'danger' ? 'rojo' : c.tono === 'warning' ? 'amarillo' : null;
+  const d = c.ahora ? null : c.delta;
+  const cmp = d
+    ? comparacionHtml({
+        flecha: d.sentido === 'sube' ? '▲' : d.sentido === 'baja' ? '▼' : '=',
+        texto: d.texto,
+        favorable: d.sentido === 'igual' ? null : d.favorable,
+      })
+    : '';
+  // La nota de la pantalla («3 sin resolver», «la app no lo mide») va al pie:
+  // un «—» sin su porqué no se entiende en un papel que se firma.
+  const nota = 'nota' in c && typeof c.nota === 'string' ? c.nota : '';
+  const base = c.ahora ? 'Vista actual' : d ? `Antes ${d.antes}` : nota ? '' : 'Sin comparación';
+  const pie = [base, nota].filter(Boolean).join(' · ');
+  return `<div class="kp"><span class="l">${icono(iconoDe(c.label), 16)}${esc(c.label)}</span><span class="v">${esc(c.valor)}${
+    c.unidad ? `<small>${esc(c.unidad)}</small>` : ''
+  }${tono ? marca(tono) : ''}</span>${cmp}<span class="p">${esc(pie)}</span></div>`;
+}
+
+export function resumenEjecutivo(
+  datos: DatosInforme[],
+  opc: { conclusion?: string; periodoAnterior?: string; generado: string; resumen?: ResumenPortadaPdf },
+): Pieza[] {
+  const f = fuentesDe(datos);
+  const piezas: Pieza[] = [tituloSeccion('Sección 2', 'Resumen ejecutivo')];
+
+  const escrita = opc.conclusion ?? opc.resumen?.frase;
+  const texto = escrita ? esc(escrita) : conclusionAuto(f);
+  piezas.push(
+    bloque(
+      lineas(texto, 640, 7.6) * 24 + 48,
+      `<div class="concl"><p class="eb">En pocas palabras</p><p>${texto}</p></div>`,
+    ),
+  );
+
+  // Las cifras de la pantalla mandan: el papel dice lo mismo que se vio.
+  const tarjetas = opc.resumen?.cifras.length
+    ? opc.resumen.cifras.map(tarjetaDePantalla)
+    : tarjetasResumen(f).map(tarjetaHtml);
+  if (tarjetas.length > 0) {
+    const cols = tarjetas.length === 4 ? 4 : 3;
+    const filas = Math.ceil(tarjetas.length / cols);
+    const comparado = opc.resumen?.cifras.some((c) => c.delta && !c.ahora) || hayComparacion(f);
+    const contra = comparado
+      ? `▲ ▼ contra ${opc.resumen?.comparadoCon || opc.periodoAnterior || 'el período anterior'}`
+      : 'Cifras del período';
+    piezas.push(
+      bloque(
+        30 + filas * 122 + (filas - 1) * 10,
+        `<div><div class="sub"><h2>Indicadores clave</h2><span>${esc(contra)}</span></div><div class="${
+          cols === 4 ? 'g4r' : 'g3'
+        }">${tarjetas.join('')}</div></div>`,
+      ),
+    );
+  }
+
+  if (f.veh && f.veh.r.porVehiculo.length > 0) {
+    const filas = f.veh.r.porVehiculo;
+    const marcha = filas.filter((v) => v.estado === 'en_marcha').length;
+    const m = f.veh.r.metrics;
+    piezas.push(
+      bloque(
+        68,
+        `<div class="box gris va"><span class="va-t">Vista actual · ${esc(opc.generado)} · sin comparación</span><span class="va-c"><span><b>${entero(
+          filas.length,
+        )}</b> unidades</span><span><i class="dot d-m"></i><b>${entero(marcha)}</b> en marcha</span><span><i class="dot d-d"></i><b>${entero(
+          filas.length - marcha,
+        )}</b> detenidas</span>${
+          m.kmRecorridos > 0 ? `<span>Índice <b>${entero(m.indiceSeguroPromedio)}</b>/100</span>` : ''
+        }<span><b>${entero(m.papelesVencidos)}</b> con papeles vencidos</span></span></div>`,
+      ),
+    );
+  }
+
+  const puntos = puntosDeAtencion(f);
+  const items = puntos.length
+    ? puntos
+        .map(
+          (p) =>
+            `<li><span>${p.tono === 'rojo' ? etiqueta('rojo') : etiqueta('amarillo')}</span><span><b>${esc(p.titulo)}</b><span>${esc(p.detalle)}</span></span></li>`,
+        )
+        .join('')
+    : `<li><span>${etiqueta('verde')}</span><span><b>Sin puntos de atención</b><span>Nada vencido ni pendiente en lo que trae este informe.</span></span></li>`;
+  piezas.push(
+    bloque(
+      30 + Math.max(1, puntos.length) * 53,
+      `<div><div class="sub"><h2>Puntos de atención</h2><span>Ordenados por urgencia</span></div><ol class="pts">${items}</ol></div>`,
+    ),
+  );
+  return piezas;
+}
+
+/** La línea de la portada que dice qué trae el informe. */
+export function queTrae(datos: DatosInforme[], comparado = false): string {
+  const f = fuentesDe(datos);
+  const partes: string[] = [];
+  if (f.veh) partes.push('operación y mantenimiento de la flota');
+  if (f.usr) partes.push('personal y sus papeles');
+  if (f.cos) partes.push('costos');
+  if (f.est) partes.push('indicadores de conducción');
+  if (!partes.length) return '';
+  const s = enumerar(partes);
+  return `${s[0].toUpperCase()}${s.slice(1)} del período${
+    comparado || hayComparacion(f) ? ', comparados con el período anterior' : ''
+  }.`;
+}
+
+// ───────────────────────────── Cierre ─────────────────────────────
+
+/** Las piezas del cierre: de dónde sale cada dato, glosario y firmas. */
+export function cierre(
+  datos: DatosInforme[],
+  opc: {
+    numero: number;
+    periodo?: string;
+    periodoAnterior?: string;
+    generado: string;
+    generadoPor?: FirmantePdf;
+    anio: number;
+    comparado?: boolean;
+  },
+): Pieza[] {
+  const f = fuentesDe(datos);
+  const comparado = !!opc.comparado || hayComparacion(f);
+  const piezas: Pieza[] = [tituloSeccion(`Sección ${opc.numero}`, 'Notas, glosario y firmas')];
+
+  type Momento = 'vista' | 'periodo' | 'anterior';
+  const origen: [string, string, Momento][] = [];
+  if (f.veh) {
+    origen.push(['Marcha y conductor titular', 'Vehículos (GPS y asignación)', 'vista']);
+    origen.push(['Índice de manejo (0–100)', 'Vehículos y perfil del conductor', 'vista']);
+    origen.push(['Papeles vencidos y por vencer', 'Documentos de cada unidad', 'vista']);
+    origen.push(['ODT abiertas', 'Mantenimiento', 'vista']);
+    origen.push(['Km y eventos de manejo', 'Telemetría GPS de FOM', 'periodo']);
+  }
+  if (f.usr) {
+    origen.push(['Licencia y carta médica', 'Documentos de cada persona', 'vista']);
+    origen.push(['Km, horas y fallas por persona', 'Sesiones de manejo y ODT', 'periodo']);
+  }
+  if (f.cos) origen.push(['Gastos y categorías', 'Costos y gastos', 'periodo']);
+  if (f.est) origen.push(['Indicadores, distancias y alertas', 'Telemetría GPS y sesiones de FOM', 'periodo']);
+  if (comparado) origen.push(['Comparación ▲ ▼', `Mismas fuentes${opc.periodoAnterior ? `, ${opc.periodoAnterior}` : ''}`, 'anterior']);
+
+  if (origen.length > 0) {
+    const momento = (m: Momento): string =>
+      m === 'vista'
+        ? etiqueta('neutro', 'Vista actual')
+        : `<span class="tg pe">${m === 'periodo' ? 'Período' : 'Período anterior'}</span>`;
+    piezas.push(
+      tabla({
+        titulo: 'De dónde sale cada dato',
+        aclaracion: 'Todas las cifras se consultan en FOM al generar el informe',
+        columnas: [
+          { titulo: 'Dato', ancho: 260 },
+          { titulo: 'Origen en FOM', ancho: 270 },
+          { titulo: 'Momento', ancho: 152 },
+        ],
+        filas: origen.map(([a, b, m]) => ({ celdas: [`<b>${esc(a)}</b>`, esc(b), momento(m)] })),
+      }),
+    );
+    const vista = `Cómo estaba la flota al generar el informe (${opc.generado}). No se compara con el período anterior.`;
+    const periodo = `Lo ocurrido en ${opc.periodo ?? 'el período elegido'}.${
+      comparado ? ` Se compara con ${opc.periodoAnterior ?? 'el período anterior'}.` : ''
+    }`;
+    piezas.push(
+      bloque(
+        58 + Math.max(lineas(vista, 300, 7.2), lineas(periodo, 300, 7.2)) * 20,
+        `<div class="g2c"><div class="box gris"><h2>Vista actual</h2><p class="txt">${esc(vista)}</p></div><div class="box azul"><h2>Período</h2><p class="txt">${esc(
+          periodo,
+        )}</p></div></div>`,
+      ),
+    );
+  }
+
+  const glosario: [string, string][] = [
+    ['ODT', 'Orden de trabajo. Tiene tres estados: Abierta, En revisión y Resuelta.'],
+    ['Índice de manejo', 'Nota de 0 a 100 de cada unidad o conductor. Más alto es mejor.'],
+    ['Score de conducción', 'Eventos de manejo por cada 100 km. Más bajo es mejor; óptimo menor a 1,5.'],
+    ['Evento de manejo', 'Aceleración brusca, frenada brusca o exceso de velocidad registrado por el GPS.'],
+    ['Identificación', 'Km hechos con conductor identificado en la app.'],
+    ['Sin dato («—»)', 'No hubo medición. Nunca se cuenta como cero ni como Conforme.'],
+  ];
+  let altoGlosario = 30;
+  for (let i = 0; i < glosario.length; i += 2) {
+    const l = Math.max(...glosario.slice(i, i + 2).map(([, b]) => lineas(b, 329, 6.6)));
+    altoGlosario += 17 + 20 + l * 18;
+  }
+  piezas.push(
+    bloque(
+      altoGlosario,
+      `<div><h2 class="mb4">Glosario</h2><div class="glos">${glosario
+        .map(([a, b]) => `<div><b>${esc(a)}</b><p>${esc(b)}</p></div>`)
+        .join('')}</div></div>`,
+    ),
+  );
+
+  const firma = (rol: string, nombre?: string, cargo?: string): string =>
+    `<div class="firma"><p class="eb mut">${esc(rol)}</p><div class="fl"></div><div class="linea"></div><span><b>Nombre:</b> ${
+      nombre ? esc(nombre) : '&nbsp;'
+    }</span><span><b>Cargo:</b> ${cargo ? esc(cargo) : '&nbsp;'}</span><span><b>Fecha:</b> ____ / ____ / ${opc.anio}</span></div>`;
+  piezas.push(
+    bloque(
+      164,
+      `<div><div class="sub"><h2>Firmas</h2><span>Conformidad con el contenido del informe</span></div><div class="g3">${firma(
+        'Elaborado por',
+        opc.generadoPor?.nombre,
+        opc.generadoPor?.cargo,
+      )}${firma('Revisado por')}${firma('Aprobado por')}</div></div>`,
+    ),
+  );
+  return piezas;
+}
