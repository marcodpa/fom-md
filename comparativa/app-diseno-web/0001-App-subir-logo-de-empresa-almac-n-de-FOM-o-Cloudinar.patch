@@ -0,0 +1,73 @@
+/**
+ * SHA-256 de unos bytes, en hexadecimal.
+ *
+ * El almacén de FOM pide la huella (`checksumSha256`) de cada archivo que se
+ * sube. La app no trae una librería de hash y un logo pesa a lo sumo 2 MB, así
+ * que se calcula aquí, a mano y sin dependencias.
+ */
+
+const K = new Uint32Array([
+  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+]);
+
+const rotar = (x: number, n: number): number => (x >>> n) | (x << (32 - n));
+
+export function sha256Hex(bytes: Uint8Array): string {
+  const h = new Uint32Array([
+    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
+  ]);
+
+  // Relleno: un 1, ceros y el largo en bits, hasta completar bloques de 64 bytes.
+  const largo = bytes.length;
+  const total = (((largo + 9 + 63) >> 6) << 6) >>> 0;
+  const datos = new Uint8Array(total);
+  datos.set(bytes);
+  datos[largo] = 0x80;
+  const vista = new DataView(datos.buffer);
+  vista.setUint32(total - 8, Math.floor(largo / 0x20000000), false);
+  vista.setUint32(total - 4, (largo << 3) >>> 0, false);
+
+  const w = new Uint32Array(64);
+  for (let bloque = 0; bloque < total; bloque += 64) {
+    for (let i = 0; i < 16; i += 1) w[i] = vista.getUint32(bloque + i * 4, false);
+    for (let i = 16; i < 64; i += 1) {
+      const s0 = rotar(w[i - 15], 7) ^ rotar(w[i - 15], 18) ^ (w[i - 15] >>> 3);
+      const s1 = rotar(w[i - 2], 17) ^ rotar(w[i - 2], 19) ^ (w[i - 2] >>> 10);
+      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) | 0;
+    }
+    let [a, b, c, d, e, f, g, hh] = h;
+    for (let i = 0; i < 64; i += 1) {
+      const S1 = rotar(e, 6) ^ rotar(e, 11) ^ rotar(e, 25);
+      const ch = (e & f) ^ (~e & g);
+      const t1 = (hh + S1 + ch + K[i] + w[i]) | 0;
+      const S0 = rotar(a, 2) ^ rotar(a, 13) ^ rotar(a, 22);
+      const maj = (a & b) ^ (a & c) ^ (b & c);
+      const t2 = (S0 + maj) | 0;
+      hh = g;
+      g = f;
+      f = e;
+      e = (d + t1) | 0;
+      d = c;
+      c = b;
+      b = a;
+      a = (t1 + t2) | 0;
+    }
+    h[0] += a;
+    h[1] += b;
+    h[2] += c;
+    h[3] += d;
+    h[4] += e;
+    h[5] += f;
+    h[6] += g;
+    h[7] += hh;
+  }
+
+  return [...h].map((x) => x.toString(16).padStart(8, '0')).join('');
+}
