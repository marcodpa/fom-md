+/**
+ * LA ESPERA CORTA: mientras una pantalla trae sus datos.
+ *
+ * Solo las tres flechas, encendiéndose una tras otra hacia adelante —como las
+ * luces de una pista— y la barra fina debajo. Sin nombre ni lema: se ve sobre
+ * una pantalla que ya es de FOM, y tiene que leerse en un segundo.
+ */
+export function CargaFomMini({ tamano = 64, texto }: { tamano?: number; texto?: string }) {
+  const reducido = useReducedMotion();
+  const ola = useSharedValue(0);
+  const barra = useSharedValue(0);
+
+  useEffect(() => {
+    const vuelta = reducido ? 2400 : 1100;
+    ola.value = withRepeat(withTiming(1, { duration: vuelta, easing: Easing.linear }), -1, false);
+    barra.value = withRepeat(withTiming(1, { duration: 1400, easing: Easing.bezier(0.45, 0, 0.25, 1) }), -1, false);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [reducido]);
+
+  const alto = (tamano * 82) / 104;
+  const estiloLuz = useAnimatedStyle(() => ({ transform: [{ translateX: interpolate(barra.value, [0, 1], [-48, 120]) }] }));
+
+  return (
+    <View style={styles.mini} pointerEvents="none">
+      <View style={{ width: tamano, height: alto }}>
+        {FLECHAS.map((d, i) => (
+          <FlechaOla key={d} d={d} indice={i} ola={ola} ancho={tamano} alto={alto} reducido={reducido} />
+        ))}
+      </View>
+      <View style={[styles.pista, styles.pistaMini]}>
+        <Animated.View style={[styles.luz, styles.luzMini, estiloLuz]} />
+      </View>
+      {texto ? <ThemedText style={styles.estado}>{texto}…</ThemedText> : null}
+    </View>
+  );
+}
+
+/** Una flecha de la ola: se enciende en su turno y empuja un poco hacia adelante. */
+function FlechaOla({ d, indice, ola, ancho, alto, reducido }: { d: string; indice: number; ola: SharedValue<number>; ancho: number; alto: number; reducido: boolean }) {
+  const estilo = useAnimatedStyle(() => {
+    // Cada flecha tiene su tramo de la vuelta: 0–0,45, 0,18–0,63, 0,36–0,81.
+    const t = (ola.value - indice * 0.18 + 1) % 1;
+    const luz = reducido ? 1 : interpolate(t, [0, 0.22, 0.45, 1], [0.22, 1, 0.22, 0.22]);
+    const paso = reducido ? 0 : interpolate(t, [0, 0.22, 0.45, 1], [-3, 3, -3, -3]);
+    return { opacity: luz, transform: [{ translateX: paso }] };
+  });
+  return (
+    <Animated.View style={[StyleSheet.absoluteFill, estilo]}>
+      <Svg width={ancho} height={alto} viewBox={ISOTIPO_FOM.viewBox}>
+        <Path d={d} fill={AZUL_FOM} />
+      </Svg>
+    </Animated.View>
+  );
+}
