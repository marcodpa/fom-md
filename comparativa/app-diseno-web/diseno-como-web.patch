new file mode 100644
index 0000000..269766b
--- /dev/null
+++ b/src/lib/mapbox.ts
@@ -0,0 +1,60 @@
+/**
+ * MAPBOX: el mismo proveedor de mapas que el panel web de FOM.
+ *
+ * Con `EXPO_PUBLIC_MAPBOX_TOKEN` (un token PÚBLICO `pk.` de la cuenta de
+ * Mapbox de FOM, solo con permisos de lectura de estilos) la app dibuja sus
+ * mapas con Mapbox: estilo Standard, luz de día o de noche según el tema,
+ * satélite y 3D. Sin token, la app sigue con el mapa de siempre
+ * (`react-native-maps`), así que nada se rompe.
+ *
+ * Nunca un token secreto `sk.` aquí: todo lo que empieza por EXPO_PUBLIC
+ * queda dentro de la app y cualquiera puede leerlo.
+ */
+import type { MapaTipo } from '@/lib/map-prefs';
+
+export const MAPBOX_TOKEN = (process.env.EXPO_PUBLIC_MAPBOX_TOKEN ?? '').trim();
+
+/** ¿Hay un token público de Mapbox configurado? */
+export const HAY_MAPBOX = /^pk\./u.test(MAPBOX_TOKEN);
+
+/** El estilo de Mapbox para cada capa que ofrece la app. */
+export const ESTILO_MAPBOX: Record<MapaTipo, string> = {
+  standard: 'mapbox://styles/mapbox/standard',
+  satellite: 'mapbox://styles/mapbox/standard-satellite',
+};
+
+/** La luz del estilo Standard según el tema de la app: noche en oscuro, día en claro. */
+export function luzMapbox(esquema: 'light' | 'dark' | string): 'day' | 'night' {
+  return esquema === 'dark' ? 'night' : 'day';
+}
+
+/**
+ * Colores de noche del panel web (tema «FOM»): agua y suelo hondos y vías en un
+ * azul frío que se lee sobre el negro. Así el mapa del teléfono y el de la web
+ * se ven iguales.
+ */
+export const COLORES_NOCHE_FOM = {
+  colorWater: '#07162a',
+  colorLand: '#101c2b',
+  colorGreenspace: '#112b26',
+  colorRoads: '#3b5069',
+  colorTrunks: '#4d7bb1',
+  colorMotorways: '#5b93d6',
+  colorPlaceLabels: '#e3ecf7',
+  colorRoadLabels: '#c3d3e5',
+  colorPointOfInterestLabels: '#9fb6cf',
+} as const;
+
+/** La configuración del estilo Standard (`basemap`) para una capa y un tema. */
+export function configStandard(tipo: MapaTipo, esquema: string): Record<string, string | boolean> {
+  const luz = luzMapbox(esquema);
+  const base: Record<string, string | boolean> = {
+    lightPreset: luz,
+    showPlaceLabels: true,
+    showRoadLabels: true,
+    showPointOfInterestLabels: true,
+    showTransitLabels: false,
+  };
+  if (tipo === 'satellite') return base;
+  return { ...base, show3dObjects: true, ...(luz === 'night' ? COLORES_NOCHE_FOM : {}) };
+}
