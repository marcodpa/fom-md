@@ -0,0 +1,35 @@
+// ============================================================
+// CONTEO DE EMPRESAS — una sola regla (igual que la web:
+// src/panel/datos/contarEmpresas.js).
+// La cuenta de respaldo del sistema (`respaldo`) no es una empresa de verdad:
+// no entra en «Empresas», ni en «Todas», ni en activas/suspendidas.
+// Activa = el servidor dijo que el servicio SÍ está activo (`=== true`).
+// Suspendida = el servidor dijo que NO lo está (`=== false`). Si el dato no
+// llegó (indefinido) no se afirma ninguna de las dos. Sin imports a propósito.
+// ============================================================
+
+type ConServicio = { respaldo?: boolean | null; servicioActivo?: boolean | null };
+
+/** Las empresas de verdad: todas menos la cuenta de respaldo. */
+export const soloOperativas = <T extends ConServicio>(lista: readonly T[] | null | undefined): T[] =>
+  (lista ?? []).filter((e) => !e?.respaldo);
+
+/** `{ operativas, activas, suspendidas }` de una lista de empresas. */
+export function contarEmpresas(lista: readonly ConServicio[] | null | undefined): {
+  operativas: number;
+  activas: number;
+  suspendidas: number;
+} {
+  const operativas = soloOperativas(lista);
+  return {
+    operativas: operativas.length,
+    activas: operativas.filter(estaActiva).length,
+    suspendidas: operativas.filter(estaSuspendida).length,
+  };
+}
+
+/** ¿El servidor dijo que el servicio está activo? (`=== true`: sin dato no se afirma.) */
+export const estaActiva = (e: ConServicio | null | undefined): boolean => e?.servicioActivo === true;
+
+/** ¿El servidor dijo que el servicio NO está activo? (`=== false`.) */
+export const estaSuspendida = (e: ConServicio | null | undefined): boolean => e?.servicioActivo === false;
