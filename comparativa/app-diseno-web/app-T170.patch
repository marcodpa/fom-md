+              {identidad}
+            </ThemedText>
+          </View>
+        </View>
+        <View style={styles.fVel}>
+          <ThemedText style={[styles.fVelCifra, { color: colors[tonoVel] }]} tabular>
+            {Math.round(velocidad)}
+            <ThemedText style={[styles.fVelUnidad, { color: FRANJA_TEXTO_3 }]}> km/h</ThemedText>
+          </ThemedText>
+          <MarcaVivo vivo={vivo} />
+        </View>
+      </View>
+      <View style={styles.fCifras}>
+        <View>
+          <ThemedText style={[styles.fCifra, { color: FRANJA_TEXTO }]} tabular>
+            {textoKm(km)}
+            {km != null ? <ThemedText style={[styles.fCifraUnidad, { color: FRANJA_TEXTO_2 }]}> km</ThemedText> : null}
+          </ThemedText>
+          <ThemedText style={[styles.fCifraLabel, { color: FRANJA_TEXTO_3 }]}>Recorrido hoy</ThemedText>
+        </View>
+        <View>
+          <ThemedText style={[styles.fCifra, { color: FRANJA_TEXTO }]} tabular>
+            {tiempo.cifra}
+            {tiempo.unidad ? (
