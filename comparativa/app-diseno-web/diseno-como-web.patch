+                    accessibilityState={{ selected: activo }}
+                    style={[
+                      styles.item,
+                      { backgroundColor: activo ? 'rgba(61, 155, 245, 0.16)' : colors.surfaceSunken, borderColor: activo ? colors.primary : 'transparent' },
+                    ]}>
+                    <View style={[styles.letra, { backgroundColor: colors.success }]}>
+                      <ThemedText style={[styles.letraTexto, { color: colors.onSuccess }]}>A</ThemedText>
+                    </View>
+                    <View style={styles.flex1}>
+                      <ThemedText style={styles.itemTitulo}>Viaje {v.numero}</ThemedText>
+                      <ThemedText variant="caption" color="textSecondary">
+                        {horaCorta(v.inicio.hora)} → {v.fin.enCurso ? 'en camino' : horaCorta(v.fin.hora)} · {duracion(v.minutos)} ·{' '}
+                        {(v.distanciaM / 1000).toFixed(1)} km
