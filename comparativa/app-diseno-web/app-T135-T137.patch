+  if (typeof n !== 'number' || !Number.isFinite(n)) return '—';
+  const redondo = Math.round(n * 1000) / 1000;
+  const decimales = `${redondo}`.split('.')[1]?.length ?? 0;
+  const texto = miles(redondo, decimales);
+  return Math.abs(redondo) < 10_000 ? texto.replace(/\./g, '') : texto;
+}
