+    const velC = r.conductores.flatMap((c) => (c.velocidadMax === null ? [] : [c.velocidadMax]));
+    const scoreC = por100(tc.acel + tc.fren + tc.exc, tc.km);
+    piezas.push(
+      tabla({
+        titulo: 'Cuadro por conductor',
+        aclaracion: 'Acel., Fren. y Exc.: eventos del período',
