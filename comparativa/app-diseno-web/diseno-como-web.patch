+                    </View>
+                  </PressableScale>
+                );
+              }
+              const p = it.parada!;
+              return (
+                <PressableScale
+                  key={it.clave}
+                  onPress={() => alEnfocar({ lat: p.lat, lng: p.lng, clave: Date.now() })}
+                  accessibilityRole="button"
+                  style={[styles.item, { backgroundColor: colors.surfaceSunken, borderColor: 'transparent' }]}>
+                  <View style={[styles.letra, { backgroundColor: colors.warning }]}>
+                    <ThemedText style={[styles.letraTexto, { color: colors.onWarning }]}>P</ThemedText>
+                  </View>
+                  <View style={styles.flex1}>
