diff --git a/test/gps-telemetry.test.js b/test/gps-telemetry.test.js
new file mode 100644
index 0000000..7971dbe
--- /dev/null
+++ b/test/gps-telemetry.test.js
@@ -0,0 +1,58 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const {
+  TELEMETRIA_AUSENTE,
+  toCanonicalTelemetry,
+} = require('../dist/gps-canonical/gps-telemetry.js');
+
+// La unidad viaja pegada al valor, de modo que estas pruebas cubren los tres
+// casos con independencia de lo que declare hoy `COBAN_SPEED_WIRE_UNIT`. El dia
+// que la unidad quede demostrada, la conversion ya esta probada y solo cambia
+// lo que estampa el decodificador.
+
+const conVelocidad = (value, wireUnit) => ({
+  speed: { raw: String(value), value, wireUnit },
+  heading: null,
+});
+
+test('kph se guarda tal cual', () => {
+  assert.equal(toCanonicalTelemetry(conVelocidad(80, 'kph')).speedKph, 80);
+});
+
+test('los nudos se convierten a km/h', () => {
+  // 1 nudo = 1,852 km/h exactos, por definicion de milla nautica.
+  assert.equal(toCanonicalTelemetry(conVelocidad(50, 'knot')).speedKph, 92.6);
+});
+
+test('una unidad indeterminada no se guarda', () => {
+  const r = toCanonicalTelemetry(conVelocidad(42.5, 'undetermined'));
+  // NULL, no cero: cero afirmaria que el vehiculo estaba detenido.
+  assert.equal(r.speedKph, null);
+});
+
+test('el rumbo se guarda sin depender de la velocidad', () => {
+  const r = toCanonicalTelemetry({
+    speed: null,
+    heading: { raw: '187.30', degrees: 187.3 },
+  });
+  assert.equal(r.headingDeg, 187.3);
+  assert.equal(r.speedKph, null);
+});
+
+test('ignicion y odometro no se derivan de nada', () => {
+  const r = toCanonicalTelemetry(conVelocidad(100, 'kph'));
+  // Aunque haya velocidad, el encendido no se infiere del movimiento.
+  assert.equal(r.ignition, null);
+  assert.equal(r.odometerKm, null);
+});
+
+test('la ausencia total son cuatro nulos', () => {
+  assert.deepEqual(TELEMETRIA_AUSENTE, {
+    speedKph: null,
+    headingDeg: null,
+    ignition: null,
+    odometerKm: null,
+  });
+});
