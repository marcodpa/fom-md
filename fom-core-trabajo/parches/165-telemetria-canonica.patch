From 644215b034017f18c9e6e4100bcb7f8bd860ef06 Mon Sep 17 00:00:00 2001
From: marcodpa <marcodpa@users.noreply.github.com>
Date: Tue, 18 Aug 2026 11:48:19 -0400
Subject: [PATCH 2/5] Validar la reversion de la migracion de telemetria en CI

Los pasos de reversion del CI encadenan `migration:down` y cada uno
afirma que arriba de la pila esta la migracion que le toca. El primero
esperaba encontrar `create_database_observer_views`, que hasta ahora era
la ultima aplicada.

Al anadir una migracion posterior, ese primer `down` revierte la nueva y
la comprobacion falla: no porque la migracion este mal, sino porque el
CI cuenta desde el final. Cualquier migracion futura tiene el mismo
problema, asi que el paso nuevo lo deja dicho en un comentario.

De paso, la comprobacion afirma algo que este PR sostiene y que conviene
demostrar en vez de argumentar: `fom_app` puede insertar en `speed_kph`
sin haber concedido ningun permiso nuevo, porque el GRANT de tabla que
ya existia alcanza a las columnas nuevas.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 .github/workflows/ci.yml | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index dfc9f3f..2e2a5ce 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -368,6 +368,19 @@ jobs:
             -v ON_ERROR_STOP=1 \
             -c "DROP ROLE fom_observer_ci"
 
+      # Esta migracion es ahora la ultima aplicada, de modo que le corresponde
+      # el primer `migration:down`. Los pasos siguientes revierten en cadena y
+      # cada uno afirma cual espera encontrar arriba: si se anade otra
+      # migracion, su paso de reversion va aqui, antes que este.
+      - name: Validate GPS position telemetry down
+        run: |
+          test "$(psql -h localhost -U fom_core_ci -d fom_core_ci -tAc "SELECT count(*) FROM fom_meta.pgmigrations WHERE name='20260817120000000_add_gps_position_telemetry'")" = "1"
+          test "$(psql -h localhost -U fom_core_ci -d fom_core_ci -tAc "SELECT count(*) FROM information_schema.columns WHERE table_schema='fom' AND table_name='gps_positions' AND column_name IN ('speed_kph','heading_deg','ignition','odometer_km')")" = "4"
+          test "$(psql -h localhost -U fom_core_ci -d fom_core_ci -tAc "SELECT has_column_privilege('fom_app','fom.gps_positions','speed_kph','INSERT')")" = "t"
+          npm run migration:down
+          test "$(psql -h localhost -U fom_core_ci -d fom_core_ci -tAc "SELECT count(*) FROM fom_meta.pgmigrations WHERE name='20260817120000000_add_gps_position_telemetry'")" = "0"
+          test "$(psql -h localhost -U fom_core_ci -d fom_core_ci -tAc "SELECT count(*) FROM information_schema.columns WHERE table_schema='fom' AND table_name='gps_positions' AND column_name IN ('speed_kph','heading_deg','ignition','odometer_km')")" = "0"
+
       - name: Validate database observer views down
         run: |
           test "$(psql -h localhost -U fom_core_ci -d fom_core_ci -tAc "SELECT count(*) FROM fom_meta.pgmigrations WHERE name='20260816193000000_create_database_observer_views'")" = "1"
-- 
