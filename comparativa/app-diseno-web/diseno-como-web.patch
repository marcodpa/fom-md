+/** Una flecha: entra desde la izquierda y después late hacia adelante. */
+function Flecha({ d, entrada, avanza, ancho, alto }: { d: string; entrada: SharedValue<number>; avanza: SharedValue<number>; ancho: number; alto: number }) {
