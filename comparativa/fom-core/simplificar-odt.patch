--- /dev/null
+++ b/test/work-order-flow-runtime.js
@@ -0,0 +1,301 @@
+'use strict';
+
+// T-72: flujo simple de ODT contra PostgreSQL real con el login efectivo
+// IN ROLE fom_app. Cubre las acciones compuestas, el historial y la
+// auditoría de cada paso, la atomicidad ante un paso fallido, el «Terminé»
+// del conductor responsable, la devolución con evento de reloj, la
+// idempotencia móvil y la nota obligatoria de entrega en la base.
+
+const assert = require('node:assert/strict');
+const { randomUUID } = require('node:crypto');
+const { Pool } = require('pg');
+const {
+  runWithActorStore,
+  setCurrentActor,
+} = require('../dist/authentication/actor-context.js');
+const {
+  ConsoleOperationsService,
+} = require('../dist/console-api/console-operations.service.js');
+const {
+  WorkOrderExecutionService,
+} = require('../dist/console-api/work-order-execution.service.js');
+const {
+  WorkOrderFlowService,
+} = require('../dist/console-api/work-order-flow.service.js');
+const {
+  MobileMutationReceiptService,
+} = require('../dist/mobile/mobile-mutation-receipt.service.js');
+
+const config = {
+  host: process.env.FOM_DB_HOST,
+  port: Number(process.env.FOM_DB_PORT),
+  database: process.env.FOM_DB_NAME,
+};
+const admin = new Pool({
+  ...config,
+  user: process.env.FOM_DB_USER,
+  password: process.env.FOM_DB_PASSWORD,
+  max: 2,
+});
+const runtime = new Pool({
+  ...config,
+  user: process.env.FOM_45C_RUNTIME_DB_USER,
+  password: process.env.FOM_45C_RUNTIME_DB_PASSWORD,
+  max: 3,
+});
+const database = {
+  getPool: () => runtime,
+  query: (text, values) => runtime.query(text, values),
+};
+const receipts = new MobileMutationReceiptService();
+const operations = new ConsoleOperationsService(database, receipts);
+const execution = new WorkOrderExecutionService(database);
+const flow = new WorkOrderFlowService(database, operations, execution, receipts);
+
+const suffix = randomUUID().slice(0, 8);
+const tenant = randomUUID();
+const otherTenant = randomUUID();
+const supervisor = randomUUID();
+const driver = randomUUID();
+const foreigner = randomUUID();
+const vehicle = randomUUID();
+const otherVehicle = randomUUID();
+const dispatched = randomUUID();
+const atomic = randomUUID();
+const approved = randomUUID();
+const idempotent = randomUUID();
+
+const as = (userId, role, body) =>
+  runWithActorStore(() => {
+    setCurrentActor({ userId, tenantId: tenant, role, platformAdmin: false });
+    return body();
+  });
+
+async function rejects(body, status, label) {
+  try {
+    await body();
+    assert.fail(`${label}: debía responder ${status}`);
+  } catch (error) {
+    assert.equal(error.getStatus?.(), status, `${label}: ${error.message}`);
+  }
+}
+
+async function snapshot(workOrderId) {
+  const result = await admin.query(
+    `SELECT order_row.status::text AS status,
+       (SELECT count(*)::int FROM fom.work_order_events event
+         WHERE event.work_order_id = order_row.id) AS events,
+       (SELECT count(*)::int FROM fom.audit_log audit
+         WHERE audit.entity_id = order_row.id) AS audits,
+       (SELECT count(*)::int FROM fom.work_order_assignments assignment
+         WHERE assignment.work_order_id = order_row.id) AS assignments
+     FROM fom.work_orders order_row WHERE order_row.id = $1`,
+    [workOrderId],
+  );
+  return result.rows[0];
+}
+
+async function seed() {
+  await admin.query(
+    `INSERT INTO fom.tenants (id, code, name, kind, status, category)
+     VALUES ($1, $3, 'WO flow runtime', 'organization', 'active', 'contratista'),
+            ($2, $4, 'WO flow foreign', 'organization', 'active', 'contratista')`,
+    [tenant, otherTenant, `wof-${suffix}`, `wof-other-${suffix}`],
+  );
+  await admin.query(
+    `INSERT INTO fom.users (id, email, display_name, status, email_verified_at)
+     VALUES ($1, $4, 'WOF Supervisor', 'active', clock_timestamp()),
+            ($2, $5, 'WOF Conductor', 'active', clock_timestamp()),
+            ($3, $6, 'WOF Foreigner', 'active', clock_timestamp())`,
+    [
+      supervisor, driver, foreigner,
+      `wof-super-${suffix}@runtime.invalid`,
+      `wof-driver-${suffix}@runtime.invalid`,
+      `wof-other-${suffix}@runtime.invalid`,
+    ],
+  );
+  await admin.query(
+    `INSERT INTO fom.tenant_memberships
+       (tenant_id, user_id, role, status, activated_at)
+     VALUES ($1, $3, 'supervisor', 'active', clock_timestamp()),
+            ($1, $4, 'conductor', 'active', clock_timestamp()),
+            ($2, $5, 'operator', 'active', clock_timestamp())`,
+    [tenant, otherTenant, supervisor, driver, foreigner],
+  );
+  await admin.query(
+    `INSERT INTO fom.vehicles (id, tenant_id, code)
+     VALUES ($1, $2, $5), ($3, $4, $6)`,
+    [vehicle, tenant, otherVehicle, otherTenant, `wof-v-${suffix}`, `wof-x-${suffix}`],
+  );
+  for (const workOrderId of [dispatched, atomic, approved, idempotent]) {
+    await admin.query(
+      `INSERT INTO fom.work_orders
+         (id, tenant_id, vehicle_id, created_by_user_id, last_status_actor_user_id,
+          description)
+       VALUES ($1, $2, $3, $4, $4, 'Orden del flujo simple runtime')`,
+      [workOrderId, tenant, vehicle, supervisor],
+    );
+  }
+  for (const [status, note] of [['en_revision', 'Revisión'], ['aprobada', 'Aprobación']]) {
+    await admin.query(
+      `UPDATE fom.work_orders
+          SET status = $3, last_status_actor_user_id = $4, last_status_note = $5
+        WHERE tenant_id = $1 AND id = $2`,
+      [tenant, approved, status, supervisor, note],
+    );
+  }
+}
+
+async function main() {
+  await seed();
+
+  // Permisos: el conductor no asigna ni resuelve.
+  await rejects(
+    () => as(driver, 'conductor', () => flow.dispatch(dispatched, {
+      expectedStatus: 'abierta', userId: driver,
+    })),
+    403,
+    'conductor asigna',
+  );
+
+  // Atomicidad: persona de otro ente → 404 y la orden queda intacta.
+  const before = await snapshot(atomic);
+  await rejects(
+    () => as(supervisor, 'supervisor', () => flow.dispatch(atomic, {
+      expectedStatus: 'abierta', userId: foreigner,
+    })),
+    404,
+    'asignar a persona ajena',
+  );
+  assert.deepEqual(await snapshot(atomic), before);
+
+  // «Asignar a…» desde abierta: tres pasos, historial y auditoría de cada uno.
+  const dispatch = await as(supervisor, 'supervisor', () => flow.dispatch(dispatched, {
+    expectedStatus: 'abierta', userId: driver, note: 'Revisar frenos hoy',
+  }));
+  assert.equal(dispatch.workOrder.status, 'asignada');
+  const history = await admin.query(
+    `SELECT from_status::text AS "from", to_status::text AS "to", actor_user_id AS actor
+       FROM fom.work_order_events WHERE work_order_id = $1 ORDER BY sequence_number`,
+    [dispatched],
+  );
+  assert.deepEqual(history.rows.map((row) => `${row.from}>${row.to}`), [
+    'null>abierta', 'abierta>en_revision', 'en_revision>aprobada', 'aprobada>asignada',
+  ]);
+  assert.ok(history.rows.slice(1).every((row) => row.actor === supervisor));
+  const audits = await admin.query(
+    `SELECT action FROM fom.audit_log WHERE entity_id = $1 ORDER BY occurred_at, id`,
+    [dispatched],
+  );
+  assert.deepEqual(audits.rows.map(({ action }) => action).sort(), [
+    'work_order.assign', 'work_order.transitioned', 'work_order.transitioned',
+  ]);
+
+  // El conductor responsable ve y termina su ODT sin pasos intermedios.
+  const mine = await as(driver, 'conductor', () => execution.listAssigned({ limit: 50, offset: 0 }));
+  assert.deepEqual(mine.items.map(({ id }) => id), [dispatched]);
+  const finishId = randomUUID();
+  const finished = await as(driver, 'conductor', () => execution.finish(dispatched, {
+    clientEventId: finishId, expectedStatus: 'asignada', note: 'Pastillas cambiadas',
+  }));
+  assert.deepEqual(finished.events.map(({ eventKind }) => eventKind), ['inicio', 'entrega']);
+  const replay = await as(driver, 'conductor', () => execution.finish(dispatched, {
+    clientEventId: finishId, expectedStatus: 'asignada', note: 'Pastillas cambiadas',
+  }));
+  assert.equal(replay.replayed, true);
+
+  // Devolver: estado, historial y evento de reloj a nombre del supervisor.
+  const returned = await as(supervisor, 'supervisor', () => flow.returnToExecution(dispatched, {
+    expectedStatus: 'en_calidad', reason: 'Falta purgar el sistema',
+  }));
+  assert.equal(returned.workOrder.status, 'en_ejecucion');
+  assert.equal(returned.executionEvent.eventKind, 'devolucion');
+  await as(driver, 'conductor', () => execution.finish(dispatched, {
+    clientEventId: randomUUID(), expectedStatus: 'en_ejecucion', note: 'Sistema purgado',
+  }));
+  const clock = await as(driver, 'conductor', () => execution.detail(dispatched));
+  assert.deepEqual(clock.events.map(({ eventKind }) => eventKind), [
+    'inicio', 'entrega', 'devolucion', 'entrega',
+  ]);
+  assert.ok(clock.workOrder.createdAt && clock.workOrder.assignedAt);
+
+  // Cerrar desde calidad con costo; el detalle trae los tres instantes.
+  const closed = await as(supervisor, 'supervisor', () => flow.close(dispatched, {
+    expectedStatus: 'en_calidad', resolutionNote: 'Frenos verificados en ruta',
+    resolutionCost: 85.5, resolutionCurrency: 'USD',
+  }));
+  assert.equal(closed.workOrder.status, 'cerrada');
+  assert.equal(closed.workOrder.resolutionCost, 85.5);
+  const detail = await as(supervisor, 'supervisor', () => operations.getWorkOrder(dispatched));
+  for (const field of ['createdAt', 'assignedAt', 'resolvedAt']) {
+    assert.ok(detail.workOrder[field], `${field} presente`);
+  }
+  assert.equal(detail.workOrder.completionOdometerRequired, false);
+  assert.ok(new Date(detail.workOrder.assignedAt) <= new Date(detail.workOrder.resolvedAt));
+
+  // «Resolver ya» desde aprobada.
+  const resolved = await as(supervisor, 'supervisor', () => flow.resolve(approved, {
+    expectedStatus: 'aprobada', resolutionNote: 'Se ajustó en sitio sin taller',
+  }));
+  assert.equal(resolved.workOrder.status, 'cerrada');
+  await rejects(
+    () => as(supervisor, 'supervisor', () => flow.resolve(approved, {
+      expectedStatus: 'aprobada', resolutionNote: 'Segundo intento',
+    })),
+    409,
+    'resolver una orden ya cerrada',
+  );
+
+  // Idempotencia móvil: misma llave, misma respuesta, sin segundo cambio.
+  const key = randomUUID();
+  const body = { expectedStatus: 'abierta', userId: driver };
+  const first = await as(supervisor, 'supervisor', () => flow.dispatch(idempotent, body, key));
+  const eventsAfterFirst = (await snapshot(idempotent)).events;
+  const second = await as(supervisor, 'supervisor', () => flow.dispatch(idempotent, body, key));
+  assert.equal(first.replayed, false);
+  assert.equal(second.replayed, true);
+  assert.equal((await snapshot(idempotent)).events, eventsAfterFirst);
+
+  // La base exige la nota de entrega en filas nuevas.
+  const assignment = await admin.query(
+    `SELECT id FROM fom.work_order_assignments
+      WHERE work_order_id = $1 AND ended_at IS NULL`,
+    [idempotent],
+  );
+  const client = await runtime.connect();
+  try {
+    await client.query('BEGIN');
+    await client.query(`SELECT set_config('fom.actor_user_id', $1, true)`, [driver]);
+    await assert.rejects(
+      () => client.query(
+        `INSERT INTO fom.work_order_execution_events
+           (tenant_id, work_order_id, assignment_id, actor_user_id,
