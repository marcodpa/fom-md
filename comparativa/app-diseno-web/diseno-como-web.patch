new file mode 100644
index 0000000..680a1c9
--- /dev/null
+++ b/src/components/logo-fom.tsx
@@ -0,0 +1,56 @@
+import Svg, { G, Path } from 'react-native-svg';
+
+import { ISOTIPO_FOM, WORDMARK_FOM } from '@/lib/logos';
+
+/**
+ * Logo de FOM: las tres flechas en movimiento, el mismo vector de la web
+ * (`public/brand/fom-symbol.svg`). Trae SU azul, no el acento del tema: el
+ * logo no se repinta con la marca de la empresa activa.
+ *
+ * `size` es el ANCHO; el alto sale de la proporción del símbolo (104×82).
+ */
+export function LogoFom({ size = 40 }: { size?: number }) {
+  return (
+    <Svg width={size} height={(size * 82) / 104} viewBox={ISOTIPO_FOM.viewBox}>
+      {ISOTIPO_FOM.trazos?.map((t) => (
+        <Path key={t.d} d={t.d} fill={t.color} />
+      ))}
+    </Svg>
+  );
+}
+
+/**
+ * Logo completo: símbolo + «FOM» en blanco, como `fom-logo.svg` de la web
+ * (lienzo de 280×84). Pensado para fondos oscuros (login, espera de entrada).
+ *
+ * `width` es el ancho total; el alto se deriva del lienzo.
+ */
+export function LogoFomCompleto({ width = 280 }: { width?: number }) {
+  return (
+    <Svg width={width} height={(width * 84) / 280} viewBox="0 0 280 84">
+      {/* En la web el símbolo va bajado 1 para alinearse con las letras. */}
+      <G transform="translate(0 1)">
+        {ISOTIPO_FOM.trazos?.map((t) => (
+          <Path key={t.d} d={t.d} fill={t.color} />
+        ))}
+      </G>
+      {WORDMARK_FOM.map((t) => (
+        <Path key={t.d} d={t.d} fill={t.color} fillRule="evenodd" />
+      ))}
+    </Svg>
+  );
+}
+
+/**
+ * Isotipo cuadrado para los registros de logos por empresa (que piden un
+ * `size` de caja): el símbolo centrado dentro de un cuadrado de ese lado.
+ */
+export function LogoFomCuadrado({ size = 40 }: { size?: number }) {
+  return (
+    <Svg width={size} height={size} viewBox="0 -11 104 104">
+      {ISOTIPO_FOM.trazos?.map((t) => (
+        <Path key={t.d} d={t.d} fill={t.color} />
+      ))}
+    </Svg>
+  );
+}
