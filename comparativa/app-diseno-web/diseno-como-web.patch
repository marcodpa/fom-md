+import { StyleSheet, View, type StyleProp, type ViewStyle } from 'react-native';
+
+import { Card } from '@/components/card';
+import { Chip } from '@/components/chip';
+import { AccionesOdtAsignada, MOMENTO_TALLER, RelojOdt } from '@/components/odt-asignada-acciones';
+import { otStatusColor, ODT_ESTADO_LABEL } from '@/components/ot-status-badge';
+import { PressableScale } from '@/components/pressable-scale';
+import { TabIcon } from '@/components/tab-icon';
+import { ThemedText } from '@/components/themed-text';
+import { useAsyncData } from '@/hooks/use-async-data';
+import { getEjecucionOdt, getOdtAsignadas, type EjecucionOdt, type OdtAsignada } from '@/services/fomOrdenes';
+import { useTheme } from '@/theme';
+
+/**
+ * «ASIGNADAS A TI»: las ODT que el supervisor le asignó a quien tiene la
+ * sesión, cada una con su unidad, su título, su estado, el tiempo trabajado y
+ * el botón que le toca (iniciar, pausar, reanudar, entregar).
+ *
+ * Se pide sola y se relee al volver a la pantalla y tras cada paso. Si FOM no
+ * se las enseña (403/404) o no tiene ninguna en taller, la tarjeta no aparece.
+ */
+export function SeccionOdtAsignadas({
+  onAbrir,
+  style,
+}: {
+  onAbrir: (id: string) => void;
+  style?: StyleProp<ViewStyle>;
+}) {
+  const { spacing } = useTheme();
+  const { data, recargar } = useAsyncData(
+    async () => {
+      const lista = await getOdtAsignadas();
+      if (!lista || lista.length === 0) return null;
+      // El reloj vive en el detalle de cada una. Si uno falla, esa ODT sale
+      // igual, sin reloj: sus botones siguen sirviendo.
+      const ejecuciones = await Promise.all(lista.map((o) => getEjecucionOdt(o.id).catch(() => null)));
+      return lista.map((o, i) => ({ orden: o, ejecucion: ejecuciones[i] }));
+    },
+    [],
+    { onFocus: true },
+  );
+
+  if (!data) return null;
+
+  return (
+    <Card style={[{ gap: spacing.md, paddingBottom: spacing.xs }, style]}>
+      <View style={{ gap: 2 }}>
+        <ThemedText style={styles.titulo}>Asignadas a ti</ThemedText>
+        <ThemedText variant="caption" color="textSecondary">
+          El supervisor te asignó estas ODT. Inicia, pausa y entrega desde aquí.
+        </ThemedText>
+      </View>
+      <View>
+        {data.map(({ orden, ejecucion }, i) => (
+          <FilaAsignada
+            key={orden.id}
+            orden={orden}
+            ejecucion={ejecucion}
+            primera={i === 0}
+            onAbrir={() => onAbrir(orden.id)}
+            onHecho={recargar}
+          />
+        ))}
+      </View>
+    </Card>
+  );
+}
+
+/** Una ODT asignada: unidad, título (abre el detalle), estado, reloj y botones. */
+function FilaAsignada({
