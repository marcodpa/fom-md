+import { StyleSheet, View } from 'react-native';
+
+import { Card } from '@/components/card';
+import { Pastilla } from '@/components/pastilla';
+import { PressableScale } from '@/components/pressable-scale';
+import { ThemedText } from '@/components/themed-text';
+import type { EstadoProgramada, InspeccionProgramada } from '@/services/inspeccionService';
+import { useTheme, type ColorTokens } from '@/theme';
+import { formatFecha } from '@/utils/date';
+
+/** Cómo se ve cada estado de una cita: el mismo semáforo que el resto de la app. */
+const VISTA: Record<EstadoProgramada, { label: string; tono: keyof ColorTokens }> = {
+  pendiente: { label: 'Pendiente', tono: 'warning' },
+  vencida: { label: 'Vencida', tono: 'danger' },
+  hecha: { label: 'Hecha', tono: 'success' },
+};
+
+/** La línea de abajo de cada cita: qué puede hacer con ella. */
+function queHacer(p: InspeccionProgramada, activa: boolean): { texto: string; tono: keyof ColorTokens } {
+  if (p.estado === 'hecha') return { texto: 'Enviada. Ya cuenta para tu supervisor.', tono: 'textMuted' };
+  if (p.estado === 'vencida') {
+    return { texto: 'No se hizo a tiempo. Pídele a tu supervisor que la reprograme.', tono: 'textMuted' };
+  }
+  if (!p.deHoy) return { texto: `Se hace el ${formatFecha(p.fecha)}.`, tono: 'textMuted' };
+  return activa
+    ? { texto: 'La estás haciendo abajo.', tono: 'onActive' }
+    : { texto: 'Tócala para hacerla ahora →', tono: 'primary' };
+}
+
+/**
+ * «INSPECCIONES PROGRAMADAS PARA TI»: las citas que el supervisor puso desde la
+ * web —unidad, formato y día— y cómo van.
+ *
+ * Solo se puede tocar la de HOY: FOM recibe una programada únicamente el día de
+ * su cita. Las demás se ven para que el conductor sepa qué viene y qué se le
+ * pasó. Sin citas no pinta nada: la diaria sigue siendo lo primero.
+ */
+export function InspeccionProgramadaLista({
+  programadas,
+  activaId,
+  onElegir,
+}: {
+  programadas: InspeccionProgramada[];
+  /** La que se está respondiendo ahora, si alguna. */
+  activaId?: string;
+  onElegir: (p: InspeccionProgramada) => void;
+}) {
+  const { colors, spacing, radii, borderWidths } = useTheme();
+  if (programadas.length === 0) return null;
+  const paraHoy = programadas.filter((p) => p.estado === 'pendiente' && p.deHoy).length;
+
+  return (
+    <Card style={{ gap: spacing.xs }}>
+      <View style={[styles.fila, { gap: spacing.sm }]}>
+        <ThemedText variant="subtitle" style={[styles.flex1, styles.titulo]}>
+          Inspecciones programadas para ti
+        </ThemedText>
+        {paraHoy > 0 ? <Pastilla tono="warning" label={`${paraHoy} hoy`} conPunto /> : null}
+      </View>
+
+      {programadas.map((p, n) => {
+        const v = VISTA[p.estado];
+        const activa = p.id === activaId;
+        const tocable = p.estado === 'pendiente' && p.deHoy && !activa;
+        const pista = queHacer(p, activa);
+        const contenido = (
+          <>
+            <View style={[styles.fila, { gap: spacing.sm }]}>
+              <ThemedText variant="button" style={styles.flex1} numberOfLines={1}>
+                {[p.unidad, p.placa].filter(Boolean).join(' · ')}
+              </ThemedText>
+              <Pastilla tono={v.tono} label={v.label} conPunto={p.estado !== 'hecha'} />
+            </View>
+            <ThemedText variant="caption" color="textSecondary" numberOfLines={1}>
+              {[p.formato, p.deHoy ? 'Hoy' : formatFecha(p.fecha)].join(' · ')}
+            </ThemedText>
+            <ThemedText variant="caption" color={pista.tono} style={tocable ? styles.enlace : undefined}>
+              {pista.texto}
+            </ThemedText>
+          </>
+        );
+        const estilo = [
+          {
+            gap: 2,
+            paddingVertical: spacing.sm + 2,
+            paddingHorizontal: activa ? spacing.sm + 2 : 0,
+            borderTopWidth: n === 0 || activa ? 0 : borderWidths.hairline,
+            borderTopColor: colors.border,
+          },
+          activa && {
+            backgroundColor: colors.activeSurface,
+            borderColor: colors.activeBorder,
+            borderWidth: borderWidths.hairline,
+            borderRadius: radii.sm,
+          },
+        ];
+        return tocable ? (
+          <PressableScale
+            key={p.id}
+            onPress={() => onElegir(p)}
+            accessibilityRole="button"
+            accessibilityLabel={`Hacer la inspección programada de ${p.unidad}: ${p.formato}`}
+            style={estilo}>
+            {contenido}
+          </PressableScale>
+        ) : (
+          <View key={p.id} style={estilo}>
+            {contenido}
+          </View>
+        );
+      })}
+    </Card>
+  );
+}
+
+const styles = StyleSheet.create({
+  fila: { flexDirection: 'row', alignItems: 'center' },
+  flex1: { flex: 1, minWidth: 0 },
+  titulo: { fontSize: 17, lineHeight: 22 },
+  enlace: { fontWeight: '600' },
+});
