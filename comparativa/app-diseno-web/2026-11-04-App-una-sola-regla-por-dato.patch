+// ============================================================
+// LA DIARIA DE HOY — una sola cuenta para toda la app (igual que la web:
+// src/panel/datos/inspeccionesHoy.js). Reglas:
+//  - cuenta la UNIDAD, no los registros (una unidad con dos inspecciones es una);
+//  - solo la clase diaria: la programada no sustituye a la diaria (sin clase,
+//    servidor viejo, todas eran diarias);
+//  - «hoy» es el día LOCAL del teléfono, nunca el de UTC;
+//  - una inspección de una unidad que ya no está en la flota no suma.
+// Solo importa `date.ts` (que no importa nada): se prueba con Node solo.
+// ============================================================
+
+// La hora local de hoy es de utils/date.ts: aquí solo se reexporta, para no tener dos.
+import { hoyISO } from './date.ts';
+
+export { hoyISO };
+
+/** Lo mínimo que se mira de una inspección. `programada`/`scheduled` es la de cita; lo demás, diaria. */
+export type InspeccionDeDia = { clase?: string | null; fecha?: string | null; vehicleId?: string | null; vehiculoId?: string | null };
+
+/** Solo la diaria cuenta; las demás se ven como una inspección más. */
+export const esDiaria = (i: InspeccionDeDia | null | undefined): boolean =>
+  i?.clase !== 'programada' && i?.clase !== 'scheduled';
+
+const idDeInspeccion = (i: InspeccionDeDia): string | null => i.vehicleId ?? i.vehiculoId ?? null;
+
+/**
+ * Las unidades de la flota que todavía no tienen su diaria de hoy.
+ * `idDe` dice cómo sacar el id de una unidad (por defecto `.id`; en la app, `u.vehicle.id`).
+ */
+export function unidadesSinDiariaHoy<V>(
+  flota: readonly V[] | null | undefined,
+  inspecciones: readonly InspeccionDeDia[] | null | undefined,
+  hoy: string = hoyISO(),
+  idDe: (v: V) => string = (v) => (v as unknown as { id: string }).id,
+): V[] {
+  const hechas = new Set(
+    (inspecciones ?? [])
+      .filter((i) => esDiaria(i) && String(i?.fecha ?? '').slice(0, 10) === hoy)
+      .map(idDeInspeccion),
+  );
+  return (flota ?? []).filter((v) => !hechas.has(idDe(v)));
+}
+
+/** Cuántas unidades ya hicieron la diaria de hoy: el total menos las que faltan. */
+export function diariasHechasHoy<V>(
+  flota: readonly V[] | null | undefined,
+  inspecciones: readonly InspeccionDeDia[] | null | undefined,
+  hoy: string = hoyISO(),
+  idDe?: (v: V) => string,
+): number {
+  return (flota ?? []).length - unidadesSinDiariaHoy(flota, inspecciones, hoy, idDe).length;
+}
