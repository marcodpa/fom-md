+function finishDatabase(status, options = {}) {
+  const calls = [];
+  const state = { status };
+  const client = {
+    async query(text, values = []) {
+      calls.push({ text, values });
+      if (/^(BEGIN|COMMIT|ROLLBACK)$/u.test(text)) return { rows: [] };
+      if (text.includes('FOR UPDATE OF work_order')) {
+        return { rows: [{ status: state.status, assignment_id: options.unassigned ? null : ASSIGNMENT }] };
+      }
+      if (text.includes('WHERE tenant_id = $1 AND client_event_id = $2')) {
+        return { rows: options.previous ? [options.previous] : [] };
+      }
+      if (text.includes('UPDATE fom.work_orders')) {
+        state.status = values[2];
+        return { rows: [] };
+      }
+      if (text.includes('INSERT INTO fom.work_order_execution_events')) {
+        if (options.failOn === values[4]) {
+          throw Object.assign(new Error('check violation'), { code: '23514' });
+        }
+        return { rows: [{ eventKind: values[4], fromStatus: values[5], toStatus: values[6], note: values[7] }] };
+      }
+      return { rows: [] };
+    },
+    release() {},
+  };
+  return { calls, state, getPool: () => ({ connect: async () => client }) };
+}
+
+const FINISH = {
+  clientEventId: KEY,
+  note: 'Se cambió la correa y se probó en ruta',
+};
+const writes = (db) => db.calls.some(({ text }) => /UPDATE fom\.|INSERT INTO/u.test(text));
+
+test('Terminé desde asignada registra inicio y entrega en una transacción', async () => {
+  const db = finishDatabase('asignada');
+  const result = await as('conductor', () => new WorkOrderExecutionService(db).finish(ORDER, {
+    ...FINISH, expectedStatus: 'asignada',
+  }), TECHNICIAN);
+  assert.equal(db.state.status, 'en_calidad');
+  assert.equal(result.replayed, false);
+  assert.deepEqual(result.events.map(({ eventKind }) => eventKind), ['inicio', 'entrega']);
+  const inserts = db.calls.filter(({ text }) => text.includes('INSERT INTO fom.work_order_execution_events'));
+  assert.equal(inserts[1].values[8], KEY, 'la entrega lleva el clientEventId del cliente');
+  assert.notEqual(inserts[0].values[8], KEY);
+  assert.equal(inserts[1].values[7], FINISH.note);
+  assert.equal(db.calls.filter(({ text }) => text === 'BEGIN').length, 1);
+  assert.equal(db.calls.at(-1).text, 'COMMIT');
+});
+
+test('Terminé desde en_ejecucion solo entrega; desde pausada reanuda y entrega', async () => {
+  const running = finishDatabase('en_ejecucion');
+  const direct = await as('operator', () => new WorkOrderExecutionService(running).finish(ORDER, {
+    ...FINISH, expectedStatus: 'en_ejecucion',
+  }), TECHNICIAN);
+  assert.deepEqual(direct.events.map(({ eventKind }) => eventKind), ['entrega']);
+
+  const paused = finishDatabase('pausada');
+  const resumed = await as('operator', () => new WorkOrderExecutionService(paused).finish(ORDER, {
+    ...FINISH, expectedStatus: 'pausada',
+  }), TECHNICIAN);
+  assert.deepEqual(resumed.events.map(({ eventKind }) => eventKind), ['reanudacion', 'entrega']);
+});
+
+test('Terminé: quien no es responsable vigente recibe 404 sin escribir', async () => {
+  const db = finishDatabase('asignada', { unassigned: true });
+  await assert.rejects(
+    () => as('conductor', () => new WorkOrderExecutionService(db).finish(ORDER, {
+      ...FINISH, expectedStatus: 'asignada',
+    }), TECHNICIAN),
+    (error) => error.status === 404,
+  );
+  assert.equal(writes(db), false);
+  assert.equal(db.calls.at(-1).text, 'ROLLBACK');
+});
+
+test('Terminé: estado obsoleto 409 y un fallo en la entrega no deja el inicio', async () => {
+  const stale = finishDatabase('en_calidad');
+  await assert.rejects(
+    () => as('conductor', () => new WorkOrderExecutionService(stale).finish(ORDER, {
+      ...FINISH, expectedStatus: 'asignada',
+    }), TECHNICIAN),
+    (error) => error.status === 409,
+  );
+  assert.equal(writes(stale), false);
+
+  const broken = finishDatabase('asignada', { failOn: 'entrega' });
+  await assert.rejects(
+    () => as('conductor', () => new WorkOrderExecutionService(broken).finish(ORDER, {
+      ...FINISH, expectedStatus: 'asignada',
+    }), TECHNICIAN),
+  );
+  assert.ok(broken.calls.some(({ values }) => values[4] === 'inicio'), 'el inicio llegó a escribirse');
+  assert.equal(broken.calls.some(({ text }) => text === 'COMMIT'), false);
+  assert.equal(broken.calls.at(-1).text, 'ROLLBACK');
+});
+
+test('Terminé: el mismo clientEventId devuelve lo registrado; con otra nota, 409', async () => {
+  const previous = {
+    id: ASSIGNMENT, workOrderId: ORDER, actorUserId: TECHNICIAN,
+    eventKind: 'entrega', fromStatus: 'en_ejecucion', toStatus: 'en_calidad',
+    note: FINISH.note,
+  };
+  const db = finishDatabase('en_calidad', { previous });
+  const replay = await as('conductor', () => new WorkOrderExecutionService(db).finish(ORDER, {
+    ...FINISH, expectedStatus: 'asignada',
+  }), TECHNICIAN);
+  assert.equal(replay.replayed, true);
+  assert.deepEqual(replay.events, [previous]);
+  assert.equal(writes(db), false);
+
+  const other = finishDatabase('en_calidad', { previous });
+  await assert.rejects(
+    () => as('conductor', () => new WorkOrderExecutionService(other).finish(ORDER, {
+      ...FINISH, note: 'Otra nota distinta', expectedStatus: 'asignada',
+    }), TECHNICIAN),
+    (error) => error.status === 409,
+  );
+});
+
+test('puerta móvil: el conductor solo cruza a sus ODT asignadas y su reloj', () => {
+  const guard = new MobileOperationsReadGuard(new Reflector());
+  const proto = MobileWorkOrderExecutionController.prototype;
+  const context = (handler, method, role) => ({
+    getHandler: () => handler,
+    switchToHttp: () => ({
+      getRequest: () => ({
+        method,
+        fomMobileActor: { userId: TECHNICIAN, tenantId: TENANT, role, platformAdmin: false },
+      }),
+    }),
+  });
+  for (const [handler, method] of [
+    [proto.listAssigned, 'GET'],
+    [proto.detail, 'GET'],
+    [proto.execute, 'POST'],
+    [proto.finish, 'POST'],
+  ]) {
+    assert.equal(guard.canActivate(context(handler, method, 'conductor')), true, handler.name);
+    assert.throws(() => guard.canActivate(context(handler, method, 'usuario')), /Operational data/u);
+  }
+  for (const [handler, method] of [
+    [proto.assign, 'PUT'],
+    [proto.listAssignable, 'GET'],
+    [proto.dispatch, 'POST'],
+    [proto.resolve, 'POST'],
+    [proto.close, 'POST'],
+    [proto.returnToExecution, 'POST'],
+  ]) {
+    assert.throws(
+      () => guard.canActivate(context(handler, method, 'conductor')),
+      (error) => error.getStatus() === 403,
+      handler.name,
+    );
+    assert.equal(guard.canActivate(context(handler, method, 'supervisor')), true);
+  }
+});
+
+test('consola registra las rutas estáticas de ODT antes del parámetro :workOrderId', () => {
+  const controllers = consoleModule.slice(
+    consoleModule.indexOf('controllers: ['),
+    consoleModule.indexOf('providers: ['),
+  );
+  assert.ok(
+    controllers.indexOf('ConsoleWorkOrderExecutionController') <
+      controllers.indexOf('ConsoleOperationsController'),
+  );
+});
