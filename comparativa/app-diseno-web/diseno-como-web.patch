+        marcas.current.set(p.id, marca);
+      } else {
+        marca.setLngLat([p.coords.lng, p.coords.lat]);
+      }
+      const el = marca.getElement();
+      el.innerHTML = html;
+      el.title = [p.label, p.detalle].filter(Boolean).join(' · ');
+    });
+    marcas.current.forEach((marca, id) => {
+      if (!vistos.has(id)) {
+        marca.remove();
+        marcas.current.delete(id);
+      }
+    });
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [markers, vehicleCoords, resaltadoId, colorScheme, listo]);
+
+  // Estelas por debajo de los marcadores.
+  useEffect(() => {
+    const m = mapa.current;
+    if (!m || !m.isStyleLoaded()) return;
+    const datos = {
+      type: 'FeatureCollection' as const,
+      features: puntos
+        .filter((p) => (p.estela?.length ?? 0) > 1)
+        .map((p) => ({ type: 'Feature' as const, properties: { color: colorDe(p) }, geometry: { type: 'LineString' as const, coordinates: p.estela!.map((c) => [c.lng, c.lat]) } })),
+    };
+    const fuente = m.getSource('fom-estelas') as import('mapbox-gl').GeoJSONSource | undefined;
+    if (fuente) fuente.setData(datos);
+    else {
+      m.addSource('fom-estelas', { type: 'geojson', data: datos });
+      m.addLayer({ id: 'fom-estelas', type: 'line', source: 'fom-estelas', slot: 'top', layout: { 'line-cap': 'round', 'line-join': 'round' }, paint: { 'line-color': ['get', 'color'], 'line-width': 3, 'line-emissive-strength': 1 } } as never);
+    }
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [markers, listo]);
+
+  // Encuadre: al cargar y cada vez que cambia el conjunto (nunca por un refresco de posiciones).
+  useEffect(() => {
+    const m = mapa.current;
+    const mapboxgl = gl.current;
+    if (!m || !mapboxgl || !esMulti || !puntos.length) return;
+    if (puntos.length === 1) {
+      m.easeTo({ center: [puntos[0].coords.lng, puntos[0].coords.lat], zoom: 14 });
+      return;
+    }
+    const limites = puntos.reduce((b, p) => b.extend([p.coords.lng, p.coords.lat]), new mapboxgl.LngLatBounds([puntos[0].coords.lng, puntos[0].coords.lat], [puntos[0].coords.lng, puntos[0].coords.lat]));
+    m.fitBounds(limites, { padding: 60, maxZoom: 15, pitch: prefs.tresD ? PITCH_3D : 0, duration: 600 });
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [encuadreClave, listo === 1]);
+
+  const siguiente = (() => {
+    const op = opcionesMapa();
+    const i = op.findIndex((o) => o.id === prefs.tipo);
+    return op[(Math.max(0, i) + 1) % op.length];
+  })();
+  const enMarcha = esMulti ? markers!.filter((p) => (p.estado ? p.estado === 'marcha' : p.live)).length : 0;
+  const fondo = { backgroundColor: colors.surfaceElevated, borderColor: colors.border, borderRadius: radii.md };
+
+  return (
+    <View style={[styles.container, { backgroundColor: colors.surface, borderColor: colors.border, borderRadius: radii.lg }, style]}>
+      <View ref={caja} style={StyleSheet.absoluteFill} />
+      {!hideOverlays ? (
+        <View style={[styles.pill, styles.arribaIzq, { backgroundColor: colors.surfaceElevated, borderColor: colors.border }]}>
+          <ThemedText variant="caption" color="text">
+            {esMulti ? `${markers!.length} vehículos · ${enMarcha} en marcha` : vehicleName}
+          </ThemedText>
+        </View>
+      ) : null}
+      <View style={styles.controles}>
+        <Pressable accessibilityRole="button" accessibilityLabel={`Ver ${siguiente.label.toLowerCase()}`} onPress={() => actualizar({ tipo: siguiente.id })} style={[styles.ctrl, fondo]}>
+          <ThemedText variant="overline" color={prefs.tipo === 'standard' ? 'text' : 'primary'}>{prefs.tipo === 'standard' ? 'MAPA' : 'SAT'}</ThemedText>
+        </Pressable>
+        <Pressable accessibilityRole="switch" accessibilityLabel={prefs.tresD ? '3D' : '2D'} accessibilityState={{ checked: prefs.tresD }} onPress={() => actualizar({ tresD: !prefs.tresD })} style={[styles.ctrl, fondo]}>
+          <ThemedText variant="overline" color={prefs.tresD ? 'primary' : 'textSecondary'}>{prefs.tresD ? '3D' : '2D'}</ThemedText>
+        </Pressable>
+      </View>
+    </View>
+  );
+}
+
+// Estilos de los marcadores HTML (no son componentes de React Native).
+if (typeof document !== 'undefined' && !document.getElementById('fom-marcadores-css')) {
+  const css = document.createElement('style');
+  css.id = 'fom-marcadores-css';
+  css.textContent = `
+.fom-marcador{display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer}
+.fom-placa{font:700 10px/13px system-ui,sans-serif;padding:1px 5px;border:1px solid;border-radius:6px;max-width:96px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.fom-punto{display:block;width:16px;height:16px;border-radius:50%;border:3px solid}
+.fom-flecha{display:block}`;
+  document.head.appendChild(css);
+}
+
+const styles = StyleSheet.create({
+  container: { width: '100%', height: 300, borderWidth: StyleSheet.hairlineWidth, overflow: 'hidden' },
+  pill: { position: 'absolute', flexDirection: 'row', alignItems: 'center', paddingHorizontal: 10, paddingVertical: 5, borderRadius: 999, borderWidth: StyleSheet.hairlineWidth },
+  arribaIzq: { top: 12, left: 12 },
+  controles: { position: 'absolute', top: 12, right: 12, gap: 8 },
+  ctrl: { width: 40, height: 36, alignItems: 'center', justifyContent: 'center', borderWidth: StyleSheet.hairlineWidth },
+});
