+/**
+ * Lo gastado este mes en la unidad, como el bloque «Costos del mes» de la web:
+ * el total, una barra con el peso de cada categoría y la lista de las que más
+ * pesan. Los gastos son los mismos que enseña «Gastos de la unidad».
+ */
+export function FichaUnidadCostos({ costos }: { costos: CostoItem[] }) {
+  const { colors, radii, spacing, borderWidths } = useTheme();
+  const total = costos.reduce((a, c) => a + c.monto, 0);
+
+  if (costos.length === 0 || total <= 0) {
+    return (
+      <ThemedText style={styles.vacio} color="textMuted">
+        Todavía no se ha anotado ningún gasto de esta unidad este mes.
+      </ThemedText>
+    );
+  }
+
+  const porCategoria = new Map<string, number>();
+  for (const c of costos) porCategoria.set(c.categoriaId, (porCategoria.get(c.categoriaId) ?? 0) + c.monto);
+  const ordenadas = [...porCategoria.entries()]
+    .map(([id, monto]) => ({ label: CATEGORIAS_COSTO.find((x) => x.id === id)?.label ?? id, monto }))
+    .sort((a, b) => b.monto - a.monto);
+  // Más de tres en una tarjeta de teléfono es una tabla: lo demás va junto.
+  const filas =
+    ordenadas.length > MAX_CATEGORIAS + 1
+      ? [
+          ...ordenadas.slice(0, MAX_CATEGORIAS),
+          {
+            label: 'Otros gastos',
+            monto: ordenadas.slice(MAX_CATEGORIAS).reduce((a, c) => a + c.monto, 0),
+          },
+        ]
+      : ordenadas;
+
+  return (
+    <View style={{ gap: spacing.sm }}>
+      <View style={[styles.total, { gap: spacing.sm }]}>
+        <ThemedText style={styles.totalCifra} tabular>
+          {dinero(total)}
+        </ThemedText>
+        <ThemedText style={styles.totalNota} color="textSecondary">
+          {`del mes · ${costos.length} ${costos.length === 1 ? 'gasto' : 'gastos'}`}
+        </ThemedText>
+      </View>
+
+      <View style={[styles.barra, { gap: 3 }]} accessibilityElementsHidden importantForAccessibility="no-hide-descendants">
+        {filas.map((f, i) => (
+          <View
+            key={f.label}
+            style={{
+              flex: f.monto / total,
+              height: 8,
+              borderRadius: radii.pill,
+              backgroundColor: colors[TONOS[i % TONOS.length]],
+            }}
+          />
+        ))}
+      </View>
+
+      <View>
+        {filas.map((f, i) => (
+          <View
+            key={f.label}
+            style={[
+              styles.fila,
+              { gap: spacing.sm + 2, borderTopWidth: borderWidths.hairline, borderTopColor: colors.border },
+            ]}>
+            <View style={[styles.punto, { backgroundColor: colors[TONOS[i % TONOS.length]] }]} />
+            <ThemedText style={styles.filaLabel} color="textSecondary" numberOfLines={1}>
+              {f.label}
+            </ThemedText>
+            <ThemedText style={styles.filaMonto} tabular>
+              {dinero(f.monto)}
+            </ThemedText>
+          </View>
+        ))}
+      </View>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  vacio: { fontSize: 13, lineHeight: 18 },
+  total: { flexDirection: 'row', alignItems: 'baseline' },
+  totalCifra: { fontSize: 26, lineHeight: 30, fontWeight: '700', letterSpacing: -0.5 },
+  totalNota: { fontSize: 13, lineHeight: 18 },
+  barra: { flexDirection: 'row' },
+  fila: { flexDirection: 'row', alignItems: 'center', height: 32 },
+  punto: { width: 8, height: 8, borderRadius: 3 },
+  filaLabel: { flex: 1, minWidth: 0, fontSize: 14, lineHeight: 18 },
+  filaMonto: { fontSize: 14, lineHeight: 18, fontWeight: '600' },
+});
