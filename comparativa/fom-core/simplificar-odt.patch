+        state.status = 'asignada';
+        state.sequence += 1;
+        state.last = { sequence: state.sequence, fromStatus: from, toStatus: 'asignada', note: values[3] };
+        return { rows: [] };
+      }
+      if (text.includes('FROM fom.work_order_events')) {
+        return { rows: [state.last] };
+      }
+      if (text.includes('FROM fom.tenant_memberships')) {
