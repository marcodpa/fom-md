+import { analizar, duracion, horaCorta, quitarSaltos, resumen, type Analisis, type PuntoRuta } from '@/lib/recorrido';
+import { getPosicionVehiculoFom, getRecorridoVehiculoFom } from '@/services';
+import { useTheme } from '@/theme';
+import type { MapMarker } from '@/types';
+
+/** Los mismos rangos que el Centro de control de la web. */
+const RANGOS = [6, 12, 24] as const;
+/** Lo más que se pide de una vez (como la web): más, y el teléfono se arrastra. */
+const LIMITE = 1000;
+
+/**
+ * EL RECORRIDO DE UNA UNIDAD, como en el Centro de control de la web.
+ *
+ * El mapa a pantalla completa con los viajes por las calles (Map Matching de
+ * Mapbox), el inicio A, el fin B y cada parada P; abajo, el rango (últimas 6,
+ * 12 o 24 h), el resumen y la línea de tiempo. Tocar un viaje lo resalta y lo
+ * encuadra; tocar una parada lleva el mapa a ella.
+ */
+export default function RecorridoScreen() {
+  const { colors, spacing, radii } = useTheme();
+  const router = useRouter();
+  const insets = useSafeAreaInsets();
+  const ventana = useWindowDimensions();
+  const { vehicleId = '', companyId, nombre } = useLocalSearchParams<{ vehicleId?: string; companyId?: string; nombre?: string }>();
+
+  const [horas, setHoras] = useState<(typeof RANGOS)[number]>(24);
+  const [viajeActivo, setViajeActivo] = useState<number | null>(null);
+  const [foco, setFoco] = useState<{ lat: number; lng: number; limites?: [number, number][]; clave: number } | null>(null);
+
+  // Las posiciones CRUDAS del rango, del más antiguo al más reciente.
+  const { data, estado, recargar } = useAsyncData(
+    async () => {
+      const desde = new Date(Date.now() - horas * 3600000).toISOString();
+      const [filas, ahora] = await Promise.all([
+        getRecorridoVehiculoFom(vehicleId, { from: desde, limit: LIMITE, companyId: companyId || undefined }),
+        getPosicionVehiculoFom(vehicleId).catch(() => null),
+      ]);
+      const puntos: PuntoRuta[] = filas
+        .map((p) => ({
+          lat: p.lat,
+          lng: p.lng,
+          hora: p.reportadaEn ?? p.recibidaEn ?? '',
+          velocidadKmh: p.velocidadKmh ?? null,
+          ignition: p.contacto ?? null,
+        }))
+        .filter((p) => p.hora)
+        .reverse();
+      return { analisis: analizar(quitarSaltos(puntos)), truncado: filas.length >= LIMITE, ahora };
+    },
+    [vehicleId, horas, companyId],
+  );
+
+  // Los viajes pegados a las calles: llegan después, y el mapa cambia la línea cruda por la buena.
+  const [pegado, setPegado] = useState<Analisis | null>(null);
+  const analisis = data?.analisis ?? null;
+  useEffect(() => {
+    if (!analisis || !analisis.viajes.length) return;
+    let vivo = true;
+    void emparejarViajes(analisis.viajes).then((viajes) => {
+      if (vivo) setPegado({ ...analisis, viajes });
+    });
+    return () => {
+      vivo = false;
+    };
+  }, [analisis]);
+  // Lo pegado vale solo para el análisis del que salió.
+  const ruta = pegado && analisis && pegado.puntos === analisis.puntos ? pegado : analisis;
+
+  const r = analisis ? resumen(analisis) : null;
+  const linea = useMemo(() => {
+    if (!ruta) return [];
+    const viajes = ruta.viajes.map((v) => ({ clave: `v${v.numero}`, desde: v.inicio.hora, viaje: v, parada: null }));
+    const paradas = ruta.paradas.map((p, i) => ({ clave: `p${i}`, desde: p.desde, viaje: null, parada: p }));
+    return [...viajes, ...paradas].sort((a, b) => Date.parse(b.desde) - Date.parse(a.desde));
+  }, [ruta]);
+
+  // Dónde está ahora: el punto de la unidad sobre su recorrido.
+  const marcadores: MapMarker[] = data?.ahora
+    ? [{ id: vehicleId, label: nombre ?? 'Unidad', coords: { lat: data.ahora.lat, lng: data.ahora.lng }, live: true, placa: nombre ?? undefined }]
+    : [];
+
+  const altoPanel = Math.round(ventana.height * 0.42);
+  const elegirViaje = (n: number | null) => {
+    setViajeActivo(n);
+    const v = n == null ? null : ruta?.viajes.find((x) => x.numero === n);
+    if (v) {
+      const limites = v.trazo && v.trazo.length > 1 ? v.trazo : v.puntos.map((p) => [p.lng, p.lat] as [number, number]);
+      setFoco({ lat: v.inicio.lat, lng: v.inicio.lng, limites, clave: Date.now() });
+    }
+  };
+
+  return (
+    <ThemedView style={styles.root}>
+      <MapaVehiculo
+        markers={marcadores}
+        sinUsuario
+        hideOverlays
+        ruta={ruta ?? null}
+        viajeActivo={viajeActivo}
+        onElegirViaje={elegirViaje}
+        foco={foco}
+        margenArriba={insets.top + 64}
+        margenAbajo={altoPanel}
+        style={styles.mapa}
+      />
+
+      {/* Arriba: volver y de qué unidad es, flotando sobre el mapa. */}
+      <View style={[styles.arriba, { paddingTop: insets.top + spacing.sm }]} pointerEvents="box-none">
+        <PressableScale
+          onPress={() => (router.canGoBack() ? router.back() : router.replace('/'))}
+          accessibilityRole="button"
+          accessibilityLabel="Volver"
+          style={[styles.circulo, { backgroundColor: 'rgba(20, 26, 34, 0.94)', borderRadius: radii.pill }]}>
+          <Svg width={22} height={22} viewBox="0 0 24 24" fill="none">
+            <Path d="M15 18l-6-6 6-6" stroke={colors.text} strokeWidth={2} strokeLinecap="round" strokeLinejoin="round" />
+          </Svg>
+        </PressableScale>
+        <View style={[styles.capsula, { backgroundColor: 'rgba(20, 26, 34, 0.94)' }]}>
+          <ThemedText style={[styles.eyebrow, { color: colors.textSecondary }]}>RECORRIDO</ThemedText>
+          <ThemedText style={styles.nombre} numberOfLines={1}>
+            {nombre || 'Unidad'}
+          </ThemedText>
+        </View>
+      </View>
+
+      {/* Abajo: el rango, el resumen y la línea de tiempo. */}
+      <View
+        style={[
+          styles.panel,
+          { height: altoPanel, paddingBottom: insets.bottom + spacing.sm, backgroundColor: colors.surface, borderRadius: radii.xl },
+        ]}>
+        <View style={[styles.rangos, { gap: spacing.sm }]}>
+          {RANGOS.map((h) => {
+            const activo = h === horas;
+            return (
+              <PressableScale
+                key={h}
+                onPress={() => {
+                  setHoras(h);
+                  setViajeActivo(null);
+                }}
+                accessibilityRole="button"
+                accessibilityState={{ selected: activo }}
+                style={[
+                  styles.rango,
+                  {
+                    borderColor: activo ? colors.primary : colors.border,
+                    backgroundColor: activo ? 'rgba(61, 155, 245, 0.16)' : colors.surfaceSunken,
+                  },
+                ]}>
+                <ThemedText style={[styles.rangoTexto, { color: activo ? colors.text : colors.textSecondary }]}>Últimas {h} h</ThemedText>
+              </PressableScale>
+            );
+          })}
+        </View>
+
+        {estado === 'cargando' && !data ? (
+          <View style={styles.centro}>
+            <ActivityIndicator color={colors.primary} />
+            <ThemedText variant="caption" color="textSecondary">
+              Cargando recorrido…
+            </ThemedText>
+          </View>
+        ) : estado === 'error' && !data ? (
+          <View style={styles.centro}>
+            <ThemedText variant="body" color="textSecondary" style={styles.textoCentro}>
+              No se pudo cargar el recorrido.
+            </ThemedText>
+            <PressableScale onPress={recargar} accessibilityRole="button" style={[styles.reintentar, { backgroundColor: colors.primary }]}>
+              <ThemedText style={[styles.rangoTexto, { color: colors.onPrimary }]}>Reintentar</ThemedText>
+            </PressableScale>
+          </View>
+        ) : linea.length === 0 ? (
+          <View style={styles.centro}>
+            <ThemedText variant="body" color="textSecondary" style={styles.textoCentro}>
+              No hay viajes ni paradas registrados en las últimas {horas} h.
+            </ThemedText>
+          </View>
+        ) : (
+          <>
+            {r ? (
+              <View style={[styles.resumen, { gap: spacing.sm }]}>
+                <Cifra valor={String(r.viajes)} label={r.viajes === 1 ? 'viaje' : 'viajes'} />
+                <Cifra valor={r.km.toFixed(1)} label="km" />
+                <Cifra valor={String(r.paradas)} label={`${r.paradas === 1 ? 'parada' : 'paradas'} · ${duracion(r.minutosParada)}`} />
+              </View>
+            ) : null}
+            {data?.truncado ? (
+              <ThemedText variant="caption" color="warning" style={{ paddingHorizontal: 4 }}>
+                El rango trae más posiciones de las que se pueden mostrar: faltan las más antiguas.
+              </ThemedText>
+            ) : null}
+            <ScrollView style={styles.flex1} contentContainerStyle={{ gap: 6, paddingBottom: spacing.md }}>
+              {linea.map((it) =>
+                it.viaje ? (
+                  <PressableScale
+                    key={it.clave}
+                    onPress={() => elegirViaje(viajeActivo === it.viaje!.numero ? null : it.viaje!.numero)}
+                    accessibilityRole="button"
+                    accessibilityState={{ selected: viajeActivo === it.viaje.numero }}
+                    style={[
+                      styles.fila,
+                      {
+                        backgroundColor: viajeActivo === it.viaje.numero ? 'rgba(61, 155, 245, 0.16)' : colors.surfaceSunken,
+                        borderColor: viajeActivo === it.viaje.numero ? colors.primary : 'transparent',
+                      },
+                    ]}>
+                    <View style={[styles.letra, { backgroundColor: colors.success }]}>
+                      <ThemedText style={[styles.letraTexto, { color: colors.onSuccess }]}>A</ThemedText>
+                    </View>
+                    <View style={styles.flex1}>
+                      <ThemedText style={styles.filaTitulo}>Viaje {it.viaje.numero}</ThemedText>
+                      <ThemedText variant="caption" color="textSecondary">
+                        {horaCorta(it.viaje.inicio.hora)} → {it.viaje.fin.enCurso ? 'en camino' : horaCorta(it.viaje.fin.hora)} ·{' '}
+                        {duracion(it.viaje.minutos)} · {(it.viaje.distanciaM / 1000).toFixed(1)} km
+                      </ThemedText>
+                    </View>
+                  </PressableScale>
+                ) : (
+                  <PressableScale
+                    key={it.clave}
+                    onPress={() => setFoco({ lat: it.parada!.lat, lng: it.parada!.lng, clave: Date.now() })}
+                    accessibilityRole="button"
+                    style={[styles.fila, { backgroundColor: colors.surfaceSunken, borderColor: 'transparent' }]}>
+                    <View style={[styles.letra, { backgroundColor: colors.warning }]}>
+                      <ThemedText style={[styles.letraTexto, { color: colors.onWarning }]}>P</ThemedText>
+                    </View>
+                    <View style={styles.flex1}>
+                      <ThemedText style={styles.filaTitulo}>Estacionada {duracion(it.parada!.minutos)}</ThemedText>
+                      <ThemedText variant="caption" color="textSecondary">
+                        {horaCorta(it.parada!.desde)} → {horaCorta(it.parada!.hasta)}
+                      </ThemedText>
+                    </View>
+                  </PressableScale>
+                ),
+              )}
+            </ScrollView>
+          </>
+        )}
+      </View>
+    </ThemedView>
+  );
+}
+
+/** Una cifra del resumen: número grande y qué es. */
+function Cifra({ valor, label }: { valor: string; label: string }) {
+  const { colors } = useTheme();
+  return (
+    <View style={[styles.cifra, { backgroundColor: colors.surfaceSunken }]}>
+      <ThemedText style={styles.cifraValor} tabular>
+        {valor}
+      </ThemedText>
+      <ThemedText style={[styles.cifraLabel, { color: colors.textSecondary }]} numberOfLines={1}>
+        {label}
+      </ThemedText>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  root: { flex: 1 },
+  // A pantalla completa: el alto explícito gana al alto por defecto del mapa.
+  mapa: { position: 'absolute', top: 0, left: 0, right: 0, bottom: 0, height: '100%' },
+  flex1: { flex: 1, minWidth: 0 },
+  arriba: { position: 'absolute', top: 0, left: 0, right: 64, flexDirection: 'row', alignItems: 'center', gap: 8, paddingHorizontal: 14 },
+  circulo: { width: 44, height: 44, alignItems: 'center', justifyContent: 'center' },
+  capsula: { flex: 1, minWidth: 0, minHeight: 52, justifyContent: 'center', gap: 2, paddingVertical: 8, paddingHorizontal: 16, borderRadius: 20 },
+  eyebrow: { fontSize: 10, lineHeight: 13, letterSpacing: 1.4, fontWeight: '600' },
+  nombre: { fontSize: 15, lineHeight: 20, fontWeight: '600' },
+  panel: { position: 'absolute', left: 8, right: 8, bottom: 8, padding: 14, gap: 10 },
+  rangos: { flexDirection: 'row' },
+  rango: { flex: 1, minHeight: 36, borderRadius: 999, borderWidth: 1, alignItems: 'center', justifyContent: 'center', paddingHorizontal: 8 },
+  rangoTexto: { fontSize: 12, lineHeight: 16, fontWeight: '600' },
+  resumen: { flexDirection: 'row' },
+  cifra: { flex: 1, minWidth: 0, padding: 10, borderRadius: 14, gap: 2 },
+  cifraValor: { fontSize: 18, lineHeight: 22, fontWeight: '700' },
+  cifraLabel: { fontSize: 11, lineHeight: 14 },
+  fila: { flexDirection: 'row', alignItems: 'center', gap: 12, padding: 10, borderRadius: 14, borderWidth: 1 },
+  letra: { width: 28, height: 28, borderRadius: 14, alignItems: 'center', justifyContent: 'center' },
+  letraTexto: { fontSize: 12, lineHeight: 14, fontWeight: '800' },
+  filaTitulo: { fontSize: 14, lineHeight: 19, fontWeight: '600' },
+  centro: { flex: 1, alignItems: 'center', justifyContent: 'center', gap: 10 },
+  textoCentro: { textAlign: 'center' },
+  reintentar: { minHeight: 40, paddingHorizontal: 18, borderRadius: 999, alignItems: 'center', justifyContent: 'center' },
+});
