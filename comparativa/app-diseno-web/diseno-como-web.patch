+  actualizar: (cambio: Partial<MapaPrefs>) => void;
+  abajo: number;
+  arriba: boolean;
+  margenArriba: number;
+  onEncuadrar?: () => void;
+  onRecentrar?: () => void;
+}) {
+  const { colors, radii } = useTheme();
+  const opciones = opcionesMapa();
+  // La siguiente capa del ciclo: es lo que hará el botón al tocarlo.
+  const actual = opciones.findIndex((o) => o.id === prefs.tipo);
+  const siguiente = opciones[(Math.max(0, actual) + 1) % opciones.length];
+  const fondo = { backgroundColor: colors.surfaceElevated, borderColor: colors.border, borderRadius: radii.md };
+  const colorTrafico = prefs.trafico ? colors.primary : colors.textSecondary;
+
+  return (
+    <View
+      style={[
+        styles.overlay,
+        arriba ? styles.topRightCtrl : styles.bottomRight,
+        arriba ? { top: 12 + margenArriba } : { bottom: 12 + abajo },
+      ]}>
+      {onRecentrar ? (
+        <PressableScale
+          onPress={onRecentrar}
+          accessibilityRole="button"
+          accessibilityLabel="Ir a la unidad destacada"
+          style={[styles.ctrl, fondo]}>
+          <TabIcon name="mira" color={colors.primary} size={18} />
+        </PressableScale>
+      ) : null}
+      {onEncuadrar ? (
+        <PressableScale
+          onPress={onEncuadrar}
+          accessibilityRole="button"
+          accessibilityLabel="Encuadrar toda la flota"
+          style={[styles.ctrl, fondo]}>
+          <TabIcon name="encuadrar" color={colors.text} size={18} />
+        </PressableScale>
+      ) : null}
+      <PressableScale
+        onPress={() => actualizar({ tipo: siguiente.id })}
+        accessibilityRole="button"
+        accessibilityLabel={`Ver ${siguiente.label.toLowerCase()}`}
+        accessibilityHint="Cambia la capa del mapa"
+        style={[styles.ctrl, fondo]}>
+        <TabIcon name="capas" color={prefs.tipo === 'standard' ? colors.text : colors.primary} size={18} />
+      </PressableScale>
+      <PressableScale
+        onPress={() => actualizar({ tresD: !prefs.tresD })}
+        accessibilityRole="switch"
+        accessibilityLabel={prefs.tresD ? '3D' : '2D'}
+        accessibilityHint="Alterna entre vista plana e inclinada"
+        accessibilityState={{ checked: prefs.tresD }}
+        style={[styles.ctrl, fondo]}>
+        <ThemedText variant="overline" color={prefs.tresD ? 'primary' : 'textSecondary'}>
+          {prefs.tresD ? '3D' : '2D'}
+        </ThemedText>
+      </PressableScale>
+      <PressableScale
+        onPress={() => actualizar({ trafico: !prefs.trafico })}
+        accessibilityRole="switch"
+        accessibilityLabel="Tráfico"
+        accessibilityHint="Muestra u oculta el tráfico en vivo"
+        accessibilityState={{ checked: prefs.trafico }}
+        style={[styles.ctrl, fondo]}>
+        {/* El semáforo de la web: teñido cuando el tráfico está a la vista. */}
+        <Svg width={18} height={18} viewBox="0 0 24 24" fill="none">
+          <Rect x={7} y={2} width={10} height={20} rx={3} stroke={colorTrafico} strokeWidth={2} />
+          <Circle cx={12} cy={7} r={1.5} stroke={colorTrafico} strokeWidth={2} />
+          <Circle cx={12} cy={12} r={1.5} stroke={colorTrafico} strokeWidth={2} />
+          <Circle cx={12} cy={17} r={1.5} stroke={colorTrafico} strokeWidth={2} />
+        </Svg>
+      </PressableScale>
     </View>
   );
 }
