@@ -0,0 +1,59 @@
+import { Image } from 'expo-image';
+import type { ReactNode } from 'react';
+import { View, type StyleProp, type ViewStyle } from 'react-native';
+
+import type { FotoPropia } from '@/hooks/use-foto-vehiculo';
+import { urlDe } from '@/lib/cloudinary';
+
+/**
+ * La foto PROPIA de una unidad (la que subieron desde la web o la app) dentro
+ * de un recuadro de `ancho × alto`, con la regla de la web:
+ *  - el recorte sin fondo, entero y sin cortar (`contain`);
+ *  - si no hay, su foto normal, llenando el recuadro (`cover`, centrada en lo
+ *    importante por Cloudinary) — el recuadro va redondeado, no recortada
+ *    sobre lo de abajo;
+ *  - si no hay ninguna (o aún se busca, o no cargó), `respaldo`: el render del
+ *    catálogo por marca y modelo o la silueta de su tipo.
+ *
+ * Quien lo usa pone el tamaño, el redondeado y el fondo del recuadro.
+ */
+export function FotoVehiculo({
+  foto,
+  ancho,
+  alto,
+  respaldo,
+  etiqueta,
+  estilo,
+}: {
+  foto: FotoPropia;
+  ancho: number;
+  alto: number;
+  respaldo: ReactNode;
+  /** Qué se lee en voz alta; sin ella, la foto se ignora (es adorno junto al nombre). */
+  etiqueta?: string;
+  estilo?: StyleProp<ViewStyle>;
+}) {
+  if (!foto.id || !foto.tipo) return <>{respaldo}</>;
+  // Se pide al doble del tamaño: nítida en pantallas de 2x y 3x sin bajar de más.
+  const uri =
+    foto.tipo === 'recorte'
+      ? urlDe(foto.id, Math.round(ancho * 2), 0, { ajuste: 'contener' })
+      : urlDe(foto.id, Math.round(ancho * 2), Math.round(alto * 2));
+  if (!uri) return <>{respaldo}</>;
+  return (
+    <View style={[{ width: ancho, height: alto, overflow: 'hidden' }, estilo]}>
+      <Image
+        // Cada foto con su caché: al cambiar de unidad no se queda la anterior.
+        key={foto.id}
+        source={{ uri }}
+        recyclingKey={foto.id}
+        style={{ width: '100%', height: '100%' }}
+        contentFit={foto.tipo === 'recorte' ? 'contain' : 'cover'}
+        transition={180}
+        onError={foto.alFallar}
