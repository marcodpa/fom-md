+/** El nombre entra en la clave: con él se decide qué ODT son suyas. */
+function clavePanel(vehicle: Vehicle | null, user: User): string {
+  return `${user.id}|${user.companyId ?? ''}|${user.name}|${vehicle?.id ?? ''}`;
+}
+
+/** Sigue valiendo: nada lo olvidó, FOM no cambió y no ha pasado el minuto. */
+function panelVigente(e: EntradaPanel): boolean {
+  return (
+    e.gen === panelesGen &&
+    e.api === generacionLecturas() &&
+    (e.en === null || Date.now() - e.en < PANEL_VIGENTE_MS)
+  );
+}
+
+/**
+ * Los avisos sin leer del panel que ya está en memoria y vale, sin pedir nada;
+ * `null` si no lo hay. La campana arranca con él: al cambiar de pestaña no
+ * parpadea de 0 a N.
+ */
+export function noLeidasEnMemoria(vehicle: Vehicle | null, user: User): number | null {
+  const e = paneles.get(clavePanel(vehicle, user));
+  return e?.listo && panelVigente(e) ? e.listo.noLeidas : null;
+}
