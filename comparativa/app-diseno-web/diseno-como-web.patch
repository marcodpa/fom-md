+  markerColor?: string;
+  /**
+   * Posición del VEHÍCULO (modo single) que reporta su GPS (mock hoy, API
+   * mañana). Con ella el mapa muestra DOS puntos: el vehículo aquí y TU
+   * ubicación con el punto del sistema (FOM-02 §8-8). Sin ella, se conserva la
+   * simulación legada (el teléfono ES el vehículo).
+   */
+  vehicleCoords?: LatLng | null;
+  /**
+   * Marcadores de toda la flota (modo multi-vehículo). Si se pasan, el mapa
+   * muestra todos los vehículos en sus coordenadas. VACÍO también cuenta: el
+   * mapa queda en modo flota, sin puntos y con su encuadre — no cae al modo de
+   * un solo vehículo, que dibujaría al teléfono como si fuera una unidad.
+   */
+  markers?: MapMarker[];
+  /** Toca un marcador (modo multi): devuelve su id para mostrar su info. */
+  onMarkerPress?: (id: string) => void;
+  /** Oculta las etiquetas flotantes del mapa (nombre / EN VIVO) para no duplicar. */
+  hideOverlays?: boolean;
+  /**
+   * Modo SOLO USUARIO: sin vehículo. Muestra el mapa con TU ubicación (punto
+   * del sistema) aunque no estés en ninguna unidad (directriz: la persona ve
+   * dónde está aun sin vehículo).
+   */
+  soloUsuario?: boolean;
+  /**
+   * OCULTA el punto azul del usuario. Útil en el mapa del panel del
+   * supervisor: ahí importa dónde está la FLOTA, no dónde está la persona que
+   * mira. Sin esto, el supervisor se ve a sí mismo mezclado con sus unidades.
+   */
+  sinUsuario?: boolean;
+  /**
+   * Espacio ocupado por algo que se superpone al mapa por abajo (la lengüeta
+   * del Inicio del conductor, el botón SOS…). Los controles del mapa y el aviso
+   * de permiso se suben esa cantidad para no quedar tapados ni ser intocables.
+   */
+  insetBottom?: number;
+  /** Controles ARRIBA a la derecha (cuando la parte baja está ocupada). */
+  controlesArriba?: boolean;
+  /**
+   * Cambia cuando cambia el CONJUNTO de marcadores (un filtro nuevo, no un
+   * refresco de posiciones): el mapa re-encuadra para que quepan todos. Sin
+   * ella solo encuadra al montar, como siempre.
+   */
+  encuadreClave?: string;
+  /** Marcador destacado: anillo más presente, y "recentrar" va a él. */
+  resaltadoId?: string | null;
+  /** Se tocó el mapa fuera de cualquier marcador (para soltar lo destacado). */
+  onMapaPress?: () => void;
+  /** Estilo del contenedor (para alto, bordes, etc.). */
+  style?: StyleProp<ViewStyle>;
+};
+
+type Coords = { latitude: number; longitude: number };
+type Permiso = 'pendiente' | 'ok' | 'denegado';
+
+/**
+ * Onda que sale del centro del marcador hacia afuera y se desvanece.
+ *
+ * Late solo cuando la unidad SE MUEVE. Antes latía también detenida —decía
+ * "hay señal"—, pero una flota entera latiendo no distingue nada; ahora la
+ * onda es movimiento, y el anillo quieto es "transmite pero no rueda".
+ *
+ * Va detrás del anillo y del punto, no en su lugar: el diseño del marcador no
+ * cambia, solo se le añade el latido. `duracion` se desfasa por marcador para
+ * que dos unidades rodando no latan al unísono como un semáforo.
+ */
+export function OndaMarcador({
+  color,
+  activa,
+  duracion = 2200,
+}: {
+  color: string;
+  activa: boolean;
+  duracion?: number;
+}) {
+  const reducido = useReducedMotion();
+  // En estado y no en una ref: el valor animado SÍ se lee en el render (para
+  // interpolar), y una ref leída en el render es justo lo que React prohíbe.
+  // `useState` con inicializador lo crea una sola vez, igual que antes.
+  const [onda] = useState(() => new Animated.Value(0));
+  const animar = activa && !reducido;
+
+  useEffect(() => {
+    if (!animar) return;
+    onda.setValue(0);
+    const loop = Animated.loop(
+      Animated.timing(onda, { toValue: 1, duration: duracion, useNativeDriver: true }),
+    );
+    loop.start();
+    return () => loop.stop();
+  }, [animar, onda, duracion]);
+
+  if (!animar) return null;
+  return (
+    <Animated.View
+      pointerEvents="none"
+      style={[
+        estilosMapa.markerHalo,
+        {
+          backgroundColor: color,
+          // Arranca del tamaño del punto y crece hacia afuera; nunca al revés.
+          transform: [{ scale: onda.interpolate({ inputRange: [0, 1], outputRange: [0.55, 1.9] }) }],
+          opacity: onda.interpolate({ inputRange: [0, 1], outputRange: [0.32, 0] }),
+        },
+      ]}
+    />
+  );
+}
+
+/**
+ * El dibujo de un vehículo de la flota en el mapa: la placa encima y el punto
+ * (o la flecha con su rumbo) debajo, con la onda si se mueve. Lo comparten el
+ * mapa clásico y el de Mapbox, para que la flota se vea igual en los dos.
+ */
+export function CuerpoMarcador({
+  m,
+  i,
+  color,
+  tam,
+  resaltado,
+  rumbo,
+}: {
+  m: MapMarker;
+  i: number;
+  color: string;
+  tam: number;
+  resaltado: boolean;
+  rumbo: number | null;
+}) {
+  const { colors, radii } = useTheme();
+  return (
+      <View style={estilosMapa.markerCaja}>
+        {/* LA PLACA, encima y siempre legible. Va en su propia
+            cápsula porque el mapa de abajo cambia de color con la
+            capa y el zoom: sin fondo, la mitad de las placas caían
+            sobre una carretera blanca. */}
+        {m.placa ? (
+          <View
+            style={[
+              estilosMapa.placa,
+              {
+                backgroundColor: colors.surfaceElevated,
+                borderColor: color,
+                borderRadius: radii.sm,
+              },
+            ]}>
+            <ThemedText variant="caption" tabular numberOfLines={1} style={estilosMapa.placaTexto}>
+              {m.placa}
+            </ThemedText>
+          </View>
+        ) : null}
+
+        <View style={estilosMapa.markerWrap}>
+          {/* La emergencia manda sobre el estado de marcha: si esa
+              unidad pidió ayuda, su punto es rojo aunque vaya rodando.
+              La onda solo late si SE MUEVE; desfasada por marcador. */}
+          <OndaMarcador color={color} activa={m.estado === 'marcha'} duracion={2000 + (i % 3) * 400} />
+          {/* Sin señal, el punto va desnudo: ni onda ni aro. El anillo es
+              la envoltura de algo vivo, y ahí no hay nada vivo que
+              envolver — un punto apagado tiene que verse apagado. */}
+          {m.estado === 'sin-senal' ? null : (
+            <View
+              style={[
+                estilosMapa.markerRing,
+                { borderColor: color },
+                resaltado ? estilosMapa.markerRingResaltado : null,
+              ]}
+            />
+          )}
+          {/* Con rumbo y en marcha, FLECHA girada hacia donde va; si
+              no, el punto de siempre. Una flecha en una unidad parada
+              —o sin rumbo medido— apuntaría a un sitio inventado. */}
+          {rumbo === null ? (
+            <View
+              style={[
+                estilosMapa.markerDot,
+                { width: tam, height: tam, borderRadius: tam / 2 },
+                { backgroundColor: color, borderColor: colors.background },
+              ]}
+            />
+          ) : (
+            <View style={{ transform: [{ rotate: `${rumbo}deg` }] }}>
+              <Svg width={tam + 10} height={tam + 10} viewBox="0 0 24 24">
+                {/* Punta arriba: 0° es el norte, y el giro hace el resto. */}
+                <Path
+                  d="M12 2.5 L20 21 L12 16.5 L4 21 Z"
+                  fill={color}
+                  stroke={colors.background}
+                  strokeWidth={2}
+                  strokeLinejoin="round"
+                />
+              </Svg>
+            </View>
+          )}
+        </View>
+      </View>
+  );
+}
+
+/** Región que encuadra todos los marcadores con un margen. */
+function regionDeMarcadores(markers: MapMarker[]): Region {
+  const lats = markers.map((m) => m.coords.lat);
+  const lngs = markers.map((m) => m.coords.lng);
+  const minLat = Math.min(...lats);
+  const maxLat = Math.max(...lats);
+  const minLng = Math.min(...lngs);
+  const maxLng = Math.max(...lngs);
+  return {
+    latitude: (minLat + maxLat) / 2,
+    longitude: (minLng + maxLng) / 2,
+    latitudeDelta: Math.max((maxLat - minLat) * 1.6, 0.02),
+    longitudeDelta: Math.max((maxLng - minLng) * 1.6, 0.02),
+  };
+}
+
+/**
+ * Controles del mapa (esquina inferior derecha, como en Maps): capa, encuadre
+ * y 2D/3D. La elección se recuerda para la próxima vez.
+ *
+ * La capa se cambia TOCANDO, no abriendo una hoja para elegir entre dos: un
+ * toque en vez de tres, y sin una ventana modal de por medio. Va escrito como
+ * un ciclo sobre las capas ofrecidas, así que sigue valiendo si algún día hay
+ * una tercera.
+ */
+export function ControlesMapa({
+  prefs,
+  actualizar,
+  insetBottom = 0,
+  arriba = false,
+  onEncuadrar,
+  onRecentrar,
+}: {
+  prefs: MapaPrefs;
+  actualizar: (cambio: Partial<MapaPrefs>) => void;
+  insetBottom?: number;
+  /** Coloca los controles ARRIBA a la derecha (cuando abajo hay lengüeta/SOS). */
+  arriba?: boolean;
+  /** "Que quepa todo": vuelve a encuadrar los marcadores. Solo en multi. */
+  onEncuadrar?: () => void;
+  /** Va al marcador destacado. Solo cuando hay uno. */
+  onRecentrar?: () => void;
+}) {
+  const { colors, radii } = useTheme();
+  const opciones = opcionesMapa();
+  // La siguiente capa del ciclo: es lo que hará el botón al tocarlo.
+  const actual = opciones.findIndex((o) => o.id === prefs.tipo);
+  const siguiente = opciones[(Math.max(0, actual) + 1) % opciones.length];
+
+  const fondo = {
+    backgroundColor: colors.surfaceElevated,
+    borderColor: colors.border,
+    borderRadius: radii.md,
+  };
+
+  return (
+    <>
+      <View
+        style={[
+          estilosMapa.overlay,
+          arriba ? estilosMapa.topRightCtrl : estilosMapa.bottomRight,
+          arriba ? null : { bottom: 12 + insetBottom },
+        ]}>
+        {onRecentrar ? (
+          <PressableScale
+            onPress={onRecentrar}
+            accessibilityRole="button"
+            accessibilityLabel="Ir a la unidad destacada"
+            style={[estilosMapa.ctrl, fondo]}>
+            <TabIcon name="mira" color={colors.primary} size={18} />
+          </PressableScale>
+        ) : null}
+        {onEncuadrar ? (
+          <PressableScale
+            onPress={onEncuadrar}
+            accessibilityRole="button"
+            accessibilityLabel="Encuadrar toda la flota"
+            style={[estilosMapa.ctrl, fondo]}>
+            <TabIcon name="encuadrar" color={colors.text} size={18} />
+          </PressableScale>
+        ) : null}
+        <PressableScale
+          onPress={() => actualizar({ tipo: siguiente.id })}
+          accessibilityRole="button"
+          accessibilityLabel={`Ver ${siguiente.label.toLowerCase()}`}
+          accessibilityHint="Cambia la capa del mapa"
+          style={[estilosMapa.ctrl, fondo]}>
+          {/* Teñido cuando NO es la capa de siempre: dice qué se está viendo,
+              mientras que el nombre accesible dice qué pasará al tocarlo. */}
+          <TabIcon name="capas" color={prefs.tipo === 'standard' ? colors.text : colors.primary} size={18} />
+        </PressableScale>
+        <PressableScale
+          onPress={() => actualizar({ tresD: !prefs.tresD })}
+          // El nombre accesible coincide con lo que se ve ("2D"/"3D") y el
+          // estado va aparte, para que los lectores digan si está activado.
+          accessibilityRole="switch"
+          accessibilityLabel={prefs.tresD ? '3D' : '2D'}
+          accessibilityHint="Alterna entre vista plana e inclinada"
+          accessibilityState={{ checked: prefs.tresD }}
+          style={[estilosMapa.ctrl, fondo]}>
+          <ThemedText variant="overline" color={prefs.tresD ? 'primary' : 'textSecondary'}>
+            {prefs.tresD ? '3D' : '2D'}
+          </ThemedText>
+        </PressableScale>
+      </View>
+    </>
+  );
+}
+
+/**
+ * Mapa del vehículo (nativo). Dos modos:
+ *  - single: el vehículo del conductor (con `vehicleCoords`, dos puntos:
+ *    vehículo + tu ubicación; sin ellas, simulación legada teléfono=vehículo).
+ *  - multi: si recibe `markers`, pinta toda la flota en sus coordenadas.
+ *
+ * REGLA DE MAPA (FOM-02 §8-8): en TODOS los modos se pide la ubicación del
+ * usuario y se muestra su punto ("tú") además del vehículo/vehículos. Si el
+ * permiso se niega, el mapa sigue funcionando y lo avisa con calma.
+ *
+ * Encapsula `react-native-maps` y `expo-location`. Es el mapa de RESPALDO:
+ * con token de Mapbox la app usa `map-vehiculo-mapbox.tsx` (ver
+ * `map-vehiculo.tsx`, que elige).
+ */
+export function MapaVehiculoClasico({
+  vehicleName,
+  live = false,
+  markerColor,
+  vehicleCoords,
+  markers,
+  onMarkerPress,
+  hideOverlays = false,
+  soloUsuario = false,
+  sinUsuario = false,
+  insetBottom = 0,
+  controlesArriba = false,
+  encuadreClave,
+  resaltadoId = null,
+  onMapaPress,
+  style,
+}: MapaVehiculoProps) {
+  const { colors, radii, spacing } = useTheme();
+  const esMulti = Array.isArray(markers);
+  const conCoordsVehiculo = !!vehicleCoords;
+  // Color del punto del vehículo: el indicado, o el acento de la marca.
+  const dotColor = markerColor ?? colors.primary;
+  const mapRef = useRef<MapView>(null);
+  const [permiso, setPermiso] = useState<Permiso>('pendiente');
+  const [coords, setCoords] = useState<Coords | null>(null);
+  const { prefs, actualizar } = useMapaPrefs();
+
+  // Inclina (o endereza) la cámara según la preferencia 2D/3D. Se aplica al
+  // estar listo el mapa y cada vez que se cambia el interruptor.
+  const aplicarInclinacion = useCallback(() => {
+    mapRef.current?.animateCamera({ pitch: prefs.tresD ? PITCH_3D : 0 }, { duration: 400 });
+  }, [prefs.tresD]);
+
+  useEffect(() => {
+    aplicarInclinacion();
+  }, [aplicarInclinacion]);
+
+  // Los marcadores vigentes, para que `encuadrar` no cambie de identidad en
+  // cada refresco de posiciones: si cambiara, el efecto del encuadre correría
+  // cada 20 s y el mapa saltaría solo.
+  const marcadoresRef = useRef<MapMarker[] | undefined>(markers);
+  useEffect(() => {
+    marcadoresRef.current = markers;
+  }, [markers]);
+
+  // La preferencia 3D, leída desde un callback estable: `encuadrar` no puede
+  // depender de `prefs` sin cambiar de identidad en cada toque del interruptor.
+  const tresDRef = useRef(prefs.tresD);
+  useEffect(() => {
+    tresDRef.current = prefs.tresD;
+  }, [prefs.tresD]);
+
+  /**
+   * Encuadra todos los marcadores con margen. Sin marcadores no hace nada.
+   *
+   * `fitToCoordinates` termina con la cámara PLANA: si la vista estaba en 3D,
+   * se vuelve a inclinar cuando acaba el encuadre. Sin esto, cada cambio de
+   * filtro dejaba el mapa en 2D con el interruptor diciendo "3D".
+   */
+  const encuadrar = useCallback(() => {
+    const ms = marcadoresRef.current;
+    if (!ms || ms.length === 0) return;
+    mapRef.current?.fitToCoordinates(
+      ms.map((m) => ({ latitude: m.coords.lat, longitude: m.coords.lng })),
+      { edgePadding: { top: 72, right: 48, bottom: 72, left: 48 }, animated: true },
+    );
+    if (tresDRef.current) {
+      setTimeout(() => mapRef.current?.animateCamera({ pitch: PITCH_3D }, { duration: 300 }), 550);
+    }
+  }, []);
+
+  /** Va al marcador destacado; sin uno, encuadra todo. */
+  const recentrar = useCallback(() => {
+    const m = marcadoresRef.current?.find((x) => x.id === resaltadoId);
+    if (!m) {
+      encuadrar();
+      return;
+    }
+    mapRef.current?.animateCamera(
+      { center: { latitude: m.coords.lat, longitude: m.coords.lng } },
+      { duration: 500 },
+    );
+  }, [resaltadoId, encuadrar]);
+
+  // Re-encuadre SOLO cuando cambia la clave (el conjunto), nunca por un
+  // refresco de posiciones.
+  useEffect(() => {
+    if (encuadreClave === undefined) return;
+    encuadrar();
+  }, [encuadreClave, encuadrar]);
+
+  useEffect(() => {
+    let active = true;
+    let sub: Location.LocationSubscription | null = null;
+
+    (async () => {
+      // §8-8: SIEMPRE se pide la ubicación del usuario (todos los modos).
+      const { status } = await Location.requestForegroundPermissionsAsync();
+      if (!active) return;
+      if (status !== 'granted') {
+        setPermiso('denegado');
+        return;
+      }
+      setPermiso('ok');
+
+      // Solo la simulación legada (teléfono = vehículo) sigue la posición para
+      // mover el marcador; con GPS real o en multi, el punto "tú" lo pinta el
+      // sistema con `showsUserLocation`.
+      if (esMulti || conCoordsVehiculo) return;
+
+      const current = await Location.getCurrentPositionAsync({
+        accuracy: Location.Accuracy.Balanced,
+      });
+      if (!active) return;
+      setCoords({ latitude: current.coords.latitude, longitude: current.coords.longitude });
+
+      const suscripcion = await Location.watchPositionAsync(
+        { accuracy: Location.Accuracy.Balanced, distanceInterval: 5 },
+        (loc) => {
+          const next = { latitude: loc.coords.latitude, longitude: loc.coords.longitude };
+          setCoords(next);
+          mapRef.current?.animateCamera({ center: next }, { duration: 500 });
+        },
+      );
+      // Si la pantalla se cerró mientras se creaba el watcher, la limpieza ya
+      // corrió con `sub` en null: hay que retirarlo aquí o queda vivo.
+      if (!active) {
+        suscripcion.remove();
+        return;
+      }
+      sub = suscripcion;
+    })();
+
+    return () => {
+      active = false;
+      sub?.remove();
+    };
+  }, [esMulti, conCoordsVehiculo]);
+
+  /** Aviso discreto cuando no podemos mostrar "tu ubicación" (permiso negado). */
+  const avisoSinPermiso =
+    permiso === 'denegado' ? (
+      // `right` deja libre la columna de los controles: el aviso se ajusta o
+      // corta, pero nunca se estira por encima de los botones del mapa.
+      <View style={[estilosMapa.overlay, estilosMapa.bottomLeft, { bottom: 12 + insetBottom, right: 60 }]}>
+        <View style={[estilosMapa.pill, { backgroundColor: colors.surfaceElevated, borderColor: colors.border }]}>
+          <ThemedText variant="caption" color="textMuted" numberOfLines={2}>
+            Activa la ubicación para verte en el mapa
+          </ThemedText>
+        </View>
+      </View>
+    ) : null;
+
+  // ── Modo multi-vehículo: toda la flota + tu ubicación ──────────────────────
+  if (esMulti) {
+    /**
+     * Color de un marcador, por prioridad.
+     *
+     * La emergencia manda sobre todo. Después el estado de movimiento, si la
+     * fuente lo entrega; si no, se cae al booleano `live` de siempre, para que
+     * las pantallas que aún no mandan `estado` se vean igual que antes.
+     */
+    const colorDe = (m: MapMarker): string => {
+      if (m.emergencia) return colors.danger;
+      // Con color propio, el estado no cambia el matiz: sin señal se APAGA
+      // hacia el fondo, y así el punto sigue diciendo de qué flota es.
+      if (m.color) return m.estado === 'sin-senal' ? colorApagado(m.color, colors.background) : m.color;
+      if (m.estado) {
+        if (m.estado === 'marcha') return colors.success;
+        return m.estado === 'detenido' ? colors.warning : colors.textMuted;
+      }
+      return m.live ? colors.success : colors.textMuted;
+    };
+    // El punto crece con la vida: 17 rodando, 16 quieto con señal, 14 callado.
+    const tamDe = (m: MapMarker): number => (m.estado === 'marcha' ? 17 : m.estado === 'sin-senal' ? 14 : 16);
+    /**
+     * Los grados hacia los que mira la flecha, o `null` si toca punto.
+     *
+     * Solo apunta lo que SE MUEVE y trae rumbo medido. Una unidad parada
+     * conserva el último rumbo que reportó, y dibujarlo diría que va hacia
+     * allá cuando lleva dos horas sin moverse; sin rumbo, apuntaría al norte
+     * por defecto, que es peor todavía porque parece un dato.
+     */
+    const apuntaA = (m: MapMarker): number | null =>
+      m.estado === 'marcha' && typeof m.rumbo === 'number' && Number.isFinite(m.rumbo)
+        ? ((m.rumbo % 360) + 360) % 360
+        : null;
+    const enMarcha = markers!.filter((m) => (m.estado ? m.estado === 'marcha' : m.live)).length;
+    return (
+      <View
+        style={[
+          estilosMapa.container,
+          { backgroundColor: colors.surface, borderColor: colors.border, borderRadius: radii.lg },
+          style,
+        ]}>
+        <MapView
+          ref={mapRef}
+          style={StyleSheet.absoluteFill}
+          initialRegion={markers!.length > 0 ? regionDeMarcadores(markers!) : undefined}
+          // Capa elegida por la persona (Apple Maps en iOS, Google en Android).
+          mapType={prefs.tipo}
+          onMapReady={() => {
+            aplicarInclinacion();
+            // El primer encuadre real: `initialRegion` es una aproximación y
+            // el mapa aún no sabía su tamaño.
+            if (encuadreClave !== undefined) encuadrar();
+          }}
+          showsUserLocation={permiso === 'ok' && !sinUsuario}
+          showsMyLocationButton={false}
+          // En Android el toque sobre un marcador llega TAMBIÉN aquí, marcado
+          // como tal: ese no es "tocar el mapa" y no debe soltar lo destacado.
+          onPress={(e) => {
+            if (e.nativeEvent.action === 'marker-press') return;
+            onMapaPress?.();
+          }}
+          toolbarEnabled={false}>
+          {/* La estela va ANTES que los marcadores para que la línea quede por
+              debajo del punto y no lo tape. */}
+          {markers!
+            .filter((m) => (m.estela?.length ?? 0) > 1)
+            .map((m) => (
+              <Polyline
+                key={`estela-${m.id}`}
+                coordinates={m.estela!.map((p) => ({ latitude: p.lat, longitude: p.lng }))}
+                strokeColor={colorDe(m)}
+                strokeWidth={3}
+                lineCap="round"
+                lineJoin="round"
+              />
+            ))}
+
+          {markers!.map((m, i) => {
+            const color = colorDe(m);
+            const tam = tamDe(m);
+            const resaltado = m.id === resaltadoId;
+            return (
+              <Marker
+                key={m.id}
+                coordinate={{ latitude: m.coords.lat, longitude: m.coords.lng }}
+                title={m.label}
+                description={m.detalle}
+                // Con placa, la caja crece hacia arriba: el ancla se corre para
+                // que lo que toca la coordenada siga siendo el punto, no el medio
+                // del conjunto — si no, el vehículo se pinta al norte de donde está.
+                anchor={{ x: 0.5, y: m.placa ? 0.72 : 0.5 }}
+                zIndex={resaltado ? 2 : m.estado === 'marcha' ? 1 : 0}
+                onPress={() => onMarkerPress?.(m.id)}>
+                <CuerpoMarcador m={m} i={i} color={color} tam={tam} resaltado={resaltado} rumbo={apuntaA(m)} />
+              </Marker>
+            );
+          })}
+        </MapView>
+
+        {/* Resumen de la FLOTA. No siempre lo que hay en el mapa son
+            vehículos —una emergencia pinta también a la persona—, así que
+            quien no esté enseñando una flota lo apaga con `hideOverlays`. */}
+        {!hideOverlays ? (
+          <View style={[estilosMapa.overlay, estilosMapa.topLeft]}>
+            <View
+              style={[estilosMapa.pill, { backgroundColor: colors.surfaceElevated, borderColor: colors.border }]}>
+              <ThemedText variant="caption" color="text">
+                {`${markers!.length} vehículos · ${enMarcha} en marcha`}
+              </ThemedText>
+            </View>
+          </View>
+        ) : null}
+        {/* El aviso primero: los controles quedan ENCIMA y siempre pulsables. */}
+        {avisoSinPermiso}
+        <ControlesMapa
+          prefs={prefs}
+          actualizar={actualizar}
+          insetBottom={insetBottom}
+          arriba={controlesArriba}
+          onEncuadrar={encuadrar}
+          onRecentrar={resaltadoId ? recentrar : undefined}
+        />
+      </View>
+    );
+  }
+
+  // ── Modo single: el vehículo del conductor + tu ubicación ──────────────────
+  const vehiclePoint: Coords | null = vehicleCoords
+    ? { latitude: vehicleCoords.lat, longitude: vehicleCoords.lng }
+    : coords;
+  const region: Region | undefined = vehiclePoint
+    ? { ...vehiclePoint, latitudeDelta: 0.01, longitudeDelta: 0.01 }
+    : undefined;
+  const mapaListo = !!vehiclePoint;
+  const sinNada = permiso === 'denegado' && !vehicleCoords;
+
+  return (
+    <View
+      style={[
+        estilosMapa.container,
+        { backgroundColor: colors.surface, borderColor: colors.border, borderRadius: radii.lg },
+        style,
+      ]}>
+      {mapaListo ? (
+        <MapView
+          ref={mapRef}
+          style={StyleSheet.absoluteFill}
+          initialRegion={region}
+          // Mapa detallado nativo: Apple Maps en iOS, Google Maps en Android.
+          // La capa (estándar/satélite/híbrido/3D) la elige la persona.
+          mapType={prefs.tipo}
+          onMapReady={aplicarInclinacion}
+          showsUserLocation={permiso === 'ok'}
+          showsMyLocationButton={false}
+          showsCompass
+          showsPointsOfInterests
+          toolbarEnabled={false}>
+          {/* En modo solo-usuario no hay vehículo: el único punto eres tú. */}
+          {soloUsuario ? null : (
+            <Marker coordinate={vehiclePoint!} title={vehicleName} anchor={{ x: 0.5, y: 0.5 }}>
+              <View style={estilosMapa.markerWrap}>
+                <View style={[estilosMapa.markerRing, { borderColor: dotColor }]} />
+                <View
+                  style={[estilosMapa.markerDot, { backgroundColor: dotColor, borderColor: colors.background }]}
+                />
+              </View>
+            </Marker>
+          )}
+        </MapView>
+      ) : (
+        <View style={estilosMapa.center}>
+          {sinNada ? (
+            <ThemedText
+              variant="caption"
+              color="textMuted"
+              style={[estilosMapa.permText, { paddingHorizontal: spacing.lg }]}>
+              Activa la ubicación para ver el vehículo en el mapa
+            </ThemedText>
+          ) : (
+            <ActivityIndicator color={colors.primary} />
+          )}
+        </View>
+      )}
+
+      {/* Overlay: nombre del vehículo */}
+      {!hideOverlays ? (
+        <View style={[estilosMapa.overlay, estilosMapa.topLeft]}>
+          <View
+            style={[estilosMapa.pill, { backgroundColor: colors.surfaceElevated, borderColor: colors.border }]}>
+            <ThemedText variant="caption" color="text">
+              {vehicleName}
+            </ThemedText>
+          </View>
+        </View>
+      ) : null}
+
+      {/* Overlay: en vivo */}
+      {!hideOverlays ? (
+      <View style={[estilosMapa.overlay, estilosMapa.topRight]}>
+        <View
+          style={[
+            estilosMapa.pill,
+            estilosMapa.livePill,
+            { backgroundColor: colors.surfaceElevated, borderColor: colors.border, gap: spacing.xs },
+          ]}>
+          <PulseDot color={live ? colors.success : colors.textMuted} active={live} />
+          <ThemedText variant="overline" color={live ? 'success' : 'textMuted'}>
+            {live ? 'EN VIVO' : 'SIN SEÑAL'}
+          </ThemedText>
+        </View>
+      </View>
+      ) : null}
+      {mapaListo ? avisoSinPermiso : null}
+      {mapaListo ? (
+        <ControlesMapa prefs={prefs} actualizar={actualizar} insetBottom={insetBottom} arriba={controlesArriba} />
+      ) : null}
+    </View>
+  );
+}
+
+export const estilosMapa = StyleSheet.create({
+  container: {
+    width: '100%',
+    height: 300,
+    borderWidth: StyleSheet.hairlineWidth,
+    overflow: 'hidden',
+    justifyContent: 'center',
+    alignItems: 'center',
+  },
+  center: { alignItems: 'center', justifyContent: 'center' },
+  permText: { textAlign: 'center' },
+  // Marcador del vehículo: la placa encima y el punto (o la flecha) debajo.
+  markerCaja: { alignItems: 'center', justifyContent: 'flex-end' },
+  placa: { paddingHorizontal: 5, paddingVertical: 1, borderWidth: 1, marginBottom: 2, maxWidth: 96 },
+  placaTexto: { fontSize: 10, lineHeight: 13, fontWeight: '700' },
+  markerWrap: { width: 28, height: 28, alignItems: 'center', justifyContent: 'center' },
+  markerRing: {
+    position: 'absolute',
+    width: 28,
+    height: 28,
+    borderRadius: 14,
+    borderWidth: 3,
+    opacity: 0.35,
+  },
+  markerDot: { width: 16, height: 16, borderRadius: 8, borderWidth: 3 },
+  // El destacado: el anillo deja de ser un halo y se vuelve un aro que se ve.
+  markerRingResaltado: { borderWidth: 4, opacity: 0.75 },
+  markerHalo: { position: 'absolute', width: 28, height: 28, borderRadius: 14 },
+  overlay: { position: 'absolute', top: 12 },
+  topLeft: { left: 12 },
+  topRight: { right: 12 },
+  bottomLeft: { top: undefined, bottom: 12, left: 12 },
+  bottomRight: { top: undefined, bottom: 12, right: 12, gap: 8 },
+  topRightCtrl: { top: 12, right: 12, gap: 8 },
+  // Botón cuadrado de control (capas / 2D-3D), como en Maps.
+  ctrl: {
+    width: 36,
+    height: 36,
+    alignItems: 'center',
+    justifyContent: 'center',
+    borderWidth: StyleSheet.hairlineWidth,
+  },
+  pill: {
+    flexDirection: 'row',
+    alignItems: 'center',
+    paddingHorizontal: 10,
+    paddingVertical: 5,
+    borderRadius: 999,
+    borderWidth: StyleSheet.hairlineWidth,
+  },
+  livePill: { alignItems: 'center' },
+  liveDot: { width: 8, height: 8, borderRadius: 4 },
+});
