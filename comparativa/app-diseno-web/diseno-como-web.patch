+  );
+}
+
+// ─────────────────────────────── Costos ────────────────────────────────────
+
+function PestanaCostos({ d }: { d: Extract<DatosVista, { tipo: 'costos' }> }) {
+  const { colors, radii, spacing } = useTheme();
+  const c = d.actual;
+  const total = c.porClase.producto + c.porClase.servicio;
+  const pct = (n: number) => (total > 0 ? Math.round((n / total) * 100) : 0);
+  const categorias = [...c.porCategoria].sort((a, b) => b.total - a.total);
+  const unidades = c.porVehiculo.filter((v) => v.total.costo > 0);
+
+  if (c.total.costo <= 0) {
+    return (
+      <Tarjeta>
+        <ThemedText variant="caption" color="textMuted">
+          No hay gastos registrados en este período.
+        </ThemedText>
+      </Tarjeta>
+    );
+  }
+
+  return (
+    <>
+      <Tarjeta style={{ gap: spacing.sm }}>
+        <TituloTarjeta titulo="Productos y servicios" />
+        <ThemedText variant="caption" color="textSecondary">
+          {`${miles(c.total.cantidad)} ${c.total.cantidad === 1 ? 'gasto registrado' : 'gastos registrados'}`}
+        </ThemedText>
+        <BarraPartes
+          etiqueta={`Productos ${dinero(c.porClase.producto)}, ${pct(c.porClase.producto)} %; servicios ${dinero(c.porClase.servicio)}, ${pct(c.porClase.servicio)} %`}
+          partes={[
+            { valor: c.porClase.producto, color: colors.primary, texto: `${pct(c.porClase.producto)} %` },
+            { valor: c.porClase.servicio, color: colors.accent, texto: `${pct(c.porClase.servicio)} %` },
+          ]}
+        />
+        <Leyenda
+          items={[
+            { color: colors.primary, label: 'Productos', valor: dinero(c.porClase.producto) },
+            { color: colors.accent, label: 'Servicios', valor: dinero(c.porClase.servicio) },
+          ]}
+        />
+      </Tarjeta>
+
+      <Tarjeta style={{ gap: spacing.sm }}>
+        <TituloTarjeta titulo="Gasto por categoría" />
+        {categorias.map((cat) => (
+          <View
+            key={cat.label}
+            style={{ gap: spacing.xs }}
+            accessible
+            accessibilityLabel={`${cat.label}: ${dinero(cat.total)}, ${Math.round(cat.porcentaje)} % del gasto`}>
+            <View style={styles.pie}>
+              <ThemedText variant="caption" color="textSecondary" style={styles.flex1} numberOfLines={1}>
+                {cat.label}
+              </ThemedText>
+              <ThemedText variant="caption" tabular style={styles.fuerte}>
+                {`${dinero(cat.total)} · ${miles(Math.round(cat.porcentaje))} %`}
+              </ThemedText>
+            </View>
+            <View style={[styles.pista, { backgroundColor: colors.surfaceSunken, borderRadius: radii.pill }]}>
+              <View
+                style={{
+                  width: `${Math.max(2, Math.min(100, cat.porcentaje))}%`,
+                  height: '100%',
+                  backgroundColor: cat.clase === 'servicio' ? colors.accent : colors.primary,
+                  borderRadius: radii.pill,
+                }}
+              />
+            </View>
+          </View>
+        ))}
+      </Tarjeta>
+
+      <Tarjeta style={{ gap: spacing.sm }}>
+        <TituloTarjeta titulo="Gasto por unidad" />
+        <ThemedText variant="caption" color="textMuted">
+          {`${miles(conGasto(c))} de ${miles(c.porVehiculo.length)} unidades con gastos, de mayor a menor.`}
+        </ThemedText>
+        <ListaFiltrable
+          items={unidades}
+          llave={(v) => v.vehicleId}
+          vacia="Ninguna unidad tuvo gastos."
+          fila={(v, divisor) => (
+            <FilaLista
+              divisor={divisor}
+              titulo={[v.label || 'Unidad', v.placa].filter(Boolean).join(' · ')}
+              pista={`${miles(v.total.cantidad)} ${v.total.cantidad === 1 ? 'gasto' : 'gastos'}`}
+              cifra={dinero(v.total.costo)}
+              cifraPie="total"
+            />
+          )}
+        />
+      </Tarjeta>
+    </>
+  );
+}
+
+// ─────────────────────────────── Estadístico ───────────────────────────────
+
+function PestanaEstadistico({ d }: { d: Extract<DatosVista, { tipo: 'estadistico' }> }) {
+  const { colors, spacing } = useTheme();
+  const r = d.actual;
+  // Los km de seis meses están en la tabla de distancias; se cruzan por placa e id.
+  const seisMeses = new Map(r.distancias.map((f) => [`${f.unidadLabel}|${f.placa}`, f.recorridoU6m]));
+
+  return (
+    <>
+      <Tarjeta style={{ gap: spacing.md }}>
+        <TituloTarjeta titulo="Indicadores de conducción" />
+        {r.indicadores.map((ind, i) => (
+          <View key={ind.nombre} style={[{ gap: spacing.xs }, i > 0 && styles.separado, i > 0 && { borderTopColor: colors.border, paddingTop: spacing.md }]}>
+            <View style={styles.pie}>
+              <ThemedText style={[styles.fuerte, styles.flex1]} numberOfLines={2}>
+                {ind.nombre}
+              </ThemedText>
+              {ind.medido ? (
+                <Chip tone={tonoDeRango(ind.rango) ?? 'textMuted'} label={RANGO_LABEL[ind.rango]} dot />
+              ) : (
+                <Chip tone="textMuted" label="Sin medición" />
+              )}
+            </View>
+            <View style={styles.pie}>
+              <ThemedText tabular style={styles.indicadorValor} color={ind.medido ? (tonoDeRango(ind.rango) ?? 'text') : 'textMuted'}>
+                {decimalEs(ind.valor)}
+              </ThemedText>
+              <ThemedText variant="caption" color="textMuted">
+                {`Óptimo: ${decimalEs(ind.optimo)}`}
+              </ThemedText>
+            </View>
+            <ThemedText variant="caption" color="textSecondary">
+              {ind.interpretacion}
+            </ThemedText>
+          </View>
+        ))}
+      </Tarjeta>
+
+      <Tarjeta style={{ gap: spacing.sm }}>
+        <TituloTarjeta titulo="Distancias y alertas por unidad" />
+        <ListaFiltrable
+          items={r.alertasPorVehiculo}
+          atencion={unidadEstadisticaPideAtencion}
+          llave={(f) => `${f.unidadLabel}|${f.placa}`}
+          vacia="Sin unidades en este alcance."
+          fila={(f, divisor) => {
+            const u6m = seisMeses.get(`${f.unidadLabel}|${f.placa}`);
+            return (
+              <FilaLista
+                divisor={divisor}
+                titulo={f.unidadLabel || f.placa || 'Unidad'}
+                estado={[f.area, f.unidadLabel ? f.placa : ''].filter(Boolean).join(' · ')}
+                pista={[
+                  f.km > 0 ? `${miles(f.km)} km` : 'sin km en el período',
+                  u6m != null ? `${miles(u6m)} km en 6 meses` : null,
+                  f.velocidadMax != null ? `máx. ${miles(f.velocidadMax)} km/h` : null,
+                ]
+                  .filter(Boolean)
+                  .join(' · ')}
+                cifra={f.km > 0 ? miles(f.alertas100km, 2) : '—'}
+                cifraColor={f.km > 0 ? tonoDeRango(f.rango) : 'textMuted'}
+                cifraPie="por 100 km"
+              />
+            );
+          }}
+        />
+      </Tarjeta>
+
+      <Tarjeta style={{ gap: spacing.sm }}>
+        <TituloTarjeta titulo="Resumen por conductor" />
+        <ListaFiltrable
+          items={r.conductores}
+          llave={(c) => `${c.conductor}|${c.identificado}`}
+          vacia="Nadie manejó en el período."
+          fila={(c, divisor) => (
+            <FilaLista
+              divisor={divisor}
+              titulo={c.conductor}
+              estado={c.identificado ? undefined : 'Lo que la flota rodó sin que nadie tomara la unidad'}
+              colorEstado={c.identificado ? undefined : colors.danger}
+              pista={[
+                `${miles(c.km)} km`,
+                c.identificado ? `${miles(c.horas)} h` : null,
+                `${miles(c.aceleraciones)} acel · ${miles(c.frenadas)} fren · ${miles(c.excesos)} exc`,
+              ]
