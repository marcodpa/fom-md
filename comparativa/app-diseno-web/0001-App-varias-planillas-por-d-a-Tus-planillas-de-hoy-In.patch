+import { useRef } from 'react';
+import { Alert, StyleSheet, View } from 'react-native';
+
+import { Card } from '@/components/card';
+import { InspeccionesResultado, VISTA_INSPECCION } from '@/components/inspecciones-resultado';
+import { Pastilla } from '@/components/pastilla';
+import { PressableScale } from '@/components/pressable-scale';
+import { ProgressBar } from '@/components/progress-bar';
+import { TabIcon } from '@/components/tab-icon';
+import { ThemedText } from '@/components/themed-text';
+import { exportarPdf } from '@/lib/pdf';
+import { htmlInspecciones } from '@/lib/pdf-inspeccion';
+import { getAyudasFormatoFom, getInspeccionFom, type InspeccionResumen } from '@/services';
+import type { PlanillaHecha, PlanillaUnidad } from '@/services/inspeccionService';
+import { useTheme } from '@/theme';
+import type { ColorTokens } from '@/theme/types';
+import type { InspeccionPlantilla } from '@/types';
+
+/**
+ * LA ENTRADA DE «INSPECCIÓN»: la unidad y su estado de hoy, y la lista «Tus
+ * planillas de hoy»: una fila por planilla que toca hoy (según los días de la
+ * semana que le puso el supervisor), con su estado. Con servidor viejo llega
+ * una sola. Igual que `UnidadDeHoy` y `PlanillaDeHoy` de la web
+ * (InspeccionConductor.jsx) y las mismas reglas de `InspeccionConductorReglas.jsx`.
+ */
+
+/** Las que se ven en la lista: las que tocan hoy y, si ya está llena, aunque no toque. */
+export function planillasVisibles(planillas: PlanillaUnidad[]): PlanillaUnidad[] {
+  return planillas.filter((p) => p.tocaHoy || p.hecha);
+}
+
+/** Cuántas van hechas y cuántas son, de las que se ven. */
+export function cuentaPlanillas(planillas: PlanillaUnidad[]): { hechas: number; total: number } {
+  const vistas = planillasVisibles(planillas);
+  return { hechas: vistas.filter((p) => p.hecha).length, total: vistas.length };
+}
+
+/** ¿Alguna de hoy salió bloqueada? Entonces la unidad no sale, estén hechas o no las demás. */
+export function hayBloqueada(planillas: PlanillaUnidad[]): boolean {
+  return planillasVisibles(planillas).some((p) => p.hecha?.resultado === 'bloqueada');
+}
+
+/** La unidad queda «Lista para salir» solo cuando TODAS las de hoy están hechas (y hay al menos una). */
+export function todasHechas(planillas: PlanillaUnidad[]): boolean {
+  const { hechas, total } = cuentaPlanillas(planillas);
+  return total > 0 && hechas === total;
+}
+
+/** Cómo se ve la unidad arriba de la lista. `enCurso`: puntos ya respondidos sin enviar. */
+export function estadoDeUnidad(planillas: PlanillaUnidad[], enCurso = 0): EstadoDeHoy {
+  const { hechas } = cuentaPlanillas(planillas);
+  if (hayBloqueada(planillas)) return { tono: 'danger', label: 'Bloqueada' };
+  if (todasHechas(planillas)) return { tono: 'success', label: 'Lista para salir' };
+  return hechas > 0 || enCurso > 0 ? { tono: 'primary', label: 'En curso' } : { tono: 'warning', label: 'Pendiente' };
+}
+
+/** La palabra y el tono de una planilla hecha, con la hora si se sabe. */
+export function vistaDeHecha(hecha: PlanillaHecha, hora?: string): NonNullable<PlanillaDeHoyProps['hecha']> {
+  const vista = hecha.resultado ? VISTA_INSPECCION[hecha.resultado] : null;
+  return { tono: vista?.tono ?? 'success', label: vista?.label ?? 'Hecha', ...(hora ? { hora } : {}) };
+}
+
+/** Hoy como AAAA-MM-DD del teléfono (solo para armar un resumen mínimo). */
+function hoyLocal(): string {
+  const d = new Date();
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
+}
+
+/**
+ * El resultado de UNA planilla hecha, en la hoja de siempre. Si no se pudo leer
+ * quién la hizo, se abre igual por su id y la hoja pide el detalle a FOM.
+ */
+export function ResultadoDePlanilla({
+  planilla,
+  vehicleId,
+  onClose,
+}: {
+  planilla: PlanillaUnidad | null;
+  vehicleId: string;
+  onClose: () => void;
+}) {
+  const imprimiendo = useRef(false);
+  const hecha = planilla?.hecha;
+  const inspeccion: InspeccionResumen | null =
+    planilla && hecha?.inspeccionId
+      ? (hecha.inspeccion ?? {
+          id: hecha.inspeccionId,
+          resultado: hecha.resultado ?? 'aprobada',
+          fecha: hoyLocal(),
+          ...(hecha.enviadaEn ? { enviadaEn: hecha.enviadaEn } : {}),
+          vehicleId,
+          unidad: '',
+          conductor: 'Sin conductor',
+          formato: planilla.nombre,
+        })
+      : null;
+
+  async function imprimir(id: string) {
+    if (imprimiendo.current) return;
+    imprimiendo.current = true;
+    try {
+      const d = hecha?.detalle?.id === id ? hecha.detalle : await getInspeccionFom(id);
+      await exportarPdf(htmlInspecciones([d], await getAyudasFormatoFom(d.vehicleId)));
+    } catch (e) {
+      Alert.alert('No pudimos armar el PDF', e instanceof Error ? e.message : 'Intenta de nuevo.');
+    }
+    // Después del try/catch y no en un `finally`: el compilador de React se salta los componentes con `finally`.
+    imprimiendo.current = false;
+  }
+
+  return (
+    <InspeccionesResultado
+      inspeccion={inspeccion}
+      {...(hecha?.detalle ? { detalleLeido: hecha.detalle } : {})}
+      onClose={onClose}
+      onImprimir={(id) => void imprimir(id)}
+    />
+  );
+}
+
+const DIAS = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
+const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
+
+/** «Martes 27 de octubre», sin depender del Intl del teléfono. */
+export function fechaLarga(d: Date = new Date()): string {
+  return `${DIAS[d.getDay()]} ${d.getDate()} de ${MESES[d.getMonth()]}`;
+}
+
+/** Cuántos puntos, secciones y críticos tiene una planilla. */
+export function medidaDePlanilla(p: InspeccionPlantilla | null) {
+  const items = p?.categorias.flatMap((c) => c.items) ?? [];
+  return { puntos: items.length, secciones: p?.categorias.length ?? 0, criticos: items.filter((i) => i.critico).length };
+}
+
+/** «14 puntos · 5 secciones · 6 críticos», con el plural bien puesto. */
+export function textoMedida({ puntos, secciones, criticos }: ReturnType<typeof medidaDePlanilla>): string {
+  return [
+    `${puntos} ${puntos === 1 ? 'punto' : 'puntos'}`,
+    `${secciones} ${secciones === 1 ? 'sección' : 'secciones'}`,
+    criticos > 0 ? `${criticos} ${criticos === 1 ? 'crítico' : 'críticos'}` : null,
+  ]
+    .filter(Boolean)
+    .join(' · ');
+}
+
+export type EstadoDeHoy = { tono: keyof ColorTokens; label: string };
+
+/** La unidad de hoy: fecha, marca y modelo, código y placa, y cómo va la inspección. */
+export function UnidadDeHoy({ nombre, detalle, estado }: { nombre: string; detalle: string; estado: EstadoDeHoy }) {
+  const { colors, spacing, radii } = useTheme();
+  return (
+    <Card style={[styles.fila, { gap: spacing.md }]}>
+      <View style={[styles.icono, { backgroundColor: colors.activeSurface, borderRadius: radii.pill }]}>
+        <TabIcon name="flota" color={colors.onActive} size={22} />
+      </View>
+      <View style={[styles.flex1, { gap: 2 }]}>
+        <ThemedText variant="caption" color="textMuted">
+          {fechaLarga()}
+        </ThemedText>
+        <ThemedText variant="subtitle" numberOfLines={1}>
+          {nombre}
+        </ThemedText>
+        {detalle ? (
+          <ThemedText variant="caption" color="textSecondary" numberOfLines={1}>
+            {detalle}
+          </ThemedText>
+        ) : null}
+        <View style={[styles.estado, { marginTop: spacing.xs }]}>
+          <Pastilla tono={estado.tono} label={estado.label} conPunto />
+        </View>
+      </View>
+    </Card>
+  );
+}
+
+export type PlanillaDeHoyProps = {
+  nombre: string;
+  medida: ReturnType<typeof medidaDePlanilla>;
+  /** Cuántos puntos van respondidos (en curso). */
+  respondidos: number;
+  /** Hecha: con qué tono y palabra (Aprobada, Bloqueada…) y a qué hora. */
+  hecha?: { tono: keyof ColorTokens; label: string; hora?: string } | null;
+  onPress: () => void;
+};
+
+/** Una planilla de hoy: nombre, tamaño, y si está pendiente, en curso o hecha. */
+export function PlanillaDeHoy({ nombre, medida, respondidos, hecha, onPress }: PlanillaDeHoyProps) {
+  const { colors, spacing, radii } = useTheme();
+  const enCurso = !hecha && respondidos > 0;
+  const tono: keyof ColorTokens = hecha ? hecha.tono : 'primary';
+  const fondo = hecha
+    ? hecha.tono === 'danger'
+      ? colors.dangerSurface
+      : hecha.tono === 'warning'
+        ? colors.warningSurface
+        : colors.successSurface
+    : colors.activeSurface;
+  const accion = hecha ? 'Ver resultado' : enCurso ? 'Seguir' : 'Empezar';
+  return (
+    <PressableScale onPress={onPress} accessibilityRole="button" accessibilityLabel={`${accion}: ${nombre}`}>
+      <Card style={{ gap: spacing.md }}>
+        <View style={[styles.fila, { gap: spacing.md }]}>
+          <View style={[styles.icono, { backgroundColor: fondo, borderRadius: radii.sm }]}>
+            <TabIcon name={hecha ? (hecha.tono === 'danger' ? 'aviso' : 'check') : 'inspeccion'} color={colors[tono]} size={22} />
+          </View>
+          <View style={[styles.flex1, { gap: 2 }]}>
+            <ThemedText variant="subtitle">{nombre}</ThemedText>
+            <ThemedText variant="caption" color="textSecondary">
+              {textoMedida(medida)}
+            </ThemedText>
+          </View>
+          <TabIcon name="chevron" color={colors.textMuted} size={20} />
+        </View>
+
+        {enCurso ? (
+          <View style={{ gap: spacing.xs }}>
+            <ProgressBar value={(respondidos / Math.max(1, medida.puntos)) * 100} color={colors.primary} height={6} />
+            <ThemedText variant="caption" color="textSecondary" tabular>
+              {`${respondidos} de ${medida.puntos} revisados`}
+            </ThemedText>
+          </View>
+        ) : null}
+
+        <View style={[styles.fila, { gap: spacing.sm }]}>
+          {hecha ? (
+            <Pastilla tono={hecha.tono} label={hecha.hora ? `${hecha.label} · ${hecha.hora}` : hecha.label} conPunto encoge />
+          ) : (
+            <Pastilla tono={enCurso ? 'primary' : 'warning'} label={enCurso ? 'En curso' : 'Pendiente'} conPunto />
+          )}
+          <View style={styles.hueco} />
+          <ThemedText variant="caption" color={hecha ? 'textSecondary' : 'primary'} style={styles.fuerte} numberOfLines={1}>
+            {accion}
+          </ThemedText>
+        </View>
+      </Card>
+    </PressableScale>
+  );
+}
+
+/** El rótulo de la lista: «Tus planillas de hoy» y cuántas van hechas. */
+export function RotuloPlanillas({ hechas, total }: { hechas: number; total: number }) {
+  return (
+    <View style={styles.rotulo}>
+      <ThemedText variant="overline" color="textMuted">
+        Tus planillas de hoy
+      </ThemedText>
+      <ThemedText variant="caption" color="textMuted" tabular>
+        {`${hechas} de ${total} ${total === 1 ? 'hecha' : 'hechas'}`}
+      </ThemedText>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  fila: { flexDirection: 'row', alignItems: 'center' },
+  flex1: { flex: 1, minWidth: 0 },
+  icono: { width: 44, height: 44, alignItems: 'center', justifyContent: 'center' },
+  fuerte: { fontWeight: '600' },
+  hueco: { flexGrow: 1 },
+  estado: { alignSelf: 'flex-start' },
+  rotulo: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' },
+});
