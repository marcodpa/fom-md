+/** «● EN VIVO» bajo la velocidad; sin red, la hora de la última buena; callada, «SIN SEÑAL». */
+function MarcaVivo({ vivo }: { vivo: Vivo }) {
+  const { colors } = useTheme();
+  if (!vivo) return null;
+  const color = vivo.tipo === 'vivo' ? colors.success : colors.textMuted;
+  const texto = vivo.tipo === 'vivo' ? 'EN VIVO' : vivo.tipo === 'sin-conexion' ? `SIN CONEXIÓN · ${vivo.hora}` : 'SIN SEÑAL';
+  return (
+    <View style={styles.fVivo}>
+      <PulseDot color={color} size={6} active={vivo.tipo === 'vivo'} />
+      <ThemedText style={[styles.fVivoTexto, { color }]} numberOfLines={1}>
+        {texto}
+      </ThemedText>
+    </View>
+  );
