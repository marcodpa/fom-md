diff --git a/src/hooks/use-foto-vehiculo.ts b/src/hooks/use-foto-vehiculo.ts
new file mode 100644
index 0000000..058b05c
--- /dev/null
+++ b/src/hooks/use-foto-vehiculo.ts
@@ -0,0 +1,75 @@
+import { useCallback, useEffect, useState } from 'react';
+
+import { useAppActiva } from '@/hooks/use-app-activa';
+import { fotosDeUnidad } from '@/lib/cloudinary';
+
+/**
+ * QUÉ FOTO PROPIA TOCA MOSTRAR de una unidad (la misma regla que la web, T-179):
+ *  1. el recorte sin fondo de su foto actual (`recorte`),
+ *  2. su foto propia (`foto`),
+ *  3. nada (`null`): quien lo usa pone la del catálogo por marca y modelo y, si
+ *     tampoco hay, la silueta de su tipo.
+ */
+export type FotoPropia = {
+  /** Todavía se está preguntando: mientras tanto se ve lo de respaldo. */
+  buscando: boolean;
+  tipo: 'recorte' | 'foto' | null;
+  /** Dirección de la foto elegida en Cloudinary (`<base>/<n>`), o `null`. */
+  id: string | null;
+  /** La imagen no cargó: se pasa a la siguiente de la lista. */
+  alFallar: () => void;
+};
+
+type Estado = {
+  de: string | undefined;
+  buscando: boolean;
+  original: string | null;
+  recorte: string | null;
+};
+
+export function useFotoPropia(vehiculoId: string | undefined | null): FotoPropia {
+  const id = vehiculoId || undefined;
+  const activa = useAppActiva();
+  const [estado, setEstado] = useState<Estado>({
+    de: id,
+    buscando: Boolean(id),
+    original: null,
+    recorte: null,
+  });
+  const [falladas, setFalladas] = useState<string[]>([]);
+
+  useEffect(() => {
+    // Con la app en segundo plano no se pregunta; al volver, se mira otra vez
+    // (lo recordado dura un minuto), por si la web subió una foto mientras tanto.
+    if (!id || !activa) return;
+    let vigente = true;
+    fotosDeUnidad(id)
+      .then((f) => {
+        if (vigente) setEstado({ de: id, buscando: false, ...f });
+      })
+      .catch(() => {
+        if (vigente) setEstado({ de: id, buscando: false, original: null, recorte: null });
+      });
+    return () => {
+      vigente = false;
+    };
+  }, [id, activa]);
+
+  // Al cambiar de unidad no se enseña ni un instante la foto de la anterior.
+  const { buscando, original, recorte } =
+    estado.de === id ? estado : { buscando: Boolean(id), original: null, recorte: null };
+  const elegida =
+    recorte && !falladas.includes(recorte)
+      ? { tipo: 'recorte' as const, id: recorte }
+      : original && !falladas.includes(original)
+        ? { tipo: 'foto' as const, id: original }
+        : { tipo: null, id: null };
+
+  const idElegida = elegida.id;
+  const alFallar = useCallback(() => {
+    // Si falla el recorte se pasa a la foto; si falla la foto, a lo de respaldo.
+    if (idElegida) setFalladas((previas) => [...previas, idElegida]);
+  }, [idElegida]);
+
+  return { buscando, ...elegida, alFallar };
+}
