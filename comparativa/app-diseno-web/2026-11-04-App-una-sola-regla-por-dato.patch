+/**
+ * EL ESTADO QUE SE MUESTRA DE UNA UNIDAD — espejo de `estadoUnidad.js` de la web.
+ *
+ * La señal la decide `estadoSenal` (`sin-senal.ts`) y aquí solo se le pone
+ * encima la marcha. Claves: 'en_marcha' | 'parada' (las dos con señal, verdes)
+ * | 'sin_ubicacion' (ámbar) | 'sin_senal' | 'sin_gps' (grises).
+ *
+ * También vive aquí la tabla de tono y de texto por clave: ninguna pantalla,
+ * mapa ni marcador decide colores ni nombres por su cuenta. Antes cada uno tenía
+ * su `ESTADO_VISTA` o su `TEXTO_ESTADO`, y la parada salía ámbar en el mapa,
+ * verde en la ficha, «Detenido» en una lista y «Parado» en otra.
+ */
+import type { ColorTokens } from '../theme/types';
+import {
+  estadoSenal,
+  type ColorSenal,
+  type DatosSenal,
+  type EstadoSenal,
+  type Marcha,
+  type MomentoReporte,
+} from './sin-senal';
+
+/** Cómo está una unidad AHORA, en las cinco claves de la web. */
+export type ClaveEstado = 'en_marcha' | 'parada' | 'sin_ubicacion' | 'sin_senal' | 'sin_gps';
+
+/** Todas, en el orden en que se miran: lo que rueda, primero. */
+export const ESTADOS_UNIDAD: readonly ClaveEstado[] = ['en_marcha', 'parada', 'sin_ubicacion', 'sin_senal', 'sin_gps'];
+
+/** Los tokens del tema que usan los estados. */
+export type TonoEstado = Extract<keyof ColorTokens, 'success' | 'warning' | 'textMuted'>;
+
+/** El color de cada estado, como token del tema. La parada va en verde: tiene señal. */
+export const TONO_ESTADO: Record<ClaveEstado, TonoEstado> = {
+  en_marcha: 'success',
+  parada: 'success',
+  sin_ubicacion: 'warning',
+  sin_senal: 'textMuted',
+  sin_gps: 'textMuted',
+};
+
+/** El color de catálogo de cada estado (`COLOR.conexion` / `marcha_estado` de la web). */
+export const COLOR_ESTADO: Record<ClaveEstado, ColorSenal> = {
+  en_marcha: 'verde',
+  parada: 'verde',
+  sin_ubicacion: 'ambar',
+  sin_senal: 'gris',
+  sin_gps: 'gris',
+};
+
+/**
+ * Los mismos colores, en hexadecimal, para los marcadores del mapa que no leen
+ * el tema (el dibujo de `vehicleMarker.js` de la web y sus PNG).
+ */
+export const HEX_COLOR: Record<ColorSenal, string> = {
+  verde: '#35e888',
+  ambar: '#ffbf43',
+  gris: '#a1afbf',
+};
+
+/** El fondo de la pastilla de cada estado, como token del tema. */
+export const FONDO_ESTADO: Record<ClaveEstado, keyof ColorTokens> = {
+  en_marcha: 'successSurface',
+  parada: 'successSurface',
+  sin_ubicacion: 'warningSurface',
+  sin_senal: 'surfaceSunken',
+  sin_gps: 'surfaceSunken',
+};
+
+/** El nombre corto de cada estado. «Detenida», nunca «Detenido» ni «Parado». */
+export const ETIQUETA_ESTADO: Record<ClaveEstado, string> = {
+  en_marcha: 'En marcha',
+  parada: 'Detenida',
+  sin_ubicacion: 'Sin ubicación',
+  sin_senal: 'Sin señal',
+  sin_gps: 'Nunca reportó',
+};
+
+/** El estado de una unidad con su color y su señal completa. */
+export interface EstadoDeUnidad {
+  clave: ClaveEstado;
