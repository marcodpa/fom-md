+/**
+ * NOMBRE DE LA UNIDAD — una sola forma de llamarla en toda la app.
+ *
+ * Espejo de `src/panel/datos/nombreUnidad.js` del panel web:
+ *   nombreUnidad   → alias; si no hay, el número interno en mayúsculas; si no,
+ *                    la placa; si no, «Unidad».
+ *   etiquetaUnidad → «nombre · PLACA», sin repetir la placa y sin «·» colgando.
+ * Antes cada pantalla elegía a mano `id || placa`, `id · placa` o «Unidad», y la
+ * misma unidad se llamaba distinto según dónde se mirara.
+ *
+ * Puro, con import relativo: `node --test` lo carga tal cual.
+ */
+import { normalizarPlaca } from './placas';
+
+/** Lo que hace falta para nombrar una unidad (un `Vehicle` lo cumple). */
+export interface Nombrable {
+  alias?: string | null;
+  numero?: string | null;
+  placa?: string | null;
+}
+
+/** El texto sin espacios; '' si no hay nada o es la raya de «sin dato». */
+export const textoUnidad = (valor: unknown): string => {
+  const t = String(valor ?? '').trim();
+  return t === '—' ? '' : t;
+};
+
+/**
+ * El número interno de la unidad en mayúsculas ('' si no tiene). FOM guarda el
+ * `code` en minúsculas, pero la flota escribe «SVL-012» en la puerta.
+ */
+export const numeroInterno = (v: Nombrable | null | undefined): string => textoUnidad(v?.numero).toUpperCase();
+
+/** La placa de la unidad, normalizada ('' si no tiene). */
+export const placaUnidad = (v: Nombrable | null | undefined): string => normalizarPlaca(textoUnidad(v?.placa));
+
+/** Cómo se llama la unidad en pantalla. Nunca vacío. */
+export function nombreUnidad(v: Nombrable | null | undefined): string {
+  return textoUnidad(v?.alias) || numeroInterno(v) || placaUnidad(v) || 'Unidad';
+}
+
+/** «Hilux 27 · A12BC3D»; sin placa o con la placa ya dicha en el nombre, solo el nombre. */
+export function etiquetaUnidad(v: Nombrable | null | undefined): string {
+  const nombre = nombreUnidad(v);
+  const placa = placaUnidad(v);
+  if (!placa || normalizarPlaca(nombre) === placa) return nombre;
+  return `${nombre} · ${placa}`;
+}
+
+/** Lo que trae el servidor de una unidad (`/vehicles`) para nombrarla. */
+export interface IdentidadServidor {
+  alias?: string | null;
+  fleetNumber?: string | null;
+  code?: string | null;
+  plate?: string | null;
+}
+
+/**
+ * Lo que toda lectura de una unidad del servidor comparte: alias, placa y
+ * número. Lo vacío es siempre '' (nunca «—» ni undefined). El número es el de
+ * flota si llega y, si no, el `code`.
+ */
+export function identidadDeServidor(v: IdentidadServidor | null | undefined): { alias: string; placa: string; numero: string } {
+  return {
+    alias: textoUnidad(v?.alias),
+    placa: normalizarPlaca(textoUnidad(v?.plate)),
+    numero: textoUnidad(v?.fleetNumber) || textoUnidad(v?.code),
+  };
+}
