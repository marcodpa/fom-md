   return `${negativo ? '-' : ''}${agrupada}${decimal ? `,${decimal}` : ''}`;
 }
+
+/**
+ * Número como lo escribe la web (`numero` de formato.js): punto de miles SIEMPRE
+ * (también «1.234») y coma decimal. Sin `decimales`, hasta 3 y sin ceros de
+ * relleno; con `decimales`, exactos. Nulo o no numérico: «—».
+ */
+export function numero(n: number | null | undefined, decimales?: number): string {
+  if (n === null || n === undefined || !Number.isFinite(Number(n))) return '—';
+  const v = Number(n);
+  const fijo = decimales !== undefined;
+  const [entero, fraccionCruda] = Math.abs(v).toFixed(fijo ? decimales : 3).split('.');
+  const fraccion = !fijo && fraccionCruda ? fraccionCruda.replace(/0+$/, '') : fraccionCruda;
+  const cero = Number(`${entero}.${fraccion || 0}`) === 0;
+  return `${v < 0 && !cero ? '-' : ''}${entero.replace(/\B(?=(\d{3})+(?!\d))/g, '.')}${fraccion ? `,${fraccion}` : ''}`;
+}
