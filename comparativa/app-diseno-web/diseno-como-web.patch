+import { instanteOrden, type FechaOrden } from '@/lib/orden';
+import { formatFechaCorta } from '@/utils/date';
+
+/**
+ * FILTRO DE FECHA de Mantenimiento: «Hoy», «7 días», «30 días», «Todo» o un
+ * rango propio. Cuenta por el día en que se REPORTÓ la orden (su `creadaEn`,
+ * la misma fecha que se ve en la tarjeta y que ordena la lista). La web hace
+ * la misma cuenta en src/panel/datos/filtroFecha.js.
+ *
+ * FOM no deja pedir las órdenes por fecha (solo estado, unidad y página): se
+ * filtra aquí, sobre lo ya cargado. Pendiente para el servidor:
+ * `createdFrom` / `createdTo` en el listado de work-orders.
+ *
+ * Los días van en hora LOCAL: «Hoy» es desde las 00:00 de aquí, y «7 días» es
+ * hoy y los 6 anteriores, enteros.
+ */
+
+export type AtajoFecha = '' | 'hoy' | '7d' | '30d' | 'rango';
+
+/** Lo elegido: un atajo o, con «rango», sus dos días en `AAAA-MM-DD` ('' = sin ese lado). */
+export type FiltroFecha = { atajo: AtajoFecha; desde: string; hasta: string };
+
+/** Sin filtro: lo que arranca la pantalla. */
+export const SIN_FECHA: FiltroFecha = { atajo: '', desde: '', hasta: '' };
+
+/** Los atajos, en el orden en que se ofrecen. `''` = todas las fechas. */
+export const ATAJOS_FECHA: { id: Exclude<AtajoFecha, 'rango'>; label: string; corto: string; dias?: number }[] = [
+  { id: 'hoy', label: 'Hoy', corto: 'Hoy', dias: 1 },
+  { id: '7d', label: 'Últimos 7 días', corto: '7 días', dias: 7 },
+  { id: '30d', label: 'Últimos 30 días', corto: '30 días', dias: 30 },
+  { id: '', label: 'Todas las fechas', corto: 'Todo' },
+];
+
+const RE_DIA = /^\d{4}-\d{2}-\d{2}$/;
+
+/** 00:00 locales del día de `ms`, menos `atras` días. */
+function inicioDelDia(ms: number, atras = 0): number {
+  const d = new Date(ms);
+  return new Date(d.getFullYear(), d.getMonth(), d.getDate() - atras).getTime();
+}
+
+/** El tramo en ms: `desde` incluido, `hasta` excluido; `null` = sin límite por ese lado. */
+export function rangoDeFecha(valor: FiltroFecha, ahora = Date.now()): { desde: number | null; hasta: number | null } {
+  const atajo = ATAJOS_FECHA.find((a) => a.dias && a.id === valor.atajo);
+  if (atajo?.dias) return { desde: inicioDelDia(ahora, atajo.dias - 1), hasta: null };
+  if (valor.atajo !== 'rango') return { desde: null, hasta: null };
+  let desde = RE_DIA.test(valor.desde) ? instanteOrden(valor.desde) : null;
+  let hasta = RE_DIA.test(valor.hasta) ? instanteOrden(valor.hasta) : null;
+  if (desde === -Infinity) desde = null;
+  if (hasta === -Infinity) hasta = null;
+  // Un rango al revés se da la vuelta en vez de dejar la lista vacía.
+  if (desde !== null && hasta !== null && desde > hasta) [desde, hasta] = [hasta, desde];
+  // «Hasta el 20» incluye todo el 20: se corta a las 00:00 del 21.
+  if (hasta !== null) hasta = inicioDelDia(hasta, -1);
+  return { desde, hasta };
+}
+
+/** ¿Hay algún filtro de fecha puesto? */
+export function hayFiltroFecha(valor: FiltroFecha): boolean {
+  const r = rangoDeFecha(valor);
+  return r.desde !== null || r.hasta !== null;
+}
+
+/**
+ * Las de la lista que caen en el filtro, por la fecha que da `fecha`. Sin
+ * filtro pasa todo; con filtro, lo que no trae fecha se queda fuera. No
+ * reordena: la lista sigue de la más nueva a la más vieja.
+ */
+export function filtrarPorFecha<T>(lista: readonly T[], valor: FiltroFecha, fecha: (x: T) => FechaOrden, ahora = Date.now()): T[] {
+  const { desde, hasta } = rangoDeFecha(valor, ahora);
+  if (desde === null && hasta === null) return [...lista];
+  return lista.filter((x) => {
+    const ms = instanteOrden(fecha(x));
+    if (ms === -Infinity) return false;
+    return (desde === null || ms >= desde) && (hasta === null || ms < hasta);
+  });
+}
+
+/** Lo que dice el botón con el filtro puesto: «Hoy», «7 días», «3 oct – 20 oct», «Desde 3 oct». */
+export function textoFiltroFecha(valor: FiltroFecha): string {
+  const atajo = ATAJOS_FECHA.find((a) => a.dias && a.id === valor.atajo);
+  if (atajo) return atajo.corto;
+  if (valor.atajo !== 'rango') return '';
+  let a = RE_DIA.test(valor.desde) ? valor.desde : '';
+  let b = RE_DIA.test(valor.hasta) ? valor.hasta : '';
+  if (a && b && a > b) [a, b] = [b, a];
+  if (a && b) return a === b ? formatFechaCorta(a) : `${formatFechaCorta(a)} – ${formatFechaCorta(b)}`;
+  if (a) return `Desde ${formatFechaCorta(a)}`;
+  if (b) return `Hasta ${formatFechaCorta(b)}`;
+  return '';
+}
