+/**
+ * Los datos de ORIGEN de cada formato, para el informe empresarial en A4.
+ *
+ * Cada formato del PDF lleva sus `secciones` genéricas (las que dibuja la vista
+ * previa en pantalla) y, además, el reporte del que salieron: con él, el papel
+ * arma la portada, el resumen ejecutivo, su sección y el cierre con las mismas
+ * cifras, sin volver a pedir nada al servidor.
+ *
+ * `anterior` es el MISMO reporte del período anterior. Con él, las cifras
+ * llevan ▲▼ y «Antes …»; sin él, el informe sale completo, solo que sin flechas.
+ */
+
+import type {
+  FichaUnidadReporte,
+  FleetReport,
+  FormatoPredefReporte,
+  ReporteCostos,
+  UserReport,
+} from '@/types';
+
+export type DatosInforme =
+  | { tipo: 'vehiculos'; reporte: FleetReport; anterior?: FleetReport }
+  | { tipo: 'usuarios'; reporte: UserReport; anterior?: UserReport }
+  | { tipo: 'costos'; reporte: ReporteCostos; anterior?: ReporteCostos }
+  /**
+   * El anterior del estadístico puede ser el mismo informe o el reporte de
+   * flota del período anterior (de él salen km, eventos y unidades medidas;
+   * la identificación de conductores no, y queda sin «antes»).
+   */
+  | { tipo: 'estadistico'; reporte: FormatoPredefReporte; anterior?: FormatoPredefReporte | FleetReport }
+  /** La ficha de una unidad elegida: va dentro de la sección de Vehículos. */
+  | { tipo: 'ficha'; ficha: FichaUnidadReporte };
+
+/** Quién genera el informe: va en la portada, en el pie y en «Elaborado por». */
+export interface FirmantePdf {
+  nombre: string;
+  cargo?: string;
+}
