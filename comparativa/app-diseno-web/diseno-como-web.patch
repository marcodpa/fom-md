@@ -0,0 +1,431 @@
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { StyleSheet, View } from 'react-native';
+import Svg, { Circle, Path } from 'react-native-svg';
+
+import { Flotante } from '@/components/escalonado';
+import { PressableScale } from '@/components/pressable-scale';
+import { Skeleton } from '@/components/skeleton';
+import { ThemedText } from '@/components/themed-text';
+import {
+  distanciaLlegada,
+  extraPorTrafico,
+  horaLlegada,
+  mensajeLlegada,
+  pedirLlegada,
+  tiempoLlegada,
+  type PuntoLlegada,
+  type RutaLlegada,
+} from '@/lib/llegada';
+import { useTheme } from '@/theme';
+
+// ============================================================
+// «LLEGADA» EN EL MAPA DE LA FLOTA (la unidad elegida)
+// ------------------------------------------------------------
+// La tarjeta que flota abajo sobre el mapa y su estado. La usan los dos
+// mapas de Mapbox de la app (el nativo y el de la vista web): ellos dibujan
+// la ruta y el pin, esta tarjeta dice cuánto tarda, a qué hora llega y a qué
+// distancia. Mismo diseño que la tarjeta del panel web.
+// ============================================================
+
+/** Una unidad que puede ser origen o destino. */
+export type UnidadLlegada = { id: string; lat: number; lng: number; placa: string };
+
+type Destino = PuntoLlegada & { nombre: string; unidadId?: string };
+
+/** Lo abierto, de qué unidad (`para`) y cuál elección de destino va (`eleccion`). */
+type Abierta = { para: string; eligiendo: boolean; destino: Destino | null; eleccion: number };
+
+type Resultado = { para: string; eleccion: number; clave: string; ruta: RutaLlegada | null; error: string | null; en: number };
+
+export type FaseLlegada = 'cerrada' | 'inicio' | 'eligiendo' | 'cargando' | 'lista' | 'error';
+
+/**
+ * Lado de la rejilla (en grados, ~330 m) con que se vuelve a pedir la ruta
+ * cuando la unidad (o la unidad destino) se mueve: la flota se relee cada
+ * 20 s y no hace falta una pregunta nueva por cada metro.
+ */
+const REJILLA = 0.003;
+/** Cada cuánto se refresca una llegada a la vista (como la caché de 2 min de la web). */
+const REFRESCO_MS = 120000;
+const celda = (p: PuntoLlegada) => `${Math.round(p.lat / REJILLA)},${Math.round(p.lng / REJILLA)}`;
+
+/**
+ * El estado de «Llegada» para la unidad elegida. Se reinicia solo al elegir
+ * otra unidad (el estado recuerda para cuál era) o cuando deja de estar
+ * disponible (un recorrido en pantalla, sin unidad elegida…).
+ */
+export function useLlegada({
+  disponible,
+  unidadId,
+  unidades,
+}: {
+  disponible: boolean;
+  unidadId: string | null;
+  unidades: UnidadLlegada[];
+}) {
+  const [abierta, setAbierta] = useState<Abierta | null>(null);
+  const [res, setRes] = useState<Resultado | null>(null);
+  // Cada 2 min se vuelve a preguntar (el tráfico cambia aunque la unidad esté quieta).
+  const [vuelta, setVuelta] = useState(0);
+
+  const origenU = unidadId ? unidades.find((u) => u.id === unidadId) : undefined;
+  const vigente = disponible && origenU && abierta && abierta.para === unidadId ? abierta : null;
+  const origen: PuntoLlegada | null = origenU ? { lat: origenU.lat, lng: origenU.lng } : null;
+  // Si el destino es otra unidad, va donde esté ahora.
+  const destinoU = vigente?.destino?.unidadId ? unidades.find((u) => u.id === vigente.destino!.unidadId) : undefined;
+  const destino: Destino | null = vigente?.destino
+    ? destinoU
+      ? { ...vigente.destino, lat: destinoU.lat, lng: destinoU.lng }
+      : vigente.destino
+    : null;
+  const clave = origen && destino ? `${celda(origen)}>${celda(destino)}:${vuelta}` : null;
+
+  const conDestino = !!vigente?.destino;
+  useEffect(() => {
+    if (!conDestino) return;
+    const t = setInterval(() => setVuelta((v) => v + 1), REFRESCO_MS);
+    return () => clearInterval(t);
+  }, [conDestino]);
+
+  useEffect(() => {
+    if (!vigente || !clave || !origen || !destino) return;
+    if (res && res.para === vigente.para && res.eleccion === vigente.eleccion && res.clave === clave) return;
+    // Sin abortar la petición: va a una caché compartida y abortarla le
+    // dejaría un error a quien la pida igual justo después. Una respuesta
+    // que llega tarde (otra elección, otra celda) simplemente se ignora.
+    let vigenteAun = true;
+    const para = vigente.para;
+    const eleccion = vigente.eleccion;
+    pedirLlegada(origen, destino).then(
+      (ruta) => {
+        if (vigenteAun) setRes({ para, eleccion, clave, ruta, error: null, en: Date.now() });
+      },
+      (e: unknown) => {
+        if (vigenteAun) setRes({ para, eleccion, clave, ruta: null, error: mensajeLlegada(e), en: Date.now() });
+      },
+    );
+    return () => {
+      vigenteAun = false;
+    };
+    // Solo cuando cambia la elección o la celda de origen o destino (no en cada relectura de la flota).
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [vigente?.para, vigente?.eleccion, clave]);
+
+  // El resultado de ESTA elección (aunque sea de una celda anterior: mientras
+  // se recalcula por el movimiento, la tarjeta no vuelve al esqueleto).
+  const suyo = vigente && res && res.para === vigente.para && res.eleccion === vigente.eleccion ? res : null;
+  const fase: FaseLlegada = !vigente
+    ? 'cerrada'
+    : vigente.eligiendo
+      ? 'eligiendo'
+      : !destino
+        ? 'inicio'
+        : !suyo
+          ? 'cargando'
+          : suyo.error
+            ? 'error'
+            : 'lista';
+
+  const abrir = useCallback(() => {
+    if (unidadId) setAbierta({ para: unidadId, eligiendo: false, destino: null, eleccion: 0 });
+  }, [unidadId]);
+  const cerrar = useCallback(() => setAbierta(null), []);
+  const elegir = useCallback(() => setAbierta((a) => (a ? { ...a, eligiendo: true } : a)), []);
+  // Cancelar vuelve a lo de antes (el destino que había, si había).
+  const cancelar = useCallback(() => setAbierta((a) => (a ? { ...a, eligiendo: false } : a)), []);
+  // Quitar borra el destino y la ruta; la tarjeta vuelve a «Elegir destino».
+  const quitar = useCallback(() => setAbierta((a) => (a ? { ...a, eligiendo: false, destino: null, eleccion: a.eleccion + 1 } : a)), []);
+
+  /**
+   * Un toque en el mapa. Eligiendo, ese punto es el destino. Con la tarjeta
+   * abierta el toque se queda aquí (no suelta la unidad): se cierra con la X.
+   * Devuelve si lo usó.
+   */
+  const tocarPunto = useCallback(
+    (p: PuntoLlegada): boolean => {
+      if (!vigente) return false;
+      if (vigente.eligiendo && Number.isFinite(p.lat) && Number.isFinite(p.lng)) {
+        setAbierta({ ...vigente, eligiendo: false, destino: { lat: p.lat, lng: p.lng, nombre: 'Punto elegido' }, eleccion: vigente.eleccion + 1 });
+      }
+      return true;
+    },
+    [vigente],
+  );
+
+  /** Un toque en una unidad. Eligiendo, esa unidad es el destino. Devuelve si lo usó. */
+  const tocarUnidad = useCallback(
+    (id: string): boolean => {
+      if (!vigente?.eligiendo) return false;
+      const u = unidades.find((x) => x.id === id);
+      // La propia unidad no puede ser su destino: el toque se ignora.
+      if (!u || id === vigente.para) return true;
+      setAbierta({
+        ...vigente,
+        eligiendo: false,
+        destino: { lat: u.lat, lng: u.lng, nombre: u.placa, unidadId: u.id },
+        eleccion: vigente.eleccion + 1,
+      });
+      return true;
+    },
+    [vigente, unidades],
+  );
+
+  const ruta = fase === 'lista' || fase === 'eligiendo' ? (suyo?.ruta ?? null) : null;
+  return {
+    fase,
+    placa: origenU?.placa ?? 'Unidad',
+    origen,
+    destino,
+    ruta,
+    error: suyo?.error ?? null,
+    /** Cuándo llegó la respuesta: «llega a las…» cuenta desde ahí (se refresca cada 2 min). */
+    calculadaEn: suyo?.en ?? null,
+    /** Cambia con cada ruta nueva que llega: el mapa la encuadra una vez. */
+    encuadreClave: ruta && vigente ? `${vigente.para}:${vigente.eleccion}` : null,
+    abrir,
+    cerrar,
+    elegir,
+    cancelar,
+    quitar,
+    tocarPunto,
+    tocarUnidad,
+  };
+}
+
+export type Llegada = ReturnType<typeof useLlegada>;
+
+/** Los puntos que debe abarcar la cámara: la unidad, el destino y el camino. */
+export function puntosLlegada(l: Llegada): [number, number][] {
+  const p: [number, number][] = [...(l.ruta?.trazo ?? [])];
+  if (l.origen) p.push([l.origen.lng, l.origen.lat]);
+  if (l.destino) p.push([l.destino.lng, l.destino.lat]);
+  return p;
+}
+
+// ── Iconos ──────────────────────────────────────────────────────────────────
+
+/** El reloj de «Llegada»: en la tarjeta y en el botón de los controles del mapa. */
+export function IconoLlegada({ color, size = 18 }: { color: string; size?: number }) {
+  return (
+    <Svg width={size} height={size} viewBox="0 0 24 24" fill="none">
+      <Circle cx={12} cy={12} r={8.5} stroke={color} strokeWidth={1.8} />
+      <Path d="M12 7.5V12l3 2" stroke={color} strokeWidth={1.8} strokeLinecap="round" strokeLinejoin="round" />
+    </Svg>
+  );
+}
+
+function IconoDestino({ color }: { color: string }) {
+  return (
+    <Svg width={18} height={18} viewBox="0 0 24 24" fill="none">
+      <Circle cx={12} cy={12} r={7} stroke={color} strokeWidth={1.8} />
+      <Path d="M12 2.5v4M12 17.5v4M2.5 12h4M17.5 12h4" stroke={color} strokeWidth={1.8} strokeLinecap="round" />
+    </Svg>
+  );
+}
+
+function IconoCerrar({ color }: { color: string }) {
+  return (
+    <Svg width={18} height={18} viewBox="0 0 24 24" fill="none">
+      <Path d="M18 6L6 18M6 6l12 12" stroke={color} strokeWidth={1.8} strokeLinecap="round" />
+    </Svg>
+  );
+}
+
+// ── La tarjeta ──────────────────────────────────────────────────────────────
+
+/**
+ * La tarjeta de «Llegada»: abajo, a lo ancho con 16 px de margen, encima de
+ * lo que tape el mapa (`abajo`). `onAlto` avisa de su alto para que el mapa
+ * suba sus controles y encuadre la ruta sin quedar debajo.
+ */
+export function LlegadaTarjeta({ llegada, abajo, onAlto }: { llegada: Llegada; abajo: number; onAlto?: (alto: number) => void }) {
+  const { colors, radii, spacing, shadows } = useTheme();
+  const { fase, placa } = llegada;
+  const extra = llegada.ruta ? extraPorTrafico(llegada.ruta.minutos, llegada.ruta.minutosNormales) : null;
+  const destinoNombre = llegada.destino?.nombre || 'Punto elegido';
+
+  const boton = useMemo(
+    () => ({
+      primario: [estilos.boton, { backgroundColor: colors.primary }],
+      secundario: [estilos.boton, { backgroundColor: colors.surfaceElevated, borderColor: colors.borderStrong, borderWidth: 1 }],
+    }),
+    [colors],
+  );
+
+  if (fase === 'cerrada') return null;
+
+  return (
+    <Flotante
+      onLayout={(e) => onAlto?.(Math.round(e.nativeEvent.layout.height))}
+      accessibilityLabel={`Llegada de ${placa}`}
+      style={[
+        estilos.tarjeta,
+        shadows.floating,
+        {
+          bottom: 12 + abajo,
+          backgroundColor: colors.surface,
+          borderColor: colors.border,
+          borderRadius: radii.lg,
+          gap: spacing.md,
+        },
+      ]}>
+      {/* Encabezado: la unidad y la pregunta. */}
+      <View style={estilos.fila}>
+        <View style={[estilos.ibox, { backgroundColor: colors.infoSurface, borderRadius: radii.sm }]}>
+          <IconoLlegada color={colors.primary} />
+        </View>
+        <View style={estilos.cabTexto}>
+          <ThemedText style={estilos.placa} numberOfLines={1}>
+            {placa}
+          </ThemedText>
+          <ThemedText style={estilos.bajada} color="textSecondary" numberOfLines={1}>
+            {fase === 'lista' ? 'Llegada con el tráfico de ahora' : '¿Cuánto tarda en llegar?'}
+          </ThemedText>
+        </View>
+        <PressableScale
+          onPress={llegada.cerrar}
+          accessibilityRole="button"
+          accessibilityLabel="Cerrar llegada"
+          hitSlop={6}
+          style={[estilos.cerrar, { backgroundColor: colors.surfaceSunken }]}>
+          <IconoCerrar color={colors.textSecondary} />
+        </PressableScale>
+      </View>
+
+      {fase === 'eligiendo' ? (
+        <>
+          <View style={[estilos.fila, estilos.eligiendo]} accessibilityLiveRegion="polite">
+            <IconoDestino color={colors.primary} />
+            <ThemedText style={estilos.texto14} numberOfLines={2}>
+              Toca un punto del mapa o una unidad
+            </ThemedText>
+          </View>
+          <PressableScale onPress={llegada.cancelar} accessibilityRole="button" style={boton.secundario}>
+            <ThemedText style={estilos.botonTexto}>Cancelar</ThemedText>
+          </PressableScale>
+        </>
+      ) : null}
+
+      {/* Mismo alto que el resultado: al llegar la ruta la tarjeta no salta. */}
+      {fase === 'cargando' ? (
+        <>
+          <View style={estilos.cuerpo} accessibilityLabel="Calculando la llegada" accessibilityLiveRegion="polite">
+            <Skeleton width={150} height={30} radius={radii.sm} />
+            <Skeleton height={22} radius={radii.sm} />
+            <Skeleton width="60%" height={14} radius={radii.sm} />
+          </View>
+          <Skeleton height={48} radius={radii.pill} />
+        </>
+      ) : null}
+
+      {fase === 'lista' && llegada.ruta ? (
+        <>
+          <View style={estilos.cuerpo} accessibilityLiveRegion="polite">
+            <View style={estilos.tiempoFila}>
+              <ThemedText style={estilos.tiempo} tabular>
+                {tiempoLlegada(llegada.ruta.minutos)}
+              </ThemedText>
+              <ThemedText style={estilos.bajada} color="textSecondary" numberOfLines={1}>
+                llega a las {horaLlegada(llegada.ruta.minutos, llegada.calculadaEn ?? undefined)}
+              </ThemedText>
+            </View>
+            {/* La mini línea del viaje: ● unidad ─── distancia ─── ◆ destino. */}
+            <View
+              accessible
+              accessibilityLabel={`${distanciaLlegada(llegada.ruta.km)} desde ${placa} hasta ${destinoNombre}`}>
+              <View style={estilos.fila}>
+                <View style={[estilos.origen, { backgroundColor: colors.text, borderColor: colors.surface }]} />
+                <View style={[estilos.trazo, { backgroundColor: colors.borderStrong }]} />
+                <View style={[estilos.distancia, { backgroundColor: colors.surfaceSunken, borderRadius: radii.sm }]}>
+                  <ThemedText style={estilos.distanciaTexto} tabular>
+                    {distanciaLlegada(llegada.ruta.km)}
+                  </ThemedText>
+                </View>
+                <View style={[estilos.trazo, { backgroundColor: colors.borderStrong }]} />
+                <View style={[estilos.rombo, { backgroundColor: colors.primary }]} />
+              </View>
+              <View style={[estilos.fila, estilos.puntos]}>
+                <ThemedText style={estilos.punto} color="textMuted" numberOfLines={1}>
+                  {placa}
+                </ThemedText>
+                <ThemedText style={[estilos.punto, estilos.derecha]} color="textMuted" numberOfLines={1}>
+                  {destinoNombre}
+                </ThemedText>
+              </View>
+            </View>
+            {extra ? (
+              <View style={[estilos.chip, { backgroundColor: colors.warningSurface, borderRadius: radii.sm }]}>
+                <ThemedText style={estilos.chipTexto} color="warning">
+                  +{tiempoLlegada(extra)} por tráfico
+                </ThemedText>
+              </View>
+            ) : null}
+          </View>
+          <View style={estilos.fila}>
+            <PressableScale onPress={llegada.elegir} accessibilityRole="button" style={[boton.secundario, estilos.flex]}>
+              <ThemedText style={estilos.botonTexto}>Cambiar destino</ThemedText>
+            </PressableScale>
+            <PressableScale onPress={llegada.quitar} accessibilityRole="button" style={estilos.textoBoton}>
+              <ThemedText style={estilos.botonTexto} color="textSecondary">
+                Quitar
+              </ThemedText>
+            </PressableScale>
+          </View>
+        </>
+      ) : null}
+
+      {fase === 'inicio' || fase === 'error' ? (
+        <>
+          {fase === 'error' && llegada.error ? (
+            <ThemedText style={estilos.texto14} color="danger" accessibilityRole="alert">
+              {llegada.error}
+            </ThemedText>
+          ) : null}
+          <View style={estilos.fila}>
+            <PressableScale onPress={llegada.elegir} accessibilityRole="button" style={[boton.primario, estilos.flex]}>
+              <ThemedText style={[estilos.botonTexto, { color: colors.onPrimary }]}>
+                {fase === 'error' ? 'Elegir otro destino' : 'Elegir destino'}
+              </ThemedText>
+            </PressableScale>
+            {fase === 'error' && llegada.destino ? (
+              <PressableScale onPress={llegada.quitar} accessibilityRole="button" style={estilos.textoBoton}>
+                <ThemedText style={estilos.botonTexto} color="textSecondary">
+                  Quitar
+                </ThemedText>
+              </PressableScale>
+            ) : null}
+          </View>
+        </>
+      ) : null}
+    </Flotante>
+  );
+}
+
+const estilos = StyleSheet.create({
+  tarjeta: { position: 'absolute', left: 16, right: 16, padding: 16, borderWidth: 1 },
+  fila: { flexDirection: 'row', alignItems: 'center', gap: 12 },
+  flex: { flex: 1 },
+  ibox: { width: 40, height: 40, alignItems: 'center', justifyContent: 'center' },
+  cabTexto: { flex: 1, minWidth: 0 },
+  placa: { fontSize: 15, lineHeight: 20, fontWeight: '600' },
+  bajada: { fontSize: 13, lineHeight: 18 },
+  cerrar: { width: 36, height: 36, borderRadius: 999, alignItems: 'center', justifyContent: 'center' },
+  eligiendo: { minHeight: 48, gap: 10 },
+  texto14: { flexShrink: 1, fontSize: 14, lineHeight: 20 },
+  cuerpo: { gap: 10, minHeight: 92 },
+  tiempoFila: { flexDirection: 'row', alignItems: 'baseline', gap: 10, flexWrap: 'wrap' },
+  tiempo: { fontSize: 28, lineHeight: 34, fontWeight: '700', letterSpacing: -0.5 },
+  origen: { width: 12, height: 12, borderRadius: 6, borderWidth: 2 },
+  trazo: { flex: 1, height: 2, borderRadius: 1 },
+  distancia: { height: 22, paddingHorizontal: 8, justifyContent: 'center', marginHorizontal: -4 },
+  distanciaTexto: { fontSize: 12, lineHeight: 16, fontWeight: '600' },
+  rombo: { width: 10, height: 10, borderRadius: 2, transform: [{ rotate: '45deg' }], marginRight: 1 },
+  puntos: { justifyContent: 'space-between', marginTop: 4 },
