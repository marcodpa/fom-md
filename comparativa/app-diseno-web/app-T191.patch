+   *  - en cualquier otra altura (o en camino) el dedo mueve la hoja.
+   * Si no le toca, se aparta (`fail`) y el desplazamiento sigue como siempre.
+   */
+  const arrastre = Gesture.Pan()
+    .manualActivation(true)
+    .onTouchesDown((e) => {
+      const t = e.allTouches[0];
+      if (t) {
