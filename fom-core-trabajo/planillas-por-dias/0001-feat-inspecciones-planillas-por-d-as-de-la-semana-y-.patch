+/**
+ * Los días se guardan en orden de semana para que comparar sea trivial. Un
+ * día desconocido se rechaza aquí aunque el DTO ya lo filtre: callarlo
+ * convertiría «feriado» en «todos los días».
+ */
+function ordenarDias(weekdays: readonly string[]): string[] {
+  const conocidos: readonly string[] = WEEKDAYS;
+  if (weekdays.some((day) => !conocidos.includes(day))) {
+    throw new BadRequestException('Unknown weekday');
+  }
+  return WEEKDAYS.filter((day) => weekdays.includes(day));
