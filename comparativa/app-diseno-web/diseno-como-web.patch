+          ],
+        };
+      }),
+      total: {
+        celdas: [
+          `Total · ${entero(r.alertasPorVehiculo.length)}`,
+          '',
+          '',
+          entero(t.km),
+          entero(km6),
+          d100(t.acel, t.km),
+          d100(t.fren, t.km),
+          d100(t.exc, t.km),
+          vel.length > 0 ? entero(Math.max(...vel)) : '—',
+          scoreFlota === null ? '—' : decimal(scoreFlota),
+        ],
+      },
+      vacia: 'Sin unidades en el alcance.',
+    }),
+  );
+
+  // ── Cuadro por conductor. ──
+  if (r.conductores.length > 0) {
+    const tc = r.conductores.reduce(
+      (a, c) => ({
+        km: a.km + c.km,
+        min: a.min + (c.minutosConduccion ?? 0),
+        acel: a.acel + c.aceleraciones,
+        fren: a.fren + c.frenadas,
+        exc: a.exc + c.excesos,
+      }),
