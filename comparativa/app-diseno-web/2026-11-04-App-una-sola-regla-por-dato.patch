index 0000000..2d191af
--- /dev/null
+++ b/src/utils/vencimientos.ts
@@ -0,0 +1,94 @@
+// ============================================================
+// VENCIMIENTOS — la ÚNICA regla de cuándo un papel está vigente, por vencer o
+// vencido (igual que la web: src/panel/datos/vencimientos.js). Ninguna pantalla
+// vuelve a escribir un 30, un 7 ni una división entre 86400000 para esto: lo
+// vigila test/regla-conteos.test.mjs. Sin imports a propósito (se prueba con
+// Node solo).
+//
+//  · La fecha guardada es el ÚLTIMO DÍA en que el papel vale. Vence el 31 de
+//    agosto: sirve todo el 31 y está vencido el 1 de septiembre.
+//  · Se cuentan DÍAS DE CALENDARIO LOCAL (de medianoche a medianoche), nunca
+//    milisegundos: contar instantes daba «vencido» desde la primera hora del
+//    propio día de vencimiento.
+//  · Un 'AAAA-MM-DD' pelado lo lee JS como medianoche UTC, y en Venezuela
+//    (UTC-4) cae la tarde anterior: se arma siempre como fecha local.
+//  · Si el servidor ya trae `daysToExpiry`, se usa ese número tal cual.
+// ============================================================
+
+/** Desde cuántos días antes un papel cuenta como «por vencer». */
+export const UMBRAL_POR_VENCER_DIAS = 30;
+/** Desde cuántos días antes un papel es urgente (atención inmediata). */
+export const UMBRAL_URGENTE_DIAS = 7;
+
+export type VeredictoVencimiento = 'vencido' | 'por_vencer' | 'vigente';
+
+const MS_POR_DIA = 86_400_000;
+
+/**
+ * Fecha local a partir de 'AAAA-MM-DD' (o de un ISO con hora, tomando solo el
+ * día), de un Date o de un número. Fecha inválida: Invalid Date.
+ */
+export function fechaLocal(valor: string | number | Date): Date {
+  if (typeof valor === 'string') {
+    const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(valor);
+    if (m) return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
+  }
+  return new Date(valor);
+}
+
+const mediaNoche = (d: Date): Date => new Date(d.getFullYear(), d.getMonth(), d.getDate());
+
+/** Días de calendario que faltan para `fecha` (0 = hoy, negativo = ya venció). NaN si la fecha no sirve. */
+export function diasDeCalendario(fecha: string | number | Date, hoy: string | number | Date = new Date()): number {
+  const vence = fechaLocal(fecha);
+  const ahora = fechaLocal(hoy);
+  if (Number.isNaN(vence.getTime()) || Number.isNaN(ahora.getTime())) return NaN;
+  // round, no floor: un cambio de hora no debe mover el día.
+  return Math.round((mediaNoche(vence).getTime() - mediaNoche(ahora).getTime()) / MS_POR_DIA);
+}
+
+/**
+ * Los días que faltan: los que dice el servidor (`daysToExpiry`) si vienen; si
+ * no, los de calendario local de la fecha.
+ */
+export function diasParaVencer(
+  fecha: string | number | Date,
+  diasServidor?: number | null,
+  hoy: string | number | Date = new Date(),
+): number {
+  if (diasServidor != null && Number.isFinite(Number(diasServidor))) return Number(diasServidor);
+  return diasDeCalendario(fecha, hoy);
+}
+
+/**
+ * 'vencido' | 'por_vencer' | 'vigente' a partir de los días que faltan.
+ * Hoy NO es vencido: el papel vale hasta el final del día. Sin número válido: null.
+ */
+export function clasificarVencimiento(dias: number | string | null | undefined): VeredictoVencimiento | null {
+  if (dias == null || dias === '') return null;
+  const n = Number(dias);
+  if (!Number.isFinite(n)) return null;
+  if (n < 0) return 'vencido';
+  if (n <= UMBRAL_POR_VENCER_DIAS) return 'por_vencer';
+  return 'vigente';
+}
+
+/** ¿Es de atención inmediata? Vencido, o vence en `UMBRAL_URGENTE_DIAS` días o menos. */
+export function esUrgente(dias: number | string | null | undefined): boolean {
+  const n = Number(dias);
+  return dias != null && dias !== '' && Number.isFinite(n) && n <= UMBRAL_URGENTE_DIAS;
+}
+
+/** Cuántos papeles hay vencidos y por vencer, a partir del veredicto de cada uno. */
+export function contarVencimientos(docs: readonly { estado?: string | null }[] | null | undefined): {
+  vencidos: number;
+  porVencer: number;
+} {
+  let vencidos = 0;
+  let porVencer = 0;
+  for (const d of docs ?? []) {
+    if (d?.estado === 'vencido') vencidos += 1;
+    else if (d?.estado === 'por_vencer') porVencer += 1;
+  }
+  return { vencidos, porVencer };
+}
