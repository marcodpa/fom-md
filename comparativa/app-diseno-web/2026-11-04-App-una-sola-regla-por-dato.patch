+// ============================================================
+// LA REGLA DE LOS GRUPOS DE ODT — un solo lugar (igual que la web:
+// src/panel/datos/odtGrupos.js).
+// ------------------------------------------------------------
+// La ODT se muestra con 3 estados: Abierta / En revisión / Resuelta. Es SOLO
+// presentación: FOM sigue con sus nueve estados y lo que se le envía no cambia.
+// Cancelada cuenta como resuelta porque ya no espera nada.
+//
+// Este archivo NO importa nada a propósito (así se prueba con Node solo y no
+// puede formar círculos). Quien necesite contar, agrupar, nombrar o pintar
+// órdenes lo hace desde aquí; comparar `estado === 'abierta'` en otro lado
+// falla en test/regla-conteos.test.mjs.
+//
+// Las órdenes del SISTEMA (preventivas sin autor) cuentan en todos los totales.
+// Si una pantalla necesita dejarlas fuera lo dice con `contarOdt(odts, { excluir })`.
+// ============================================================
+
+/** Los tres grupos que se ven. */
+export type GrupoOdt = 'abierta' | 'revision' | 'resuelta';
+
+/** Tono del tema con que se pinta cada grupo. */
+export type TonoOdt = 'warning' | 'info' | 'success';
+
+/** Los tres estados con que la app guarda `WorkOrderListItem.estado`. */
+export type EstadoOdtApp = 'abierta' | 'en_revision' | 'cerrada';
+
+export const ESTADOS_VISIBLES: readonly {
+  clave: GrupoOdt;
+  etiqueta: string;
+  plural: string;
+  tono: TonoOdt;
+  /** Los estados reales de FOM (y los 3 de la app) que caen en el grupo. */
+  estados: readonly string[];
+}[] = [
+  { clave: 'abierta', etiqueta: 'Abierta', plural: 'Abiertas', tono: 'warning', estados: ['abierta'] },
+  {
+    clave: 'revision',
+    etiqueta: 'En revisión',
+    plural: 'En revisión',
+    // Un solo tono en toda la app: azul (info), como la web.
+    tono: 'info',
+    estados: ['en_revision', 'aprobada', 'asignada', 'en_ejecucion', 'pausada', 'en_calidad'],
+  },
+  { clave: 'resuelta', etiqueta: 'Resuelta', plural: 'Resueltas', tono: 'success', estados: ['cerrada', 'cancelada'] },
+];
+
+export const ETIQUETA_GRUPO: Record<GrupoOdt | 'otro', string> = {
+  abierta: 'Abierta',
+  revision: 'En revisión',
+  resuelta: 'Resuelta',
+  otro: 'Otro estado',
+};
+
+/** El estado de la app que corresponde a cada grupo. */
+const ESTADO_DE_GRUPO: Record<GrupoOdt, EstadoOdtApp> = {
+  abierta: 'abierta',
+  revision: 'en_revision',
+  resuelta: 'cerrada',
+};
+
+/** 'abierta' | 'revision' | 'resuelta' de un estado (real de FOM o de la app); 'otro' si no lo conocemos. */
+export function grupoOdt(estado: string | null | undefined): GrupoOdt | 'otro' {
+  return ESTADOS_VISIBLES.find((g) => g.estados.includes(estado ?? ''))?.clave ?? 'otro';
+}
+
+/** El estado de la app (los 3) de un estado real de FOM; null si no lo conocemos. */
+export function estadoVisible(estado: string | null | undefined): EstadoOdtApp | null {
+  const g = grupoOdt(estado);
+  return g === 'otro' ? null : ESTADO_DE_GRUPO[g];
+}
+
+/** «Abierta», «En revisión» o «Resuelta» para un estado (real o de la app). */
+export function etiquetaOdt(estado: string | null | undefined): string {
+  return ETIQUETA_GRUPO[grupoOdt(estado)];
+}
+
+/** El tono del tema de un grupo ('abierta' | 'revision' | 'resuelta'). */
+export function tonoDeGrupo(g: GrupoOdt): TonoOdt {
+  return (ESTADOS_VISIBLES.find((x) => x.clave === g) ?? ESTADOS_VISIBLES[0]).tono;
+}
+
+/** El tono del tema de un estado. Un estado que no conocemos se lee como abierta (ámbar: pide mirarlo). */
+export function tonoOdt(estado: string | null | undefined): TonoOdt {
+  const g = grupoOdt(estado);
+  return tonoDeGrupo(g === 'otro' ? 'abierta' : g);
+}
+
+type ConEstado = { estado?: string | null };
+
+export const estaAbierta = (o: ConEstado | null | undefined): boolean => grupoOdt(o?.estado) === 'abierta';
+export const estaEnRevision = (o: ConEstado | null | undefined): boolean => grupoOdt(o?.estado) === 'revision';
+export const estaResuelta = (o: ConEstado | null | undefined): boolean => grupoOdt(o?.estado) === 'resuelta';
+
+/** ¿Sigue sin resolverse (abierta o en revisión)? Una de estado desconocido no cuenta. */
+export const estaSinResolver = (o: ConEstado | null | undefined): boolean => {
+  const g = grupoOdt(o?.estado);
+  return g === 'abierta' || g === 'revision';
+};
+
+export interface OpcionesContarOdt<T> {
+  /** Órdenes que NO deben contarse (por ejemplo, las del sistema). Sin esto cuentan todas. */
+  excluir?: (o: T) => boolean;
+}
+
+/** Cuántas órdenes hay en cada grupo. `sinResolver` = abiertas + en revisión (lo que aún espera algo). */
+export function contarOdt<T extends ConEstado>(
+  odts: readonly T[] | null | undefined,
+  opciones: OpcionesContarOdt<T> = {},
+): { abierta: number; revision: number; resuelta: number; sinResolver: number } {
+  const cuenta = { abierta: 0, revision: 0, resuelta: 0 };
+  for (const o of odts ?? []) {
+    if (opciones.excluir?.(o)) continue;
+    const g = grupoOdt(o?.estado);
+    if (g !== 'otro') cuenta[g] += 1;
+  }
+  return { ...cuenta, sinResolver: cuenta.abierta + cuenta.revision };
+}
