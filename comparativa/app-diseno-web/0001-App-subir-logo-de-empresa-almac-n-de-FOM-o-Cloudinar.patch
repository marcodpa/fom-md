--- /dev/null
+++ b/src/lib/responsable-empresa.ts
@@ -0,0 +1,69 @@
+/**
+ * RESPONSABLE DE LA EMPRESA + MENSAJES EN LLANO (alta y logo de una empresa).
+ *
+ * Es lo mismo que hace la web en `src/panel/datos/responsableEmpresa.js`, con los
+ * mismos textos: al crear una empresa se pide su responsable, que queda creado
+ * como usuario SUPERVISOR de la empresa, con una clave temporal que se muestra
+ * una sola vez. Lógica pura, sin pantalla ni red.
+ */
+
+/** El teléfono como lo acepta FOM: «+» y de 7 a 15 dígitos, sin espacios, guiones ni paréntesis. */
+export function normalizarTelefono(telefono: string | null | undefined): string {
+  return String(telefono ?? '').replace(/[\s\-().]/g, '');
+}
+
+const CORREO = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+/**
+ * Revisa lo que el formulario pide del responsable. Devuelve el aviso en español
+ * del primer problema, o `null` si está todo bien. Nombre, apellido y correo son
+ * obligatorios: sin ellos no se puede crear su usuario.
+ */
+export function problemaDelResponsable(datos: { contacto?: string; email?: string }): string | null {
+  const nombre = String(datos.contacto ?? '').trim().replace(/\s+/g, ' ');
+  if (nombre.length < 2) return 'Escribe el nombre y el apellido del responsable.';
+  if (nombre.split(' ').length < 2) return 'Escribe también el apellido del responsable.';
+  if (nombre.length > 120) return 'El nombre del responsable es demasiado largo.';
+  const email = String(datos.email ?? '').trim();
+  if (!email) return 'Escribe el correo del responsable: con él entrará a FOM.';
+  if (!CORREO.test(email)) return 'Escribe un correo válido para el responsable, por ejemplo nombre@empresa.com.';
+  return null;
+}
+
+// --- Errores en llano ---------------------------------------------------------
+const ERRORES: [RegExp, string][] = [
+  [
+    /object_storage_unavailable|storage[_ ]unavailable/i,
+    'Por ahora el servidor no puede guardar archivos. No es un fallo tuyo: inténtalo más tarde o avisa al equipo técnico.',
+  ],
+  [
+    // Incluye el texto que la app ya traduce del 409 («Esa persona ya pertenece a esta empresa.»).
+    /already has active company access|already belongs to this company|ya pertenece a esta empresa/i,
+    'Ese correo ya tiene acceso a una empresa. Usa otro correo para el responsable.',
+  ],
+  [
+    /code already exists|company with that code/i,
+    'Ya existe una empresa con un nombre parecido. Cambia un poco el nombre.',
+  ],
+  [/phone must be/i, 'El teléfono debe empezar por + y el código del país, por ejemplo +584141234567.'],
+  [/rif must look like/i, 'El RIF debe verse así: J-12345678-9.'],
+  [/email must be an email|must be an email/i, 'El correo no es válido.'],
+];
+
+/**
+ * El texto de un error listo para mostrar. Nunca deja pasar un código crudo del
+ * servidor (`object_storage_unavailable`…): lo cambia por una frase en español.
+ */
+export function textoDeError(
+  error: unknown,
+  porDefecto = 'No se pudo completar la operación. Inténtalo de nuevo.',
+): string {
+  const e = error as { message?: unknown; code?: unknown } | string | null | undefined;
+  const crudo = typeof e === 'string' ? e : typeof e?.message === 'string' ? e.message : '';
+  const codigo = typeof e === 'object' && e && typeof e.code === 'string' ? e.code : '';
+  const conocido = ERRORES.find(([patron]) => patron.test(`${crudo} ${codigo}`));
+  if (conocido) return conocido[1];
+  // Un código suelto en minúsculas con guion bajo (`algo_que_fallo`) no es para una persona.
+  if (/^[a-z0-9]+(_[a-z0-9]+)+$/.test(crudo.trim())) return porDefecto;
+  return crudo.trim() || porDefecto;
+}
