+/**
+ * Lo que pasó HOY, armado con lo que el servidor sí sabe: inspecciones
+ * enviadas, órdenes abiertas, avisos y unidades que dejaron de reportar. Lo
+ * más nuevo arriba y solo los doce últimos, como la web: el detalle vive en
+ * cada módulo.
+ */
+function eventosDeHoy(
+  { unidades, odts, alertas, inspecciones }: DatosEventos & { unidades: Unidad[] },
+  ahora: number,
+  irA: (pathname: string, params?: Record<string, string>) => void,
+  empresaId: string,
+): EventoHoy[] {
+  const hoy = new Date(ahora).toDateString();
+  const esDeHoy = (iso: string | null | undefined): iso is string => !!iso && new Date(iso).toDateString() === hoy;
+  const porId = new Map(unidades.map((x) => [x.u.vehicle.id, x]));
+  const lista: EventoHoy[] = [];
+
+  for (const i of inspecciones) {
+    if (!esDeHoy(i.enviadaEn)) continue;
+    const vehiculo = identidadDeUnidad({ numero: i.unidad, placa: i.placa }) || '—';
+    lista.push({
+      id: `insp-${i.id}`,
+      en: i.enviadaEn,
+      tono: i.resultado === 'aprobada' ? 'ok' : 'aviso',
+      texto: `${vehiculo} · inspección de hoy hecha por ${i.conductor}`,
+      detalle: RESULTADO[i.resultado] ?? i.resultado,
+      onPress: () => irA('/inspecciones', { companyId: empresaId }),
+    });
+  }
+  for (const o of odts) {
+    if (!esDeHoy(o.creadaEn)) continue;
+    const x = porId.get(o.vehicleId);
+    lista.push({
+      id: `odt-${o.id}`,
+      en: o.creadaEn,
+      tono: 'aviso',
+      texto: `${x ? x.nombre : o.vehicleLabel || '—'} · se abrió una orden de trabajo`,
+      detalle: o.descripcion,
+      onPress: () => irA('/panel/mantenimiento'),
+    });
+  }
+  for (const n of alertas) {
+    if (!esDeHoy(n.creadaEn)) continue;
+    lista.push({
+      id: `aviso-${n.id}`,
+      en: n.creadaEn,
+      tono: n.leida ? 'gris' : 'azul',
+      texto: n.titulo,
+      detalle: n.detalle,
+      onPress: () => irA('/notificaciones', { companyId: empresaId }),
+    });
+  }
+  for (const x of unidades) {
+    if (!esDeHoy(x.reporte) || x.conSenal) continue;
+    lista.push({
+      id: `senal-${x.u.vehicle.id}`,
+      en: x.reporte,
+      tono: 'malo',
+      texto: `${x.nombre} dejó de reportar`,
+      detalle: textoSinSenal(x.reporte, ahora),
+      onPress: () => irA('/unidad', { vehicleId: x.u.vehicle.id, companyId: empresaId }),
+    });
+  }
+  return masNuevoPrimero(lista, (e) => e.en).slice(0, 12);
+}
