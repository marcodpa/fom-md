+/**
+ * Regla de errores: en `src/services` y `src/app` no se traga un fallo.
+ *
+ * Un `.catch(() => [])`, `.catch(() => null)`, `.catch(() => undefined)` o un
+ * `catch {}` vacío convierte «no se pudo leer» en «no hay nada»: la pantalla
+ * enseña ceros, listas vacías o "sin papeles" cuando en realidad falló la
+ * lectura. Para eso está `leerConAviso` (src/services/leerConAviso.ts), que
+ * devuelve el valor vacío JUNTO a `fallo: true`, o dejar que el error suba.
+ *
+ * Las excepciones que ya existían y son legítimas van en EXCEPCIONES, por
+ * archivo, con su cantidad y su motivo. Un caso NUEVO (o una cantidad mayor)
+ * falla la prueba; si desaparece alguno, baja la cantidad aquí.
+ * No apagues esta prueba: arregla el sitio o justifica la excepción.
+ */
+import assert from 'node:assert/strict';
+import { readdirSync, readFileSync, statSync } from 'node:fs';
+import { join, relative, sep } from 'node:path';
+import { test } from 'node:test';
+import { fileURLToPath } from 'node:url';
+
+const RAIZ = join(fileURLToPath(new URL('.', import.meta.url)), '..');
+const CARPETAS = ['src/services', 'src/app'];
+
+/** archivo (con /) → { cantidad, motivo } */
+const EXCEPCIONES = {
+  // ── Servicios ──
+  'src/services/accountService.ts': { cantidad: 1, motivo: 'Saber si el perfil está completo es una pista para decidir a dónde ir; si falla se sigue al flujo normal.' },
+  'src/services/asignacionService.ts': { cantidad: 2, motivo: 'Las asignaciones solo ponen el nombre del titular; sin ellas la unidad sale sin titular, no sin datos.' },
+  'src/services/auditoriaService.ts': { cantidad: 1, motivo: 'Los nombres de las empresas son adorno de cada evento de auditoría.' },
+  'src/services/authService.ts': { cantidad: 1, motivo: 'Cerrar sesión en el servidor es de mejor esfuerzo: la sesión local se borra igual.' },
+  'src/services/avisosGpsService.ts': { cantidad: 3, motivo: 'Almacén local de avisos (leer/guardar sin almacenamiento solo pierde el recuerdo) y cola secuencial: el fallo de una tarea no debe romper la siguiente.' },
+  'src/services/brandService.ts': { cantidad: 1, motivo: 'El logo/color de la empresa es adorno: sin él se usa la marca por defecto.' },
+  'src/services/companyService.ts': { cantidad: 3, motivo: 'empresasDb() devuelve null a propósito (getTipoEmpresa cae al tipo del mock), el directorio solo pone el nombre del titular y los gastos de combustible solo afinan las recargas del reporte de usuarios.' },
+  'src/services/costService.ts': { cantidad: 1, motivo: 'gastosDeFom devuelve null (no [] ) cuando no se pudo leer; historicoDe lo marca como costoIncompleto.' },
+  'src/services/emergencyService.ts': { cantidad: 2, motivo: 'Personas y unidades solo ponen nombres a la emergencia; la emergencia sale igual.' },
+  'src/services/fleetService.ts': { cantidad: 3, motivo: 'Métrica/posición ausente se muestra como «sin dato» (null), que es lo que significa; no se inventa un valor.' },
+  'src/services/fomDirectorio.ts': { cantidad: 4, motivo: 'Nombres de empresa y datos de apoyo del directorio: sin ellos la persona sale igual.' },
+  'src/services/fomDocumentos.ts': { cantidad: 1, motivo: 'Documentos de empresa de un ente que FOM aún no publica: vacío hasta que exista la ruta.' },
+  'src/services/fomLogos.ts': { cantidad: 1, motivo: 'El logo es adorno: sin él se usa el de FOM.' },
+  'src/services/fomMantenimiento.ts': { cantidad: 4, motivo: 'Lecturas de apoyo (rutas por ente aún no publicadas y lecturas por unidad); el caller usa null como «no se pudo leer».' },
+  'src/services/fomMetricasConductor.ts': { cantidad: 1, motivo: 'null = sin métrica; el caller muestra «sin dato».' },
+  'src/services/fomMetricasUnidad.ts': { cantidad: 1, motivo: 'null = sin métrica; el caller muestra «sin dato».' },
+  'src/services/fomOrdenes.ts': { cantidad: 1, motivo: 'La orden ligada a una inspección es opcional: si no se lee, la inspección se entrega igual.' },
+  'src/services/fomPagos.ts': { cantidad: 1, motivo: 'Los pagos de un ente son una cifra de apoyo de la lista de cobros.' },
+  'src/services/fomSesion.ts': { cantidad: 5, motivo: 'Entrada/salida de sesión: limpiar el almacén y recoger entes son de mejor esfuerzo; el login no puede quedar a medias por eso.' },
+  'src/services/fomVehiculos.ts': { cantidad: 3, motivo: 'Lecturas de refresco de la flota viva: se conserva lo último conocido (desactualizada) y las asignaciones solo ponen el titular.' },
+  'src/services/formatoPredefService.ts': { cantidad: 1, motivo: 'Las asignaciones solo ponen el nombre del titular en el informe.' },
+  'src/services/gpsService.ts': { cantidad: 1, motivo: 'El equipo GPS solo lo ve el supervisor; sin él la ficha sale sin equipo.' },
+  'src/services/inspeccionService.ts': { cantidad: 5, motivo: 'Detalle/órdenes ligadas a una inspección ya enviada, recuerdo local y formatos: de apoyo; la inspección no se pierde.' },
+  'src/services/maintenanceService.ts': { cantidad: 1, motivo: 'Las posiciones solo afinan los km de la alerta; null = sin posición.' },
+  'src/services/notiConductorService.ts': { cantidad: 3, motivo: 'Estado leído/descartado en el teléfono (sin almacenamiento dura la sesión) y precalentar la caché de acciones (void).' },
+  'src/services/reporteVehiculos.ts': { cantidad: 2, motivo: 'PENDIENTE: la ficha por unidad sale sin historial si falla la lectura de ODT o de costos; debería marcarse como incompleta.' },
+  'src/services/driverService.ts': { cantidad: 1, motivo: 'Alertas de FOM: las calculadas (papeles por vencer) se entregan igual; PENDIENTE decir que las de FOM no se leyeron.' },
+  'src/services/fomEntes.ts': { cantidad: 2, motivo: 'Lista de apoyo de entes y asignación posterior de compañía desde la ficha: no deben tumbar el alta.' },
+  // ── Pantallas ──
+  'src/app/(driver)/index.tsx': { cantidad: 3, motivo: 'Inspección de hoy y equipo GPS son tarjetas de apoyo de la pantalla de inicio; null = no se pudo leer y la tarjeta no se pinta.' },
+  'src/app/(driver)/inspeccion.tsx': { cantidad: 1, motivo: 'Releer las planillas de hoy tras enviar: si falla se queda lo que ya había.' },
+  'src/app/(driver)/mantenimiento.tsx': { cantidad: 1, motivo: 'null = no se pudo leer; la pantalla lo trata como estado de error propio.' },
+  'src/app/admin/usuarios.tsx': { cantidad: 1, motivo: 'PENDIENTE: usuarios del sistema; debería mostrar «no se pudo leer».' },
+  'src/app/crear-odt.tsx': { cantidad: 1, motivo: 'La telemetría solo rellena la ubicación sugerida de la ODT.' },
+  'src/app/emergencia.tsx': { cantidad: 6, motivo: 'Geocodificación, lecturas de apoyo, ubicación del teléfono y avisos de la pantalla de emergencia: no deben retrasar ni romper el SOS.' },
+  'src/app/inspecciones.tsx': { cantidad: 1, motivo: 'Detalle de inspecciones graves para el resumen del día; las que no se lean se omiten del resumen.' },
+  'src/app/orden.tsx': { cantidad: 2, motivo: 'Taller/ejecución de la ODT: lecturas de apoyo; null oculta esa sección.' },
+  'src/app/panel/mantenimiento.tsx': { cantidad: 1, motivo: 'El resumen de FOM es una cifra de apoyo; null oculta el recuadro.' },
+  'src/app/gps-nuevo.tsx': { cantidad: 1, motivo: 'Sin bandeja (red o permiso) no hay prueba de señal; la pantalla sigue con el paso manual.' },
+  'src/app/notificaciones.tsx': { cantidad: 1, motivo: 'Eliminar un aviso: si falla, el refresco lo devuelve a su sitio (la lista es la verdad).' },
+  'src/app/sos.tsx': { cantidad: 1, motivo: 'Se prueba la siguiente fuente de la emergencia si la anterior no existe.' },
+};
+
+const PATRONES = [
+  /\.catch\(\s*\(\s*\)\s*=>\s*\[\s*\]/gu,
+  /\.catch\(\s*\(\s*\)\s*=>\s*null\b/gu,
+  /\.catch\(\s*\(\s*\)\s*=>\s*undefined\b/gu,
+  // catch {} / catch (e) {} vacíos, aunque solo lleven comentarios.
+  /\bcatch\s*(?:\(\s*\w*\s*\)\s*)?\{\s*\}/gu,
+];
+
+function archivos(dir) {
+  const salida = [];
+  for (const nombre of readdirSync(dir)) {
+    const ruta = join(dir, nombre);
+    if (statSync(ruta).isDirectory()) salida.push(...archivos(ruta));
+    else if (/\.(ts|tsx)$/u.test(nombre)) salida.push(ruta);
+  }
+  return salida;
+}
+
+/** Quita los comentarios para que un catch con solo un comentario dentro cuente como vacío. */
+function sinComentarios(texto) {
+  return texto.replace(/\/\*[\s\S]*?\*\//gu, ' ').replace(/(^|[^:'"`])\/\/.*$/gmu, '$1');
+}
+
+function contar() {
+  const cuenta = new Map();
+  for (const carpeta of CARPETAS) {
+    for (const ruta of archivos(join(RAIZ, carpeta))) {
+      const texto = sinComentarios(readFileSync(ruta, 'utf8'));
+      let n = 0;
+      for (const p of PATRONES) n += (texto.match(p) ?? []).length;
+      if (n > 0) cuenta.set(relative(RAIZ, ruta).split(sep).join('/'), n);
+    }
+  }
+  return cuenta;
+}
+
+test('no aparece un fallo tragado nuevo en src/services ni src/app', () => {
+  const cuenta = contar();
+  const nuevos = [];
+  for (const [archivo, n] of cuenta) {
+    const permitido = EXCEPCIONES[archivo]?.cantidad ?? 0;
+    if (n > permitido) {
+      nuevos.push(`${archivo}: ${n} (permitidos ${permitido}). Usa leerConAviso o deja que el error suba.`);
+    }
+  }
+  assert.deepEqual(nuevos, [], `\nFallos tragados nuevos:\n${nuevos.join('\n')}`);
+});
+
+test('la lista de excepciones no tiene cantidades de más', () => {
+  const cuenta = contar();
+  const sobrantes = [];
+  for (const [archivo, { cantidad }] of Object.entries(EXCEPCIONES)) {
+    const real = cuenta.get(archivo) ?? 0;
+    if (real < cantidad) sobrantes.push(`${archivo}: hay ${real}, la lista dice ${cantidad}. Bájala.`);
+  }
+  assert.deepEqual(sobrantes, [], `\nExcepciones que ya no existen:\n${sobrantes.join('\n')}`);
+});
+
+test('los fallos que se arreglaron no volvieron', () => {
+  const vigilados = [
+    'src/services/notificationService.ts',
+    'src/app/mis-notificaciones.tsx',
+    'src/app/admin/flota.tsx',
+    'src/app/admin/index.tsx',
+    'src/app/editar-vehiculo.tsx',
+    'src/app/editar-usuario.tsx',
+  ];
+  const cuenta = contar();
+  for (const archivo of vigilados) assert.equal(cuenta.get(archivo) ?? 0, 0, `${archivo} volvió a tragar un fallo`);
+});
