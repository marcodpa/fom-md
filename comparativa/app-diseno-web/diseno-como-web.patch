@@ -0,0 +1,308 @@
+import type { ReactNode } from 'react';
+import { StyleSheet, View, type LayoutChangeEvent } from 'react-native';
+import Svg, { Circle, Path } from 'react-native-svg';
+
+import { Card } from '@/components/card';
+import { OpcionRiel, RielOpciones } from '@/components/riel-opciones';
+import { PressableScale } from '@/components/pressable-scale';
+import { ThemedText } from '@/components/themed-text';
+import { tinte } from '@/lib/color';
+import { useTheme, type ColorTokens } from '@/theme';
+
+/*
+ * Piezas de la FICHA DE UNIDAD, como la del panel web adaptada al teléfono:
+ * las cuatro cifras en 2×2, la fila de partes que salta a cada sección y la
+ * tarjeta de cada sección con su nombre en frase normal.
+ */
+
+/** Las mismas ocho partes que las pestañas de la web, en el mismo orden. */
+export const PARTES_FICHA = [
+  { id: 'resumen', label: 'Resumen' },
+  { id: 'ficha', label: 'Ficha de la unidad' },
+  { id: 'telemetria', label: 'Telemetría' },
+  { id: 'usuarios', label: 'Usuarios' },
+  { id: 'inspecciones', label: 'Inspecciones' },
+  { id: 'mantenimiento', label: 'Mantenimiento' },
+  { id: 'documentos', label: 'Documentos' },
+  { id: 'costos', label: 'Costos' },
+] as const;
+
+export type ParteFicha = (typeof PARTES_FICHA)[number]['id'];
+
+// ───────────────────────────── Íconos ─────────────────────────────────────
+// Los cuatro de las cifras de la web (camión, escudo, llave, velocímetro). La
+// barra de abajo no tiene escudo ni llave, y no se toca para una sola pantalla.
+
+export type IconoCifra = 'camion' | 'escudo' | 'llave' | 'velocimetro';
+
+function IconoCifraSvg({ nombre, color, size = 16 }: { nombre: IconoCifra; color: string; size?: number }) {
+  const trazo = {
+    stroke: color,
+    strokeWidth: 1.8,
+    strokeLinecap: 'round' as const,
+    strokeLinejoin: 'round' as const,
+    fill: 'none',
+  };
+  return (
+    <Svg width={size} height={size} viewBox="0 0 24 24">
+      {nombre === 'camion' ? (
+        <>
+          <Path d="M3 6h11v10H3z" {...trazo} />
+          <Path d="M14 9h4l3 3v4h-7" {...trazo} />
+          <Circle cx={7} cy={17.5} r={1.8} {...trazo} />
+          <Circle cx={17} cy={17.5} r={1.8} {...trazo} />
+        </>
+      ) : null}
+      {nombre === 'escudo' ? (
+        <>
+          <Path d="M12 3 5 6v5.5c0 4.3 3 7.8 7 9.5 4-1.7 7-5.2 7-9.5V6z" {...trazo} />
+          <Path d="m9 12 2.2 2.2L15.5 10" {...trazo} />
+        </>
+      ) : null}
+      {nombre === 'llave' ? (
+        <Path d="M15 4a5 5 0 0 0-4.6 6.9L4 17.3V20h2.7l6.4-6.4A5 5 0 0 0 20 9l-3 1-2-2 1-3z" {...trazo} />
+      ) : null}
+      {nombre === 'velocimetro' ? (
+        <>
+          <Path d="M4 16a8 8 0 1 1 16 0" {...trazo} />
+          <Path d="m12 16 4-5" {...trazo} />
+        </>
+      ) : null}
+    </Svg>
+  );
+}
+
+// ───────────────────────────── Cifras 2×2 ─────────────────────────────────
+
+export type CifraFicha = {
+  label: string;
+  valor: string;
+  nota: string;
+  icono: IconoCifra;
+  /** Color del ícono: el mismo tono que le da la web a la cifra. */
+  tono: keyof ColorTokens;
+  /** El número en gris: hay cifra pero no dice nada todavía (sin km, sin nota). */
+  apagada?: boolean;
+};
+
+/** Las cuatro cifras de la unidad, en dos filas de dos, como la web en el teléfono. */
+export function CifrasFicha({ items }: { items: CifraFicha[] }) {
+  const { colors, spacing } = useTheme();
+  return (
+    <View style={[styles.rejilla, { gap: spacing.sm + 2 }]} accessibilityLabel="Cifras de la unidad">
+      {items.map((c) => (
+        <Card
+          key={c.label}
+          style={styles.cifra}
+          accessible
+          accessibilityLabel={`${c.label}: ${c.valor}. ${c.nota}`}>
+          <View style={[styles.cifraCabeza, { gap: 6 }]}>
+            <IconoCifraSvg nombre={c.icono} color={colors[c.tono]} />
+            <ThemedText style={styles.cifraLabel} color="textSecondary" numberOfLines={1}>
+              {c.label}
+            </ThemedText>
+          </View>
+          <ThemedText
+            style={styles.cifraValor}
+            color={c.apagada ? 'textMuted' : 'text'}
+            tabular
+            numberOfLines={1}
+            adjustsFontSizeToFit>
+            {c.valor}
+          </ThemedText>
+          <ThemedText style={styles.cifraNota} color="textMuted" numberOfLines={1}>
+            {c.nota}
+          </ThemedText>
+        </Card>
+      ))}
+    </View>
+  );
+}
+
+// ───────────────────────────── Partes ─────────────────────────────────────
+
+/**
+ * La fila de partes: las pestañas de la web hechas chips que se desplazan.
+ * Aquí no cambian de pantalla: llevan a su sección dentro de la ficha.
+ */
+export function PartesFicha({
+  activa,
+  onElegir,
+}: {
+  activa: ParteFicha;
+  onElegir: (parte: ParteFicha) => void;
+}) {
+  const { colors, radii, spacing, borderWidths } = useTheme();
+  return (
+    // Va fija arriba al bajar por la ficha: lleva el fondo de la pantalla para
+    // que lo que pasa por debajo no se lea a través, y llega de borde a borde
+    // para que se note que hay más partes a la derecha.
+    <View style={{ marginHorizontal: -spacing.lg, paddingVertical: spacing.sm, backgroundColor: colors.background }}>
+    <RielOpciones
+      seleccion={activa}
+      contentContainerStyle={{ gap: spacing.sm, paddingHorizontal: spacing.lg }}>
+      {PARTES_FICHA.map((p) => {
+        const on = p.id === activa;
+        return (
+          <OpcionRiel key={p.id} id={p.id}>
+            <PressableScale
+              onPress={() => onElegir(p.id)}
+              accessibilityRole="button"
+              accessibilityState={{ selected: on }}
+              accessibilityLabel={`Ir a ${p.label}`}>
+              <View
+                style={[
+                  styles.parte,
+                  {
+                    borderRadius: radii.sm,
+                    borderWidth: borderWidths.thin,
+                    backgroundColor: on ? tinte(colors.primary, 0.18) : colors.surfaceSunken,
+                    borderColor: on ? tinte(colors.primary, 0.5) : colors.border,
+                  },
+                ]}>
+                <ThemedText
+                  style={[styles.parteTexto, { fontWeight: on ? '600' : '500' }]}
+                  color={on ? 'primary' : 'textSecondary'}>
+                  {p.label}
+                </ThemedText>
+              </View>
+            </PressableScale>
+          </OpcionRiel>
+        );
+      })}
+    </RielOpciones>
+    </View>
+  );
+}
+
+// ───────────────────────────── Sección ────────────────────────────────────
+
+/**
+ * Una sección de la ficha: tarjeta con su nombre en frase normal (el mismo de
+ * la pestaña de la web) y, a la derecha, una nota o un enlace.
+ *
+ * `sinRelleno` es para las secciones hechas de filas tocables (Usuarios,
+ * Mantenimiento): las filas ponen su propio aire y su separador llega de borde
+ * a borde.
+ */
+export function SeccionFicha({
+  titulo,
+  derecha,
+  sinRelleno = false,
+  onLayout,
+  children,
+}: {
+  titulo: string;
+  derecha?: ReactNode;
+  sinRelleno?: boolean;
+  onLayout?: (e: LayoutChangeEvent) => void;
+  children?: ReactNode;
+}) {
+  const { spacing } = useTheme();
+  return (
+    <View onLayout={onLayout}>
+      <Card style={styles.seccion}>
+        <View
+          style={[
+            styles.seccionCabeza,
+            { gap: spacing.sm, paddingHorizontal: spacing.lg, paddingTop: spacing.md, paddingBottom: spacing.sm },
+          ]}>
+          <ThemedText style={styles.seccionTitulo} accessibilityRole="header" numberOfLines={1}>
+            {titulo}
+          </ThemedText>
+          {typeof derecha === 'string' ? (
+            <ThemedText style={styles.nota} color="textMuted" numberOfLines={1}>
+              {derecha}
+            </ThemedText>
+          ) : (
+            derecha
+          )}
+        </View>
+        {children ? (
+          <View style={sinRelleno ? null : { paddingHorizontal: spacing.lg, paddingBottom: spacing.md }}>
+            {children}
+          </View>
+        ) : null}
+      </Card>
+    </View>
+  );
+}
+
+/** Enlace corto a la derecha de una sección («Ver costos →»). */
+export function EnlaceSeccion({ label, onPress }: { label: string; onPress: () => void }) {
+  return (
+    <PressableScale onPress={onPress} accessibilityRole="link" hitSlop={8}>
+      <ThemedText style={styles.enlace} color="primary">
+        {`${label} →`}
+      </ThemedText>
+    </PressableScale>
+  );
+}
+
+/** Pares dato–valor, en dos columnas por defecto, con raya arriba (Ficha de la unidad). */
+export function DatosFicha({
+  datos,
+  columnas = 2,
+}: {
+  datos: { k: string; v: string }[];
+  /** Una sola cuando los nombres son largos («Aceleraciones bruscas»). */
+  columnas?: 1 | 2;
+}) {
+  const { colors, borderWidths, spacing } = useTheme();
+  return (
+    <View style={[styles.datos, { columnGap: spacing.lg }]}>
+      {datos.map((d) => (
+        <View
+          key={d.k}
+          style={[
+            styles.dato,
+            columnas === 1 && styles.datoUno,
+            { gap: spacing.sm, borderTopWidth: borderWidths.hairline, borderTopColor: colors.border },
+          ]}>
+          <ThemedText style={styles.datoK} color="textMuted" numberOfLines={1}>
+            {d.k}
+          </ThemedText>
+          <ThemedText style={styles.datoV} numberOfLines={1}>
+            {d.v}
+          </ThemedText>
+        </View>
+      ))}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  rejilla: { flexDirection: 'row', flexWrap: 'wrap' },
+  // Dos por fila: la mitad menos la mitad del hueco.
+  cifra: {
+    flexBasis: '47%',
+    flexGrow: 1,
+    paddingVertical: 10,
+    paddingHorizontal: 12,
+    gap: 2,
+  },
+  cifraCabeza: { flexDirection: 'row', alignItems: 'center', height: 16 },
+  cifraLabel: { fontSize: 12, lineHeight: 16 },
+  cifraValor: { fontSize: 26, lineHeight: 30, fontWeight: '700', letterSpacing: -0.5, marginTop: 2 },
+  cifraNota: { fontSize: 11, lineHeight: 16 },
+  parte: { height: 36, paddingHorizontal: 14, justifyContent: 'center' },
+  parteTexto: { fontSize: 13, lineHeight: 18 },
+  // El borde y la sombra los pone la tarjeta del tema, igual en toda la app.
+  seccion: { padding: 0, overflow: 'hidden' },
+  seccionCabeza: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' },
+  seccionTitulo: { fontSize: 17, lineHeight: 22, fontWeight: '600', flexShrink: 1 },
+  nota: { fontSize: 12, lineHeight: 16 },
+  enlace: { fontSize: 13, lineHeight: 18, fontWeight: '600' },
+  datos: { flexDirection: 'row', flexWrap: 'wrap' },
+  dato: {
+    flexBasis: '45%',
+    flexGrow: 1,
+    height: 34,
+    flexDirection: 'row',
+    alignItems: 'center',
+    justifyContent: 'space-between',
+  },
+  datoUno: { flexBasis: '100%' },
+  datoK: { fontSize: 13, lineHeight: 18 },
+  datoV: { fontSize: 14, lineHeight: 18, fontWeight: '600', flexShrink: 1, textAlign: 'right' },
+});
