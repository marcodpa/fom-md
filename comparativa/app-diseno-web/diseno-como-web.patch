+ * y la de la portada del PDF salieran de dos sitios, acabarían diciendo cosas
+ * distintas sin que nadie lo notara.
+ *
+ * El período anterior se pide con los MISMOS servicios que el actual, en
+ * paralelo y una sola vez por cambio de filtros. Si esa segunda lectura falla,
+ * las cifras salen igual, sin comparación: no se cae la pantalla por el dato
+ * de apoyo.
+ */
+
+
+import type { TabIconName } from '@/components/tab-icon';
+import { exportarPdf, guardarPdf, type FormatoPdf, type PortadaPdf } from '@/lib/pdf';
+import { periodoDe, type Preset } from '@/lib/periodo';
+import { rangoDeIndice } from '@/lib/indice';
+import { formatoCostos, formatoEstadistico, formatoUsuarios, formatoVehiculos } from '@/lib/reportePdf';
+import { comparar } from '@/lib/informe-numeros';
+import { etiquetaCortaDeUnidad } from '@/lib/vehiculos';
+import {
+  getOrdenesDeTrabajo,
+  getReporte,
+  getReporteCostos,
+  getReporteDeVehiculos,
+  getReporteFormatoPredefinida,
+  getReporteUsuarios,
+} from '@/services';
+import type {
+  FleetReport,
+  FormatoPredefFilaAlertas,
+  FormatoPredefReporte,
+  ReportPeriod,
