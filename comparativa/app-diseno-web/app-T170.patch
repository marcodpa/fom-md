index 0000000..9c82461
--- /dev/null
+++ b/src/components/mi-unidad-hoja.tsx
@@ -0,0 +1,241 @@
+import type { ReactNode } from 'react';
+import { useEffect, useState } from 'react';
+import { Pressable, StyleSheet, View, type LayoutChangeEvent } from 'react-native';
+import { Gesture, GestureDetector } from 'react-native-gesture-handler';
+import Animated, {
+  interpolate,
+  runOnJS,
+  useAnimatedReaction,
+  useAnimatedRef,
+  useAnimatedScrollHandler,
+  useAnimatedStyle,
+  useSharedValue,
+  withSpring,
+} from 'react-native-reanimated';
+
+import { ALTO_FRANJA, SOLAPE } from '@/components/mi-unidad-piezas';
+import { useReducedMotion, useTheme } from '@/theme';
+
+/** Lo que se ve de la hoja al entrar si aún no se midió el Resumen (franja + Resumen de la maqueta). */
+const VISIBLE_INICIAL = 446;
+/** Aire bajo el Resumen al entrar, antes de la barra de pestañas. */
+const AIRE_ABAJO = 12;
+/** Velocidad a partir de la cual el lanzamiento manda sobre la posición. */
+const VELOCIDAD_SNAP = 550;
+/** Lo que mide la franja compacta (miniatura de 44 + 10 arriba y abajo). */
+const ALTO_COMPACTA = 65;
+
+type Props = {
+  /** Dónde queda el borde de arriba de la hoja subida (bajo el encabezado y una tira de mapa). */
+  arriba: number;
+  /** Alto de la pantalla (sin la barra de pestañas). */
+  alto: number;
+  /** La franja oscura: identidad, velocidad y las cifras de hoy. Es el asa de la hoja. */
+  franja: ReactNode;
+  /** La foto sin fondo, montada entre la franja y la hoja. */
+  foto?: ReactNode;
+  /** Lo de arriba de la hoja: avisos y el Resumen. Su alto decide cuánto se ve al entrar. */
+  resumen: ReactNode;
+  /** Lo que aparece al subirla o desplazarla: telemetría, índice de manejo. */
+  resto?: ReactNode;
+  /** La franja que queda fija al desplazar. */
+  compacta: ReactNode;
+  /** El SOS: flota sobre el mapa, pegado al borde de la hoja, y se aparta al subirla. */
+  sos?: ReactNode;
+  /**
+   * Dónde queda el borde de arriba de la hoja quieta (px desde arriba de la
+   * pantalla): la pantalla ajusta el mapa para que la unidad quede a la vista.
+   */
+  onBorde?: (px: number) => void;
+};
+
+/**
+ * LA HOJA DE «MI UNIDAD» (T-170), con los tres estados de la maqueta:
+ *  - al entrar, a media altura: la franja con la foto y el Resumen entero;
+ *  - subida (arrastrándola o tocando la franja): aparece la telemetría;
+ *  - desplazada: la franja se encoge en una barra fija con la miniatura y
+ *    debajo siguen la telemetría y el índice de manejo.
+ *
+ * A media altura TODA la hoja se arrastra (no hay nada que desplazar); subida,
+ * el contenido se desplaza y el asa es la franja. Corre en el hilo de UI
+ * (gesture-handler + reanimated), como la lengüeta de siempre.
+ */
+export function HojaMiUnidad({ arriba, alto, franja, foto, resumen, resto, compacta, sos, onBorde }: Props) {
+  const { colors, spacing, shadows } = useTheme();
+  const reducido = useReducedMotion();
+
+  // Cuánto mide lo que se ve al entrar: la franja (menos lo que la pisa la hoja) y el Resumen.
+  const [altoResumen, setAltoResumen] = useState<number | null>(null);
+  const visible = altoResumen == null ? VISIBLE_INICIAL : ALTO_FRANJA - SOLAPE + 20 + altoResumen + AIRE_ABAJO;
+  /** Desplazamiento de la hoja a media altura (0 = subida). */
+  const media = Math.max(0, Math.round(alto - visible - arriba));
+
+  const y = useSharedValue(media);
+  const inicio = useSharedValue(media);
+  const desplazado = useSharedValue(0);
+  const mediaUI = useSharedValue(media);
+  const scrollRef = useAnimatedRef<Animated.ScrollView>();
+  const [subida, setSubida] = useState(false);
+  const [conCompacta, setConCompacta] = useState(false);
+
+  // El borde quieto, para el mapa: se avisa al decidir el destino, no al final del resorte.
+  const borde = arriba + (subida ? 0 : media);
+  useEffect(() => {
+    onBorde?.(borde);
+  }, [borde, onBorde]);
+
+  // Al bajarla se vuelve al principio: a media altura se ve el Resumen, no lo de abajo.
+  useEffect(() => {
+    if (!subida) scrollRef.current?.scrollTo({ y: 0, animated: !reducido });
+  }, [subida, scrollRef, reducido]);
+
+  function asentar(destino: number) {
+    'worklet';
+    const sube = destino === 0;
+    runOnJS(setSubida)(sube);
+    if (reducido) {
+      y.value = destino;
+      return;
+    }
+    y.value = withSpring(destino, { damping: 22, stiffness: 260, mass: 0.9, overshootClamping: true });
+  }
+
+  /** El arrastre: el dedo la mueve 1:1 y al soltar cae arriba o a media altura. */
+  const arrastre = () =>
+    Gesture.Pan()
+      .activeOffsetY([-8, 8])
+      .onBegin(() => {
+        inicio.value = y.value;
+      })
+      .onUpdate((e) => {
+        y.value = Math.max(0, Math.min(media, inicio.value + e.translationY));
+      })
+      .onEnd((e) => {
+        // Un lanzamiento rápido manda sobre la posición.
+        if (Math.abs(e.velocityY) > VELOCIDAD_SNAP) {
+          asentar(e.velocityY < 0 ? 0 : media);
+          return;
+        }
+        asentar(y.value < media / 2 ? 0 : media);
+      });
+
+  // A media altura, toda la hoja es el asa. Subida, solo la franja: lo demás se desplaza.
+  const arrastreHoja = arrastre().enabled(!subida && media > 0);
+  const arrastreFranja = arrastre().enabled(subida);
+  // Un toque en la franja también la sube o la baja: negarle el toque a algo tocable es una trampa.
+  const toque = Gesture.Tap().onEnd(() => {
+    asentar(y.value > media / 2 ? 0 : media);
+  });
+  const gestoFranja = Gesture.Exclusive(arrastreFranja, toque);
+
+  // Medido el Resumen (o girada la pantalla), la hoja quieta a media altura se
+  // recoloca. Solo si estaba quieta ahí: subida o en camino, no se la toca.
+  useEffect(() => {
+    mediaUI.value = media;
+  }, [media, mediaUI]);
+  useAnimatedReaction(
+    () => mediaUI.value,
+    (ahora, antes) => {
+      if (antes != null && ahora !== antes && Math.abs(y.value - antes) < 1) y.value = ahora;
+    },
+  );
+
+  const alDesplazar = useAnimatedScrollHandler((e) => {
+    desplazado.value = e.contentOffset.y;
+  });
+  // La compacta aparece cuando la franja grande ya se fue por arriba.
+  const umbral = ALTO_FRANJA - SOLAPE - ALTO_COMPACTA;
+  useAnimatedReaction(
+    () => desplazado.value > umbral,
+    (ahora, antes) => {
+      if (ahora !== antes) runOnJS(setConCompacta)(ahora);
+    },
+  );
+
+  const estiloHoja = useAnimatedStyle(() => ({ transform: [{ translateY: y.value }] }));
+  const estiloCompacta = useAnimatedStyle(() => ({
+    opacity: interpolate(desplazado.value, [umbral - 30, umbral + 10], [0, 1], 'clamp'),
+  }));
+  // El SOS va pegado al borde de la hoja y se apaga al subirla (la maqueta no lo deja sobre la franja).
+  const estiloSos = useAnimatedStyle(() => ({
+    transform: [{ translateY: y.value }],
+    opacity: media > 0 ? interpolate(y.value, [media * 0.55, media], [0, 1], 'clamp') : 1,
+  }));
+
+  const medirResumen = (e: LayoutChangeEvent) => {
+    const h = Math.round(e.nativeEvent.layout.height);
+    if (h > 0 && h !== altoResumen) setAltoResumen(h);
+  };
+
+  return (
+    <>
+      {sos ? (
+        <Animated.View pointerEvents={subida ? 'none' : 'box-none'} style={[styles.sos, { top: arriba - 68 }, estiloSos]}>
+          {sos}
+        </Animated.View>
+      ) : null}
+
+      <GestureDetector gesture={arrastreHoja}>
+        <Animated.View style={[styles.hoja, shadows.sheet, { top: arriba, height: alto - arriba }, estiloHoja]}>
+          <Animated.ScrollView
+            ref={scrollRef}
+            scrollEnabled={subida}
+            onScroll={alDesplazar}
+            scrollEventThrottle={16}
+            showsVerticalScrollIndicator={false}
+            bounces={false}
+            overScrollMode="never"
+            contentContainerStyle={{ paddingBottom: spacing.xl }}>
+            <GestureDetector gesture={gestoFranja}>
+              <View
+                accessible
+                accessibilityRole="adjustable"
+                accessibilityLabel="Detalle de tu unidad"
+                accessibilityHint={subida ? 'Arrastra o toca para bajarla' : 'Arrastra o toca para ver más'}>
+                {franja}
+              </View>
+            </GestureDetector>
+            <View style={[styles.cuerpo, { backgroundColor: colors.surface, marginTop: -SOLAPE }]}>
+              <View onLayout={medirResumen}>{resumen}</View>
+              {resto}
+            </View>
+            {/* La foto va al final para quedar ENCIMA de la hoja que pisa. */}
+            {foto}
+          </Animated.ScrollView>
+
+          {/* Desplazada: la franja encogida queda fija arriba. Tocarla vuelve al principio. */}
+          <Animated.View
+            pointerEvents={conCompacta ? 'auto' : 'none'}
+            style={[styles.compacta, estiloCompacta]}>
+            <Pressable
+              onPress={() => scrollRef.current?.scrollTo({ y: 0, animated: !reducido })}
+              accessibilityRole="button"
+              accessibilityLabel="Volver al resumen de tu unidad">
+              {compacta}
+            </Pressable>
+          </Animated.View>
+        </Animated.View>
+      </GestureDetector>
+    </>
+  );
+}
+
+const styles = StyleSheet.create({
+  hoja: {
+    position: 'absolute',
+    left: 0,
+    right: 0,
+    zIndex: 20,
+    borderTopLeftRadius: 28,
+    borderTopRightRadius: 28,
+    overflow: 'hidden',
+  },
+  cuerpo: {
+    borderTopLeftRadius: 28,
+    borderTopRightRadius: 28,
+    paddingTop: 20,
+    paddingHorizontal: 20,
+  },
+  compacta: { position: 'absolute', top: 0, left: 0, right: 0, zIndex: 6 },
+  sos: { position: 'absolute', right: 16, zIndex: 19 },
+});
