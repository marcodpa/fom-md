+  const t = r.alertasPorVehiculo.reduce(
+    (a, v) => ({ km: a.km + v.km, acel: a.acel + v.aceleraciones, fren: a.fren + v.frenadas, exc: a.exc + v.excesos }),
+    { km: 0, acel: 0, fren: 0, exc: 0 },
+  );
+  const km6 = r.distancias.reduce((a, d) => a + d.recorridoU6m, 0);
+  const vel = r.alertasPorVehiculo.flatMap((v) => (v.velocidadMax === null ? [] : [v.velocidadMax]));
+  const d100 = (x: number, km: number): string => {
+    const v = por100(x, km);
+    return v === null ? '—' : decimal(v);
+  };
+  const scoreFlota = por100(t.acel + t.fren + t.exc, t.km);
+  piezas.push(
+    tabla({
+      titulo: 'Distancias y alertas por unidad',
