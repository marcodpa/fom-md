+                />
+              ) : null}
+            </Card>
+
+            <Card style={{ gap: spacing.md + 2 }}>
+              <ThemedText variant="subtitle" style={styles.tituloTarjeta}>
+                Vencimientos de los próximos 6 meses
+              </ThemedText>
