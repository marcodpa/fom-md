+/**
+ * «LLEGADA»: cuánto tarda la unidad elegida en llegar a un destino (un punto
+ * del mapa u otra unidad) con el tráfico de ahora, a qué hora llega y por
+ * dónde. La misma cuenta y los mismos textos que el panel web
+ * (`herramientasMapbox.js` y `rutaConTrafico` en `mapboxApi.js`).
+ *
+ * La ruta se pide a Mapbox Directions con el perfil `driving-traffic` (el que
+ * sabe del tráfico de ahora) y se dibuja de UN color, azul FOM: el tráfico da
+ * el tiempo, no se pinta (pedido de Marco, 21 oct 2026).
+ */
+import { MAPBOX_TOKEN } from '@/lib/mapbox';
+
+export type PuntoLlegada = { lat: number; lng: number };
+
+export type RutaLlegada = {
+  /** Minutos con el tráfico de ahora (al menos 1). */
+  minutos: number;
+  /** Minutos en un día normal a esta hora; null si Mapbox no lo da. */
+  minutosNormales: number | null;
+  km: number;
+  /** El camino, [lng, lat]. */
+  trazo: [number, number][];
+};
+
+/** Azul FOM fijo: la ruta y el pin del destino. */
+export const AZUL_LLEGADA = '#3D9BF5';
+/** Borde de la ruta: blanco sobre el mapa claro, casi negro sobre el oscuro o el satélite. */
+export const bordeLlegada = (mapaClaro: boolean) => (mapaClaro ? '#FFFFFF' : '#08121C');
+
+/**
+ * La gota del destino (30 × 40, la punta abajo al centro): el mismo dibujo
+ * que la web. El SVG en texto lo usa el mapa web; el nativo dibuja lo mismo.
+ */
+export const PIN_DESTINO_D = 'M15 38.5S27 25.4 27 15.5a12 12 0 0 0-24 0C3 25.4 15 38.5 15 38.5Z';
+export const PIN_DESTINO_SVG = `<svg width="30" height="40" viewBox="0 0 30 40" aria-hidden="true"><path d="${PIN_DESTINO_D}" fill="${AZUL_LLEGADA}" stroke="#FFFFFF" stroke-width="2" stroke-linejoin="round"/><circle cx="15" cy="15.5" r="4.6" fill="#FFFFFF"/></svg>`;
+
+const BASE = 'https://api.mapbox.com/directions/v5/mapbox/driving-traffic';
+
+// Las últimas respuestas, por origen, destino y tramo de 2 minutos (como la
+// web): la flota se relee cada 20 s y no hace falta volver a preguntar lo mismo.
+const TOPE_CACHE = 20;
+const cache = new Map<string, Promise<RutaLlegada>>();
+
+const coord = (p: PuntoLlegada) => `${p.lng.toFixed(6)},${p.lat.toFixed(6)}`;
+
+/** Error con un texto ya en lenguaje llano para la tarjeta. */
+export class ErrorLlegada extends Error {}
+
+/**
+ * Pide la ruta a Mapbox. El token va solo en la URL de la petición: nunca en
+ * un log ni en un mensaje de error.
+ */
+export function pedirLlegada(origen: PuntoLlegada, destino: PuntoLlegada): Promise<RutaLlegada> {
+  if (!MAPBOX_TOKEN) return Promise.reject(new ErrorLlegada('La llegada no está disponible en este momento.'));
+  const clave = `${coord(origen)}>${coord(destino)}:${Math.floor(Date.now() / 120000)}`;
+  const guardada = cache.get(clave);
+  if (guardada) return guardada;
+  const p = (async (): Promise<RutaLlegada> => {
+    const url =
+      `${BASE}/${coord(origen)};${coord(destino)}` +
+      `?geometries=geojson&overview=full&annotations=duration&language=es&access_token=${encodeURIComponent(MAPBOX_TOKEN)}`;
+    let r: Response;
+    try {
+      r = await fetch(url);
+    } catch {
+      throw new ErrorLlegada('No pudimos calcular la llegada. Revisa la conexión y prueba otra vez.');
+    }
+    if (r.status === 401 || r.status === 403) throw new ErrorLlegada('La llegada no está disponible en este momento.');
+    const cuerpo = (await r.json().catch(() => null)) as {
+      code?: string;
+      routes?: { duration: number; duration_typical?: number; distance: number; geometry?: { coordinates?: [number, number][] } }[];
+    } | null;
+    const ruta = cuerpo?.routes?.[0];
+    if (!r.ok || cuerpo?.code !== 'Ok' || !ruta) {
+      // 422 / NoRoute / NoSegment: el punto no está cerca de ninguna carretera.
+      if (r.status === 422 || r.ok || /NoRoute|NoSegment/u.test(cuerpo?.code ?? '')) {
+        throw new ErrorLlegada('No encontramos un camino por carretera hasta ese punto. Prueba con otro destino.');
+      }
+      throw new ErrorLlegada('No pudimos calcular la llegada. Revisa la conexión y prueba otra vez.');
+    }
+    const trazo = (ruta.geometry?.coordinates ?? []).filter(
+      (c) => Array.isArray(c) && Number.isFinite(c[0]) && Number.isFinite(c[1]),
+    );
+    return {
+      minutos: Math.max(1, Math.round(ruta.duration / 60)),
+      minutosNormales:
+        typeof ruta.duration_typical === 'number' && ruta.duration_typical > 0
+          ? Math.max(1, Math.round(ruta.duration_typical / 60))
+          : null,
+      km: ruta.distance / 1000,
+      trazo,
+    };
+  })();
+  // Lo que falla no se recuerda: la próxima vez se vuelve a pedir.
+  const recordada = p.catch((e) => {
+    if (cache.get(clave) === recordada) cache.delete(clave);
+    throw e;
+  });
+  cache.set(clave, recordada);
+  while (cache.size > TOPE_CACHE) cache.delete(cache.keys().next().value as string);
+  return recordada;
+}
+
+/** El texto llano de un error (el detalle técnico no llega a la pantalla). */
+export function mensajeLlegada(e: unknown): string {
+  return e instanceof ErrorLlegada ? e.message : 'No pudimos calcular la llegada. Revisa la conexión y prueba otra vez.';
+}
+
+// ── Textos de la tarjeta (los mismos de la web) ─────────────────────────────
+
+/** «18 min», «1 h», «1 h 05 min». */
+export function tiempoLlegada(minutos: number): string {
+  const m = Math.max(0, Math.round(Number(minutos) || 0));
+  if (m < 60) return `${m} min`;
+  const h = Math.floor(m / 60);
+  const r = m % 60;
+  return r ? `${h} h ${String(r).padStart(2, '0')} min` : `${h} h`;
+}
+
+/** «12,4 km» con coma decimal; desde 10 km, sin decimales. A mano: el Intl del teléfono no siempre trae es-VE. */
+export function distanciaLlegada(km: number): string {
+  const n = Math.max(0, Number(km) || 0);
+  if (n < 10) return `${n.toFixed(1).replace('.', ',')} km`;
+  return `${String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/gu, '.')} km`;
+}
+
+/** «3:42 p. m.»: la hora en que llega si sale ahora (hora del teléfono). */
+export function horaLlegada(minutos: number, desde = Date.now()): string {
+  const d = new Date(desde + Math.max(0, Number(minutos) || 0) * 60000);
+  const h = d.getHours();
+  const h12 = h % 12 === 0 ? 12 : h % 12;
+  return `${h12}:${String(d.getMinutes()).padStart(2, '0')} ${h < 12 ? 'a. m.' : 'p. m.'}`;
+}
+
+/** Minutos que suma el tráfico de ahora sobre lo normal; null si no llega a 2 min y al 10 %. */
+export function extraPorTrafico(minutos: number, minutosNormales: number | null): number | null {
+  if (!Number.isFinite(minutos) || minutosNormales == null || !Number.isFinite(minutosNormales) || minutosNormales <= 0) return null;
+  const extra = Math.round(minutos - minutosNormales);
+  return extra >= 2 && extra >= minutosNormales * 0.1 ? extra : null;
+}
