+import * as Location from 'expo-location';
+import { useEffect, useMemo, useState } from 'react';
+import { StyleSheet, View } from 'react-native';
+
+import type { MapaVehiculoProps } from '@/components/map-vehiculo-clasico';
+import MapaFomDom, { type MarcadorDom, type RutaDom } from '@/components/mapa-fom-dom';
+import { useMapaPrefs } from '@/hooks/use-map-prefs';
+import { configStandard, ESTILO_MAPBOX, MAPBOX_TOKEN } from '@/lib/mapbox';
+import { useTheme } from '@/theme';
+import type { MapMarker } from '@/types';
+import { colorApagado } from '@/utils/paleta-flota';
+
+/**
+ * El mapa de Mapbox de la web, para la app en el teléfono cuando no hay Mapbox
+ * nativo (Expo Go). Resuelve aquí todo lo que el mapa no puede saber por sí
+ * solo —el tema, las preferencias, tu ubicación, el color de cada unidad— y se
+ * lo pasa ya hecho a `mapa-fom-dom.tsx`, que corre en una vista web.
+ */
+export function MapaVehiculoDom({
+  vehicleName,
+  live = false,
+  markerColor,
+  vehicleCoords,
+  markers,
+  onMarkerPress,
+  hideOverlays = false,
+  soloUsuario = false,
+  sinUsuario = false,
+  insetBottom = 0,
+  margenArriba = 0,
+  margenAbajo = 0,
+  encuadreClave,
+  resaltadoId = null,
+  onMapaPress,
+  style,
+  ruta,
+  viajeActivo = null,
+  onElegirViaje,
+  foco = null,
+}: MapaVehiculoProps) {
+  const { colors, colorScheme } = useTheme();
+  const { prefs, actualizar } = useMapaPrefs();
+  const esMulti = Array.isArray(markers);
+
+  // TU ubicación: solo donde importa (el conductor). En la flota estorba.
+  const conUsuario = !sinUsuario && (soloUsuario || !esMulti);
+  const [usuario, setUsuario] = useState<{ lat: number; lng: number } | null>(null);
+  useEffect(() => {
+    if (!conUsuario) return;
+    let sub: Location.LocationSubscription | null = null;
+    let vivo = true;
+    (async () => {
+      const { status } = await Location.requestForegroundPermissionsAsync();
+      if (!vivo || status !== 'granted') return;
+      const ahora = await Location.getCurrentPositionAsync({ accuracy: Location.Accuracy.Balanced }).catch(() => null);
+      if (vivo && ahora) setUsuario({ lat: ahora.coords.latitude, lng: ahora.coords.longitude });
+      const s = await Location.watchPositionAsync({ accuracy: Location.Accuracy.Balanced, distanceInterval: 10 }, (p) =>
+        setUsuario({ lat: p.coords.latitude, lng: p.coords.longitude }),
+      );
+      if (vivo) sub = s;
+      else s.remove();
+    })().catch(() => undefined);
+    return () => {
+      vivo = false;
+      sub?.remove();
+    };
+  }, [conUsuario]);
+
+  const colorDe = (m: MapMarker): string => {
+    if (m.emergencia) return colors.danger;
+    if (m.color) return m.estado === 'sin-senal' ? colorApagado(m.color, colors.background) : m.color;
+    if (m.estado) return m.estado === 'marcha' ? colors.success : m.estado === 'detenido' ? colors.warning : colors.textMuted;
+    return m.live ? colors.success : colors.textMuted;
+  };
+
+  const lista: MapMarker[] = esMulti
+    ? markers!
+    : vehicleCoords && !soloUsuario
+      ? [{ id: 'unidad', label: vehicleName ?? 'Unidad', coords: vehicleCoords, live, color: markerColor }]
+      : [];
+  const marcadores: MarcadorDom[] = useMemo(
+    () =>
+      lista.map((m) => ({
+        id: m.id,
+        label: m.label,
+        detalle: m.detalle,
+        lat: m.coords.lat,
+        lng: m.coords.lng,
+        color: colorDe(m),
+        rumbo: m.estado === 'marcha' && typeof m.rumbo === 'number' ? m.rumbo : null,
+        placa: m.placa,
+        estela: m.estela && m.estela.length > 1 ? m.estela.map((c) => [c.lng, c.lat] as [number, number]) : undefined,
+      })),
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+    [markers, vehicleCoords, vehicleName, live, markerColor, soloUsuario, colors],
+  );
+
+  // El recorrido, en la forma ligera que cruza a la vista web.
+  const rutaDom: RutaDom | null = useMemo(
+    () =>
+      ruta
+        ? {
+            viajes: ruta.viajes.map((v) => ({
+              numero: v.numero,
+              trazo: v.trazo && v.trazo.length > 1 ? v.trazo : v.puntos.map((p) => [p.lng, p.lat] as [number, number]),
+              inicio: v.inicio,
+              fin: v.fin,
+              minutos: v.minutos,
+              km: v.distanciaM / 1000,
+            })),
+            paradas: ruta.paradas.map((p) => ({ lat: p.lat, lng: p.lng, minutos: p.minutos, desde: p.desde, hasta: p.hasta })),
+          }
+        : null,
+    [ruta],
+  );
+
+  const enMarcha = esMulti ? markers!.filter((p) => (p.estado ? p.estado === 'marcha' : p.live)).length : 0;
+  const pildora = hideOverlays ? null : esMulti ? `${markers!.length} vehículos · ${enMarcha} en marcha` : (vehicleName ?? null);
+
+  return (
+    <View style={[styles.caja, { backgroundColor: colors.background }, style]}>
+      <MapaFomDom
+        token={MAPBOX_TOKEN}
+        estilo={ESTILO_MAPBOX[prefs.tipo]}
+        config={configStandard(prefs.tipo, colorScheme)}
+        colores={{
+          fondo: colors.background,
+          superficie: colors.surface,
+          texto: colors.text,
+          textoSec: colors.textSecondary,
+          borde: colors.border,
+          primario: colors.primary,
+          exito: colors.success,
+          peligro: colors.danger,
+        }}
+        marcadores={marcadores}
+        resaltadoId={resaltadoId}
+        usuario={conUsuario ? usuario : null}
+        ruta={rutaDom}
+        viajeActivo={viajeActivo}
+        foco={foco}
+        tipo={prefs.tipo}
+        tresD={prefs.tresD}
+        trafico={prefs.trafico}
+        margenArriba={margenArriba}
+        margenAbajo={Math.max(margenAbajo, insetBottom)}
+        encuadreClave={encuadreClave}
+        pildora={pildora}
+        onMarcador={async (id) => onMarkerPress?.(id)}
+        onMapa={async () => onMapaPress?.()}
+        onPrefs={async (cambio) => actualizar(cambio)}
+        onViaje={async (n) => onElegirViaje?.(n)}
+        dom={{ style: styles.web, scrollEnabled: false, containerStyle: styles.web } as never}
+      />
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  caja: { width: '100%', height: 300, overflow: 'hidden' },
+  web: { flex: 1, backgroundColor: 'transparent' },
+});
