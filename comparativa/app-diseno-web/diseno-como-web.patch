+/** Lo que dura el conteo de una cifra de tablero (ms). */
+const CONTEO_MS = 500;
+/** Cada cuánto, como mucho, se repinta la cifra mientras cuenta (ms). */
+const CONTEO_PASO = 33;
+
+/**
+ * La cifra de un tablero CONTANDO hasta su valor: desde 0 la primera vez que
+ * llega el dato y, después, desde el valor anterior (nunca vuelve a 0).
+ *
+ * Solo repinta cuando cambia el entero que se ve y como mucho ~30 veces por
+ * segundo: una cifra de 7 son 7 repintados, no 30. Con "reducir movimiento"
+ * va de una.
+ */
+export function useConteo(valor: number): number {
+  const reducido = useReducedMotionReanimated();
+  const [visto, setVisto] = useState(reducido ? valor : 0);
+  const desde = useRef(reducido ? valor : 0);
+
+  useEffect(() => {
+    const inicio = desde.current;
+    desde.current = valor;
+    if (reducido || inicio === valor || !Number.isFinite(valor)) {
+      setVisto(valor);
+      return;
+    }
+    const t0 = Date.now();
+    let ultimo = 0;
+    let id = 0;
+    const paso = () => {
+      const ahora = Date.now();
+      const p = Math.min(1, (ahora - t0) / CONTEO_MS);
+      // Sale rápido y se posa despacio en la cifra (ease-out cúbica).
+      const curva = 1 - (1 - p) ** 3;
+      if (p === 1 || ahora - ultimo >= CONTEO_PASO) {
+        ultimo = ahora;
+        setVisto(Math.round(inicio + (valor - inicio) * curva));
+      }
+      if (p < 1) id = requestAnimationFrame(paso);
+    };
+    id = requestAnimationFrame(paso);
+    return () => {
+      cancelAnimationFrame(id);
+      // Cortado a medias (otro valor llegó): se posa en el valor de una.
+      setVisto(valor);
+    };
+  }, [valor, reducido]);
+
+  return visto;
+}
+
+/** La cifra contando, para ponerla DENTRO de un texto ya estilado. */
+export function Conteo({ valor }: { valor: number }) {
+  return `${useConteo(valor)}`;
+}
