diff --git a/test/inspection-templates-weekdays.test.js b/test/inspection-templates-weekdays.test.js
new file mode 100644
index 0000000..8d03580
--- /dev/null
+++ b/test/inspection-templates-weekdays.test.js
@@ -0,0 +1,141 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { join } = require('node:path');
+const { test } = require('node:test');
+require('reflect-metadata');
+const { plainToInstance } = require('class-transformer');
+const { validateSync } = require('class-validator');
+const {
+  CreateInspectionTemplateDto,
+  UpdateInspectionTemplateWeekdaysDto,
+} = require('../dist/console-api/console-inspection-templates.dto.js');
+const {
+  InspectionTemplateCatalogQueryDto,
+} = require('../dist/mobile/mobile-field.dto.js');
+
+// ============================================================
+// Planillas por días de la semana — T-200
+// ------------------------------------------------------------
+// Cada planilla dice qué días toca; un conductor puede deber varias el mismo
+// día y la diaria pasa a ser una por unidad, planilla y día.
+// ============================================================
+
+const root = join(__dirname, '..');
+const read = (path) => readFileSync(join(root, path), 'utf8');
+const migration = read(
+  'src/database/migrations/files/' +
+    '20261027120000000_schedule_inspection_templates_by_weekday.ts',
+);
+const field = read('src/mobile/mobile-field.service.ts');
+const templates = read('src/console-api/console-inspection-templates.service.ts');
+const consoleController = read(
+  'src/console-api/console-inspection-templates.controller.ts',
+);
+const tenantWrites = read('src/console-api/console-tenant-daily-writes.controller.ts');
+const mobileController = read('src/mobile/mobile-inspection-templates.controller.ts');
+
+const errores = (Clase, cuerpo) =>
+  validateSync(plainToInstance(Clase, cuerpo), {
+    whitelist: true,
+    forbidNonWhitelisted: true,
+  });
+
+const item = {
+  code: 'frenos', category: 'Seguridad', name: 'Frenos', displayOrder: 1,
+};
+
+test('la migración agrega días validados por la base y es reversible', () => {
+  const up = migration.slice(0, migration.indexOf('export const down'));
+  const down = migration.slice(migration.indexOf('export const down'));
+  assert.match(up, /ADD COLUMN weekdays jsonb NOT NULL DEFAULT '\[\]'::jsonb/u);
+  assert.match(
+    up,
+    /weekdays <@ '\["lunes","martes","miercoles","jueves","viernes","sabado","domingo"\]'::jsonb/u,
+  );
+  assert.match(
+    up,
+    /ON fom\.inspections \(tenant_id, vehicle_id, template_id, inspection_date\)\s*\n\s*WHERE kind = 'daily'/u,
+  );
+  assert.match(up, /GRANT SELECT \(weekdays\), INSERT \(weekdays\), UPDATE \(weekdays\)/u);
+  // El reverso falla cerrado antes de restaurar la unicidad más estricta.
+  assert.match(down, /HAVING count\(\*\) > 1/u);
+  assert.match(down, /RAISE EXCEPTION/u);
+  assert.ok(
+    down.indexOf('RAISE EXCEPTION') < down.indexOf('DROP INDEX'),
+    'el guardián va antes de tocar el índice',
+  );
+  assert.match(
+    down,
+    /ON fom\.inspections \(tenant_id, vehicle_id, inspection_date\)\s*\n\s*WHERE kind = 'daily'/u,
+  );
+  assert.match(down, /DROP COLUMN weekdays/u);
+});
+
+test('crear acepta días válidos y opcionales; rechaza repetidos y desconocidos', () => {
+  const base = { code: 'diaria', version: 1, name: 'Diaria', items: [item] };
+  assert.deepEqual(errores(CreateInspectionTemplateDto, base), []);
+  const sinDias = plainToInstance(CreateInspectionTemplateDto, base);
+  assert.deepEqual(sinDias.weekdays, [], 'sin días = todos los días');
+  assert.deepEqual(
+    errores(CreateInspectionTemplateDto, { ...base, weekdays: ['lunes', 'viernes'] }),
+    [],
+  );
+  for (const weekdays of [['lunes', 'lunes'], ['feriado'], 'lunes', ['Lunes']]) {
+    assert.notDeepEqual(
+      errores(CreateInspectionTemplateDto, { ...base, weekdays }),
+      [],
+      JSON.stringify(weekdays),
+    );
+  }
+});
+
+test('editar días exige la lista (vacía vale) y no admite campos ajenos', () => {
+  assert.deepEqual(errores(UpdateInspectionTemplateWeekdaysDto, { weekdays: [] }), []);
+  assert.deepEqual(
+    errores(UpdateInspectionTemplateWeekdaysDto, { weekdays: ['sabado', 'domingo'] }),
+    [],
+  );
+  assert.notDeepEqual(errores(UpdateInspectionTemplateWeekdaysDto, {}), []);
+  assert.notDeepEqual(
+    errores(UpdateInspectionTemplateWeekdaysDto, { weekdays: [], status: 'publicada' }),
+    [],
+  );
+});
+
+test('la consola edita días en borrador o publicada, nunca en archivada, con auditoría', () => {
+  assert.match(consoleController, /@Patch\(':templateId\/weekdays'\)/u);
+  assert.match(tenantWrites, /@Patch\('inspection-templates\/:templateId\/weekdays'\)/u);
+  assert.match(tenantWrites, /consoleTenantInspectionTemplateWeekdaysUpdate/u);
+  const metodo = templates.slice(templates.indexOf('async updateWeekdays'));
+  assert.match(metodo, /requireManagerActor\(\)/u);
+  assert.match(metodo, /FOR UPDATE/u);
+  assert.match(metodo, /status === 'archivada'/u);
+  assert.match(metodo, /'inspection_template\.weekdays_changed'/u);
+  assert.match(templates, /Unknown weekday/u);
+});
+
+test('el móvil filtra por hoy con la zona de la empresa y marca lo ya llenado', () => {
+  assert.match(mobileController, /@Query\(\) query: InspectionTemplateCatalogQueryDto/u);
+  assert.match(field, /AT TIME ZONE zona/u);
+  assert.match(field, /SELECT timezone FROM fom\.tenants WHERE id = \$1/u);
+  assert.match(field, /template\.weekdays = '\[\]'::jsonb OR template\.weekdays \? \$4/u);
+  assert.match(field, /done\.template_id = template\.id/u);
+  assert.match(field, /done\.kind = 'daily'/u);
+  assert.match(field, /ORDER BY due_today DESC/u);
+  assert.deepEqual(errores(InspectionTemplateCatalogQueryDto, {}), []);
+  assert.deepEqual(errores(InspectionTemplateCatalogQueryDto, { scope: 'today' }), []);
+  assert.notDeepEqual(errores(InspectionTemplateCatalogQueryDto, { scope: 'ayer' }), []);
+});
+
+test('la entrega fecha con el día de la empresa y el 409 es por planilla', () => {
+  const entrega = field.slice(field.indexOf('async submitInspection'));
+  assert.match(entrega, /inspection_date\)\s*\n\s*VALUES \(\$1, \$2, \$3, \$4, \$5, \$6, \$7::date\)/u);
+  assert.match(entrega, /hoy\.fecha/u);
+  assert.doesNotMatch(entrega, /SELECT CURRENT_DATE/u);
+  assert.match(
+    field,
+    /already submitted today inspection for that template and vehicle/u,
+  );
+});
