+import { StyleSheet, View } from 'react-native';
+
+import { Button } from '@/components/button';
+import { ErrorState } from '@/components/error-state';
+import { HojaModal } from '@/components/hoja-modal';
+import { Pastilla } from '@/components/pastilla';
+import { Skeleton } from '@/components/skeleton';
+import { ThemedText } from '@/components/themed-text';
+import { useAsyncData } from '@/hooks/use-async-data';
+import {
+  getInspeccionFom,
+  type InspeccionDetalle,
+  type InspeccionResumen,
+  type RespuestaInspeccion,
+} from '@/services';
+import { useTheme, type ColorTokens } from '@/theme';
+import type { InspeccionEstado } from '@/types';
+import { formatFecha, formatHora } from '@/utils/date';
+
+/**
+ * Cómo se ve cada resultado: su color y cómo se dice. `largo` es el nombre
+ * entero, el de la web; `label` el corto, para filas donde no cabe.
+ */
+export const VISTA_INSPECCION: Record<InspeccionEstado, { label: string; largo: string; tono: keyof ColorTokens }> = {
+  pendiente: { label: 'Pendiente', largo: 'Pendiente', tono: 'textSecondary' },
+  aprobada: { label: 'Aprobada', largo: 'Aprobada', tono: 'success' },
+  aprobada_con_observaciones: { label: 'Con observaciones', largo: 'Aprobada con observaciones', tono: 'warning' },
+  bloqueada: { label: 'Bloqueada', largo: 'Bloqueada', tono: 'danger' },
+};
+
+/** Lo que se marcó mal en una inspección, contado como en la web. */
+export interface CuentaFallas {
+  criticas: number;
+  observaciones: number;
+  /** Los ítems que no quedaron conformes, por nombre. */
+  nombres: string[];
+}
+
+/**
+ * Misma regla que la web: una falla en un punto crítico es falla crítica;
+ * cualquier otra respuesta no conforme cuenta como observación.
+ */
+export function contarFallas(respuestas: RespuestaInspeccion[]): CuentaFallas {
+  const malas = respuestas.filter((r) => r.estado !== 'conforme');
+  const criticas = malas.filter((r) => r.critico && r.estado === 'falla').length;
+  return { criticas, observaciones: malas.length - criticas, nombres: malas.map((r) => r.nombre) };
+}
+
+/** «1 falla crítica · 2 observaciones», con el plural bien puesto. */
+export function textoFallas(c: CuentaFallas): string {
+  return `${c.criticas} ${c.criticas === 1 ? 'falla crítica' : 'fallas críticas'} · ${c.observaciones} ${
+    c.observaciones === 1 ? 'observación' : 'observaciones'
+  }`;
+}
+
+const ITEM_VISTA: Record<RespuestaInspeccion['estado'], { label: string; tono: keyof ColorTokens }> = {
+  conforme: { label: 'Conforme', tono: 'success' },
+  observacion: { label: 'Observación', tono: 'warning' },
+  falla: { label: 'Falla', tono: 'danger' },
+};
+
+/**
+ * RESULTADO DE UNA INSPECCIÓN, en una hoja que sube desde abajo.
+ *
+ * Es el «Ver resultado» de la web pasado al teléfono: quién, cuándo y dónde, y
+ * lo que se marcó mal. Los puntos conformes solo se cuentan —en una pantalla
+ * chica, treinta filas de «Conforme» tapan las dos que importan—. El resultado
+ * lo pone el conductor; aquí no se cambia.
+ */
+export function InspeccionesResultado({
+  inspeccion,
+  detalleLeido,
+  onClose,
+  onImprimir,
+  onVerHallazgos,
+}: {
+  inspeccion: InspeccionResumen | null;
+  /** El detalle, si quien abre la hoja ya lo leyó: así no se pide dos veces. */
+  detalleLeido?: InspeccionDetalle;
+  onClose: () => void;
+  onImprimir: (id: string) => void;
+  onVerHallazgos?: () => void;
+}) {
+  const { colors, spacing, radii, borderWidths } = useTheme();
+  // Solo se pide si no vino ya leído (y si es el de esta inspección).
+  const yaLeido = detalleLeido && detalleLeido.id === inspeccion?.id ? detalleLeido : undefined;
+  const id = yaLeido ? '' : (inspeccion?.id ?? '');
+  const { data: pedido, estado, recargar } = useAsyncData(
+    () => (id ? getInspeccionFom(id) : Promise.resolve(null)),
+    [id],
+  );
+  const detalle = yaLeido ?? pedido;
+  /** «Ver hallazgos» solo lleva a algo si esta salió con fallas u observaciones. */
+  const conHallazgos =
+    inspeccion?.resultado === 'bloqueada' || inspeccion?.resultado === 'aprobada_con_observaciones';
+
+  const v = inspeccion ? VISTA_INSPECCION[inspeccion.resultado] : null;
+  const respuestas = detalle?.respuestas ?? [];
+  const cuenta = detalle ? contarFallas(respuestas) : null;
+  const malas = respuestas.filter((r) => r.estado !== 'conforme');
+  const conformes = respuestas.length - malas.length;
+
+  const datos: [string, string][] = inspeccion
+    ? [
+        ['Conductor', inspeccion.conductor],
+        [
+          'Fecha y hora',
+          [formatFecha(inspeccion.fecha), inspeccion.enviadaEn ? formatHora(inspeccion.enviadaEn) : null]
+            .filter(Boolean)
+            .join(' · '),
+        ],
+        ['Ubicación', inspeccion.ubicacion ?? 'Sin ubicación'],
+        ['Formato', inspeccion.formato],
+      ]
+    : [];
+
+  return (
+    <HojaModal visible={!!inspeccion} onClose={onClose} titulo="Resultado de inspección" icon="inspeccion">
+      {inspeccion && v ? (
+        <>
+          <View style={[styles.cabeza, { gap: spacing.sm }]}>
+            <ThemedText variant="subtitle" style={styles.flex1} numberOfLines={1}>
+              {[inspeccion.unidad, inspeccion.placa].filter(Boolean).join(' · ')}
+            </ThemedText>
+            <Pastilla tono={v.tono} label={v.largo} conPunto />
+          </View>
+
+          <View style={{ gap: spacing.xs }}>
+            {datos.map(([k, valor]) => (
+              <View key={k} style={[styles.dato, { gap: spacing.md }]}>
+                <ThemedText variant="caption" color="textMuted">
+                  {k}
+                </ThemedText>
+                <ThemedText variant="caption" color="textSecondary" style={styles.valor} numberOfLines={2}>
+                  {valor}
+                </ThemedText>
+              </View>
+            ))}
+          </View>
+
+          {!yaLeido && estado === 'error' ? (
+            <ErrorState description="No pudimos cargar las respuestas de esta inspección." onRetry={recargar} />
+          ) : !detalle ? (
+            <View style={{ gap: spacing.sm }}>
+              <Skeleton height={20} width="60%" />
+              <Skeleton height={56} radius={radii.md} />
+              <Skeleton height={56} radius={radii.md} />
+            </View>
+          ) : (
+            <>
+              <View
+                style={[
+                  styles.resumen,
+                  {
+                    backgroundColor: colors.surfaceSunken,
+                    borderColor: colors.border,
+                    borderWidth: borderWidths.hairline,
+                    borderRadius: radii.md,
+                    padding: spacing.md,
+                  },
+                ]}>
+                <ThemedText variant="button" color={cuenta && cuenta.criticas > 0 ? 'danger' : 'text'}>
+                  {cuenta ? textoFallas(cuenta) : ''}
+                </ThemedText>
+                <ThemedText variant="caption" color="textMuted">
+                  {respuestas.length === 0
+                    ? 'Sin respuestas disponibles.'
+                    : `${conformes} ${conformes === 1 ? 'punto conforme' : 'puntos conformes'} de ${respuestas.length}`}
+                </ThemedText>
+              </View>
+
+              {malas.map((r) => {
+                const iv = ITEM_VISTA[r.estado];
+                return (
+                  <View
+                    key={r.id}
+                    style={[
+                      styles.item,
+                      {
+                        gap: spacing.sm,
+                        paddingTop: spacing.md,
+                        borderTopWidth: borderWidths.hairline,
+                        borderTopColor: colors.border,
+                      },
+                    ]}>
+                    <View style={styles.flex1}>
+                      <ThemedText variant="button" numberOfLines={2}>
+                        {r.nombre}
+                      </ThemedText>
+                      <ThemedText variant="caption" color="textMuted" numberOfLines={1}>
+                        {[r.categoria || 'General', r.critico ? 'Punto crítico' : null].filter(Boolean).join(' · ')}
+                      </ThemedText>
+                      {r.nota ? (
+                        <ThemedText variant="caption" color="textSecondary">
+                          {r.nota}
+                        </ThemedText>
+                      ) : null}
+                    </View>
+                    <Pastilla tono={iv.tono} label={iv.label} />
+                  </View>
+                );
+              })}
+            </>
+          )}
+
+          <ThemedText variant="caption" color="textMuted">
+            Respuestas registradas desde la app. El supervisor no modifica el resultado.
+          </ThemedText>
+
+          <View style={{ gap: spacing.sm }}>
+            {onVerHallazgos && conHallazgos ? <Button label="Ver hallazgos →" onPress={onVerHallazgos} /> : null}
+            <Button label="Imprimir" icon="reporte" variant="secondary" onPress={() => onImprimir(inspeccion.id)} />
+          </View>
+        </>
+      ) : null}
+    </HojaModal>
+  );
+}
+
+const styles = StyleSheet.create({
+  cabeza: { flexDirection: 'row', alignItems: 'center' },
+  dato: { flexDirection: 'row', justifyContent: 'space-between' },
+  valor: { flexShrink: 1, textAlign: 'right' },
+  resumen: { gap: 2 },
+  item: { flexDirection: 'row', alignItems: 'flex-start' },
+  flex1: { flex: 1, minWidth: 0 },
+});
