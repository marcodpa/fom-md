+/** El porcentaje de papeles al día, como etiqueta (90 % o más conforme; 70 % o más alerta). */
+function papelPct(p: number): string {
+  if (p >= 90) return etiqueta('verde');
+  if (p >= 70) return etiqueta('amarillo');
+  return etiqueta('rojo');
+}
