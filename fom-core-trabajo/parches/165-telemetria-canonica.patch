+function mismoNumerico(
+  almacenado: string | null | undefined,
+  entrante: number | null,
+  decimales: number,
+): boolean {
+  if (almacenado === null || almacenado === undefined) {
+    return entrante === null;
+  }
+  if (entrante === null) {
+    return false;
+  }
+  return almacenado === entrante.toFixed(decimales);
+}
