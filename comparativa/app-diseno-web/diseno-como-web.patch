+import { useRouter } from 'expo-router';
+import { StyleSheet, View } from 'react-native';
+
+import { PressableScale } from '@/components/pressable-scale';
+import { TabIcon } from '@/components/tab-icon';
+import { ThemedText } from '@/components/themed-text';
+import { useAsyncData } from '@/hooks/use-async-data';
+import { getMisProgramadas } from '@/services/inspeccionService';
+import { useTheme } from '@/theme';
+
+/**
+ * AVISO EN EL INICIO: «tienes una inspección programada para hoy».
+ *
+ * Solo aparece si hay alguna que se pueda hacer HOY; las próximas, las
+ * vencidas y las hechas se ven en la pestaña Inspección. Si FOM no responde o
+ * aún no publica las citas, no pinta nada: es un recordatorio, no un bloqueo.
+ */
+export function InspeccionProgramadaAviso() {
+  const { colors, spacing, radii } = useTheme();
+  const router = useRouter();
+  const { data } = useAsyncData(() => getMisProgramadas().catch(() => []), [], { onFocus: true });
+  const deHoy = (data ?? []).filter((p) => p.estado === 'pendiente' && p.deHoy);
+  if (deHoy.length === 0) return null;
+  const primera = deHoy[0];
+
+  return (
+    <PressableScale
+      onPress={() => router.navigate('/inspeccion')}
+      accessibilityRole="button"
+      accessibilityLabel="Ver las inspecciones programadas para hoy"
+      style={[
+        styles.aviso,
+        {
+          backgroundColor: colors.surfaceSunken,
+          borderColor: colors.border,
+          borderRadius: radii.lg,
+          padding: spacing.md,
+          gap: spacing.md,
+        },
+      ]}>
+      <View style={[styles.icono, { backgroundColor: colors.infoSurface, borderRadius: radii.sm }]}>
+        <TabIcon name="inspeccion" color={colors.info} size={21} />
+      </View>
+      <View style={styles.flex1}>
+        <ThemedText variant="button" numberOfLines={1}>
+          {deHoy.length === 1
+            ? '1 inspección programada para hoy'
+            : `${deHoy.length} inspecciones programadas para hoy`}
+        </ThemedText>
+        <ThemedText variant="caption" color="textMuted" numberOfLines={1}>
+          {[primera.unidad, primera.formato].join(' · ')}
+        </ThemedText>
+      </View>
+      <ThemedText variant="caption" color="primary" style={styles.enlace}>
+        Hacer →
+      </ThemedText>
+    </PressableScale>
+  );
+}
+
+const styles = StyleSheet.create({
+  aviso: { flexDirection: 'row', alignItems: 'center', borderWidth: StyleSheet.hairlineWidth },
+  icono: { width: 42, height: 42, alignItems: 'center', justifyContent: 'center' },
+  flex1: { flex: 1, minWidth: 0 },
+  enlace: { fontWeight: '600' },
+});
