+import { StyleSheet, View } from 'react-native';
+
+import { Conteo } from '@/components/animated-number';
+import { Card } from '@/components/card';
+import { Chip } from '@/components/chip';
+import { ODT_ESTADO_LABEL, otStatusColor } from '@/components/ot-status-badge';
+import { PressableScale } from '@/components/pressable-scale';
+import { ThemedText } from '@/components/themed-text';
+import { useTheme, type ColorTokens } from '@/theme';
+import type { OdtEstado } from '@/types';
+
+/**
+ * Las piezas de la pestaña Mantenimiento del supervisor, hechas como en el
+ * panel web (lienzo «FOM normalizado», mesa A2): pestañas, cifras 2×2, la fila
+ * de una orden y los pasos de una ODT. Solo las usa esa pantalla.
+ */
+
+// ───────────────────────────── Pestañas ─────────────────────────────
+
+export type PestanaMantenimiento = 'ordenes' | 'todas' | 'planes';
+
+const PESTANAS: { id: PestanaMantenimiento; label: string }[] = [
+  { id: 'ordenes', label: 'Órdenes' },
+  { id: 'todas', label: 'Todas las órdenes' },
+  { id: 'planes', label: 'Planes' },
+];
+
+/**
+ * Las tres vistas de la web: Órdenes · Todas las órdenes · Planes. Texto con la
+ * raya azul debajo de la activa, sobre una línea que las une.
+ */
+export function PestanasMantenimiento({
+  activa,
+  onCambiar,
+}: {
+  activa: PestanaMantenimiento;
+  onCambiar: (p: PestanaMantenimiento) => void;
+}) {
+  const { colors, spacing, borderWidths } = useTheme();
+  return (
+    <View
+      accessibilityRole="tablist"
+      style={[styles.pestanas, { gap: spacing.xl, borderBottomWidth: borderWidths.hairline, borderBottomColor: colors.border }]}>
+      {PESTANAS.map((p) => {
+        const on = p.id === activa;
+        return (
+          <PressableScale
+            key={p.id}
+            onPress={() => onCambiar(p.id)}
+            hitSlop={6}
+            accessibilityRole="tab"
+            accessibilityState={{ selected: on }}>
+            <View style={[styles.pestana, { borderBottomColor: on ? colors.primary : 'transparent' }]}>
+              <ThemedText
+                style={[styles.pestanaTexto, { fontWeight: on ? '600' : '500' }]}
+                color={on ? 'primary' : 'textSecondary'}
+                numberOfLines={1}>
+                {p.label}
+              </ThemedText>
+            </View>
+          </PressableScale>
+        );
+      })}
+    </View>
+  );
+}
+
+// ───────────────────────────── Cifras ─────────────────────────────
+
+export type CifraMantenimiento = {
+  label: string;
+  valor: number | string;
+  /** El punto de color delante de la etiqueta. */
+  tono: keyof ColorTokens;
+};
+
+/**
+ * Las cifras de arriba, dos por fila como en la mesa A2: punto de color,
+ * etiqueta y el número grande. Si quedan impares, la última va a lo ancho para
+ * no dejar un hueco.
+ */
+export function CifrasMantenimiento({ items }: { items: CifraMantenimiento[] }) {
+  const { colors, spacing } = useTheme();
+  return (
+    <View style={[styles.cifras, { gap: spacing.sm + 2 }]}>
+      {items.map((k, i) => {
+        const sola = items.length % 2 === 1 && i === items.length - 1;
+        return (
+          <Card key={k.label} style={[styles.cifra, sola ? styles.cifraAncha : styles.cifraMitad]}>
+            <View style={[styles.fila, { gap: spacing.sm }]}>
+              <View style={[styles.punto, { backgroundColor: colors[k.tono] }]} />
+              <ThemedText style={styles.cifraLabel} color="textSecondary" numberOfLines={1}>
+                {k.label}
+              </ThemedText>
+            </View>
+            <ThemedText style={styles.cifraValor} tabular numberOfLines={1}>
+              {typeof k.valor === 'number' ? <Conteo valor={k.valor} /> : k.valor}
+            </ThemedText>
+          </Card>
+        );
+      })}
+    </View>
+  );
+}
+
+// ───────────────────────────── Fila de orden ─────────────────────────────
+
+/**
+ * UNA ORDEN (o una alerta) en la lista: la unidad arriba en pequeño, el título,
+ * y debajo el botón para abrirla junto a su etiqueta y cuándo/qué tipo es.
+ *
+ * La etiqueta es el estado de la ODT en sus tres palabras (Abierta, En
+ * revisión, Resuelta); una alerta del sistema no es una ODT y lleva su tipo en
+ * gris.
+ */
+export function FilaOrden({
+  unidad,
+  titulo,
+  estado,
+  etiqueta,
+  detalle,
+  primera,
+  onPress,
+}: {
+  unidad: string;
+  titulo: string;
+  /** Estado de la ODT. Sin él (una alerta), se usa `etiqueta`. */
+  estado?: OdtEstado;
+  etiqueta?: string;
+  /** «hace 3 días · Correctiva». */
+  detalle: string;
+  primera: boolean;
+  onPress: () => void;
+}) {
+  const { colors, spacing, borderWidths, radii } = useTheme();
+  // En revisión ya la atiende alguien: se mira cómo va. Lo demás se revisa.
+  const boton = estado === 'en_revision' ? 'Ver avance →' : estado === 'cerrada' ? 'Ver →' : 'Revisar →';
+  const tag = estado ? ODT_ESTADO_LABEL[estado] : etiqueta;
+  return (
+    <View
+      style={[
+        styles.orden,
+        { borderTopWidth: primera ? 0 : borderWidths.hairline, borderTopColor: colors.border, paddingVertical: spacing.md },
+      ]}>
+      <ThemedText variant="caption" color="textMuted" numberOfLines={1}>
+        {unidad}
+      </ThemedText>
+      <ThemedText style={styles.ordenTitulo} numberOfLines={2}>
+        {titulo}
+      </ThemedText>
+      <View style={[styles.fila, { gap: spacing.md, marginTop: 4 }]}>
+        <PressableScale
+          onPress={onPress}
+          hitSlop={6}
+          accessibilityRole="button"
+          accessibilityLabel={`${boton.replace(' →', '')}: ${titulo}, ${unidad}${tag ? `, ${tag}` : ''}`}>
+          <View
+            style={[
+              styles.botonFila,
+              {
+                backgroundColor: colors.surfaceElevated,
+                borderColor: colors.borderStrong,
+                borderWidth: borderWidths.hairline,
+                borderRadius: radii.pill,
+              },
+            ]}>
+            <ThemedText style={styles.botonTexto} numberOfLines={1}>
+              {boton}
+            </ThemedText>
+          </View>
+        </PressableScale>
+        <View style={[styles.flex1, { gap: 2 }]}>
+          {tag ? <Chip tone={estado ? otStatusColor(estado) : 'textMuted'} textoTono={estado ? undefined : 'textSecondary'} label={tag} dot /> : null}
+          <ThemedText variant="caption" color="textMuted" numberOfLines={1}>
+            {detalle}
+          </ThemedText>
+        </View>
+      </View>
+    </View>
+  );
+}
+
+// ───────────────────────────── Cómo avanza ─────────────────────────────
+
+const PASOS: { estado: OdtEstado; texto: string }[] = [
+  { estado: 'abierta', texto: 'Alguien reporta la falla y elige la unidad.' },
+  { estado: 'en_revision', texto: 'El supervisor la revisa, asigna quién hace el trabajo y sigue el avance.' },
+  { estado: 'cerrada', texto: 'Se confirma la solución y se registra el costo si lo hay.' },
+];
+
+/** «Cómo avanza una ODT»: los tres estados, uno por paso, unidos por un riel. */
+export function ComoAvanzaOdt() {
+  const { colors, spacing } = useTheme();
+  return (
+    <Card style={{ gap: spacing.md }}>
+      <View style={{ gap: 2 }}>
+        <ThemedText style={styles.tituloTarjeta}>Cómo avanza una ODT</ThemedText>
+        <ThemedText variant="caption" color="textSecondary">
+          Del reporte al cierre, en tres pasos.
+        </ThemedText>
+      </View>
+      <View accessibilityRole="list">
+        {PASOS.map((p, i) => {
+          const ultimo = i === PASOS.length - 1;
+          return (
+            <View key={p.estado} style={[styles.paso, { gap: spacing.md }]}>
+              <View style={styles.riel}>
+                <View style={[styles.numero, { backgroundColor: colors.primary }]}>
+                  <ThemedText style={[styles.numeroTexto, { color: colors.onPrimary }]}>{i + 1}</ThemedText>
+                </View>
+                {ultimo ? null : <View style={[styles.rielLinea, { backgroundColor: colors.border }]} />}
+              </View>
+              <View style={[styles.flex1, { gap: 4, paddingBottom: ultimo ? 0 : spacing.md }]}>
+                <Chip tone={otStatusColor(p.estado)} label={ODT_ESTADO_LABEL[p.estado]} dot />
+                <ThemedText style={styles.pasoTexto} color="textSecondary">
+                  {p.texto}
+                </ThemedText>
+              </View>
+            </View>
+          );
+        })}
+      </View>
+    </Card>
+  );
+}
+
+const styles = StyleSheet.create({
+  fila: { flexDirection: 'row', alignItems: 'center' },
+  flex1: { flex: 1, minWidth: 0 },
+  pestanas: { flexDirection: 'row' },
+  pestana: { paddingHorizontal: 2, paddingBottom: 10, borderBottomWidth: 2 },
+  pestanaTexto: { fontSize: 14, lineHeight: 20 },
+  cifras: { flexDirection: 'row', flexWrap: 'wrap' },
+  // Dos por fila: la mitad menos medio hueco.
+  cifraMitad: { width: '48.5%' },
+  cifraAncha: { width: '100%' },
+  cifra: { paddingVertical: 12, paddingHorizontal: 14, gap: 2 },
+  punto: { width: 8, height: 8, borderRadius: 4 },
+  cifraLabel: { fontSize: 13, lineHeight: 16, flexShrink: 1 },
+  cifraValor: { fontSize: 28, lineHeight: 32, fontWeight: '700', letterSpacing: -0.5, marginTop: 2 },
+  tituloTarjeta: { fontSize: 17, lineHeight: 22, fontWeight: '600' },
+  orden: { gap: 4 },
+  ordenTitulo: { fontSize: 15, lineHeight: 20, fontWeight: '600' },
+  botonFila: { height: 40, paddingHorizontal: 16, alignItems: 'center', justifyContent: 'center' },
+  botonTexto: { fontSize: 14, lineHeight: 18, fontWeight: '600' },
+  paso: { flexDirection: 'row' },
+  riel: { width: 24, alignItems: 'center' },
+  numero: { width: 24, height: 24, borderRadius: 12, alignItems: 'center', justifyContent: 'center' },
+  numeroTexto: { fontSize: 12, lineHeight: 16, fontWeight: '700' },
+  rielLinea: { flex: 1, width: 2, marginVertical: 4 },
+  pasoTexto: { fontSize: 12, lineHeight: 17 },
+});
