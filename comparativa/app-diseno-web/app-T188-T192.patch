+            <ThemedText style={[styles.detalle, styles.zona, { color: colors.textMuted }]} numberOfLines={1}>
+              {area}
+            </ThemedText>
+          </View>
+
+          {/* Su aviso más grave, entero en su línea: es lo que hay que atender. */}
+          {avisoTono && avisoLabel ? (
