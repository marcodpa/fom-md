+import { useEffect } from 'react';
+import { StyleSheet, View } from 'react-native';
+import Animated, {
+  Easing,
+  interpolate,
+  useAnimatedStyle,
+  useSharedValue,
+  withDelay,
+  withRepeat,
+  withTiming,
+  type SharedValue,
+} from 'react-native-reanimated';
+import Svg, { Circle, Defs, Path, RadialGradient, Stop } from 'react-native-svg';
+
+import { ThemedText } from '@/components/themed-text';
+import { AZUL_FOM, BLANCO_FOM, ISOTIPO_FOM } from '@/lib/logos';
+import { useReducedMotion } from '@/theme';
+
+/**
+ * LA CARGA DE FOM: la misma animación que la pantalla de carga de la web
+ * (`public/carga-fom.css` del panel).
+ *
+ * 1. Las tres flechas entran una tras otra desde la izquierda.
+ * 2. Se escribe «FOM», letra a letra, y aparece el lema.
+ * 3. Mientras carga, una luz recorre las flechas hacia adelante y una barra
+ *    fina va y viene debajo: la marca «avanza», que es lo que dice su forma.
+ *
+ * Todo corre en el hilo de UI (Reanimated): la carga se proyecta justo cuando
+ * el hilo de JS está más ocupado, y así no da tirones.
+ */
+
+/** La curva de entrada de la web: cubic-bezier(0.2, 0.8, 0.2, 1). */
+const ENTRA = Easing.bezier(0.2, 0.8, 0.2, 1);
+const FLECHAS = (ISOTIPO_FOM.trazos ?? []).map((t) => t.d);
+const LETRAS = ['F', 'O', 'M'];
+/** Fondo de la carga: el de la app y el de la web. */
+export const FONDO_CARGA = '#0A0D12';
+
+type Props = {
+  /** La línea chica de abajo ("Iniciando", "Cargando"…). Sin ella, no se muestra. */
+  estado?: string;
+  /** Sin fondo propio: se monta sobre lo que ya hay (el planeta del login). */
+  sinFondo?: boolean;
+  /** Ancho de las flechas; el nombre escala con ellas. */
+  tamano?: number;
