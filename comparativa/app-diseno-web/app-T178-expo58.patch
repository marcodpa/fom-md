diff --git a/src/components/fundido-tema.tsx b/src/components/fundido-tema.tsx
new file mode 100644
index 0000000..5ebbf1b
--- /dev/null
+++ b/src/components/fundido-tema.tsx
@@ -0,0 +1,62 @@
+import { useCallback, useEffect, useState } from 'react';
+import { StyleSheet } from 'react-native';
+import Animated, { runOnJS, useAnimatedStyle, useSharedValue, withTiming } from 'react-native-reanimated';
+
+import { curvasUI, DURACION, useReducedMotion, useTheme } from '@/theme';
+
+/**
+ * CAMBIO DE TEMA SUAVE (claro ↔ oscuro, Azul FOM ↔ Glass gris).
+ *
+ * Sin esto, toda la app saltaba de colores en un cuadro. Aquí, en el mismo
+ * cuadro en que se pinta el tema nuevo, se pone encima un velo del FONDO
+ * ANTERIOR y se apaga en 380 ms: lo nuevo aparece fundiéndose desde el color de
+ * antes. Solo opacidad, en el hilo de UI, y sin tocar nada de debajo.
+ *
+ * No toma toques (`pointerEvents="none"`): mientras se apaga ya se puede usar
+ * la pantalla. Con «reducir movimiento» el cambio es directo.
+ */
+export function FundidoTema() {
+  const { colors, colorScheme, apariencia } = useTheme();
+  const reducido = useReducedMotion();
+  const clave = `${colorScheme}:${apariencia}`;
+
+  // Lo que se pintaba antes. Se compara DURANTE el render (estado derivado):
+  // así el velo sale en el mismo cuadro que el tema nuevo, sin un parpadeo.
+  const [antes, setAntes] = useState({ clave, fondo: colors.background });
+  const [velo, setVelo] = useState<{ id: number; color: string } | null>(null);
+  // Estable: si cambiara en cada render, el velo volvería a arrancar su fundido.
+  const quitarVelo = useCallback(() => setVelo(null), []);
+  if (antes.clave !== clave) {
+    setAntes({ clave, fondo: colors.background });
+    if (!reducido) setVelo((v) => ({ id: (v?.id ?? 0) + 1, color: antes.fondo }));
+  } else if (antes.fondo !== colors.background) {
+    // Mismo tema con otro fondo (no debería pasar): se apunta sin animar.
+    setAntes({ clave, fondo: colors.background });
+  }
+
+  if (!velo) return null;
+  // Con `key`: un segundo cambio a medio fundido arranca un velo nuevo.
+  return <Velo key={velo.id} color={velo.color} alTerminar={quitarVelo} />;
+}
+
+function Velo({ color, alTerminar }: { color: string; alTerminar: () => void }) {
+  // Nace opaco: el primer cuadro tapa el salto de color.
+  const opacidad = useSharedValue(1);
+
+  useEffect(() => {
+    opacidad.set(
+      withTiming(0, { duration: DURACION.lento, easing: curvasUI.enfasis }, (terminado) => {
+        if (terminado) runOnJS(alTerminar)();
+      }),
+    );
+  }, [opacidad, alTerminar]);
+
+  const estilo = useAnimatedStyle(() => ({ opacity: opacidad.value }));
+
+  return (
+    <Animated.View
+      pointerEvents="none"
+      style={[StyleSheet.absoluteFill, { backgroundColor: color }, estilo]}
+    />
+  );
+}
