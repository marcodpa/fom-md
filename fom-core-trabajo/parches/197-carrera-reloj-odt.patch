 .github/workflows/gps-console-ci.yml          |   8 +
 ...25170000000_fix_work_order_insert_clock.ts | 187 ++++++++++++++++++
 test/operations-runtime.sql                   |  14 ++
 4 files changed, 217 insertions(+)
 create mode 100644 src/database/migrations/files/20260825170000000_fix_work_order_insert_clock.ts

