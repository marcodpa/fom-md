diff --git a/.npmrc b/.npmrc
new file mode 100644
index 0000000..7c5134a
--- /dev/null
+++ b/.npmrc
@@ -0,0 +1,4 @@
+# @rnmapbox/maps pide mapbox-gl 2 como dependencia opcional (solo para web),
+# pero la app usa mapbox-gl 3 (el del panel web). Sin esto, npm se niega a
+# instalar en el servidor de Expo y la APK no se arma.
+legacy-peer-deps=true
