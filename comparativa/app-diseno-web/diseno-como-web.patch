+      filas: r.alertasPorVehiculo.map((v) => {
+        const k6 = seis.get(`${v.unidadLabel}|${v.placa}`);
+        const medido = v.km > 0;
+        return {
+          celdas: [
+            `<b>${esc(idEnPapel(v.unidadLabel))}</b>`,
+            esc(placaEnPapel(v.placa)),
+            esc(v.area || '—'),
+            medido ? entero(v.km) : '—',
+            k6 === undefined ? '—' : entero(k6),
