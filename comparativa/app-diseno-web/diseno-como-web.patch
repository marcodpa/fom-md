+        <LinearGradient
+          colors={GRIS_GLASS}
+          locations={[0, 0.7, 1]}
+          start={{ x: 0.25, y: 0 }}
+          end={{ x: 0.75, y: 1 }}
+          style={StyleSheet.absoluteFill}
+        />
+        <View
+          style={[
+            styles.muestraTarjeta,
+            { borderRadius: radii.lg, backgroundColor: paletaGlass.surface, borderColor: paletaGlass.border },
+          ]}>
+          <View style={[styles.cajaIconoGrande, { borderRadius: radii.sm, backgroundColor: paletaGlass.infoSurface }]}>
+            <TabIcon name="ot" color={colorSchemes.dark.onActive} size={18} />
+          </View>
+          <ThemedText style={[styles.muestraEtiqueta, { color: paletaGlass.textSecondary }]}>Tarjeta de ejemplo</ThemedText>
+          <ThemedText style={[styles.pista, { color: paletaGlass.textMuted }]}>
+            Así se ven las cifras, las listas y los botones.
+          </ThemedText>
+        </View>
+        <View style={[styles.muestraBoton, { backgroundColor: colors.primary, borderRadius: radii.pill }]}>
+          <TabIcon name="anadir" color={colors.onPrimary} size={18} />
+          <ThemedText style={[styles.muestraBotonTexto, { color: colors.onPrimary }]}>Botón principal</ThemedText>
+        </View>
+      </View>
+    </View>
+  );
+}
