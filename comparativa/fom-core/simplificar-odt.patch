+import { ConflictException, Injectable, NotFoundException } from '@nestjs/common';
+import { randomUUID } from 'node:crypto';
+import type { PoolClient } from 'pg';
+import { DatabaseService } from '../database/database.service';
+import {
+  MobileMutationReceiptService,
+  type MobileMutationOperation,
+} from '../mobile/mobile-mutation-receipt.service';
+import { ConsoleOperationsService } from './console-operations.service';
+import type { TransitionWorkOrderDto } from './console.dto';
+import { requireManagerActor } from './console-roles';
+import { TenantScopeService } from './tenant-scope.service';
+import type {
+  CloseWorkOrderDto,
+  DispatchWorkOrderDto,
+  ResolveWorkOrderDto,
+  ReturnWorkOrderDto,
+} from './work-order-execution.dto';
+import {
+  WorkOrderExecutionService,
+  type WorkOrderActor,
+} from './work-order-execution.service';
+
+type WorkOrderStatus = TransitionWorkOrderDto['status'];
+
+/**
+ * Pasos internos que «Asignar a…» recorre desde cada estado de partida.
+ * Desde asignada no hay paso previo: es una reasignación.
+ */
+const DISPATCH_PATH: Record<string, WorkOrderStatus[]> = {
+  abierta: ['en_revision', 'aprobada'],
+  en_revision: ['aprobada'],
+  aprobada: [],
+  asignada: [],
+};
+
+/** Nota de historial de cada paso cuando quien asigna no escribe una. */
+const DISPATCH_NOTE: Record<string, string> = {
+  en_revision: 'Revisada al asignar',
+  aprobada: 'Aprobada al asignar',
+};
+
+/** Estados desde los que cierra cada acción. */
+const CLOSE_FROM: Record<'work_order.resolve' | 'work_order.close', string[]> = {
+  'work_order.resolve': ['abierta', 'en_revision', 'aprobada'],
+  'work_order.close': ['en_calidad'],
+};
+
+/**
+ * Flujo simple de ODT (T-72): Abierta → En curso → Resuelta.
+ *
+ * La base conserva sus nueve estados, su máquina de transiciones y su
+ * historial append-only. Este servicio solo agrupa pasos: cada acción
+ * compuesta recorre los estados intermedios dentro de UNA transacción usando
+ * el mismo núcleo que la transición manual, de modo que cada paso deja su fila
+ * de historial (disparador) y de auditoría exactamente como si alguien lo
+ * hubiera hecho a mano. Si un paso falla, no queda ninguno: ni una ODT
+ * aprobada sin responsable ni un cierre sin resolución.
+ *
+ * Solo supervisor o administrador FOM. El tenant sale de la sesión o de un
+ * ente explícito resuelto por `TenantScopeService`; nunca del cuerpo.
+ */
+@Injectable()
+export class WorkOrderFlowService {
+  constructor(
+    private readonly database: DatabaseService,
+    private readonly operations: ConsoleOperationsService,
+    private readonly execution: WorkOrderExecutionService,
+    private readonly receipts: MobileMutationReceiptService,
+    private readonly tenantScope: TenantScopeService = new TenantScopeService(
+      database,
+    ),
+  ) {}
+
+  /** El móvil exige Idempotency-Key en estas acciones, como en la transición. */
+  requireIdempotencyKey(key: string | undefined): string {
+    return this.receipts.requireKey(key);
+  }
+
+  /** «Asignar a…»: abierta/en_revision/aprobada/asignada → asignada. */
+  async dispatch(
+    workOrderId: string,
+    dto: DispatchWorkOrderDto,
+    idempotencyKey?: string,
+    requestedTenantId?: string,
+  ) {
+    return this.run(
+      'work_order.dispatch',
+      workOrderId,
+      dto,
+      idempotencyKey,
+      requestedTenantId,
+      async (client, actor, tenantId) => {
+        const current = await this.lockedStatus(client, tenantId, workOrderId);
+        if (current !== dto.expectedStatus) {
+          throw new ConflictException('Work order state changed; reload it');
+        }
+        const transitions: Record<string, unknown>[] = [];
+        let from = current as WorkOrderStatus;
+        for (const to of DISPATCH_PATH[current] ?? []) {
+          const step = await this.operations.applyWorkOrderTransition(
+            client,
+            actor,
+            tenantId,
+            workOrderId,
+            {
+              expectedStatus: from,
+              status: to,
+              note: dto.note ?? DISPATCH_NOTE[to],
+            },
+          );
+          transitions.push(step.event as Record<string, unknown>);
+          from = to;
+        }
+        const assigned = await this.execution.assignInTransaction(
+          client,
+          actor,
+          tenantId,
+          workOrderId,
+          { userId: dto.userId, note: dto.note },
+        );
+        if (!assigned.replayed) {
+          transitions.push(
+            await this.lastEvent(client, tenantId, workOrderId),
+          );
+        }
+        return {
+          workOrder: await this.header(client, tenantId, workOrderId),
+          assignment: assigned.assignment,
+          transitions,
+          replayed: false,
+        };
+      },
+    );
+  }
+
+  /** «Resolver ya»: abierta/en_revision/aprobada → cerrada con resolución. */
+  async resolve(
+    workOrderId: string,
+    dto: ResolveWorkOrderDto,
+    idempotencyKey?: string,
+    requestedTenantId?: string,
+  ) {
+    return this.closeFrom('work_order.resolve', workOrderId, dto, idempotencyKey, requestedTenantId);
+  }
+
+  /** «Cerrar» tras la entrega del responsable: en_calidad → cerrada. */
+  async close(
+    workOrderId: string,
+    dto: CloseWorkOrderDto,
+    idempotencyKey?: string,
+    requestedTenantId?: string,
+  ) {
+    return this.closeFrom('work_order.close', workOrderId, dto, idempotencyKey, requestedTenantId);
+  }
+
+  /**
+   * «Devolver»: en_calidad → en_ejecucion con motivo.
+   *
+   * Además del historial de estados, deja el evento de reloj `devolucion` a
+   * nombre de quien devuelve y sobre la asignación vigente: el retrabajo
+   * vuelve a contar como tiempo productivo del responsable.
+   */
+  async returnToExecution(
+    workOrderId: string,
+    dto: ReturnWorkOrderDto,
+    idempotencyKey?: string,
+    requestedTenantId?: string,
+  ) {
+    return this.run(
+      'work_order.return',
+      workOrderId,
+      dto,
+      idempotencyKey,
+      requestedTenantId,
+      async (client, actor, tenantId) => {
+        const current = await this.lockedStatus(client, tenantId, workOrderId);
+        if (current !== dto.expectedStatus) {
+          throw new ConflictException('Work order state changed; reload it');
+        }
+        const responsible = await client.query<{ id: string }>(
+          `SELECT id FROM fom.work_order_assignments
+            WHERE tenant_id = $1 AND work_order_id = $2
+              AND assignment_role = 'responsable' AND ended_at IS NULL`,
+          [tenantId, workOrderId],
+        );
+        if (!responsible.rows[0]) {
+          throw new ConflictException('Work order has no active responsible');
+        }
+        const step = await this.operations.applyWorkOrderTransition(
+          client,
+          actor,
+          tenantId,
+          workOrderId,
+          { expectedStatus: 'en_calidad', status: 'en_ejecucion', note: dto.reason },
+        );
+        const clock = await client.query<Record<string, unknown>>(
+          `INSERT INTO fom.work_order_execution_events
+             (tenant_id, work_order_id, assignment_id, actor_user_id,
+              event_kind, from_status, to_status, note, client_event_id)
+           VALUES ($1, $2, $3, $4, 'devolucion', 'en_calidad', 'en_ejecucion',
+                   $5, $6)
+           RETURNING id, event_kind AS "eventKind",
+             from_status::text AS "fromStatus", to_status::text AS "toStatus",
+             note, occurred_at AS "occurredAt"`,
+          [
+            tenantId,
+            workOrderId,
+            responsible.rows[0].id,
+            actor.userId,
+            dto.reason,
+            randomUUID(),
+          ],
+        );
+        return {
+          workOrder: step.workOrder,
+          event: step.event,
+          executionEvent: clock.rows[0],
+          replayed: false,
+        };
+      },
+    );
+  }
+
+  private async closeFrom(
+    operation: 'work_order.resolve' | 'work_order.close',
+    workOrderId: string,
+    dto: ResolveWorkOrderDto | CloseWorkOrderDto,
+    idempotencyKey?: string,
+    requestedTenantId?: string,
+  ) {
+    const transition: TransitionWorkOrderDto = {
+      expectedStatus: dto.expectedStatus,
+      status: 'cerrada',
+      // El historial pide una nota corta; si no llega, la resolución la da.
+      note: dto.note ?? dto.resolutionNote.slice(0, 1000),
+      resolutionNote: dto.resolutionNote,
+      ...(dto.resolutionCost !== undefined && { resolutionCost: dto.resolutionCost }),
+      ...(dto.resolutionCurrency !== undefined && {
+        resolutionCurrency: dto.resolutionCurrency,
+      }),
+      ...(dto.completionOdometerKm !== undefined && {
+        completionOdometerKm: dto.completionOdometerKm,
+      }),
+    };
+    return this.run(
+      operation,
+      workOrderId,
+      dto,
+      idempotencyKey,
+      requestedTenantId,
+      async (client, actor, tenantId) => {
+        // El DTO ya limita el origen; se repite para quien llame al servicio
+        // sin pasar por HTTP: «Resolver ya» no cierra trabajo en calidad.
+        if (!CLOSE_FROM[operation].includes(dto.expectedStatus)) {
+          throw new ConflictException('Invalid work order status transition');
+        }
+        this.operations.validateWorkOrderTransition(transition);
+        const step = await this.operations.applyWorkOrderTransition(
+          client,
+          actor,
+          tenantId,
+          workOrderId,
+          transition,
+        );
+        return { ...step, replayed: false };
+      },
+    );
+  }
+
+  /**
+   * Una transacción por acción, con recibo idempotente opcional (el móvil lo
+   * exige; la consola protege con expectedStatus). Un fallo en cualquier paso
+   * revierte todos los anteriores.
+   */
+  private async run<T extends Record<string, unknown>>(
+    operation: MobileMutationOperation,
+    workOrderId: string,
+    dto: object,
+    idempotencyKey: string | undefined,
+    requestedTenantId: string | undefined,
+    body: (
+      client: PoolClient,
+      actor: WorkOrderActor,
+      tenantId: string,
+    ) => Promise<T>,
+  ): Promise<T> {
+    const actor = requireManagerActor();
+    const client = await this.database.getPool().connect();
+    try {
+      await client.query('BEGIN');
+      // La asignación vive bajo RLS por actor: se declara antes de leerla.
+      await client.query(`SELECT set_config('fom.actor_user_id', $1, true)`, [
+        actor.userId,
+      ]);
+      const tenantId = (
+        await this.tenantScope.requireWritable(requestedTenantId, client)
+      ).tenantId;
+      const requestHash = idempotencyKey
+        ? this.receipts.hashRequest({ tenantId, workOrderId, ...dto })
+        : null;
+      if (idempotencyKey && requestHash) {
+        const previous = await this.receipts.replay<T>(
+          client,
+          actor,
+          operation,
+          idempotencyKey,
+          requestHash,
+        );
+        if (previous) {
+          await client.query('COMMIT');
+          return { ...previous, replayed: true };
+        }
+      }
+      const response = await body(client, actor, tenantId);
+      if (idempotencyKey && requestHash) {
+        await this.receipts.store(
+          client,
+          actor,
+          operation,
+          idempotencyKey,
+          requestHash,
+          response,
+        );
+      }
+      await client.query('COMMIT');
+      return response;
+    } catch (error) {
+      await client.query('ROLLBACK');
+      // La máquina de la base es la última palabra: si rechaza un paso, el
+      // cliente recibe el mismo 409 que en la transición manual.
+      if ((error as { code?: string }).code === '23514') {
+        throw new ConflictException('Invalid work order status transition');
+      }
+      throw error;
+    } finally {
+      client.release();
+    }
+  }
+
+  private async lockedStatus(
+    client: PoolClient,
+    tenantId: string,
+    workOrderId: string,
+  ): Promise<string> {
+    const order = await client.query<{ status: string }>(
+      `SELECT status::text AS status FROM fom.work_orders
+        WHERE tenant_id = $1 AND id = $2 FOR UPDATE`,
+      [tenantId, workOrderId],
+    );
+    if (!order.rows[0]) throw new NotFoundException('Work order not found');
+    return order.rows[0].status;
+  }
+
+  private async header(
+    client: PoolClient,
+    tenantId: string,
+    workOrderId: string,
+  ) {
+    const result = await client.query<Record<string, unknown>>(
+      `SELECT id, status::text AS status,
+              coalesce(severity, 'media') AS severity,
+              status_changed_at AS "statusChangedAt"
+         FROM fom.work_orders
+        WHERE tenant_id = $1 AND id = $2`,
+      [tenantId, workOrderId],
+    );
+    return result.rows[0];
+  }
+
+  private async lastEvent(
+    client: PoolClient,
+    tenantId: string,
+    workOrderId: string,
+  ): Promise<Record<string, unknown>> {
+    const result = await client.query<Record<string, unknown>>(
+      `SELECT sequence_number AS "sequence",
+              from_status AS "fromStatus", to_status AS "toStatus",
+              note, occurred_at AS "occurredAt"
