+  TituloTarjeta,
+} from '@/components/reportes-piezas';
+import { Skeleton } from '@/components/skeleton';
+import { ThemedText } from '@/components/themed-text';
+import { rangoDeIndice } from '@/lib/indice';
+import { etiquetaCortaDeUnidad } from '@/lib/vehiculos';
+import { useTheme, type ColorTokens } from '@/theme';
+import type { DocumentoEstado, ReportPeriod, ScoreRange } from '@/types';
+import { miles } from '@/utils/numero';
+
+/*
+ * EL CONTENIDO de cada pestaña, bajo «En pocas palabras»:
+ * - Vehículos: la operación de la flota, el mantenimiento y cada unidad.
+ * - Usuarios: la seguridad y cada persona.
+ * - Costos: productos y servicios, categorías y gasto por unidad.
+ * - Estadístico: los indicadores de conducción, las distancias y los conductores.
+ *
+ * Las listas abren con las cinco que más piden atención: con ochenta unidades
+ * en fila, lo urgente queda en la página tres.
+ */
+
+/** Cuántas filas se ven antes de «Ver las N». */
+const VISIBLES = 5;
+
+/** Los decimales a la manera de aquí: «1.5» → «1,5». */
+const decimalEs = (s: string): string => s.replace(/(\d)\.(\d)/g, '$1,$2');
+
+const RANGO_LABEL: Record<ScoreRange, string> = { verde: 'Conforme', amarillo: 'Alerta', rojo: 'Atención' };
+
+const PAPEL_LABEL: Record<DocumentoEstado, string> = { vigente: 'al día', por_vencer: 'por vencer', vencido: 'vencida' };
+
+function colorPapel(e: DocumentoEstado | null | undefined, colors: ColorTokens): string {
+  if (e === 'vigente') return colors.success;
+  if (e === 'por_vencer') return colors.warning;
+  if (e === 'vencido') return colors.danger;
+  return colors.textMuted;
+}
+
+/**
+ * Una lista con su filtro «Piden atención» y su «Ver las N».
+ *
+ * Lo que pide atención va siempre primero, también con «Todas»: el filtro
+ * acorta la lista, no la reordena.
+ */
+function ListaFiltrable<T>({
+  items,
+  atencion,
+  llave,
+  fila,
+  todas = 'Todas',
+  vacia,
+}: {
+  items: T[];
+  atencion?: (it: T) => boolean;
+  llave: (it: T) => string;
+  fila: (it: T, divisor: boolean) => ReactNode;
+  /** «Todas» o «Todos», según de qué sea la lista. */
+  todas?: 'Todas' | 'Todos';
+  vacia: string;
+}) {
+  const { spacing } = useTheme();
+  const [soloAtencion, setSoloAtencion] = useState(false);
+  const [abierta, setAbierta] = useState(false);
+
+  const urgentes = atencion ? items.filter(atencion) : [];
+  const ordenados = atencion ? [...urgentes, ...items.filter((it) => !atencion(it))] : items;
+  const lista = soloAtencion ? urgentes : ordenados;
+  const vistos = abierta ? lista : lista.slice(0, VISIBLES);
+  const art = todas === 'Todas' ? 'las' : 'los';
+
+  return (
+    <View style={{ gap: spacing.sm }}>
+      {atencion && items.length > 0 ? (
+        <View style={[styles.chips, { gap: spacing.sm }]}>
+          <ChipFiltro label={todas} cuenta={items.length} activo={!soloAtencion} onPress={() => setSoloAtencion(false)} />
+          <ChipFiltro
+            label="Piden atención"
+            cuenta={urgentes.length}
+            activo={soloAtencion}
+            onPress={() => setSoloAtencion(true)}
+          />
+        </View>
+      ) : null}
+      {lista.length === 0 ? (
+        <ThemedText variant="caption" color="textMuted" style={{ paddingVertical: spacing.sm }}>
+          {soloAtencion ? 'Nada pide atención en este período.' : vacia}
+        </ThemedText>
+      ) : (
+        <View>
+          {vistos.map((it, i) => (
+            <View key={llave(it)}>{fila(it, i > 0)}</View>
+          ))}
+        </View>
+      )}
+      {lista.length > VISIBLES ? (
+        <View style={styles.pie}>
+          <ThemedText variant="caption" color="textMuted">
+            {abierta ? `${lista.length} de ${items.length}` : `${VISIBLES} de ${lista.length}`}
+          </ThemedText>
+          <Enlace label={abierta ? 'Ver menos' : `Ver ${art} ${lista.length}`} onPress={() => setAbierta((a) => !a)} />
+        </View>
+      ) : null}
+    </View>
+  );
+}
+
+function Divisor() {
+  const { colors, spacing } = useTheme();
+  return <View style={{ height: StyleSheet.hairlineWidth, backgroundColor: colors.border, marginVertical: spacing.xs }} />;
+}
+
+// ─────────────────────────────── Vehículos ─────────────────────────────────
+
+function PestanaVehiculos({
+  d,
+  periodo,
+  onVerOdt,
+}: {
+  d: Extract<DatosVista, { tipo: 'vehiculos' }>;
+  periodo: ReportPeriod;
+  onVerOdt?: () => void;
+}) {
+  const { colors, spacing } = useTheme();
+  const filas = d.actual.porVehiculo;
+  const total = filas.length;
+  const enMarcha = filas.filter((v) => v.estado === 'en_marcha').length;
+  const pct = total > 0 ? Math.round((enMarcha / total) * 100) : 0;
+  // En toda la empresa cuentan todas sus ODT; en un área o una selección,
+  // solo las de esas unidades.
+  const mant = d.odt
+    ? mantenimientoDe(d.odt, periodo, d.actual.scope.tipo === 'general' ? null : new Set(filas.map((v) => v.vehicle.id)))
+    : null;
+
+  return (
+    <>
+      <Tarjeta style={{ gap: spacing.sm }}>
+        <TituloTarjeta titulo="Operación de la flota" derecha={<EtiquetaAhora />} />
+        <ThemedText variant="caption" color="textSecondary">
+          <ThemedText variant="caption" tabular style={styles.fuerte}>{`${miles(enMarcha)} de ${miles(total)}`}</ThemedText>
+          {` en marcha ahora · ${pct} %`}
+        </ThemedText>
+        <BarraPartes
+          alto={8}
+          etiqueta={`${enMarcha} de ${total} unidades en marcha ahora, ${pct} %`}
+          partes={[
+            { valor: enMarcha, color: colors.primary },
+            { valor: total - enMarcha, color: colors.borderStrong },
+          ]}
+        />
+
+        <Divisor />
+
+        <TituloTarjeta
+          titulo="Mantenimiento del período"
+          derecha={onVerOdt ? <Enlace label="Ver las ODT" onPress={onVerOdt} /> : undefined}
+        />
+        {!mant ? (
+          <ThemedText variant="caption" color="textMuted">
+            No pudimos leer las ODT de este período.
+          </ThemedText>
+        ) : mant.creadas === 0 ? (
+          <ThemedText variant="caption" color="textMuted">
+            No se crearon ODT en el período.
+          </ThemedText>
+        ) : (
+          <>
+            <ThemedText variant="caption" color="textSecondary">
+              {`${miles(mant.creadas)} ${mant.creadas === 1 ? 'ODT creada' : 'ODT creadas'} en el período, según cómo están hoy`}
+            </ThemedText>
+            <BarraPartes
+              etiqueta={`${mant.creadas} ODT: ${mant.abiertas} abiertas, ${mant.enRevision} en revisión y ${mant.resueltas} resueltas`}
+              partes={[
+                { valor: mant.abiertas, color: colors.warning, texto: miles(mant.abiertas) },
+                { valor: mant.enRevision, color: colors.primary, texto: miles(mant.enRevision) },
+                { valor: mant.resueltas, color: colors.success, texto: miles(mant.resueltas) },
+              ]}
+            />
+            <Leyenda
+              items={[
+                { color: colors.warning, label: 'Abiertas', valor: miles(mant.abiertas) },
+                { color: colors.primary, label: 'En revisión', valor: miles(mant.enRevision) },
+                {
+                  color: colors.success,
+                  label: 'Resueltas',
+                  valor: mant.conCosto > 0 ? `${miles(mant.resueltas)} · ${dinero(mant.costo)}` : miles(mant.resueltas),
+                },
+              ]}
+            />
+          </>
+        )}
+      </Tarjeta>
+
+      <Tarjeta style={{ gap: spacing.sm }}>
+        <TituloTarjeta titulo="Desglose por vehículo" />
+        <ListaFiltrable
+          items={[...filas].sort((a, b) => a.indiceSeguro - b.indiceSeguro)}
+          atencion={vehiculoPideAtencion}
+          llave={(v) => v.vehicle.id}
+          vacia="No hay unidades en este alcance."
+          fila={(v, divisor) => {
+            const marcha = v.estado === 'en_marcha';
+            const eventos = eventosDe(v);
+            const extra = [
+              v.otAbiertas > 0 ? `${v.otAbiertas} ${v.otAbiertas === 1 ? 'ODT abierta' : 'ODT abiertas'}` : null,
+              v.papeles === 'vencido' ? 'papeles vencidos' : v.papeles === 'por_vencer' ? 'papeles por vencer' : null,
+            ].filter(Boolean);
+            const modelo = [v.vehicle.marca, v.vehicle.modelo].filter(Boolean).join(' ');
+            return (
+              <FilaLista
+                divisor={divisor}
+                titulo={[etiquetaCortaDeUnidad(v.vehicle) || 'Unidad', modelo].filter(Boolean).join(' · ')}
+                estado={[marcha ? 'En marcha' : 'Detenida', v.areaName, v.vehicle.placa].filter(Boolean).join(' · ')}
+                colorEstado={marcha ? colors.success : colors.textMuted}
+                pista={[`${miles(v.km)} km`, `${miles(eventos)} ${eventos === 1 ? 'evento' : 'eventos'}`, ...extra].join(' · ')}
+                cifra={miles(v.indiceSeguro)}
+                cifraColor={tonoDeRango(v.rango)}
+                cifraPie="índice"
+              />
+            );
+          }}
+        />
+      </Tarjeta>
+    </>
+  );
+}
+
+// ─────────────────────────────── Usuarios ──────────────────────────────────
+
+function PestanaUsuarios({ d }: { d: Extract<DatosVista, { tipo: 'usuarios' }> }) {
+  const { colors, spacing } = useTheme();
+  const filas = d.actual.filas;
+  const indice = indicePersonas(filas);
+  const conIndice = filas.filter((f) => f.scoreRango != null);
+  const cuenta = (r: ScoreRange) => conIndice.filter((f) => f.scoreRango === r).length;
+  const lic = (e: DocumentoEstado | null) => filas.filter((f) => (f.licencia?.estado ?? null) === e).length;
+
+  return (
+    <>
+      <Tarjeta style={{ gap: spacing.sm }}>
+        <TituloTarjeta titulo="Seguridad" />
+        <View style={styles.indiceFila}>
+          <ThemedText tabular style={styles.indiceValor} color={indice == null ? 'textMuted' : (tonoDeRango(rangoDeIndice(indice)) ?? 'text')}>
+            {indice == null ? '—' : miles(indice)}
+          </ThemedText>
+          <View style={styles.flex1}>
+            <ThemedText style={styles.fuerte}>Índice de manejo seguro</ThemedText>
+            <ThemedText variant="caption" color="textMuted">
+              {indice == null ? 'Nadie manejó en el período.' : `Sobre 100 · ${RANGO_LABEL[rangoDeIndice(indice)]}`}
+            </ThemedText>
+          </View>
+        </View>
+        {conIndice.length > 0 ? (
+          <>
+            <BarraPartes
+              alto={8}
+              etiqueta={`${cuenta('verde')} personas con 85 o más, ${cuenta('amarillo')} de 70 a 84 y ${cuenta('rojo')} con menos de 70`}
+              partes={[
+                { valor: cuenta('verde'), color: colors.success },
+                { valor: cuenta('amarillo'), color: colors.warning },
+                { valor: cuenta('rojo'), color: colors.danger },
+              ]}
+            />
+            <Leyenda
+              items={[
+                { color: colors.success, label: '85 o más', valor: miles(cuenta('verde')) },
+                { color: colors.warning, label: '70 a 84', valor: miles(cuenta('amarillo')) },
+                { color: colors.danger, label: 'Menos de 70', valor: miles(cuenta('rojo')) },
+              ]}
+            />
+          </>
+        ) : null}
+
+        <Divisor />
+
+        <TituloTarjeta titulo="Licencias" derecha={<EtiquetaAhora />} />
+        <Leyenda
+          items={[
+            { color: colors.success, label: 'Al día', valor: miles(lic('vigente')) },
+            { color: colors.warning, label: 'Por vencer', valor: miles(lic('por_vencer')) },
+            { color: colors.danger, label: 'Vencidas', valor: miles(lic('vencido')) },
+            { color: colors.textMuted, label: 'Sin registrar', valor: miles(lic(null)) },
+          ]}
+        />
+      </Tarjeta>
+
+      <Tarjeta style={{ gap: spacing.sm }}>
+        <TituloTarjeta titulo="Por persona" />
+        <ListaFiltrable
+          items={[...filas].sort((a, b) => b.persona.metrics.kmRecorridos - a.persona.metrics.kmRecorridos)}
+          atencion={personaPideAtencion}
+          llave={(f) => f.persona.id}
+          todas="Todos"
+          vacia="No hay personas en este alcance."
+          fila={(f, divisor) => {
+            const m = f.persona.metrics;
+            const unidad = f.unidad ? `${f.unidad.label}${f.unidad.via === 'secundario' ? ' (sec.)' : ''}` : 'Sin unidad';
+            return (
+              <FilaLista
+                divisor={divisor}
+                titulo={f.persona.nombre}
+                estado={[f.areaName, unidad].filter(Boolean).join(' · ')}
+                colorEstado={colorPapel(f.licencia?.estado, colors)}
+                pista={[
+                  `${miles(m.kmRecorridos)} km`,
+                  `${miles(m.horasConducidas)} h`,
+                  `${miles(m.otReportadas)} ODT`,
+                  `licencia ${f.licencia ? PAPEL_LABEL[f.licencia.estado] : 'sin registrar'}`,
+                ].join(' · ')}
