+/**
+ * El día de hoy (AAAA-MM-DD, hora local) que se renueva solo a la medianoche:
+ * con la pantalla abierta toda la noche, «Hoy», «7 días» y «30 días» pasan a
+ * contar desde el día nuevo. Igual que la web (`useDiaDeHoy` en Mantenimiento).
+ */
+function useDiaDeHoy(): string {
+  const [dia, setDia] = useState(() => diaLocal());
+  useEffect(() => {
+    // Un poco después de las 00:00, por si el reloj del teléfono se adelanta.
+    const reloj = setTimeout(() => setDia(diaLocal()), msHastaMedianoche() + 1000);
+    // Con el teléfono dormido el reloj se atrasa: al volver a la app se mira otra vez.
+    const sub = AppState.addEventListener('change', (s) => {
+      if (s === 'active') setDia(diaLocal());
+    });
+    return () => {
+      clearTimeout(reloj);
+      sub.remove();
+    };
+  }, [dia]);
+  return dia;
+}
