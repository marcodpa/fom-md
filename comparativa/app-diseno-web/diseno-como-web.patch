+  colorSchemes,
+  paletaGlass,
+  useTheme,
+  useThemeController,
+  type Apariencia,
+  type ColorTokens,
+} from '@/theme';
+
+/** El degradado gris de Glass, el mismo de `ScreenBackground` y de la web. */
+const GRIS_GLASS = ['#60656C', '#52565E', '#60656C'] as const;
+
+/**
+ * APARIENCIA: Azul FOM o Glass gris, como en la web (Configuración).
+ *
+ * Es de la persona y de ESTE teléfono: se guarda aquí y no cambia nada para
+ * nadie más de la empresa. Al elegir, toda la app cambia al momento (esta
+ * pantalla también), así que la mejor vista previa es la propia pantalla.
+ */
+export default function AparienciaScreen() {
+  const { spacing } = useTheme();
+  const { apariencia, setApariencia } = useThemeController();
+
+  return (
+    <ThemedView style={styles.root} ambient>
+      <SafeAreaView style={styles.root} edges={['top']}>
+        <ScreenHeader title="Apariencia" />
+
+        <ScrollView contentContainerStyle={[styles.content, { padding: spacing.lg, gap: spacing.lg }]}>
+          <View style={styles.cabecera}>
+            <ThemedText accessibilityRole="header" style={styles.titulo}>
+              Apariencia
+            </ThemedText>
+            <ThemedText color="textSecondary" style={styles.bajada}>
+              Elige cómo se ve FOM en este teléfono. Solo cambia para ti.
+            </ThemedText>
+          </View>
+
+          <View accessibilityRole="radiogroup" accessibilityLabel="Tema" style={{ gap: spacing.md }}>
+            <ThemedText color="textMuted" style={styles.ceja}>
+              TEMA
+            </ThemedText>
+            {APARIENCIAS.map((a) => (
+              <OpcionApariencia
+                key={a.id}
+                id={a.id}
+                nombre={a.nombre}
+                descripcion={a.descripcion}
+                elegida={apariencia === a.id}
+                onPress={() => setApariencia(a.id)}
+              />
+            ))}
+          </View>
+
+          <LoQueNoCambia />
+          <MuestraGlass />
+
+          <ThemedText color="textMuted" style={styles.nota}>
+            La web tiene el mismo ajuste en Configuración.
+          </ThemedText>
+        </ScrollView>
+      </SafeAreaView>
+    </ThemedView>
+  );
+}
+
+/** Una opción del tema: su miniatura, su nombre, su frase y el círculo de elección. */
+function OpcionApariencia({
+  id,
+  nombre,
+  descripcion,
+  elegida,
+  onPress,
+}: {
+  id: Apariencia;
+  nombre: string;
+  descripcion: string;
+  elegida: boolean;
+  onPress: () => void;
+}) {
+  const { colors, radii, borderWidths } = useTheme();
+  return (
+    <PressableScale
+      onPress={onPress}
+      accessibilityRole="radio"
+      accessibilityState={{ checked: elegida }}
+      accessibilityLabel={`${nombre}. ${descripcion}`}
+      style={[
+        styles.opcion,
+        {
+          borderRadius: radii.lg,
+          borderWidth: borderWidths.thin,
+          backgroundColor: elegida ? colors.activeSurface : colors.surface,
+          borderColor: elegida ? colors.activeBorder : colors.border,
+        },
+      ]}>
+      <VistaPrevia glass={id === 'glass'} />
+
+      <View style={styles.opcionCabeza}>
+        <ThemedText style={styles.opcionNombre}>{nombre}</ThemedText>
+        <View
+          style={[
+            styles.radio,
+            { borderRadius: radii.pill, borderColor: elegida ? colors.onActive : colors.borderStrong },
+          ]}>
+          {elegida ? <View style={[styles.radioPunto, { borderRadius: radii.pill, backgroundColor: colors.onActive }]} /> : null}
+        </View>
+      </View>
+      <ThemedText color="textSecondary" style={styles.opcionFrase}>
+        {descripcion}
+      </ThemedText>
+      {elegida ? (
+        <View style={styles.elegida}>
+          <TabIcon name="check" color={colors.onActive} size={16} />
+          <ThemedText style={[styles.elegidaTexto, { color: colors.onActive }]}>Seleccionado</ThemedText>
+        </View>
+      ) : null}
+    </PressableScale>
+  );
+}
+
+/**
+ * Miniatura de la app con cada tema: cápsula de arriba, dos tarjetas y la
+ * barra. Pinta SIEMPRE los colores de su tema, no los del tema en uso: así se
+ * comparan las dos de un vistazo.
+ */
+function VistaPrevia({ glass }: { glass: boolean }) {
+  const { radii, colors } = useTheme();
+  const p: ColorTokens = glass ? paletaGlass : colorSchemes.dark;
+  const pieza = { backgroundColor: p.surface, borderColor: p.border, borderWidth: 1 };
+  // Las rayitas de texto, algo apagadas sobre el gris para no gritar.
+  const raya = { backgroundColor: p.textMuted, opacity: glass ? 0.7 : 1 };
+  return (
+    <View
+      style={[styles.previa, { borderRadius: radii.md, borderColor: p.border, backgroundColor: p.background }]}
+      importantForAccessibility="no-hide-descendants"
+      accessibilityElementsHidden>
+      {glass ? (
+        <LinearGradient
+          colors={GRIS_GLASS}
+          locations={[0, 0.7, 1]}
+          start={{ x: 0.25, y: 0 }}
+          end={{ x: 0.75, y: 1 }}
+          style={StyleSheet.absoluteFill}
+        />
+      ) : null}
+      <View style={[styles.previaCapsula, pieza]}>
+        <View style={[styles.previaLogo, { backgroundColor: colors.primary }]} />
+        <View style={[styles.previaNombre, { backgroundColor: p.borderStrong }]} />
+      </View>
+      <View style={styles.previaTarjetas}>
+        <View style={[styles.previaTarjeta, pieza, { borderRadius: radii.sm }]}>
+          <View style={[styles.previaRaya, raya]} />
+          <View style={[styles.previaCifra, { backgroundColor: p.text }]} />
+        </View>
+        <View style={[styles.previaTarjeta, pieza, { borderRadius: radii.sm }]}>
+          <View style={[styles.previaRaya, raya]} />
+          <View style={[styles.previaBoton, { backgroundColor: colors.primary, borderRadius: radii.pill }]} />
+        </View>
+      </View>
+      <View style={[styles.previaBarra, pieza, { borderRadius: radii.sm }]}>
+        {[0, 1, 2, 3, 4].map((i) =>
+          i === 3 ? (
+            <View key={i} style={[styles.previaActiva, { backgroundColor: p.activeSurface, borderRadius: radii.pill }]} />
+          ) : (
+            <View key={i} style={[styles.previaIcono, raya]} />
+          ),
+        )}
+      </View>
+    </View>
+  );
+}
+
+/** Lo que el tema NO toca: el azul y los botones, el logo y los colores de estado. */
+function LoQueNoCambia() {
+  const { colors, radii, borderWidths } = useTheme();
+  const filas: { texto: string; extra?: 'boton' | 'estados' }[] = [
+    { texto: 'El azul FOM y los botones.', extra: 'boton' },
+    { texto: 'El logo de tu empresa.' },
+    { texto: 'Los colores de los estados (bien, aviso, peligro).', extra: 'estados' },
+  ];
+  return (
+    <Card>
+      <ThemedText accessibilityRole="header" style={styles.tituloSeccion}>
+        Lo que no cambia
+      </ThemedText>
+      <View style={styles.lista}>
+        {filas.map((f, i) => (
+          <View
+            key={f.texto}
+            style={[
+              styles.fila,
+              i > 0 ? { borderTopWidth: borderWidths.thin, borderTopColor: colors.border } : null,
+            ]}>
+            <View style={[styles.cajaIcono, { borderRadius: radii.sm, backgroundColor: colors.infoSurface }]}>
+              <TabIcon name="check" color={colors.primary} size={16} />
+            </View>
+            <ThemedText style={styles.filaTexto}>{f.texto}</ThemedText>
+            {f.extra === 'boton' ? (
+              <View style={[styles.miniBoton, { backgroundColor: colors.primary, borderRadius: radii.pill }]} />
+            ) : f.extra === 'estados' ? (
+              <View style={styles.puntos}>
+                {[colors.success, colors.warning, colors.danger].map((c) => (
+                  <View key={c} style={[styles.punto, { backgroundColor: c, borderRadius: radii.pill }]} />
+                ))}
+              </View>
+            ) : null}
+          </View>
+        ))}
+      </View>
+    </Card>
+  );
+}
+
+/**
+ * Cómo se ve Glass gris: una tarjeta de cristal sobre el degradado gris. Es
+ * solo una muestra (sin datos ni acciones), por eso nada aquí se puede tocar.
+ */
+function MuestraGlass() {
+  const { colors, radii, spacing } = useTheme();
+  return (
+    <View style={{ gap: spacing.sm }}>
+      <View style={styles.cabeceraMuestra}>
