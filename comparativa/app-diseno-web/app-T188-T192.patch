+import { memo } from 'react';
+import { ScrollView, StyleSheet, View } from 'react-native';
+
+import { FotoSinFondo } from '@/components/foto-sin-fondo';
+import { Pastilla } from '@/components/pastilla';
+import { PressableScale } from '@/components/pressable-scale';
+import { PulseDot } from '@/components/pulse-dot';
+import { TabIcon } from '@/components/tab-icon';
+import { TextoVivo } from '@/components/texto-vivo';
+import { ThemedText } from '@/components/themed-text';
+import { useFotoPropia } from '@/hooks/use-foto-vehiculo';
+import { tinte } from '@/lib/color';
+import { textoSinSenal } from '@/lib/sin-senal';
+import { useTheme, type ColorTokens } from '@/theme';
+import type { Vehicle } from '@/types';
+
+/*
+ * PIEZAS DE LA LISTA DE VEHÍCULOS (T-190): la tarjeta de cada unidad y la fila
+ * de pastillas rápidas de arriba. La pantalla (`panel/flota.tsx`) trae los
+ * datos; aquí solo se pinta. La web tiene la misma tarjeta en
+ * `src/panel/modulos/FlotaMovil.jsx` (FilaUnidadMovil).
+ */
+
+/** Alto FIJO de la tarjeta y el aire que la separa de la siguiente: la lista no salta. */
+export const TARJETA_ALTO = 118;
+export const TARJETA_AIRE = 10;
+
+/** Cómo está ahora, ya decidido por la pantalla. `null`: su posición aún no llega. */
+export type EstadoFila = 'marcha' | 'detenido' | 'sin-senal' | null;
+
+/** Ancho de la foto en la tarjeta: lienzo 8:5, como la franja de Mi unidad. */
+const FOTO_ANCHO = 92;
+
+/**
+ * UNA UNIDAD de la lista, en su tarjeta.
+ *
+ * A la izquierda, la foto (el recorte sin fondo, su foto, la del catálogo o la
+ * silueta de su tipo). A la derecha, de arriba abajo: el número y la placa en
+ * grande; cómo está ahora (en marcha y a cuánto, detenida o sin señal y desde
+ * cuándo); quién la conduce y en qué zona opera, con el color de su área; y su
+ * aviso más grave en una pastilla, entero en su línea.
+ *
+ * Con `memo` y valores sueltos: las posiciones se releen cada veinte segundos y
+ * solo se repinta la tarjeta a la que de verdad le cambió algo.
+ */
+export const TarjetaUnidad = memo(function TarjetaUnidad({
+  vehicle,
+  numero,
+  placa,
+  conductor,
+  area,
+  colorArea,
+  estado,
+  velocidad,
+  ultimoReporte,
+  avisoTono,
+  avisoLabel,
+  avisoLatiendo,
+  resaltada,
+  onPress,
+}: {
+  vehicle: Pick<Vehicle, 'id' | 'marca' | 'modelo' | 'tipo'>;
+  numero: string;
+  placa: string;
+  conductor: string | null | undefined;
+  area: string;
+  /** El color de su área: el mismo de su punto en el mapa. */
+  colorArea: string;
+  estado: EstadoFila;
+  velocidad: number;
+  /** Hora de su último reporte (para «Sin señal · hace …»). */
+  ultimoReporte: string | null | undefined;
+  avisoTono: keyof ColorTokens | undefined;
+  avisoLabel: string | undefined;
+  avisoLatiendo: boolean | undefined;
+  resaltada: boolean;
+  onPress: (id: string) => void;
+}) {
+  const { colors, radii } = useTheme();
+  const propia = useFotoPropia(vehicle.id);
+  const placaVisible = placa && placa !== numero ? placa : '';
+  const etiqueta = [numero, placaVisible, avisoLabel].filter(Boolean).join(', ');
+
+  return (
+    <PressableScale
+      onPress={() => onPress(vehicle.id)}
+      accessibilityRole="button"
+      accessibilityLabel={etiqueta}
+      accessibilityHint="Abre su ficha con la ubicación"
+      style={{ marginBottom: TARJETA_AIRE }}>
+      <View
+        style={[
+          styles.tarjeta,
+          {
+            backgroundColor: resaltada ? tinte(colors.primary, 0.08) : colors.surface,
+            borderColor: resaltada ? tinte(colors.primary, 0.5) : colors.border,
+            borderRadius: radii.lg - 4,
+          },
+        ]}>
+        {/* La foto, sobre un fondo hundido: el recorte sin fondo flota en él. */}
+        <View style={[styles.foto, { backgroundColor: colors.surfaceSunken, borderRadius: radii.md }]}>
+          <FotoSinFondo vehicle={vehicle} ancho={propia.tipo === 'foto' ? 80 : FOTO_ANCHO} propia={propia} />
+        </View>
+
+        <View style={styles.textos}>
+          {/* El número manda: nunca cede. Si el aviso es largo, el que se recorta es el aviso. */}
+          <View style={styles.fila}>
