+
+/**
+ * LOS FILTROS DE MANTENIMIENTO, arriba de la lista y como en la web: el estado
+ * en un control de píldora (cada opción con su punto de color y su cuenta; la
+ * elegida rellena en el azul FOM) y, al lado, el botón «Tipo» que abre las
+ * opciones. El control se desliza de lado si no cabe: nunca corta el texto.
+ */
+
+/** El azul FOM es fijo en web y app, con su texto oscuro encima (nunca blanco). */
+const AZUL_FOM = '#3D9BF5';
+const SOBRE_AZUL = '#08121C';
+
+/** Los 3 estados visibles de una ODT, y «Todas». */
+export type GrupoEstado = 'todas' | 'abierta' | 'revision' | 'resuelta';
+
+const GRUPOS: { id: GrupoEstado; label: string; tono?: keyof ColorTokens }[] = [
+  { id: 'todas', label: 'Todas' },
+  { id: 'abierta', label: 'Abiertas', tono: 'warning' },
+  { id: 'revision', label: 'En revisión', tono: 'info' },
+  { id: 'resuelta', label: 'Resueltas', tono: 'success' },
+];
+
+export type OpcionTipo = { id: string; label: string; cuenta: number };
+
+export function FiltroEstadoMantenimiento({
+  valor,
+  onCambiar,
+  cuentas,
+  tipos,
+  tipo,
+  onTipo,
+}: {
+  valor: GrupoEstado;
+  onCambiar: (g: GrupoEstado) => void;
+  /** Cuántas hay en cada estado. Un texto («—») cuando no se sabe. */
+  cuentas: Record<GrupoEstado, number | string>;
+  /** Las opciones del botón «Tipo» (sin «Todos los tipos», que se añade solo). */
+  tipos: OpcionTipo[];
+  /** El tipo elegido; '' = todos. */
+  tipo: string;
+  onTipo: (id: string) => void;
+}) {
+  const { colors, spacing, borderWidths, radii } = useTheme();
+  const [abierto, setAbierto] = useState(false);
+  const elegido = tipos.find((t) => t.id === tipo);
+  const total = tipos.reduce((a, t) => a + t.cuenta, 0);
+
+  return (
+    <View style={[styles.fila, { gap: spacing.sm }]}>
+      <View
+        style={[
+          styles.riel,
+          { backgroundColor: colors.surfaceSunken, borderColor: colors.border, borderWidth: borderWidths.hairline },
+        ]}>
+        <RielOpciones seleccion={valor} contentContainerStyle={styles.rielContenido}>
+          {GRUPOS.map((g) => {
+            const on = g.id === valor;
+            const cuenta = cuentas[g.id];
+            return (
+              <OpcionRiel key={g.id} id={g.id}>
+                <Pressable
