+/**
+ * POST multipart con XMLHttpRequest: en React Native es el que entiende los
+ * archivos `{uri, name, type}` dentro de un FormData (el `fetch` de Expo no).
+ */
+function enviarFormulario(
+  url: string,
+  body: FormData,
+  limite: number,
+): Promise<{ status: number; texto: string; json: unknown }> {
+  return new Promise((resolve, reject) => {
+    const xhr = new XMLHttpRequest();
+    xhr.open('POST', url);
+    xhr.timeout = limite;
+    xhr.onload = () => {
+      let json: unknown = null;
+      try {
+        json = JSON.parse(xhr.responseText);
+      } catch {
+        json = null;
+      }
+      resolve({ status: xhr.status, texto: xhr.responseText ?? '', json });
+    };
+    xhr.onerror = () => reject(new Error('sin conexión con Cloudinary'));
+    xhr.ontimeout = () => reject(new Error(`tardó más de ${Math.round(limite / 1000)} s`));
+    xhr.send(body);
+  });
+}
