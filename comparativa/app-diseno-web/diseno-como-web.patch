+            </ThemedText>
+          ) : null}
+          <ScrollView style={styles.flex1} contentContainerStyle={{ gap: 6, paddingBottom: spacing.sm }}>
+            {linea.map((it) => {
+              if (it.viaje) {
+                const v = it.viaje;
+                const activo = viajeActivo === v.numero;
+                return (
+                  <PressableScale
+                    key={it.clave}
+                    onPress={() => {
+                      alElegirViaje(activo ? null : v.numero);
+                      if (!activo) {
+                        const limites = v.trazo && v.trazo.length > 1 ? v.trazo : v.puntos.map((p) => [p.lng, p.lat] as [number, number]);
