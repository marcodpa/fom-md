+/** El fondo suave de la pastilla de estado, del color de su tono. */
+function tinteEstado(colors: ColorTokens, tono: keyof ColorTokens): string {
+  if (tono === 'success') return colors.successSurface;
+  if (tono === 'warning') return colors.warningSurface;
+  return colors.surfaceElevated;
+}
+
+/** «hace 3 min», como `desde` de la web («ahora» bajo el minuto, días desde ayer). */
+function desdeWeb(iso: string, ahora: number): string {
+  const seg = Math.floor((ahora - new Date(iso).getTime()) / 1000);
+  if (seg < 60) return 'ahora';
+  const dias = Math.floor(seg / 86_400);
+  if (dias === 1) return 'ayer';
+  if (dias > 1) return `hace ${dias} días`;
+  return haceCuanto(iso, new Date(ahora));
+}
