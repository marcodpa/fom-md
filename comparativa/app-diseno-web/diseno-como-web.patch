+                  accessibilityRole="button"
+                  accessibilityState={{ selected: on }}
+                  accessibilityLabel={`${g.label}, ${cuenta}`}
+                  style={[styles.opcion, { backgroundColor: on ? AZUL_FOM : 'transparent' }]}>
+                  {g.tono ? (
