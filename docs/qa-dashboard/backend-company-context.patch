diff --git a/test/console-company-context.test.js b/test/console-company-context.test.js
new file mode 100644
index 0000000..992e7e4
--- /dev/null
+++ b/test/console-company-context.test.js
@@ -0,0 +1,62 @@
+'use strict';
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { ConsoleSessionGuard } = require('../dist/console-api/console-session.guard');
+const { ConsoleController } = require('../dist/console-api/console.controller');
+const { runWithActorStore, currentActor } = require('../dist/authentication/actor-context');
+const home = '10000000-0000-4000-8000-000000000001';
+const target = '10000000-0000-4000-8000-000000000002';
+function setup(role = 'admin_fom', exists = true) {
+  const actor = {userId:'person',tenantId:home,role,platformAdmin:role==='admin_fom'};
+  let queries = 0;
+  const scopes = {
+    isPlatformAdministrator: a => a.role === 'admin_fom' || a.platformAdmin,
+    requireWritable: async id => {
+      queries++;
+      assert.deepEqual(currentActor(),actor);
+      if(!exists) {const e=new Error('Not found');e.status=404;throw e;}
+      return {tenantId:id,writable:true};
+    },
+  };
+  const guard = new ConsoleSessionGuard(
+    {authenticate:async()=>({userId:actor.userId})},
+    {resolveByUserId:async()=>actor},
+    {mustChangePassword:async()=>false},scopes);
+  return {guard,actor,queries:()=>queries};
+}
+function context(selected) {
+  return {switchToHttp:()=>({getRequest:()=>({headers:{cookie:'__Host-fom_session=test',...(selected===undefined?{}:{'x-fom-console-tenant':selected})}})})};
+}
+test('admin selects a verified resource company while keeping identity and authority',async()=>{
+  const s=setup();
+  await runWithActorStore(async()=>{
+    await s.guard.canActivate(context(target));
+    assert.deepEqual(currentActor(),{...s.actor,tenantId:target});
+    assert.deepEqual(new ConsoleController({},{}).companyContext(),{tenantId:target,role:'admin_fom'});
+  });
+  assert.equal(s.queries(),1);
+});
+for(const role of ['supervisor','conductor','usuario','operator']) {
+  test(`${role} cannot select another company`,async()=>{
+    const s=setup(role);
+    await runWithActorStore(async()=>{
+      await assert.rejects(s.guard.canActivate(context(target)),e=>e.status===403);
+      assert.deepEqual(currentActor(),s.actor);
+    });
+    assert.equal(s.queries(),0);
+  });
+}
+test('invalid and missing companies never replace the actor context',async()=>{
+  for(const id of ['bad',target]) {
+    const s=setup('admin_fom',false);
+    await runWithActorStore(async()=>{
+      await assert.rejects(s.guard.canActivate(context(id)),e=>e.status===(id==='bad'?400:404));
+      assert.deepEqual(currentActor(),s.actor);
+    });
+  }
+});
+test('company context is request local and does not change the next global request',async()=>{
+  const s=setup();
+  await runWithActorStore(async()=>{await s.guard.canActivate(context(target));assert.equal(currentActor().tenantId,target);});
+  await runWithActorStore(async()=>{await s.guard.canActivate(context());assert.deepEqual(currentActor(),s.actor);});
+});
