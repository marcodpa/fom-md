-/** Velocidad a partir de la cual el lanzamiento manda sobre la posición. */
+/** Lo que asoma de la hoja abajo: la franja entera (nombre, velocidad y cifras de hoy). */
+const VISIBLE_BAJO = ALTO_FRANJA - SOLAPE;
+/** Velocidad (px/s) a partir de la cual el lanzamiento manda sobre la posición. */
 const VELOCIDAD_SNAP = 550;
 /** Lo que mide la franja compacta (miniatura de 44 + 10 arriba y abajo). */
 const ALTO_COMPACTA = 65;
+/** Cuánto hay que mover el dedo para decidir si arrastra la hoja o el contenido. */
+const UMBRAL_DECIDIR = 6;
+/** Segundos de impulso que se proyectan al soltar para elegir la altura. */
+const PROYECCION = 0.18;
+/** El resorte de las hojas (sin rebote), con el tope para que no asome nada por debajo. */
+const RESORTE_HOJA = { ...RESORTE.hoja, overshootClamping: true };
+
+/** Las tres alturas de la hoja. */
+const NIVEL = { arriba: 0, media: 1, abajo: 2 } as const;
+type Nivel = 0 | 1 | 2;
+
+/** La última altura en que se dejó la hoja: se recuerda mientras la app siga abierta. */
+let ultimoNivel: Nivel = NIVEL.media;
+function recordarNivel(n: Nivel) {
+  ultimoNivel = n;
+}
+
+/** Desplazamiento de la hoja en cada altura (0 = arriba del todo). */
+function destinoDe(nivel: number, media: number, bajo: number): number {
+  'worklet';
+  return nivel === 0 ? 0 : nivel === 1 ? media : bajo;
+}
+
+/**
+ * A qué altura cae la hoja al soltarla: la más cercana, o —con impulso— la
+ * siguiente en el sentido del lanzamiento (y más lejos si el impulso da para
+ * tanto), como la hoja de Mapas.
+ */
+function alturaAlSoltar(y: number, velocidad: number, media: number, bajo: number): Nivel {
+  'worklet';
+  const puntos = [0, media, bajo];
+  const sentido = velocidad < 0 ? -1 : 1;
+  let objetivo = y;
+  let candidatos = [0, 1, 2];
+  if (Math.abs(velocidad) > VELOCIDAD_SNAP) {
+    const delante = candidatos.filter((i) => sentido * (puntos[i] - y) > 12);
+    if (delante.length > 0) {
+      candidatos = delante;
+      objetivo = y + velocidad * PROYECCION;
+    }
+  }
+  let mejor = candidatos[0];
+  for (const i of candidatos) {
+    if (Math.abs(puntos[i] - objetivo) < Math.abs(puntos[mejor] - objetivo)) mejor = i;
+  }
+  return mejor as Nivel;
+}
 
