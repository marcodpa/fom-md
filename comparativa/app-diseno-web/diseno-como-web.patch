+/**
+ * EL RECORRIDO de una unidad: viajes, paradas y la cola de los últimos minutos.
+ *
+ * Es la misma lógica del Centro de control del panel web (`datos/recorrido.js`),
+ * así que la app y la web parten el día de una unidad en los mismos viajes y
+ * las mismas paradas. Funciones puras: sin red ni pantalla.
+ *
+ * Entran puntos {lat, lng, hora, velocidadKmh?} del más antiguo al más reciente,
+ * CRUDOS: el tiempo que la unidad pasó estacionada sale justo de los puntos de
+ * un GPS parado.
+ */
+
+export type PuntoRuta = {
+  lat: number;
+  lng: number;
+  /** Hora ISO del punto. */
+  hora: string;
+  velocidadKmh?: number | null;
+  ignition?: boolean | null;
+};
+
+export type Parada = {
+  lat: number;
+  lng: number;
+  desde: string;
+  hasta: string;
+  minutos: number;
+  primero: number;
+  ultimo: number;
+};
+
+export type Viaje = {
+  numero: number;
+  puntos: PuntoRuta[];
+  /** El trazo por las calles ([lng, lat]) cuando Mapbox lo pudo pegar. */
+  trazo?: [number, number][];
+  distanciaM: number;
+  minutos: number;
+  inicio: { lat: number; lng: number; hora: string };
+  fin: { lat: number; lng: number; hora: string; enCurso: boolean };
+};
+
+export type Analisis = { puntos: PuntoRuta[]; paradas: Parada[]; viajes: Viaje[] };
+
+/** Una unidad que se queda en el mismo sitio al menos esto (minutos) está estacionada. */
+export const MIN_PARADA_MIN = 5;
+/** «El mismo sitio»: un GPS parado baila decenas de metros alrededor de su sitio real. */
+export const RADIO_PARADA_M = 100;
+/** Un viaje más corto que esto (metros) es ruido del GPS, no un viaje. */
+const MIN_VIAJE_M = 150;
+
+const RADIO_TIERRA_M = 6371000;
+const rad = (g: number) => (g * Math.PI) / 180;
+
+/** Distancia en metros entre dos puntos (haversine). */
+export function distanciaM(a: { lat: number; lng: number }, b: { lat: number; lng: number }): number {
+  const dLat = rad(b.lat - a.lat);
+  const dLng = rad(b.lng - a.lng);
+  const h = Math.sin(dLat / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLng / 2) ** 2;
+  return 2 * RADIO_TIERRA_M * Math.asin(Math.min(1, Math.sqrt(h)));
+}
+
+const tiempo = (p: { hora: string }) => Date.parse(p.hora);
+const minutosEntre = (a: PuntoRuta, b: PuntoRuta) => Math.max(0, (tiempo(b) - tiempo(a)) / 60000);
+
+/**
+ * Quita los «saltos» del GPS: puntos que aparecen lejos, más rápido de lo que
+ * la unidad dice que va, y que vuelven enseguida. Si los puntos lejanos se
+ * repiten (4 seguidos) se acepta que la unidad sí se movió.
+ */
+export function quitarSaltos(
+  puntos: PuntoRuta[],
+  { minM = 150, kmhMin = 25, kmhTope = 160, seguidos = 4 } = {},
+): PuntoRuta[] {
+  const salida: PuntoRuta[] = [];
+  let rechazados = 0;
+  for (const p of puntos ?? []) {
+    const a = salida[salida.length - 1];
+    if (!a) {
+      salida.push(p);
+      continue;
+    }
+    const dt = Math.abs(tiempo(p) - tiempo(a)) / 3600000;
+    const m = distanciaM(a, p);
+    const dicha = Math.max(a.velocidadKmh ?? 0, p.velocidadKmh ?? 0);
+    const conocida = a.velocidadKmh != null && p.velocidadKmh != null;
+    const tope = conocida ? Math.max(dicha * 2, kmhMin) : kmhTope;
+    const salto = m > minM && (dt <= 0 || m / 1000 / dt > tope);
+    if (salto && rechazados < seguidos - 1) {
+      rechazados++;
+      continue;
+    }
+    rechazados = 0;
+    salida.push(p);
+  }
+  return salida;
+}
+
+function validos(puntos: PuntoRuta[]): PuntoRuta[] {
+  return (puntos ?? [])
+    .filter((p) => p && Number.isFinite(p.lat) && Number.isFinite(p.lng) && Number.isFinite(tiempo(p)))
+    .sort((a, b) => tiempo(a) - tiempo(b));
+}
+
+function largo(puntos: PuntoRuta[]): number {
+  let m = 0;
+  for (let i = 1; i < puntos.length; i++) m += distanciaM(puntos[i - 1], puntos[i]);
+  return m;
+}
+
+/** Último índice del grupo que empieza en `i` sin alejarse más de `radioM` de su centro. */
+function barrido(p: PuntoRuta[], i: number, radioM: number, admite: (x: PuntoRuta) => boolean = () => true): number {
+  let sLat = p[i].lat;
+  let sLng = p[i].lng;
+  let n = 1;
+  let j = i;
+  while (j + 1 < p.length && admite(p[j + 1])) {
+    if (distanciaM({ lat: sLat / n, lng: sLng / n }, p[j + 1]) > radioM) break;
+    j++;
+    sLat += p[j].lat;
+    sLng += p[j].lng;
+    n++;
+  }
+  return j;
+}
+
+/** Colapsa a UN punto cada racha quieta: la deriva de un GPS parado no es un viaje. */
+export function compactarQuietud(puntos: PuntoRuta[], { radioM = RADIO_PARADA_M, velMax = 8 } = {}): PuntoRuta[] {
+  const p = validos(puntos);
+  const quieto = (x: PuntoRuta) => x.ignition === false || x.velocidadKmh == null || x.velocidadKmh <= velMax;
+  const salida: PuntoRuta[] = [];
+  let i = 0;
+  while (i < p.length) {
+    if (!quieto(p[i])) {
+      salida.push(p[i++]);
+      continue;
+    }
+    const j = barrido(p, i, radioM, quieto);
+    if (j > i) {
+      const grupo = p.slice(i, j + 1);
+      salida.push({
+        ...p[j],
+        lat: grupo.reduce((s, x) => s + x.lat, 0) / grupo.length,
+        lng: grupo.reduce((s, x) => s + x.lng, 0) / grupo.length,
+        velocidadKmh: 0,
+      });
+    } else {
+      salida.push(p[i]);
+    }
+    i = j + 1;
+  }
+  return salida;
+}
+
+/** Los tramos en que la unidad no salió de `radioM` durante al menos `minParadaMin`. */
+export function detectarParadas(
+  puntos: PuntoRuta[],
+  { minParadaMin = MIN_PARADA_MIN, radioM = RADIO_PARADA_M } = {},
+): { puntos: PuntoRuta[]; paradas: Parada[] } {
+  const p = validos(puntos);
+  const paradas: Parada[] = [];
+  let i = 0;
+  while (i < p.length) {
+    const j = barrido(p, i, radioM);
+    if (j > i && minutosEntre(p[i], p[j]) >= minParadaMin) {
+      const tramo = p.slice(i, j + 1);
+      paradas.push({
+        lat: tramo.reduce((s, x) => s + x.lat, 0) / tramo.length,
+        lng: tramo.reduce((s, x) => s + x.lng, 0) / tramo.length,
+        desde: p[i].hora,
+        hasta: p[j].hora,
+        minutos: minutosEntre(p[i], p[j]),
+        primero: i,
+        ultimo: j,
+      });
+      i = j + 1;
+    } else {
+      i++;
+    }
+  }
+  return { puntos: p, paradas };
+}
+
+/** Parte el recorrido en viajes, de parada a parada. `fin.enCurso`: sigue en camino. */
+export function analizar(puntos: PuntoRuta[]): Analisis {
+  const { puntos: p, paradas } = detectarParadas(puntos);
+  const viajes: Viaje[] = [];
+  const cortes: [number, number][] = [];
+  let desde = 0;
+  for (const s of paradas) {
+    cortes.push([desde, s.primero]);
+    desde = s.ultimo;
+  }
+  cortes.push([desde, p.length - 1]);
+  for (const [a, b] of cortes) {
+    if (b <= a) continue;
+    const tramo = p.slice(a, b + 1);
+    const distancia = largo(tramo);
+    if (distancia < MIN_VIAJE_M) continue;
+    const ultimo = tramo[tramo.length - 1];
+    viajes.push({
+      numero: viajes.length + 1,
+      puntos: compactarQuietud(tramo),
+      distanciaM: distancia,
+      minutos: minutosEntre(tramo[0], ultimo),
+      inicio: { lat: tramo[0].lat, lng: tramo[0].lng, hora: tramo[0].hora },
+      fin: { lat: ultimo.lat, lng: ultimo.lng, hora: ultimo.hora, enCurso: b === p.length - 1 },
+    });
+  }
+  return { puntos: p, paradas, viajes };
+}
+
+/** Resumen para el encabezado del recorrido. */
+export function resumen({ viajes = [], paradas = [] }: { viajes?: Viaje[]; paradas?: Parada[] }) {
+  return {
+    viajes: viajes.length,
+    km: viajes.reduce((s, v) => s + v.distanciaM, 0) / 1000,
+    paradas: paradas.length,
+    minutosParada: paradas.reduce((s, x) => s + x.minutos, 0),
+  };
+}
+
+/** "2 h 15 min", "40 min". */
+export function duracion(minutos: number): string {
+  const m = Math.round(minutos);
+  if (m < 60) return `${m} min`;
+  const h = Math.floor(m / 60);
+  const r = m % 60;
+  return r ? `${h} h ${r} min` : `${h} h`;
+}
+
+/** "14:05" en la hora del teléfono. */
+export function horaCorta(iso: string): string {
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return '';
+  return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
+}
