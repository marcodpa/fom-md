+++ b/src/components/mapa-fom-dom.tsx
@@ -0,0 +1,507 @@
+'use dom';
+
+/**
+ * EL MAPA DE MAPBOX DE LA WEB, DENTRO DE LA APP.
+ *
+ * Es un componente "DOM" de Expo: corre Mapbox GL JS —la misma librería y el
+ * mismo estilo que el panel web— dentro de una vista web de la app. Así el
+ * mapa funciona también en Expo Go, que no trae el Mapbox nativo, y el
+ * teléfono ve exactamente lo que ve la web: luz de noche FOM, 3D, satélite,
+ * tráfico y el recorrido de una unidad con sus viajes y paradas.
+ *
+ * Aquí no hay tema ni contexto de la app (esto vive en otra página): todo
+ * llega ya resuelto por props —colores, marcadores, ruta— desde
+ * `map-vehiculo-dom.tsx`, y lo que el usuario toca vuelve por las funciones.
+ */
+import 'mapbox-gl/dist/mapbox-gl.css';
+import type { DOMProps } from 'expo/dom';
+import { useEffect, useRef, useState, type CSSProperties } from 'react';
+
+import { duracion, horaCorta } from '@/lib/recorrido';
+
+type Coord = [number, number];
+
+export type MarcadorDom = {
+  id: string;
+  label: string;
+  detalle?: string;
+  lat: number;
+  lng: number;
+  color: string;
+  /** Rumbo en grados cuando va en marcha: el punto se vuelve flecha. */
+  rumbo?: number | null;
+  placa?: string;
+  /** Estela reciente, [lng, lat]. */
+  estela?: Coord[];
+};
+
+export type RutaDom = {
+  viajes: {
+    numero: number;
+    trazo: Coord[];
+    inicio: { lat: number; lng: number; hora: string };
+    fin: { lat: number; lng: number; hora: string; enCurso: boolean };
+    minutos: number;
+    km: number;
+  }[];
+  paradas: { lat: number; lng: number; minutos: number; desde: string; hasta: string }[];
+};
+
+export type ColoresDom = {
+  fondo: string;
+  superficie: string;
+  texto: string;
+  textoSec: string;
+  borde: string;
+  primario: string;
+  exito: string;
+  peligro: string;
+};
+
+type Props = {
+  token: string;
+  estilo: string;
+  config: Record<string, string | boolean>;
+  colores: ColoresDom;
+  marcadores: MarcadorDom[];
+  resaltadoId?: string | null;
+  usuario?: { lat: number; lng: number } | null;
+  ruta?: RutaDom | null;
+  viajeActivo?: number | null;
+  /** Lleva la cámara a un sitio (o a unos límites). `clave` cambia en cada pedido. */
+  foco?: { lat: number; lng: number; limites?: Coord[]; clave: number } | null;
+  tipo: 'standard' | 'satellite';
+  tresD: boolean;
+  trafico: boolean;
+  /** Lo que tapa el mapa por arriba y por abajo: los controles y el encuadre lo respetan. */
+  margenArriba: number;
+  margenAbajo: number;
+  encuadreClave?: string;
+  /** Texto de la píldora de arriba a la izquierda (null: sin píldora). */
+  pildora?: string | null;
+  onMarcador?: (id: string) => Promise<void>;
+  onMapa?: () => Promise<void>;
+  onPrefs?: (cambio: { tipo?: 'standard' | 'satellite'; tresD?: boolean; trafico?: boolean }) => Promise<void>;
+  onViaje?: (numero: number | null) => Promise<void>;
+  dom?: DOMProps;
+};
+
+type Gl = typeof import('mapbox-gl');
+type Mapa = import('mapbox-gl').Map;
+type Marca = import('mapbox-gl').Marker;
+
+const PITCH_3D = 55;
+const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);
+
+export default function MapaFomDom(props: Props) {
+  const { colores, marcadores, ruta, viajeActivo, foco, tresD, trafico, tipo, margenArriba, margenAbajo } = props;
+  const caja = useRef<HTMLDivElement>(null);
+  const mapa = useRef<Mapa | null>(null);
+  const gl = useRef<Gl | null>(null);
+  const marcas = useRef(new Map<string, Marca>());
+  const marcasRuta = useRef<Marca[]>([]);
+  const marcaUsuario = useRef<Marca | null>(null);
+  // Las funciones de la app cambian en cada render: el mapa llama siempre a la última.
+  const ultimas = useRef(props);
+  ultimas.current = props;
+  // Sube cada vez que el estilo termina de cargar: las capas propias se vuelven a poner.
+  const [estiloListo, setEstiloListo] = useState(0);
+
+  // Crear el mapa una vez.
+  useEffect(() => {
+    let vivo = true;
+    (async () => {
+      const modulo = await import('mapbox-gl');
+      const mapboxgl = ((modulo as unknown as { default?: Gl }).default ?? modulo) as Gl;
+      if (!vivo || !caja.current) return;
+      gl.current = mapboxgl;
+      const p = ultimas.current;
+      const primero = p.marcadores[0];
+      const m = new mapboxgl.Map({
+        container: caja.current,
+        accessToken: p.token,
+        style: p.estilo,
+        config: { basemap: p.config },
+        center: primero ? [primero.lng, primero.lat] : p.usuario ? [p.usuario.lng, p.usuario.lat] : [-71.62, 10.65],
+        zoom: primero ? 11 : 11,
+        pitch: p.tresD ? PITCH_3D : 0,
+        projection: 'mercator',
+        attributionControl: false,
+        language: 'es',
+      } as never);
+      m.addControl(new mapboxgl.AttributionControl({ compact: true }), 'bottom-left');
+      m.on('click', () => void ultimas.current.onMapa?.());
+      m.on('style.load', () => setEstiloListo((n) => n + 1));
+      mapa.current = m;
+    })();
+    const alCambiarTamano = () => mapa.current?.resize();
+    window.addEventListener('resize', alCambiarTamano);
+    return () => {
+      vivo = false;
+      window.removeEventListener('resize', alCambiarTamano);
+      mapa.current?.remove();
+      mapa.current = null;
+    };
+  }, []);
+
+  // Capa y tema: el estilo cambia entero (y las capas propias vuelven con `style.load`).
+  const firmaEstilo = `${props.estilo}|${JSON.stringify(props.config)}`;
+  const estiloPuesto = useRef(firmaEstilo);
+  useEffect(() => {
+    const m = mapa.current;
+    if (!m || estiloPuesto.current === firmaEstilo) return;
+    estiloPuesto.current = firmaEstilo;
+    m.setStyle(props.estilo, { config: { basemap: props.config } } as never);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [firmaEstilo]);
+
+  useEffect(() => {
+    mapa.current?.easeTo({ pitch: tresD ? PITCH_3D : 0, duration: 400 });
+  }, [tresD]);
+
+  // TRÁFICO en vivo, como en la web: el color de la vía dice cómo está.
+  useEffect(() => {
+    const m = mapa.current;
+    if (!m || !estiloListo) return;
+    if (trafico && !m.getSource('fom-trafico')) {
+      m.addSource('fom-trafico', { type: 'vector', url: 'mapbox://mapbox.mapbox-traffic-v1' });
+      m.addLayer({
+        id: 'fom-trafico',
+        type: 'line',
+        source: 'fom-trafico',
+        'source-layer': 'traffic',
+        slot: 'middle',
+        layout: { 'line-join': 'round', 'line-cap': 'round' },
+        paint: {
+          'line-width': ['interpolate', ['linear'], ['zoom'], 10, 1.5, 16, 5],
+          'line-emissive-strength': 1,
+          'line-color': [
+            'match',
+            ['get', 'congestion'],
+            'low', '#3dd68c',
+            'moderate', '#f5c242',
+            'heavy', '#ff8a3d',
+            'severe', '#ff6369',
+            '#3dd68c',
+          ],
+        },
+      } as never);
+    } else if (!trafico && m.getSource('fom-trafico')) {
+      if (m.getLayer('fom-trafico')) m.removeLayer('fom-trafico');
+      m.removeSource('fom-trafico');
+    }
+  }, [trafico, estiloListo]);
+
+  // Marcadores de las unidades: la placa encima y el punto (o la flecha) debajo.
+  useEffect(() => {
+    const m = mapa.current;
+    const mapboxgl = gl.current;
+    if (!m || !mapboxgl) return;
+    const vistos = new Set<string>();
+    for (const p of marcadores) {
+      vistos.add(p.id);
+      const resaltado = p.id === props.resaltadoId;
+      const html =
+        (p.placa
+          ? `<span class="fom-placa" style="border-color:${p.color};background:${colores.superficie};color:${colores.texto}">${esc(p.placa)}</span>`
+          : '') +
+        (p.rumbo == null
+          ? `<span class="fom-punto" style="background:${p.color};border-color:${colores.fondo};box-shadow:0 0 0 ${resaltado ? 7 : 4}px ${p.color}55"></span>`
+          : `<svg class="fom-flecha" width="28" height="28" viewBox="0 0 24 24" style="transform:rotate(${p.rumbo}deg)"><path d="M12 2.5 L20 21 L12 16.5 L4 21 Z" fill="${p.color}" stroke="${colores.fondo}" stroke-width="2" stroke-linejoin="round"/></svg>`);
+      let marca = marcas.current.get(p.id);
+      if (!marca) {
+        const el = document.createElement('div');
+        el.className = 'fom-marcador';
+        el.addEventListener('click', (e) => {
+          e.stopPropagation();
+          void ultimas.current.onMarcador?.(p.id);
+        });
+        marca = new mapboxgl.Marker({ element: el, anchor: 'bottom' }).setLngLat([p.lng, p.lat]).addTo(m);
+        marcas.current.set(p.id, marca);
+      } else {
+        marca.setLngLat([p.lng, p.lat]);
+      }
+      const el = marca.getElement();
+      el.innerHTML = html;
+      el.style.zIndex = resaltado ? '5' : '1';
+    }
+    marcas.current.forEach((marca, id) => {
+      if (!vistos.has(id)) {
+        marca.remove();
+        marcas.current.delete(id);
+      }
+    });
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [marcadores, props.resaltadoId, colores]);
+
+  // Estelas (la cola reciente de cada unidad), por debajo de los marcadores.
+  useEffect(() => {
+    const m = mapa.current;
+    if (!m || !estiloListo) return;
+    const datos = {
+      type: 'FeatureCollection' as const,
+      features: marcadores
+        .filter((p) => (p.estela?.length ?? 0) > 1)
+        .map((p) => ({
+          type: 'Feature' as const,
+          properties: { color: p.color },
+          geometry: { type: 'LineString' as const, coordinates: p.estela! },
+        })),
+    };
+    const fuente = m.getSource('fom-estelas') as import('mapbox-gl').GeoJSONSource | undefined;
+    if (fuente) fuente.setData(datos);
+    else {
+      m.addSource('fom-estelas', { type: 'geojson', data: datos });
+      m.addLayer({
+        id: 'fom-estelas',
+        type: 'line',
+        source: 'fom-estelas',
+        slot: 'top',
+        layout: { 'line-cap': 'round', 'line-join': 'round' },
+        paint: { 'line-color': ['get', 'color'], 'line-width': 4, 'line-opacity': 0.9, 'line-dasharray': [0.1, 1.8], 'line-emissive-strength': 1 },
+      } as never);
+    }
+  }, [marcadores, estiloListo]);
+
+  // TU ubicación: el punto azul de siempre.
+  useEffect(() => {
+    const m = mapa.current;
+    const mapboxgl = gl.current;
+    if (!m || !mapboxgl) return;
+    const u = props.usuario;
+    if (!u) {
+      marcaUsuario.current?.remove();
+      marcaUsuario.current = null;
+      return;
+    }
+    if (!marcaUsuario.current) {
+      const el = document.createElement('div');
+      el.className = 'fom-yo';
+      marcaUsuario.current = new mapboxgl.Marker({ element: el, anchor: 'center' }).setLngLat([u.lng, u.lat]).addTo(m);
+    } else marcaUsuario.current.setLngLat([u.lng, u.lat]);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [props.usuario?.lat, props.usuario?.lng, estiloListo]);
+
+  // EL RECORRIDO: viajes (línea por las calles), inicio A, fin B y paradas P.
+  useEffect(() => {
+    const m = mapa.current;
+    const mapboxgl = gl.current;
+    if (!m || !mapboxgl || !estiloListo) return;
+    marcasRuta.current.forEach((x) => x.remove());
+    marcasRuta.current = [];
+    const datos = {
+      type: 'FeatureCollection' as const,
+      features: (ruta?.viajes ?? [])
