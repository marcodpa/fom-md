diff --git a/src/lib/mapbox-api.ts b/src/lib/mapbox-api.ts
new file mode 100644
index 0000000..0721520
--- /dev/null
+++ b/src/lib/mapbox-api.ts
@@ -0,0 +1,136 @@
+/**
+ * MAP MATCHING de Mapbox: pega un recorrido GPS a las calles (quita el
+ * «garabato»). Es la misma llamada que hace el panel web, con el token público
+ * de la app. Los resultados se guardan en memoria para no repetir la pregunta.
+ */
+import { MAPBOX_TOKEN } from '@/lib/mapbox';
+import type { PuntoRuta, Viaje } from '@/lib/recorrido';
+
+const BASE = 'https://api.mapbox.com';
+type Coord = [number, number];
+type Emparejado = { puntos: PuntoRuta[]; trazo: Coord[] };
+const cache = new Map<string, Promise<Emparejado | null>>();
+
+/** Distancia a partir de la cual el final por calle y el punto real se unen con un tramo. */
+const UNION_M = 10;
+/** Hasta dónde puede estar un punto de la calle para que Mapbox lo tome (máx. 50). */
+const RADIO_M = 40;
+
+const coord = (p: { lat: number; lng: number }) => `${p.lng.toFixed(6)},${p.lat.toFixed(6)}`;
+
+function metros(a: Coord, b: Coord): number {
+  const r = Math.PI / 180;
+  const dLat = (b[1] - a[1]) * r;
+  const dLng = (b[0] - a[0]) * r;
+  const h = Math.sin(dLat / 2) ** 2 + Math.cos(a[1] * r) * Math.cos(b[1] * r) * Math.sin(dLng / 2) ** 2;
+  return 2 * 6371000 * Math.asin(Math.sqrt(h));
+}
+const largoDe = (c: Coord[]) => c.reduce((t, x, i) => (i ? t + metros(c[i - 1], x) : 0), 0);
+
+/** Trozos de `tam` puntos (el tope de Mapbox es 100) que comparten un punto con el anterior. */
+function partir<T>(lista: T[], tam = 100, solape = 1): T[][] {
+  if (lista.length <= tam) return [lista];
+  const trozos: T[][] = [];
+  let desde = 0;
+  while (desde < lista.length) {
+    trozos.push(lista.slice(desde, desde + tam));
+    if (desde + tam >= lista.length) break;
+    desde += tam - solape;
+  }
+  return trozos;
+}
+
+function unir(trazos: Coord[][]): Coord[] {
+  const salida: Coord[] = [];
+  for (const t of trazos) {
+    for (const c of t) {
+      const u = salida[salida.length - 1];
+      if (u && u[0] === c[0] && u[1] === c[1]) continue;
+      salida.push(c);
+    }
+  }
+  return salida;
+}
+
+/** Segundos Unix de cada punto, solo si todos tienen hora y van en orden. */
+function marcasDeTiempo(puntos: PuntoRuta[]): number[] | null {
+  const t = puntos.map((p) => Math.floor(Date.parse(p.hora) / 1000));
+  if (t.some((x) => !Number.isFinite(x))) return null;
+  for (let i = 1; i < t.length; i++) if (t[i] < t[i - 1]) return null;
+  return t;
+}
+
+type Respuesta = {
+  code?: string;
+  matchings?: { geometry?: { coordinates?: Coord[] } }[];
+  tracepoints?: ({ location?: Coord } | null)[];
+};
+
+/** Lo que devuelve Mapbox para un trozo; null si no coincide o dio una vuelta que no existió. */
+function aplicar(puntos: PuntoRuta[], r: Respuesta): Emparejado | null {
+  const matchings = r?.matchings ?? [];
+  if (r?.code !== 'Ok' || !matchings.length) return null;
+  const trazo = unir(matchings.map((m) => m.geometry?.coordinates ?? []));
+  if (trazo.length < 2) return null;
+  // La calle no entra al estacionamiento: se une con el punto real del GPS.
+  const primero: Coord = [puntos[0].lng, puntos[0].lat];
+  const ultimo: Coord = [puntos[puntos.length - 1].lng, puntos[puntos.length - 1].lat];
+  if (metros(primero, trazo[0]) > UNION_M) trazo.unshift(primero);
+  if (metros(trazo[trazo.length - 1], ultimo) > UNION_M) trazo.push(ultimo);
+  const crudo = largoDe(puntos.map((p) => [p.lng, p.lat] as Coord));
+  if (largoDe(trazo) > crudo * 2.5 + 500) return null;
+  const trace = r.tracepoints ?? [];
+  const ajustados = puntos.map((p, i) => {
+    const t = trace[i];
+    return t?.location ? { ...p, lng: t.location[0], lat: t.location[1] } : p;
+  });
+  return { puntos: ajustados, trazo };
+}
+
+/** Pega un recorrido a las calles; null si no se pudo (sin token, sin red o sin calles). */
+export function emparejarPuntos(puntos: PuntoRuta[]): Promise<Emparejado | null> {
+  if (!MAPBOX_TOKEN || puntos.length < 2) return Promise.resolve(null);
+  const medio = puntos[Math.floor(puntos.length / 2)];
+  const clave = `${puntos.length}:${coord(puntos[0])}:${coord(medio)}:${coord(puntos[puntos.length - 1])}`;
+  const guardado = cache.get(clave);
+  if (guardado) return guardado;
+  const calculo = (async (): Promise<Emparejado | null> => {
+    const partes: Emparejado[] = [];
+    for (const trozo of partir(puntos)) {
+      const tiempos = marcasDeTiempo(trozo);
+      const url =
+        `${BASE}/matching/v5/mapbox/driving/${trozo.map(coord).join(';')}` +
+        `?geometries=geojson&overview=full&radiuses=${trozo.map(() => RADIO_M).join(';')}` +
+        (tiempos ? `&timestamps=${tiempos.join(';')}` : '') +
+        `&access_token=${encodeURIComponent(MAPBOX_TOKEN)}`;
+      const res = await fetch(url);
+      if (!res.ok) throw new Error(`Mapbox respondió ${res.status}`);
+      const parte = aplicar(trozo, (await res.json()) as Respuesta);
+      if (!parte) return null;
+      partes.push(parte);
+    }
+    return {
+      puntos: partes.flatMap((p, i) => (i === 0 ? p.puntos : p.puntos.slice(1))),
+      trazo: unir(partes.map((p) => p.trazo)),
+    };
+  })().catch((e: unknown) => {
+    cache.delete(clave);
+    throw e;
+  });
+  cache.set(clave, calculo);
+  return calculo;
+}
+
+/** Cada viaje pegado a las calles; el que no se pueda queda como estaba. */
+export function emparejarViajes(viajes: Viaje[]): Promise<Viaje[]> {
+  return Promise.all(
+    viajes.map(async (v) => {
+      try {
+        const r = await emparejarPuntos(v.puntos);
+        return r ? { ...v, puntos: r.puntos, trazo: r.trazo } : v;
+      } catch {
+        return v;
+      }
+    }),
+  );
+}
