new file mode 100644
index 0000000..fc35d20
--- /dev/null
+++ b/src/theme/movimiento.ts
@@ -0,0 +1,143 @@
+/**
+ * MOVIMIENTO DE FOM: los mismos tiempos y curvas que el panel web (T-184 en la
+ * web, `src/styles/MOVIMIENTO.md`; T-185 aquí). Un solo sitio para que toda la
+ * app se mueva igual: navegación, pestañas, hojas, listas, carga y toques.
+ *
+ * Reglas que se cumplen en todos lados:
+ *  - Solo `transform` y `opacity`, que corren en el hilo de UI y no repintan.
+ *  - Con «reducir movimiento» del sistema no hay desplazamientos: o nada, o un
+ *    fundido.
+ *  - Entra con la curva de salida (llega rápido y se posa); se va con la de
+ *    entrada (arranca suave y desaparece), y siempre más rápido de lo que entró.
+ */
+
+import type { BottomTabNavigationOptions } from 'expo-router/js-tabs';
+import { Easing as EasingRN, Platform } from 'react-native';
+import { Easing } from 'react-native-reanimated';
+
+/** Las tres duraciones de la app y de la web (ms). */
+export const DURACION = {
+  /** Toques, lo que se va y los cambios pequeños. */
+  rapido: 140,
+  /** Lo normal: fundidos, pestañas, bloques que entran. */
+  normal: 240,
+  /** Lo grande: pantallas, hojas y el cambio de tema. */
+  lento: 380,
+} as const;
+
+/**
+ * Las curvas, como los cuatro números de un `cubic-bezier` de CSS: así se
+ * copian tal cual a la web y se usan aquí en los dos motores.
+ */
+export const CURVA = {
+  /** Llega rápido y se posa (lo que entra). */
+  salida: [0.22, 1, 0.36, 1],
+  /** Arranca suave y se acelera (lo que se va). */
+  entrada: [0.4, 0, 1, 1],
+  /** Ida y vuelta pareja (lo que late o cambia de sitio). */
+  enfasis: [0.65, 0, 0.35, 1],
+} as const;
+
+type Puntos = readonly [number, number, number, number];
+const bezierRN = (p: Puntos) => EasingRN.bezier(p[0], p[1], p[2], p[3]);
+
+/** Curvas para `Animated` de React Native (con `useNativeDriver`). */
+export const curvas = {
+  salida: bezierRN(CURVA.salida),
+  entrada: bezierRN(CURVA.entrada),
+  enfasis: bezierRN(CURVA.enfasis),
+};
+
+/**
+ * Curvas para Reanimated (`withTiming`). Dentro de un worklet se arman con
+ * `Easing.bezier(...CURVA.x)`, que sí viaja al hilo de UI.
+ */
+export const curvasUI = {
+  salida: Easing.bezier(CURVA.salida[0], CURVA.salida[1], CURVA.salida[2], CURVA.salida[3]),
+  entrada: Easing.bezier(CURVA.entrada[0], CURVA.entrada[1], CURVA.entrada[2], CURVA.entrada[3]),
+  enfasis: Easing.bezier(CURVA.enfasis[0], CURVA.enfasis[1], CURVA.enfasis[2], CURVA.enfasis[3]),
+};
+
+/**
+ * Resortes. Sirven igual en `Animated.spring` y en `withSpring`.
+ * La «amortiguación» de cada uno va anotada: 1 = sin rebote.
+ */
+export const RESORTE = {
+  /** Al soltar lo que se tocó: vuelve con un rebote que casi no se ve (0,65). */
+  toque: { damping: 18, stiffness: 320, mass: 0.6 },
+  /**
+   * Hojas que suben desde abajo: SIN rebote (≈1). Si rebotaran, por debajo
+   * del borde asomaría el velo durante un instante.
+   */
+  hoja: { damping: 30, stiffness: 230, mass: 1 },
+  /** Ventanas centradas y piezas que crecen: un pelo de rebote (0,72). */
+  ventana: { damping: 22, stiffness: 260, mass: 0.9 },
+} as const;
+
+/** Lo que se encoge lo que se toca. */
+export const ESCALA_PRESION = 0.97;
+
+/** Velo detrás de hojas y ventanas: se funde, nunca se desliza. */
+export const VELO = { abrir: DURACION.normal, cerrar: DURACION.rapido } as const;
+
+/**
+ * Entrada escalonada de bloques y filas (la cascada de la web): cada uno sube
+ * 10 px y se funde, 45 ms después del anterior. Solo la primera vez.
+ */
+export const ESCALONADO = {
+  subida: 10,
+  paso: 45,
+  /** De ahí en adelante ya está fuera de la vista: entra de una. */
+  maximo: 12,
+  /** Lo que dura «la primera vez» de una pantalla (ms). */
+  ventana: 900,
+} as const;
+
+/** Cifras que cuentan hasta su valor (ms). */
+export const CONTEO = {
+  /** Las de un tablero. */
+  tablero: 500,
+  /** La cifra grande de una ficha. */
+  destacada: 900,
+} as const;
+
+// ── Navegación ─────────────────────────────────────────────────────────────
+
+/**
+ * PANTALLAS: la de siempre del teléfono, entrando desde la derecha y volviendo
+ * con el gesto del borde. En Android se usa la de iOS (`ios_from_right`) para
+ * que el sentido y el gesto sean el mismo en los dos. Con «reducir
+ * movimiento», un fundido.
+ */
+export function opcionesPila(reducido: boolean) {
+  return {
+    animation: reducido ? 'fade' : Platform.OS === 'android' ? 'ios_from_right' : 'slide_from_right',
+    animationDuration: reducido ? DURACION.rapido : DURACION.lento,
+    gestureEnabled: true,
+  } as const;
+}
+
+/**
+ * SUPERFICIES de aterrizaje (login y el inicio de cada rol): no se empujan,
+ * se funden. Entrar a la app es cambiar de sitio, no avanzar en una pila.
+ */
+export const opcionesFundido = { animation: 'fade', animationDuration: DURACION.lento } as const;
+
+/** Rutas que suben como HOJA (Documentos). */
+export const opcionesHoja = {
+  presentation: 'modal',
+  animation: 'slide_from_bottom',
+  animationDuration: DURACION.lento,
+} as const;
+
+/**
+ * PESTAÑAS: fundido corto entre una y otra; la píldora de la barra es la que
+ * se desliza. Con «reducir movimiento», cambio seco.
+ */
+export function opcionesPestanas(reducido: boolean): BottomTabNavigationOptions {
+  if (reducido) return { animation: 'none' };
+  return {
+    animation: 'fade',
+    transitionSpec: { animation: 'timing', config: { duration: DURACION.normal, easing: curvas.salida } },
+  };
+}
