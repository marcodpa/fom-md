+    ),
+  ];
+  const descripcion = 'Personas, km, horas al volante, índice de manejo y papeles.';
+
+  const cifra = (k: string, v: string, pie: string, c?: Comparacion | null): string =>
+    `<div class="cf"><p class="nota">${esc(k)}</p><p class="cv">${esc(v)}</p>${
+      c ? `<p class="nota"><b>${esc(comparacionTexto(c))}</b></p>` : ''
+    }<p class="nota">${esc(pie)}</p></div>`;
+  const cmpKm = comparar(m.kmRecorridos, ant?.metrics.kmRecorridos, { modo: 'pct', altoEsBueno: null });
+  const cmpHoras = comparar(m.horasConducidas, ant?.metrics.horasConducidas, { modo: 'pct', altoEsBueno: null });
+  const cmpOt = comparar(m.otReportadas, ant?.metrics.otReportadas, { modo: 'abs', altoEsBueno: false });
+  const papeles =
+    m.papelesAlDia === null ? etiqueta('neutro', 'Sin papeles registrados') : papelPct(m.papelesAlDia);
+  piezas.push(
+    bloque(
+      ant ? 114 : 98,
+      `<div class="box cfs">
+  <div class="cf"><p class="nota">Personas</p><p class="cv">${entero(m.usuarios)}</p><p class="nota">${entero(m.conducen)} conducen</p></div>
+  <div class="cf"><p class="nota">Papeles al día</p><p class="cv">${m.papelesAlDia === null ? '—' : porcentaje(m.papelesAlDia)}</p><p>${papeles}</p></div>
+  ${cifra('Km recorridos', entero(m.kmRecorridos), ant ? `antes ${entero(ant.metrics.kmRecorridos)}` : 'del período', cmpKm)}
