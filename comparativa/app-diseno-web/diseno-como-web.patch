+                        on ? { borderWidth: 1.5, borderColor: SOBRE_AZUL } : null,
+                      ]}
+                    />
+                  ) : null}
+                  <ThemedText
+                    style={[styles.texto, { color: on ? SOBRE_AZUL : colors.textSecondary, fontWeight: on ? '600' : '500' }]}
