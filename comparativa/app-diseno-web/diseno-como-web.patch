@@ -0,0 +1,71 @@
+import { useIsFocused } from 'expo-router';
+import { useSyncExternalStore } from 'react';
+import { AppState } from 'react-native';
+
+import { ThemedText, type ThemedTextProps } from '@/components/themed-text';
+
+/**
+ * UN SEGUNDERO para toda la app, y el texto que envejece con él.
+ *
+ * El «hace 18 s» tiene que correr solo, pero el reloj vivía en el motor de la
+ * flota y repintaba la pantalla ENTERA —mapa, lista, cifras— cada segundo para
+ * cambiar un número. Ahora late solo lo que lo enseña: este texto.
+ *
+ * Un único intervalo compartido: cien textos a la vista son un latido, no cien,
+ * y React los repinta todos en la misma pasada.
+ */
+
+const oyentes = new Set<() => void>();
+let latido: ReturnType<typeof setInterval> | undefined;
+let ahoraCompartido = Date.now();
+
+function suscribir(oyente: () => void): () => void {
+  oyentes.add(oyente);
+  if (!latido) {
+    ahoraCompartido = Date.now();
+    latido = setInterval(() => {
+      // Con la app en segundo plano nadie mira: no se repinta nada.
+      if (AppState.currentState === 'background') return;
+      ahoraCompartido = Date.now();
+      for (const o of oyentes) o();
+    }, 1_000);
+  }
+  return () => {
+    oyentes.delete(oyente);
+    // Sin nadie leyéndolo, el segundero se para.
+    if (oyentes.size === 0 && latido) {
+      clearInterval(latido);
+      latido = undefined;
+    }
+  };
+}
+
+const sinSuscribir = () => () => {};
+
+function leerAhora(): number {
+  // Parado, la última hora puede ser de hace rato: se pone al día al leerla
+  // (a saltos de un segundo, para que dos lecturas seguidas den lo mismo), así
+  // el primer cuadro no enseña un «hace» viejo antes de que arranque el latido.
+  if (!latido && Date.now() - ahoraCompartido >= 1_000) ahoraCompartido = Date.now();
+  return ahoraCompartido;
+}
+
+/**
+ * La hora, de segundo en segundo, mientras `activo` (y la pantalla a la vista).
+ * Fuera de la vista no late: nadie lo está leyendo.
+ */
+export function useSegundero(activo = true): number {
+  const enFoco = useIsFocused();
+  return useSyncExternalStore(activo && enFoco ? suscribir : sinSuscribir, leerAhora);
+}
