diff --git a/src/theme/apariencia.ts b/src/theme/apariencia.ts
new file mode 100644
index 0000000..2da283b
--- /dev/null
+++ b/src/theme/apariencia.ts
@@ -0,0 +1,41 @@
+/**
+ * APARIENCIA PERSONAL: Azul FOM o Glass gris.
+ *
+ * Los mismos ids, nombres y frases que la web (`apariencia-store.js`), para
+ * que la elección se llame igual en los dos sitios. Es de la persona y de ESTE
+ * teléfono: nunca depende de la empresa.
+ */
+
+import AsyncStorage from '@react-native-async-storage/async-storage';
+
+import type { Apariencia } from './types';
+
+export const APARIENCIAS: readonly { id: Apariencia; nombre: string; descripcion: string }[] = [
+  { id: 'azul', nombre: 'Azul FOM', descripcion: 'Los colores de FOM, con tarjetas y navegación redondeadas.' },
+  { id: 'glass', nombre: 'Glass gris', descripcion: 'Cristal translúcido, fondo gris y superficies de grafito.' },
+];
+
+/**
+ * Dónde se guarda. Fuera del prefijo `fom.memoria.` a propósito: esa memoria
+ * se borra al cerrar sesión, y la apariencia es del teléfono, no de la sesión.
+ */
+const CLAVE = 'fom.apariencia.v1';
+
+function esApariencia(valor: unknown): valor is Apariencia {
+  return APARIENCIAS.some((a) => a.id === valor);
+}
+
+/** La apariencia guardada; sin nada guardado (o si falla), Azul FOM. */
+export async function leerApariencia(): Promise<Apariencia> {
+  try {
+    const valor = await AsyncStorage.getItem(CLAVE);
+    return esApariencia(valor) ? valor : 'azul';
+  } catch {
+    return 'azul';
+  }
+}
+
+/** Guarda la elección. Si no se puede, sigue valiendo durante esta sesión. */
+export async function guardarApariencia(apariencia: Apariencia): Promise<void> {
+  await AsyncStorage.setItem(CLAVE, apariencia).catch(() => undefined);
+}
