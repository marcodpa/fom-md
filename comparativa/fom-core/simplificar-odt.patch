+function database(initialStatus, options = {}) {
+  const calls = [];
+  const state = { status: initialStatus, sequence: 1 };
+  const client = {
+    async query(text, values = []) {
+      calls.push({ text, values });
+      if (/^(BEGIN|COMMIT|ROLLBACK)$/u.test(text)) return { rows: [] };
+      if (text.includes('pg_advisory_xact_lock')) return { rows: [] };
+      if (text.includes('FROM fom.mobile_mutation_receipts')) {
+        return { rows: options.receipt ? [options.receipt] : [] };
+      }
+      if (text.includes('INSERT INTO fom.mobile_mutation_receipts')) {
+        return { rows: [] };
+      }
+      if (/SELECT status::text AS status FROM fom\.work_orders/u.test(text)) {
+        return { rows: options.missingOrder ? [] : [{ status: state.status }] };
+      }
+      if (text.includes('FROM fom.maintenance_actions action') && text.includes('FOR UPDATE OF action')) {
+        return {
+          rows: options.kmPlan
+            ? [{ id: ASSIGNMENT, kind: 'preventive', status: 'in_progress', planId: ASSIGNMENT, intervalKm: '5000' }]
+            : [],
+        };
+      }
+      if (text.includes('FROM fom.maintenance_actions action')) {
+        return { rows: [] };
+      }
+      if (/UPDATE fom\.work_orders\s+SET status = \$3::fom\.work_order_status/u.test(text)) {
+        const from = state.status;
+        state.status = values[2];
+        state.sequence += 1;
+        state.last = { sequence: state.sequence, fromStatus: from, toStatus: values[2], note: values[4] };
+        return { rows: [{ id: ORDER, status: values[2], severity: 'media' }] };
+      }
+      if (/UPDATE fom\.work_orders\s+SET status = 'asignada'/u.test(text)) {
