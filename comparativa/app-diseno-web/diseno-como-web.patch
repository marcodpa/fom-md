+ * o fin de semana sin la diaria; `hoy` es el gris de hoy mientras la diaria
+ * todavía está a tiempo (de lunes a viernes).
  */
 export type EstadoDia = 'hecha' | 'observaciones' | 'bloqueada' | 'no_hecha' | 'hoy' | 'no_cuenta';
 
diff --git a/src/components/inspeccion-fin-de-semana.tsx b/src/components/inspeccion-fin-de-semana.tsx
new file mode 100644
index 0000000..492bdd0
--- /dev/null
+++ b/src/components/inspeccion-fin-de-semana.tsx
@@ -0,0 +1,158 @@
+import AsyncStorage from '@react-native-async-storage/async-storage';
+import { useCallback, useEffect, useState } from 'react';
+import { StyleSheet, View } from 'react-native';
+
+import { Button } from '@/components/button';
+import { Card } from '@/components/card';
+import { TabIcon } from '@/components/tab-icon';
+import { ThemedText } from '@/components/themed-text';
+import { useTheme } from '@/theme';
+
+/**
+ * SÁBADO Y DOMINGO EN LA DIARIA (decisión de Marco).
+ *
+ * De lunes a viernes la diaria se hace siempre. El fin de semana, antes del
+ * formulario, se pregunta si va a trabajar con la unidad: si no, ese día no le
+ * toca. La respuesta se recuerda en el teléfono solo ese día (fecha local);
+ * mañana se vuelve a preguntar. El calendario del supervisor aplica la misma
+ * regla: el fin de semana solo cuenta si ese día la hizo.
+ */
+
+export type RespuestaFinDeSemana = 'trabajo' | 'no_trabajo';
+export type DiaFinDeSemana = 'sábado' | 'domingo';
+
+/** Hoy (o la fecha dada), como AAAA-MM-DD local. */
+function fechaLocal(d: Date): string {
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
+}
+
+/** «sábado» o «domingo» si la fecha cae en fin de semana; si no, `null`. */
+export function diaDeFinDeSemana(d: Date = new Date()): DiaFinDeSemana | null {
+  const n = d.getDay();
+  return n === 6 ? 'sábado' : n === 0 ? 'domingo' : null;
+}
+
+/** Por persona: en un teléfono compartido cada conductor responde lo suyo. */
+const clave = (userId: string) => `fom:inspeccion-fin-de-semana:${userId}`;
+
+interface Guardada {
+  fecha: string;
+  respuesta: RespuestaFinDeSemana;
+}
+
+async function leer(userId: string, fecha: string): Promise<RespuestaFinDeSemana | null> {
+  try {
+    const crudo = await AsyncStorage.getItem(clave(userId));
+    const g = crudo ? (JSON.parse(crudo) as Guardada) : null;
+    // La de otro día ya no vale: cada sábado y cada domingo se pregunta de nuevo.
+    return g?.fecha === fecha && (g.respuesta === 'trabajo' || g.respuesta === 'no_trabajo') ? g.respuesta : null;
+  } catch {
+    return null;
+  }
+}
+
+async function guardar(userId: string, fecha: string, respuesta: RespuestaFinDeSemana): Promise<void> {
+  try {
+    await AsyncStorage.setItem(clave(userId), JSON.stringify({ fecha, respuesta } satisfies Guardada));
+  } catch {
+    // Sin almacenamiento solo se pierde el recuerdo: se vuelve a preguntar.
+  }
+}
+
+/**
+ * La pregunta del fin de semana para quien mira.
+ *
+ * - `dia`: «sábado»/«domingo», o `null` de lunes a viernes (no se pregunta).
+ * - `lista`: ya se leyó lo guardado (mientras no, no se decide nada).
+ * - `respuesta`: lo que dijo hoy, o `null` si aún no respondió.
+ */
+export function useFinDeSemana(userId: string | undefined) {
+  const fecha = fechaLocal(new Date());
+  const dia = diaDeFinDeSemana();
+  const [leida, setLeida] = useState<{ fecha: string; respuesta: RespuestaFinDeSemana | null } | null>(null);
+
+  useEffect(() => {
+    if (!dia || !userId) return;
+    let activo = true;
+    void leer(userId, fecha).then((respuesta) => {
+      if (activo) setLeida({ fecha, respuesta });
+    });
+    return () => {
+      activo = false;
+    };
+  }, [dia, userId, fecha]);
+
+  const responder = useCallback(
+    (respuesta: RespuestaFinDeSemana) => {
+      setLeida({ fecha, respuesta });
+      if (userId) void guardar(userId, fecha, respuesta);
+    },
+    [userId, fecha],
+  );
+
+  const deHoy = leida?.fecha === fecha ? leida : null;
+  return {
+    dia,
+    lista: !dia || !userId || deHoy !== null,
+    respuesta: deHoy?.respuesta ?? null,
+    responder,
+  };
+}
+
+/**
+ * La tarjeta del fin de semana, antes del formulario: la pregunta o, si dijo
+ * que no trabaja, el «hoy no te toca» con la vuelta atrás.
+ */
+export function PreguntaFinDeSemana({
+  dia,
+  respuesta,
+  onResponder,
+}: {
+  dia: DiaFinDeSemana;
+  respuesta: RespuestaFinDeSemana | null;
+  onResponder: (r: RespuestaFinDeSemana) => void;
+}) {
+  const { colors, spacing, radii } = useTheme();
+  const libre = respuesta === 'no_trabajo';
+  return (
+    <Card style={{ gap: spacing.md }}>
+      <View style={[styles.cabeza, { gap: spacing.md }]}>
+        <View
+          style={[
+            styles.circulo,
+            { backgroundColor: libre ? colors.successSurface : colors.infoSurface, borderRadius: radii.pill },
+          ]}>
+          <TabIcon name={libre ? 'check' : 'calendario'} color={libre ? colors.success : colors.info} size={22} />
+        </View>
+        <ThemedText variant="subtitle" style={styles.flex1} accessibilityRole="header">
+          {libre ? 'Listo, hoy no te toca la inspección.' : `Hoy es ${dia}. ¿Vas a trabajar con la unidad?`}
+        </ThemedText>
+      </View>
+
+      {libre ? (
+        <>
+          <ThemedText variant="body" color="textSecondary">
+            Si sales con la unidad, vuelve aquí y hazla.
+          </ThemedText>
+          <Button label="Cambié de idea, voy a trabajar" variant="secondary" onPress={() => onResponder('trabajo')} />
+        </>
+      ) : (
+        <>
+          <ThemedText variant="body" color="textSecondary">
+            El fin de semana la inspección solo hace falta si sales con la unidad.
+          </ThemedText>
+          <View style={{ gap: spacing.sm }}>
+            <Button label="Sí, voy a trabajar" onPress={() => onResponder('trabajo')} />
+            <Button label="No trabajo hoy" variant="secondary" onPress={() => onResponder('no_trabajo')} />
+          </View>
+        </>
+      )}
+    </Card>
+  );
+}
+
+const styles = StyleSheet.create({
+  cabeza: { flexDirection: 'row', alignItems: 'center' },
+  circulo: { width: 48, height: 48, alignItems: 'center', justifyContent: 'center' },
+  flex1: { flex: 1, minWidth: 0 },
+});
