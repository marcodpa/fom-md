diff --git a/src/components/mapbox-nativo-marcador.tsx b/src/components/mapbox-nativo-marcador.tsx
new file mode 100644
index 0000000..dd6bdd6
--- /dev/null
+++ b/src/components/mapbox-nativo-marcador.tsx
@@ -0,0 +1,129 @@
+import { MarkerView } from '@rnmapbox/maps';
+import { memo } from 'react';
+import { Pressable, StyleSheet, View } from 'react-native';
+import Svg, { Circle, G, Path, Rect, Text as SvgText } from 'react-native-svg';
+
+// ============================================================
+// EL MARCADOR DEL PANEL WEB, EN EL MAPBOX NATIVO
+// ------------------------------------------------------------
+// El mismo dibujo que `marcadorWeb` de `mapa-fom-dom.tsx` (y que
+// `vehicleMarker.js` de la web): el carro visto desde arriba, girado hacia
+// donde va cuando rueda, y su tarjeta con la placa y el estado. Aquí va con
+// react-native-svg dentro de un `MarkerView`.
+// ============================================================
+
+export type EstadoMarcador = 'marcha' | 'detenido' | 'sin-senal';
+
+/** Los colores del estado, los mismos del panel web. */
+const COLOR_ESTADO: Record<EstadoMarcador, string> = {
+  marcha: '#35e888',
+  detenido: '#ffbf43',
+  'sin-senal': '#a1afbf',
+};
+const TEXTO_ESTADO: Record<EstadoMarcador, string> = {
+  marcha: 'En marcha',
+  detenido: 'Detenido',
+  'sin-senal': 'Sin señal',
+};
+
+/** Tamaño del dibujo y el punto del mapa dentro de él (el centro del carro). */
+const ANCHO = 174;
+const ALTO = 76;
+const ANCLA = { x: 26 / ANCHO, y: 40 / ALTO };
+
+type Props = {
+  id: string;
+  lng: number;
+  lat: number;
+  /** Placa (o, sin ella, el nombre de la unidad). */
+  placa: string;
+  estado: EstadoMarcador;
+  emergencia?: boolean;
+  /** Rumbo en grados, solo en marcha: el carro gira y sale la flecha. */
+  rumbo: number | null;
+  elegido: boolean;
+  /** Lejos se esconde la tarjeta (salvo la elegida): las de toda la flota se taparían. */
+  conTarjeta: boolean;
+  /** El rojo de la emergencia (el `danger` del tema). */
+  rojo: string;
+  onPress: (id: string) => void;
+  accessibilityLabel?: string;
+};
+
+/**
+ * Un vehículo de la flota en el Mapbox nativo. Memorizado: con una flota grande
+ * solo se vuelve a dibujar el que cambió de sitio, de estado o de elección.
+ */
+export const MarcadorWebNativo = memo(function MarcadorWebNativo({
+  id,
+  lng,
+  lat,
+  placa,
+  estado,
+  emergencia = false,
+  rumbo,
+  elegido,
+  conTarjeta,
+  rojo,
+  onPress,
+  accessibilityLabel,
+}: Props) {
+  const color = emergencia ? rojo : COLOR_ESTADO[estado];
+  const texto = emergencia ? 'Pidió ayuda' : TEXTO_ESTADO[estado];
+  const acento = elegido ? '#168fff' : color;
+  const giro = typeof rumbo === 'number' && Number.isFinite(rumbo) ? ((rumbo % 360) + 360) % 360 : null;
+  const nombre = String(placa || 'Sin placa').slice(0, 22);
+  const tam = nombre.length > 11 ? 10 : 13;
+  const tocar = () => onPress(id);
+
+  return (
+    <MarkerView coordinate={[lng, lat]} anchor={ANCLA} allowOverlap allowOverlapWithPuck isSelected={elegido}>
+      <View style={styles.caja} pointerEvents="box-none">
+        <Svg width={ANCHO} height={ALTO} viewBox={`0 0 ${ANCHO} ${ALTO}`} style={StyleSheet.absoluteFill} pointerEvents="none">
+          {conTarjeta ? (
+            <G>
+              {/* Sombra suave, como el drop-shadow de la web. */}
+              <Rect x={46} y={6} width={125} height={46} rx={12} fill="#000" opacity={0.28} />
+              <Rect x={46} y={3} width={125} height={46} rx={12} fill="#0b1927" stroke={acento} strokeWidth={elegido ? 2.5 : 1} />
+              <Circle cx={58} cy={18} r={4} fill={color} />
+              <SvgText x={69} y={23} fill="#f5f8fc" fontFamily="SplineSans_700Bold" fontSize={tam}>
+                {nombre}
+              </SvgText>
+              <SvgText x={69} y={39} fill={color} fontFamily="SplineSans_400Regular" fontSize={11}>
+                {texto}
+              </SvgText>
+            </G>
+          ) : null}
+          <G transform={`rotate(${giro ?? 0} 26 40)`}>
+            {elegido ? <Rect x={12} y={14} width={28} height={52} rx={9} fill="#0c2e4f" stroke="#168fff" strokeWidth={2} /> : null}
+            <Rect x={15} y={21} width={22} height={44} rx={7} fill="#000" opacity={0.25} />
+            <Rect x={11} y={26} width={5} height={10} rx={2} fill="#070e16" />
+            <Rect x={36} y={26} width={5} height={10} rx={2} fill="#070e16" />
+            <Rect x={12} y={48} width={4} height={10} rx={1} fill="#070e16" />
+            <Rect x={36} y={48} width={4} height={10} rx={1} fill="#070e16" />
+            <Rect x={15} y={18} width={22} height={44} rx={7} fill="#e4e9ef" stroke="#4b5968" strokeWidth={1.5} />
+            <Path d="M18 29 Q26 25 34 29 L33 36 L19 36Z" fill="#203344" />
+            <Path d="M18 47 L34 47 L33 57 L19 57Z" fill="#344658" />
+            <Rect x={19} y={37} width={14} height={9} rx={2} fill="#fafcff" />
+            <Path d="M17 23h5m8 0h5" stroke="#fff" strokeWidth={2} />
+            {giro == null ? null : <Path d="M26 4 L32 13 L26 11 L20 13Z" fill={acento} stroke="#07121e" strokeWidth={1} />}
+          </G>
+        </Svg>
+        {/* Solo el carro y la tarjeta se tocan: el resto del dibujo deja pasar el dedo al mapa. */}
+        <Pressable
+          onPress={tocar}
+          style={styles.toqueCarro}
+          accessibilityRole="button"
+          accessibilityLabel={accessibilityLabel ?? `${nombre}, ${texto}`}
+        />
+        {conTarjeta ? <Pressable onPress={tocar} style={styles.toqueTarjeta} accessible={false} /> : null}
+      </View>
+    </MarkerView>
+  );
+});
+
+const styles = StyleSheet.create({
+  caja: { width: ANCHO, height: ALTO },
+  toqueCarro: { position: 'absolute', left: 0, top: 10, width: 52, height: 60 },
+  toqueTarjeta: { position: 'absolute', left: 46, top: 3, width: 125, height: 46 },
+});
diff --git a/src/components/mapbox-nativo-ruta.tsx b/src/components/mapbox-nativo-ruta.tsx
new file mode 100644
index 0000000..b38f5a3
--- /dev/null
+++ b/src/components/mapbox-nativo-ruta.tsx
@@ -0,0 +1,355 @@
+import { LineLayer, MarkerView, ShapeSource, VectorSource, type LineLayerStyle } from '@rnmapbox/maps';
+import { memo, useCallback, useMemo, useState } from 'react';
+import { Pressable, StyleSheet, Text, View } from 'react-native';
+
+import { duracion, horaCorta, type Analisis } from '@/lib/recorrido';
+
+// ============================================================
+// CAPAS PROPIAS DEL MAPBOX NATIVO
+// ------------------------------------------------------------
+// Lo mismo que dibuja `mapa-fom-dom.tsx` en la vista web, pero con las capas
+// nativas de @rnmapbox/maps: el recorrido (viajes, inicio A, fin B y paradas
+// P), el tráfico en vivo y las estelas de la flota.
+// ============================================================
+
+export type Posicion = [number, number];
+
+/** Colores del tema que necesitan las capas (ya resueltos por quien las usa). */
+export type ColoresCapas = {
+  fondo: string;
+  texto: string;
+  textoSec: string;
+  superficie: string;
+  primario: string;
+  exito: string;
+  peligro: string;
+};
+
+/**
+ * Las esquinas (noreste y suroeste) que encierran unos puntos. `minimo` es el
+ * lado mínimo en grados: hace de «zoom máximo», porque `fitBounds` nativo no
+ * lo tiene y un punto solo acabaría pegado a la calle.
+ */
+export function limitesDe(puntos: Posicion[], minimo = 0.004): { ne: Posicion; sw: Posicion } | null {
+  if (puntos.length === 0) return null;
+  let minLng = Infinity;
+  let minLat = Infinity;
+  let maxLng = -Infinity;
+  let maxLat = -Infinity;
+  for (const [lng, lat] of puntos) {
+    if (!Number.isFinite(lng) || !Number.isFinite(lat)) continue;
+    minLng = Math.min(minLng, lng);
+    maxLng = Math.max(maxLng, lng);
+    minLat = Math.min(minLat, lat);
+    maxLat = Math.max(maxLat, lat);
+  }
+  if (!Number.isFinite(minLng)) return null;
+  const crecer = (a: number, b: number): [number, number] => {
+    const falta = minimo - (b - a);
+    return falta > 0 ? [a - falta / 2, b + falta / 2] : [a, b];
+  };
+  [minLng, maxLng] = crecer(minLng, maxLng);
+  [minLat, maxLat] = crecer(minLat, maxLat);
+  return { ne: [maxLng, maxLat], sw: [minLng, minLat] };
+}
+
+/** El trazo de un viaje: por las calles si Mapbox lo pegó; si no, los puntos crudos. */
+export function trazoDe(v: Analisis['viajes'][number]): Posicion[] {
+  return v.trazo && v.trazo.length > 1 ? v.trazo : v.puntos.map((p) => [p.lng, p.lat] as Posicion);
+}
+
+/** Todos los puntos de un recorrido (para encuadrarlo entero). */
+export function puntosDeRuta(ruta: Analisis): Posicion[] {
+  return [...ruta.viajes.flatMap(trazoDe), ...ruta.paradas.map((p) => [p.lng, p.lat] as Posicion)];
+}
+
+// ── Tráfico ─────────────────────────────────────────────────────────────────
+
+const ESTILO_TRAFICO: LineLayerStyle = {
+  lineJoin: 'round',
+  lineCap: 'round',
+  lineWidth: ['interpolate', ['linear'], ['zoom'], 10, 1.5, 16, 5],
+  lineEmissiveStrength: 1,
+  lineColor: ['match', ['get', 'congestion'], 'low', '#3dd68c', 'moderate', '#f5c242', 'heavy', '#ff8a3d', 'severe', '#ff6369', '#3dd68c'],
+};
+
+/** TRÁFICO en vivo, como en la web: el color de la vía dice cómo está. */
+export function TraficoNativo() {
+  return (
+    <VectorSource id="fom-trafico" url="mapbox://mapbox.mapbox-traffic-v1">
+      <LineLayer id="fom-trafico" sourceLayerID="traffic" slot="middle" style={ESTILO_TRAFICO} />
+    </VectorSource>
+  );
+}
+
+// ── Estelas ─────────────────────────────────────────────────────────────────
+
+const ESTILO_ESTELA: LineLayerStyle = {
+  lineCap: 'round',
+  lineJoin: 'round',
+  lineColor: ['get', 'color'],
+  lineWidth: 4,
+  lineOpacity: 0.9,
+  lineDasharray: [0.1, 1.8],
+  lineEmissiveStrength: 1,
+};
+
+/** Las estelas (la cola reciente de cada unidad), punteadas y debajo de los marcadores. */
+export const EstelasNativas = memo(function EstelasNativas({
+  estelas,
+}: {
+  estelas: { id: string; color: string; coords: Posicion[] }[];
+}) {
+  const datos = useMemo<GeoJSON.FeatureCollection>(
+    () => ({
+      type: 'FeatureCollection',
+      features: estelas
+        .filter((e) => e.coords.length > 1)
+        .map((e) => ({
+          type: 'Feature',
+          id: e.id,
+          properties: { color: e.color },
+          geometry: { type: 'LineString', coordinates: e.coords },
+        })),
+    }),
+    [estelas],
+  );
+  if (datos.features.length === 0) return null;
+  return (
+    <ShapeSource id="fom-estelas" shape={datos}>
+      <LineLayer id="fom-estelas" slot="top" style={ESTILO_ESTELA} />
+    </ShapeSource>
+  );
+});
+
+// ── Recorrido ───────────────────────────────────────────────────────────────
+
+type Pin = {
+  clave: string;
+  tipo: 'inicio' | 'fin' | 'parada';
+  letra: string;
+  texto: string;
+  titulo: string;
+  detalle: string;
+  lng: number;
+  lat: number;
+  /** El viaje al que pertenece (A y B): se aclara si se elige otro. */
+  viaje?: number;
+};
+
+/** Los pines del recorrido, como en la web: sin A ni B encima de una parada. */
+function pinesDe(ruta: Analisis): Pin[] {
+  const cerca = (a: { lat: number; lng: number }) =>
+    ruta.paradas.some((p) => Math.abs(p.lat - a.lat) < 0.0013 && Math.abs(p.lng - a.lng) < 0.0013);
+  const pines: Pin[] = [];
+  for (const v of ruta.viajes) {
+    if (!cerca(v.inicio)) {
+      pines.push({
+        clave: `a-${v.numero}`,
+        tipo: 'inicio',
+        letra: 'A',
+        texto: horaCorta(v.inicio.hora),
+        titulo: `Inicio del viaje ${v.numero}`,
+        detalle: horaCorta(v.inicio.hora),
+        lng: v.inicio.lng,
+        lat: v.inicio.lat,
+        viaje: v.numero,
+      });
+    }
+    if (!v.fin.enCurso && !cerca(v.fin)) {
+      pines.push({
+        clave: `b-${v.numero}`,
+        tipo: 'fin',
+        letra: 'B',
+        texto: horaCorta(v.fin.hora),
+        titulo: `Fin del viaje ${v.numero}`,
+        detalle: `${horaCorta(v.fin.hora)} · ${duracion(v.minutos)} · ${(v.distanciaM / 1000).toFixed(1)} km`,
+        lng: v.fin.lng,
+        lat: v.fin.lat,
+        viaje: v.numero,
+      });
+    }
+  }
+  ruta.paradas.forEach((p, i) => {
+    pines.push({
+      clave: `p-${i}-${p.desde}`,
+      tipo: 'parada',
+      letra: 'P',
+      texto: duracion(p.minutos),
+      titulo: `Estacionada ${duracion(p.minutos)}`,
+      detalle: `${horaCorta(p.desde)} → ${horaCorta(p.hasta)}`,
+      lng: p.lng,
+      lat: p.lat,
+    });
+  });
+  return pines;
+}
+
+/** Ancho fijo del pin: el punto del mapa es el centro del círculo (13 px desde la izquierda). */
+const ANCHO_PIN = 120;
+const ANCHO_PIN_ABIERTO = 230;
+
+const PinRuta = memo(function PinRuta({
+  pin,
+  abierto,
+  atenuado,
+  colores,
+  onTocar,
+}: {
+  pin: Pin;
+  abierto: boolean;
+  atenuado: boolean;
+  colores: ColoresCapas;
+  onTocar: (clave: string) => void;
+}) {
+  const ancho = abierto ? ANCHO_PIN_ABIERTO : ANCHO_PIN;
+  const circulo =
+    pin.tipo === 'inicio'
+      ? { fondo: colores.exito, letra: '#06210f' }
+      : pin.tipo === 'fin'
+        ? { fondo: colores.peligro, letra: '#2a0a0b' }
+        : { fondo: '#f5c242', letra: '#241b00' };
+  return (
+    <MarkerView coordinate={[pin.lng, pin.lat]} anchor={{ x: 13 / ancho, y: 0.5 }} allowOverlap isSelected={abierto}>
+      <View style={[estilos.pinCaja, { width: ancho, opacity: atenuado ? 0.3 : 1 }]} pointerEvents="box-none">
+        <Pressable
+          onPress={() => onTocar(pin.clave)}
+          style={estilos.pinFila}
+          accessibilityRole="button"
+          accessibilityLabel={`${pin.titulo}, ${pin.detalle}`}>
+          <View style={[estilos.pinCirculo, { backgroundColor: circulo.fondo, borderColor: colores.fondo }]}>
+            <Text style={[estilos.pinLetra, { color: circulo.letra }]}>{pin.letra}</Text>
+          </View>
+          {abierto ? (
+            <View style={[estilos.pinGlobo, { backgroundColor: colores.superficie }]}>
+              <Text style={[estilos.pinTitulo, { color: colores.texto }]} numberOfLines={1}>
+                {pin.titulo}
+              </Text>
+              <Text style={[estilos.pinDetalle, { color: colores.textoSec }]} numberOfLines={1}>
+                {pin.detalle}
+              </Text>
+            </View>
+          ) : pin.texto ? (
+            <Text style={[estilos.pinTexto, { color: colores.texto }]} numberOfLines={1}>
+              {pin.texto}
+            </Text>
+          ) : null}
+        </Pressable>
+      </View>
+    </MarkerView>
+  );
+});
+
+/**
+ * EL RECORRIDO: los viajes como líneas por las calles (borde oscuro debajo y
+ * el color de la marca encima), y los pines A, B y P. Tocar una línea elige
+ * ese viaje (o lo suelta); tocar un pin abre su detalle.
+ */
+export function RutaNativa({
+  ruta,
+  viajeActivo,
+  onElegirViaje,
+  colores,
+}: {
+  ruta: Analisis;
+  viajeActivo: number | null;
+  onElegirViaje?: (numero: number | null) => void;
+  colores: ColoresCapas;
+}) {
+  const datos = useMemo<GeoJSON.FeatureCollection>(
+    () => ({
+      type: 'FeatureCollection',
+      features: ruta.viajes
+        .map((v) => ({ v, trazo: trazoDe(v) }))
+        .filter(({ trazo }) => trazo.length > 1)
+        .map(({ v, trazo }) => ({
+          type: 'Feature',
