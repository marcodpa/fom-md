+
+/**
+ * La ficha del vehículo elegido, como `FichaUnidad` de la web: estado, placa,
+ * qué es, su imagen, la velocidad, la última señal, el conductor con su
+ * pastilla de manejo, dónde está, odómetro y GPS, «Más información» y el
+ * expediente.
+ */
+function FichaUnidad({
+  x,
+  ahora,
+  empresaId,
+  irA,
+}: {
+  x: Unidad;
+  ahora: number;
+  empresaId: string;
+  irA: (pathname: string, params?: Record<string, string>) => void;
+}) {
+  const { colors, borderWidths } = useTheme();
+  const v = x.u.vehicle;
+  const pos = x.viva?.pos ?? null;
+  const sinSenal = x.estado === 'sin-senal';
+  const estado: { texto: string; tono: keyof ColorTokens } = sinSenal
+    ? { texto: textoSinSenal(x.reporte, ahora), tono: 'textSecondary' }
+    : x.estado === 'marcha'
+      ? { texto: 'En marcha', tono: 'success' }
+      : { texto: 'Detenido', tono: 'warning' };
+  const ultimo = sinSenal ? textoUltimoReporte(x.reporte) : null;
+  const descripcion = [x.nombre, [v.marca, v.modelo, v.anio].filter(Boolean).join(' ')].filter(Boolean).join(' · ');
+  const velocidad = pos?.velocidadKmh;
+  const odometro = v.odometroKm ?? pos?.odometroKm ?? null;
+  const gps = x.conSenal ? 'Conectado' : pos ? textoSinSenal(x.reporte, ahora) : 'Sin dato';
+
+  // Lo que no cabe arriba, solo si hay dato (como la web).
+  const extras: [string, string][] = [];
+  if (pos?.contacto != null && velocidad != null) extras.push(['Motor', pos.contacto ? 'Encendido' : 'Apagado']);
+  if (x.viva?.gps?.imei) extras.push(['IMEI del equipo', x.viva.gps.imei]);
+  if (pos) extras.push(['Coordenadas', coordsEnTexto(pos)]);
+
+  const color = colors[estado.tono];
+  return (
+    <View style={styles.ficha}>
+      <View style={styles.fichaEstado}>
+        <View style={[styles.estado, { borderColor: color, backgroundColor: sinSenal ? colors.surfaceElevated : tinteEstado(colors, estado.tono) }]}>
+          <View style={[styles.estadoPunto, { backgroundColor: color }]} />
+          <ThemedText style={[styles.estadoTexto, { color }]}>{estado.texto}</ThemedText>
+        </View>
+        {ultimo ? <ThemedText style={[styles.chico, { color: colors.textSecondary }]}>{ultimo}</ThemedText> : null}
+      </View>
+      <View style={{ gap: 6 }}>
+        <ThemedText style={styles.placa}>{v.placa || 'Sin placa'}</ThemedText>
+        {descripcion ? <ThemedText style={[styles.descripcion, { color: colors.textSecondary }]}>{descripcion}</ThemedText> : null}
+      </View>
+
+      <View style={styles.retratoCaja}>
+        <View style={[styles.retrato, { borderColor: colors.border, borderWidth: borderWidths.thin }]}>
+          <VehiculoRetrato vehicle={v} enMarcha={x.estado === 'marcha'} alto={150} />
+        </View>
+        <ThemedText style={[styles.chico, { color: colors.textSecondary }]}>Imagen de referencia</ThemedText>
+      </View>
+
+      <View style={styles.velocidad}>
+        <TabIcon name="velocidad" color={colors.text} size={25} />
+        <ThemedText tabular style={styles.velocidadCifra}>
+          {velocidad == null ? 'Sin velocidad GPS' : numeroWeb(Math.round(velocidad))}
+          {velocidad == null ? null : <ThemedText style={styles.velocidadUnidad}> km/h</ThemedText>}
+        </ThemedText>
+      </View>
+
+      <View style={{ gap: 12 }}>
+        <Dato glifo="reloj" etiqueta="Última señal" valor={x.reporte ? desdeWeb(x.reporte, ahora) : 'Sin reportes'} />
+        <Dato
+          tabIcon="personal"
+          etiqueta="Conductor"
+          valor={x.u.conductorActual ?? 'Sin conductor asignado'}
+          extra={x.u.conductorActual && x.u.conductorId ? <PastillaConductor empresaId={empresaId} userId={x.u.conductorId} conduce /> : null}
+        />
+        <Dato glifo="pin" etiqueta="Ubicación" valor={pos ? coordsEnTexto(pos) : 'Sin posición disponible'} />
+      </View>
