@@ -0,0 +1,22 @@
+// ============================================================
+// ALERTAS SIN LEER — una sola regla (igual que la web:
+// src/panel/modulos/alertas-presentacion.js, `estaLeida` y `contarSinLeer`).
+// ------------------------------------------------------------
+// La campana, el globo del encabezado, la bandeja, la ficha del conductor y el
+// Resumen cuentan los avisos sin leer con esta función y sobre la MISMA lista
+// que pintan. Nadie usa un número suelto del servidor ni vuelve a escribir
+// `!n.leida` para contar. Sin imports a propósito (se prueba con Node solo).
+// ============================================================
+
+/** Lo mínimo que se mira de un aviso: la marca de la app o la hora en que se leyó. */
+export type AvisoLeible = { leida?: boolean | null; leidaEn?: string | null };
+
+/** ¿Ya se leyó? Vale la marca `leida` o una hora de lectura. */
+export function estaLeida(aviso: AvisoLeible | null | undefined): boolean {
+  return Boolean(aviso?.leida || aviso?.leidaEn);
+}
+
+/** Cuántos avisos siguen sin leer: la ÚNICA cuenta. */
+export function contarSinLeer(lista: readonly (AvisoLeible | null | undefined)[] | null | undefined): number {
+  return (lista ?? []).filter((n) => !estaLeida(n)).length;
+}
diff --git a/src/utils/atencionUnidad.ts b/src/utils/atencionUnidad.ts
new file mode 100644
index 0000000..ca77ce8
--- /dev/null
+++ b/src/utils/atencionUnidad.ts
@@ -0,0 +1,55 @@
+// ============================================================
+// ATENCIÓN DE UNA UNIDAD — una sola respuesta a «¿esta unidad pide atención
+// por sus papeles o por no tener conductor?» (mismo contrato que la web:
+// src/panel/datos/atencionUnidad.js). La usan Aptitud y los filtros de las
+// listas de unidades, para que nunca digan cosas distintas de la misma unidad.
+//
+// `docsVencidos` / `docsPorVencer` salen de contar los documentos con la regla
+// de utils/vencimientos.ts. Si la fuente no los trae (null) no se afirma nada
+// sobre papeles: ni vencidos ni al día. Sin imports a propósito.
+// ============================================================
+
+export interface DatosAtencionUnidad {
+  docsVencidos?: number | null;
+  docsPorVencer?: number | null;
+  conductorPrincipalId?: string | null;
+}
+
+export interface NovedadUnidad {
+  peso: number;
+  /** El tramo del teléfono. */
+  grupo: 'no-salen' | 'atencion';
+  color: 'rojo' | 'ambar';
+  t: string;
+}
+
+export interface AtencionUnidad {
+  vencidos: number;
+  porVencer: number;
+  sinConductor: boolean;
+  sinDatoPapeles: boolean;
+  /** Tiene papeles vencidos o por vencer, o nadie a cargo. */
+  requiere: boolean;
+  /** La PEOR novedad, o null si no hay ninguna. */
+  novedad: NovedadUnidad | null;
+}
+
+const cuenta = (n: unknown): number => (Number(n) > 0 ? Number(n) : 0);
+
+export function atencionDeUnidad(v: DatosAtencionUnidad | null | undefined): AtencionUnidad {
+  const vencidos = cuenta(v?.docsVencidos);
+  const porVencer = cuenta(v?.docsPorVencer);
+  const sinConductor = !v?.conductorPrincipalId;
+  const sinDatoPapeles = v?.docsVencidos == null || v?.docsPorVencer == null;
+
+  let novedad: NovedadUnidad | null = null;
+  if (vencidos > 0) {
+    novedad = { peso: 3, grupo: 'no-salen', color: 'rojo', t: vencidos === 1 ? 'Documento vencido' : `${vencidos} vencidos` };
+  } else if (porVencer > 0) {
+    novedad = { peso: 5, grupo: 'atencion', color: 'ambar', t: `${porVencer} por vencer` };
+  } else if (sinConductor) {
+    novedad = { peso: 7, grupo: 'atencion', color: 'ambar', t: 'Sin conductor' };
+  }
+
+  return { vencidos, porVencer, sinConductor, sinDatoPapeles, requiere: novedad !== null, novedad };
+}
