+// ── Formatos ────────────────────────────────────────────────────────────────
+
+/** «42,6»; sin dato, «—». */
+export function textoKm(km: number | null): string {
+  return km == null ? '—' : miles(km, 1);
+}
+
+/**
+ * El tiempo en marcha partido en cifra grande y unidad chica, como la maqueta:
+ * «1 h 18» + «min», «45» + «min», «2» + «h». Sin dato, «—».
+ */
+export function partesTiempo(minutos: number | null): { cifra: string; unidad: string } {
+  if (minutos == null) return { cifra: '—', unidad: '' };
+  const m = Math.round(minutos);
+  if (m < 60) return { cifra: String(m), unidad: 'min' };
+  const h = Math.floor(m / 60);
+  const r = m % 60;
+  return r ? { cifra: `${h} h ${r}`, unidad: 'min' } : { cifra: String(h), unidad: 'h' };
+}
+
+/** «1 h 18 min»; sin dato, «—». */
+export function textoTiempo(minutos: number | null): string {
+  const p = partesTiempo(minutos);
+  return p.unidad ? `${p.cifra} ${p.unidad}` : p.cifra;
+}
+
+/** Color de la velocidad: parada gris, normal verde, rápido ámbar, excesivo rojo. */
+export function velocidadTono(kmh: number): keyof ColorTokens {
+  if (kmh <= 0) return 'textMuted';
+  if (kmh >= 100) return 'danger';
+  if (kmh >= 80) return 'warning';
+  return 'success';
+}
+
+/** Cómo llega la lectura del GPS: en vivo, la última buena (sin red) o callada. */
+export type Vivo = { tipo: 'vivo' } | { tipo: 'sin-conexion'; hora: string } | { tipo: 'sin-senal' } | null;
