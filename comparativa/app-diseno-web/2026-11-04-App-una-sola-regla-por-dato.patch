--- /dev/null
+++ b/src/services/leerConAviso.ts
@@ -0,0 +1,15 @@
+/**
+ * Una lectura de apoyo que no debe tumbar la pantalla o el informe, pero
+ * TAMPOCO callarse: si falla devuelve `fallo: true` junto al valor vacío, para
+ * que quien arma el resultado diga «no se pudo leer» y no «no hay nada».
+ *
+ * Es la alternativa al `.catch(() => [])`, que borra el motivo del fallo
+ * (`test/regla-errores.test.mjs` impide volver a escribirlo).
+ */
+export async function leerConAviso<T>(lectura: Promise<T>, vacio: T): Promise<{ datos: T; fallo: boolean }> {
+  try {
+    return { datos: await lectura, fallo: false };
+  } catch {
+    return { datos: vacio, fallo: true };
+  }
+}
