--- /dev/null
+++ b/src/lib/informe-piezas.ts
@@ -0,0 +1,271 @@
+/**
+ * Las PIEZAS con que se arma cada hoja del informe: iconos, etiquetas de
+ * estado, marcas, tablas que se pueden partir entre hojas y bloques con su alto.
+ *
+ * El informe se pagina A MANO (cada hoja es una caja A4 de alto fijo), así que
+ * cada pieza dice cuánto mide. Las alturas son las de las hojas de diseño
+ * (filas de 19-20 px, encabezados de 24-26 px) redondeadas hacia arriba: si
+ * sobra un poco, queda aire. Lo que puede crecer (texto libre en tablas,
+ * listas de datos) dice lo que de verdad mide o viene partido, y un bloque más
+ * alto que una hoja se reduce al paginar: nada se corta en silencio.
+ *
+ * Todo se lee en blanco y negro: cada estado lleva su palabra, su icono y un
+ * borde distinto (lleno, discontinuo, punteado), no solo un color.
+ */
+
+import { comparacionTexto, type Comparacion } from './informe-numeros';
+import type { Semaforo } from './pdf';
+
+/** Escapa texto para meterlo en HTML. */
+export function esc(s: string): string {
+  return s
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
+
+// ─────────────────────────────── Iconos ───────────────────────────────
+
+const ICONOS = {
+  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
+  alerta: '<path d="M12 3.5 2.5 20h19z"/><path d="M12 10v4.5M12 17.2v.3"/>',
+  x: '<path d="M7 7l10 10M17 7 7 17"/>',
+  menos: '<path d="M6 12h12"/>',
+  reloj: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
+  camion:
+    '<path d="M3 6h11v10H3z"/><path d="M14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>',
+  llave: '<path d="M15 4a5 5 0 0 0-4.6 6.9L4 17.3V20h2.7l6.4-6.4A5 5 0 0 0 20 9l-3 1-2-2 1-3z"/>',
+  usuarios:
+    '<circle cx="9" cy="8" r="3.2"/><path d="M3 19c.8-3.2 3.2-5 6-5s5.2 1.8 6 5"/><path d="M16 5.5a3 3 0 0 1 0 5.6M18 14c1.6.6 2.6 2.2 3 4.5"/>',
+  dinero:
+    '<path d="M12 3v18M16.5 7.5c-.8-1.3-2.4-2-4.5-2-2.6 0-4 1.2-4 3s1.6 2.6 4 3 4 1.2 4 3-1.4 3-4 3c-2.1 0-3.7-.8-4.5-2"/>',
+  grafica: '<path d="M4 20V10M10 20V4M16 20v-7M21 20H3"/>',
+  documento: '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M10 12h5M10 16h5"/>',
+  mapa: '<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2z"/><path d="M9 4v14M15 6v14"/>',
+  velocimetro: '<path d="M4 16a8 8 0 1 1 16 0"/><path d="m12 16 4-5"/>',
+} as const;
+
+export type Icono = keyof typeof ICONOS;
+
+/** Un icono de línea, del color del texto que lo rodea. */
+export function icono(nombre: Icono, tamano = 16, clase = 'ico'): string {
+  return `<svg class="${clase}" style="width:${tamano}px;height:${tamano}px" viewBox="0 0 24 24" aria-hidden="true">${ICONOS[nombre]}</svg>`;
+}
+
+// ───────────────────────── Estados (etiquetas) ─────────────────────────
+
+/** Los estados del papel: clase CSS, palabra e icono de cada uno. */
+const ESTADO = {
+  verde: { clase: 'ok', palabra: 'Conforme', icono: 'check' },
+  amarillo: { clase: 'wa', palabra: 'Alerta', icono: 'alerta' },
+  rojo: { clase: 'ba', palabra: 'Atención', icono: 'x' },
+  neutro: { clase: 'ne', palabra: 'Sin dato', icono: 'menos' },
+} as const satisfies Record<Semaforo, { clase: string; palabra: string; icono: Icono }>;
+
+/** La palabra de cada tono en el informe («Conforme», «Alerta»…). */
+export function palabraDe(tono: Semaforo): string {
+  return ESTADO[tono].palabra;
+}
+
+/** Etiqueta de estado: borde + icono + palabra (se lee sin color). */
+export function etiqueta(tono: Semaforo, texto?: string): string {
+  const e = ESTADO[tono];
+  return `<span class="tg ${e.clase}">${icono(e.icono, 11, 'ti')}${esc(texto ?? e.palabra)}</span>`;
+}
+
+/** Etiqueta azul de «En revisión» (ODT), con su reloj. */
+export function etiquetaRevision(texto = 'En revisión'): string {
+  return `<span class="tg rv">${icono('reloj', 11, 'ti')}${esc(texto)}</span>`;
+}
+
+/**
+ * Solo la forma del estado, para celdas estrechas (la palabra va en la nota
+ * de la tabla). Lo conforme no lleva marca: así se ve de un vistazo lo que no.
+ */
+export function marca(tono: Semaforo): string {
+  if (tono === 'verde') return '';
+  const e = ESTADO[tono];
+  return `<span class="mk ${e.clase}" title="${e.palabra}">${icono(e.icono, 10, 'ti')}</span>`;
+}
+
+// ───────────────────────────── Bloques ─────────────────────────────
+
+/** Un trozo de hoja que no se parte: su HTML y lo que mide de alto, en px. */
+export interface Bloque {
+  alto: number;
+  html: string;
+}
+
+/** Una columna de tabla: su título, su ancho relativo y si es de cifras. */
+export interface ColumnaTabla {
+  titulo: string;
+  ancho: number;
+  /** Cifras: a la derecha, y su título también. */
+  der?: boolean;
+  /**
+   * Texto libre (nombres, descripciones): baja de línea en vez de cortarse
+   * con «…», y la fila crece lo que haga falta.
+   */
+  envolver?: boolean;
+}
+
+/** Una fila: sus celdas ya en HTML. */
+export interface FilaTabla {
+  celdas: string[];
+  /** `si` = fila apartada (en cursiva gris, ej. «Sin identificar»). */
+  clase?: 'si';
+  /** Alto, si no es el normal de la tabla. */
+  alto?: number;
+}
+
+/** Una tabla que puede seguir en la hoja siguiente (con su encabezado repetido). */
+export interface TablaInforme {
+  titulo?: string;
+  /** La aclaración a la derecha del título (ej. «Km: período · Estado: vista actual»). */
+  aclaracion?: string;
+  columnas: ColumnaTabla[];
+  filas: FilaTabla[];
+  /** Fila de totales: solo al final de la tabla. */
+  total?: FilaTabla;
+  /** Filas de 18 px en vez de 20 (tablas largas). */
+  compacta?: boolean;
+  /** Qué decir si no hay filas. */
+  vacia?: string;
+}
+
+/** Lo que se pagina: bloques enteros o tablas que se pueden partir. */
+export type Pieza = { tipo: 'bloque'; bloque: Bloque } | { tipo: 'tabla'; tabla: TablaInforme };
+
+export const ALTO_TITULO_TABLA = 28;
+export const ALTO_ENCABEZADO = 24;
+export const ALTO_TOTAL = 26;
+/** Ancho útil de la hoja (793 − 2 × 56 de margen): el de una tabla entera. */
+export const ANCHO_TABLA = 681;
+/** Alto de cada línea de una celda (el `line-height` de la tabla) y su relleno. */
+const LINEA_CELDA = 14;
+const RELLENO_CELDA = 6;
+
+/**
+ * Lo que mide una fila. Con columnas de texto libre, lo que pidan sus líneas:
+ * un nombre largo baja a una segunda línea y la fila se estira, en vez de
+ * cortarse con «…» o de salirse por el pie de la hoja.
+ */
+export function altoFila(t: TablaInforme, f: FilaTabla): number {
+  const base = f.alto ?? (t.compacta ? 18 : 19);
+  const suma = t.columnas.reduce((a, c) => a + c.ancho, 0) || 1;
+  let n = 1;
+  t.columnas.forEach((c, i) => {
+    if (!c.envolver || !f.celdas[i]) return;
+    const ancho = (c.ancho / suma) * ANCHO_TABLA - 10;
+    n = Math.max(n, lineas(f.celdas[i].replace(/&[a-z]+;/g, '_'), ancho, 6.8));
+  });
+  return n > 1 ? Math.max(base, n * LINEA_CELDA + RELLENO_CELDA) : base;
+}
+
+/**
+ * Cuántos pares «dato · valor» (en dos columnas) van como mucho en un bloque:
+ * 30 renglones de 22 px más el título caben holgados en una hoja.
+ */
+export const PARES_POR_BLOQUE = 60;
+
+/** Parte una lista en trozos de `n` (al menos uno, aunque venga vacía). */
+export function trozos<T>(xs: T[], n: number): T[][] {
+  if (xs.length <= n) return [xs];
+  const r: T[][] = [];
+  for (let i = 0; i < xs.length; i += n) r.push(xs.slice(i, i + n));
+  return r;
+}
+
+/** Bloque suelto. */
+export function bloque(alto: number, html: string): Pieza {
+  return { tipo: 'bloque', bloque: { alto, html } };
+}
+
+/** Tabla paginable. */
+export function tabla(t: TablaInforme): Pieza {
+  return { tipo: 'tabla', tabla: t };
+}
+
+/** El HTML de un trozo de tabla (todas sus filas o parte de ellas). */
+export function tablaHtml(t: TablaInforme, filas: FilaTabla[], conTotal: boolean, continua: boolean): string {
+  const suma = t.columnas.reduce((a, c) => a + c.ancho, 0) || 1;
+  const cols = t.columnas.map((c) => `<col style="width:${((c.ancho / suma) * 100).toFixed(2)}%">`).join('');
+  const head = t.columnas.map((c) => `<th${c.der ? ' class="r"' : ''}>${esc(c.titulo)}</th>`).join('');
+  const fila = (f: FilaTabla, clase?: string): string => {
+    const cls = clase ?? f.clase;
+    const alto = f.alto ? ` style="height:${f.alto}px"` : '';
+    const celdas = f.celdas
+      .map((c, i) => {
+        const col = t.columnas[i];
+        const clases = [col?.der ? 'r' : '', col?.envolver ? 'w' : ''].filter(Boolean).join(' ');
+        return `<td${clases ? ` class="${clases}"` : ''}${alto}>${c}</td>`;
+      })
+      .join('');
+    return `<tr${cls ? ` class="${cls}"` : ''}>${celdas}</tr>`;
+  };
+  const cuerpo = filas.map((f) => fila(f)).join('');
+  const total = conTotal && t.total ? fila(t.total, 'tot') : '';
+  const titulo = t.titulo
+    ? `<div class="sub"><h2>${esc(t.titulo)}${continua ? ' <span class="cont">(continúa)</span>' : ''}</h2>${
+        t.aclaracion ? `<span>${esc(t.aclaracion)}</span>` : ''
+      }</div>`
+    : '';
+  return `<div>${titulo}<table${t.compacta ? ' class="t18"' : ''}><colgroup>${cols}</colgroup><thead><tr>${head}</tr></thead><tbody>${cuerpo}${total}</tbody></table></div>`;
+}
+
+// ─────────────────────────── Piezas comunes ───────────────────────────
+
+/** Título de una sección: antetítulo azul, título y, si hay, la bajada. */
+export function tituloSeccion(antetitulo: string, titulo: string, bajada?: string): Pieza {
+  const baj = bajada ? `<p class="baj">${esc(bajada)}</p>` : '';
+  return bloque(bajada ? 86 : 56, `<div><p class="eb">${esc(antetitulo)}</p><h1>${esc(titulo)}</h1>${baj}</div>`);
+}
+
+/** Cuántas líneas ocupa un texto en un ancho dado (aprox., para paginar). */
+export function lineas(texto: string, anchoPx: number, pxPorLetra = 6.6): number {
+  const porLinea = Math.max(10, Math.floor(anchoPx / pxPorLetra));
+  return Math.max(1, Math.ceil(texto.replace(/<[^>]+>/g, '').length / porLinea));
+}
+
+/** Una nota al pie de una sección, en gris. */
+export function nota(html: string): Pieza {
+  return bloque(lineas(html, 682, 6.2) * 16 + 2, `<p class="nota">${html}</p>`);
+}
+
+/**
+ * El medidor de un indicador: tres zonas con borde y un triángulo donde cae
+ * el valor (sin medición, la escala sin triángulo).
+ */
+export function medidorHtml(
+  m: { posicion: number; cortes: [number, number]; altoEsBueno: boolean },
+  medido: boolean,
+): string {
+  const zonas = m.altoEsBueno ? ['#F2B8B0', '#F5DFA3', '#BFE3CB'] : ['#BFE3CB', '#F5DFA3', '#F2B8B0'];
+  const [c1, c2] = m.cortes;
+  const anchos = [c1, c2 - c1, 1 - c2];
+  const tramos = anchos
+    .map(
+      (a, i) =>
+        `<span style="flex:${Math.max(0, a).toFixed(3)};background:${zonas[i]};${i ? 'border-left:1px solid #141A22;' : ''}"></span>`,
+    )
+    .join('');
+  const pos = Math.min(1, Math.max(0, m.posicion)) * 100;
+  const tri = medido ? `<span class="med-tri" style="left:calc(${pos.toFixed(1)}% - 5px)"></span>` : '';
+  return `<div class="med"><div class="med-z">${tramos}</div>${tri}</div>`;
+}
+
+/** Barra horizontal (etiqueta · barra · cifra · %), como las de la hoja de costos. */
+export function barraHtml(label: string, fraccion: number, cifra: string, extra?: string): string {
+  const ancho = fraccion > 0 ? Math.max(2, Math.min(100, fraccion * 100)) : 0;
+  return `<div class="bar${extra !== undefined ? ' bar4' : ''}"><span class="bl">${esc(label)}</span><span class="t"><i style="width:${ancho.toFixed(1)}%"></i></span><b>${esc(cifra)}</b>${
+    extra !== undefined ? `<span class="bp">${esc(extra)}</span>` : ''
+  }</div>`;
+}
+
+/** Comparación ▲▼ con su juicio en palabras (Favorable / Desfavorable). */
+export function comparacionHtml(c: Comparacion): string {
+  if (c.favorable === null) return `<span class="cmp">${esc(comparacionTexto(c))}</span>`;
+  const tag = c.favorable ? etiqueta('verde', 'Favorable') : etiqueta('amarillo', 'Desfavorable');
+  return `<span class="cmp">${esc(comparacionTexto(c))} ${tag}</span>`;
+}
