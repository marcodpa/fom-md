+/**
+ * Las SECCIONES del informe empresarial, armadas desde los reportes de la app:
+ * resumen ejecutivo, Vehículos (operación + unidades + mantenimiento),
+ * Usuarios, Costos, Informe estadístico y el cierre con notas y firmas.
+ *
+ * Solo se dibuja lo que trae cada reporte: lo que el diseño pide y el reporte
+ * no tiene se deja fuera en vez de inventarlo. «—» siempre es «sin dato»,
+ * nunca cero.
+ */
+
+import type {
