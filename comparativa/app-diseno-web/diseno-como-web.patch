+    par('ODT abiertas', `${entero(m.reportesAbiertos)}${conOdt > 0 ? ` · ${conOdt} ${conOdt === 1 ? 'unidad' : 'unidades'}` : ''}`),
+    par('Papeles vencidos', `${entero(vencidos)} ${vencidos === 1 ? 'unidad' : 'unidades'}`),
+  ].filter(Boolean);
+  const pctMarcha = Math.round((enMarcha / total) * 100);
+  piezas.push(
+    bloque(
+      Math.max(160, pares.length * 22 + 28),
+      `<div class="box g2">
+  <div class="col">
+    <div class="sub"><h2>Operación de la flota</h2><span>Vista actual</span></div>
+    <div class="est">${tramos}</div>
+    <div class="ley"><span><i class="dot d-m"></i>En marcha ${entero(enMarcha)}</span><span><i class="dot d-d"></i>Detenidas ${entero(detenidas)}</span></div>
+    <p class="lec"><b>Lectura:</b> ${pctMarcha} % de la flota estaba en marcha al generar el informe.</p>
+  </div>
+  <div class="pares">${pares.join('')}</div>
+</div>`,
+    ),
+  );
+
+  // ── Detalle por unidad. ──
+  const fila = (v: VehicleReportRow): FilaTabla => ({
+    celdas: [
+      `<b>${esc(idEnPapel(v.vehicle.numero))}</b>`,
+      esc(placaEnPapel(v.vehicle.placa)),
+      v.titular ? esc(v.titular) : etiqueta('amarillo', 'Sin titular'),
+      v.estado === 'en_marcha' ? '<i class="dot d-m"></i>En marcha' : '<i class="dot d-d"></i>Detenida',
+      entero(v.km),
+      `${entero(v.indiceSeguro)}${marca(tonoMedido(v.rango, v.km))}`,
+      entero(eventosDe(v)),
