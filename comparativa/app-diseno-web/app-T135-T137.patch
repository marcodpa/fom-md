+/** Las palabras del resultado, las mismas del catálogo de la web. */
+const RESULTADO: Record<string, string> = {
+  pendiente: 'Pendiente',
+  aprobada: 'Aprobada',
+  aprobada_con_observaciones: 'Aprobada con observaciones',
+  bloqueada: 'Bloqueada',
+};
