+// ────────────────────────────── Costos ──────────────────────────────
+
+function seccionCostos(r: ReporteCostos, ant: ReporteCostos | undefined, n: number): SeccionInforme {
+  const piezas: Pieza[] = [
+    tituloSeccion(
+      `Sección ${n} · Formato de costos · ${CODIGO.costos}`,
+      'Costos y gastos',
+      'Todo lo que se gastó en la flota en el período, no solo el mantenimiento.',
+    ),
+  ];
+  const descripcion = 'Gasto por categoría, por unidad y su evolución.';
+  const total = r.total.costo;
+  const pct = (x: number): number => (total > 0 ? Math.round((x / total) * 100) : 0);
+
+  // ── Cifras. ──
+  const cmpGasto = comparar(total, ant?.total.costo, { modo: 'pct', altoEsBueno: false });
+  const cmpCant = comparar(r.total.cantidad, ant?.total.cantidad, { modo: 'abs', altoEsBueno: false });
+  const tarjeta = (ic: Icono, k: string, v: string, c: Comparacion | null, pie: string): string =>
+    `<div class="kp"><span class="l">${icono(ic, 16)}${esc(k)}</span><span class="v">${v}</span>${c ? comparacionHtml(c) : ''}<span class="p">${esc(pie)}</span></div>`;
+  piezas.push(
+    bloque(
+      120,
+      `<div class="g3">
+  ${tarjeta('dinero', 'Gasto del período', esc(usd(total)), cmpGasto, ant ? `Antes ${usd(ant.total.costo)}` : `${entero(r.total.cantidad)} gastos`)}
+  ${tarjeta('documento', 'Gastos registrados', entero(r.total.cantidad), cmpCant, ant ? `Antes ${entero(ant.total.cantidad)}` : 'En el período')}
+  ${tarjeta(
+    'grafica',
+    'Productos y servicios',
+    `${esc(usd(r.porClase.producto))} <small>· ${esc(usd(r.porClase.servicio))}</small>`,
+    null,
+    `${porcentaje(pct(r.porClase.producto))} · ${porcentaje(pct(r.porClase.servicio))}`,
+  )}
+</div>`,
+    ),
+  );
+
+  // ── En qué se gastó + evolución. ──
+  const cats = [...r.porCategoria].sort((a, b) => b.total - a.total);
+  const visibles = cats.slice(0, 7);
+  const resto = cats.slice(7);
+  if (resto.length > 0) {
+    const suma = resto.reduce((a, c) => a + c.total, 0);
+    visibles.push({ label: `Otras (${resto.length})`, clase: 'producto', cantidad: 0, total: suma, porcentaje: pct(suma) });
+  }
+  const mayor = Math.max(1, ...visibles.map((c) => c.total));
+  const barras = visibles.map((c) => barraHtml(c.label, c.total / mayor, usd(c.total), porcentaje(c.porcentaje))).join('');
+  const lecturaCat =
+    cats.length >= 2 && total > 0
+      ? `<p class="lec"><b>Lectura:</b> ${esc(cats[0].label.toLowerCase())} y ${esc(cats[1].label.toLowerCase())} son el ${pct(cats[0].total + cats[1].total)} % del gasto.</p>`
+      : '';
+  const cajaCat =
+    visibles.length > 0
+      ? `<div class="box col"><div class="sub"><h2>Gasto por categoría</h2><span>USD</span></div><div class="bars">${barras}</div>${lecturaCat}</div>`
+      : `<div class="box col"><div class="sub"><h2>Gasto por categoría</h2></div><p class="lec">Sin gastos registrados en el período.</p></div>`;
+  const altoCat = 70 + Math.max(1, visibles.length) * 24 + (lecturaCat ? 20 : 0);
+
+  if (r.columnas.length >= 2) {
+    const tope = Math.max(1, ...r.porColumna.map((c) => c.costo));
+    const cols = r.columnas
