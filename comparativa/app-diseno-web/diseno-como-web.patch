new file mode 100644
index 0000000..7aa7d6c
--- /dev/null
+++ b/src/app/mapa-flota.tsx
@@ -0,0 +1,143 @@
+import { useRouter } from 'expo-router';
+import { useMemo, useState } from 'react';
+import { StyleSheet, View } from 'react-native';
+import { useSafeAreaInsets } from 'react-native-safe-area-context';
+import Svg, { Path } from 'react-native-svg';
+
+import { MapaVehiculo } from '@/components/map-vehiculo';
+import { PressableScale } from '@/components/pressable-scale';
+import { ThemedText } from '@/components/themed-text';
+import { ThemedView } from '@/components/themed-view';
+import { detalleDeUnidad, estadoDeUnidad, useFlotaFom } from '@/hooks/use-flota-fom';
+import { etiquetaCortaDeUnidad } from '@/lib/vehiculos';
+import { useTheme } from '@/theme';
+import type { MapMarker } from '@/types';
+
+/** Superficie de las piezas que flotan sobre el mapa. */
+const SOBRE_MAPA = 'rgba(20, 26, 34, 0.94)';
+
+/**
+ * EL MAPA COMPLETO DE LA FLOTA, a pantalla entera, como el Centro de control
+ * de la web. Las unidades en vivo (se releen solas cada 20 s); al tocar una,
+ * su ficha flota abajo con «Ver recorrido» y «Ficha».
+ */
+export default function MapaFlotaScreen() {
+  const { colors, spacing, radii } = useTheme();
+  const router = useRouter();
+  const insets = useSafeAreaInsets();
+  const { unidades, ahora, ultimaConsulta } = useFlotaFom();
+  const [tocada, setTocada] = useState<string | null>(null);
+  const sello = ultimaConsulta ?? ahora;
+
+  const markers: MapMarker[] = useMemo(
+    () =>
+      unidades
+        .filter((u) => u.pos)
+        .map((u) => {
+          const estado = estadoDeUnidad(u, sello);
+          return {
+            id: u.vehicle.id,
+            label: etiquetaCortaDeUnidad(u.vehicle),
+            coords: { lat: u.pos!.lat, lng: u.pos!.lng },
+            live: estado !== 'sin-senal',
+            estado,
+            rumbo: u.pos?.rumbo ?? null,
+            placa: u.vehicle.placa,
+          };
+        }),
+    [unidades, sello],
+  );
+  const encuadreClave = markers.map((m) => m.id).sort().join('|');
+  const enMarcha = markers.filter((m) => m.estado === 'marcha').length;
+  const unidad = tocada ? unidades.find((u) => u.vehicle.id === tocada) : undefined;
+  const altoFicha = unidad ? 130 : 0;
+
+  return (
+    <ThemedView style={styles.root}>
+      <MapaVehiculo
+        markers={markers}
+        sinUsuario
+        hideOverlays
+        encuadreClave={encuadreClave}
+        resaltadoId={tocada}
+        onMarkerPress={setTocada}
+        onMapaPress={() => setTocada(null)}
+        margenArriba={insets.top + 64}
+        margenAbajo={altoFicha + insets.bottom}
+        style={styles.mapa}
