+import { ThemedText } from '@/components/themed-text';
+import { ThemedView } from '@/components/themed-view';
+import { useAsyncData } from '@/hooks/use-async-data';
+import { getVencimientosDeEmpresa, type DocumentoVencimiento } from '@/services';
+import { useTheme, type ColorTokens } from '@/theme';
+import { formatVencimiento } from '@/utils/date';
+import { DOC_VISTA } from '@/utils/vigencia';
+
+/** Los chips de la web: por estado y por de quién es el papel. Uno a la vez. */
+type Filtro = 'todos' | 'vencido' | 'por_vencer' | 'vigente' | 'vehiculo' | 'persona';
+const FILTROS: { id: Filtro; label: string; titulo: string }[] = [
+  { id: 'todos', label: 'Todos', titulo: 'Todos los documentos' },
+  // Lo vencido y lo que vence en 30 días es lo que pide moverse ya.
+  { id: 'vencido', label: 'Vencidos', titulo: 'Atención inmediata' },
+  { id: 'por_vencer', label: 'Por vencer', titulo: 'Atención inmediata' },
+  { id: 'vigente', label: 'Vigentes', titulo: 'Vigentes' },
+  { id: 'vehiculo', label: 'Vehículos', titulo: 'Documentos de vehículos' },
+  { id: 'persona', label: 'Personas', titulo: 'Documentos de personas' },
+];
+
+/** Cuántas filas se pintan antes de «Ver los N»: una flota grande tiene cientos. */
+const TOPE_LISTA = 20;
+
+const MESES_CORTOS = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
+const MESES = [
+  'enero',
+  'febrero',
+  'marzo',
+  'abril',
+  'mayo',
+  'junio',
+  'julio',
+  'agosto',
+  'septiembre',
+  'octubre',
+  'noviembre',
+  'diciembre',
+];
+
+/** Alto de la barra más alta de los vencimientos por mes. */
+const ALTO_BARRA = 100;
+
+/** Lo más urgente arriba: vencidos, por vencer y al final los vigentes. */
+const ORDEN_ESTADO: Record<DocumentoVencimiento['estado'], number> = { vencido: 0, por_vencer: 1, vigente: 2 };
+
+function pasaFiltro(d: DocumentoVencimiento, f: Filtro): boolean {
+  // «Todos» son todos: la cifra «Total» y su pastilla cuentan lo mismo que se lista.
+  if (f === 'todos') return true;
+  if (f === 'vehiculo') return d.ambito === 'vehiculo';
+  if (f === 'persona') return d.ambito !== 'vehiculo';
+  return d.estado === f;
+}
+
+/**
+ * ¿Es la cédula, la licencia o la carta médica de OTRA persona? Esas tienen
+ * ficha propia: su detalle, sin «ajeno», redirige a las fichas de quien está en
+ * sesión y terminarías editando las tuyas. Se abren de solo lectura y las
+ * renueva su dueño.
+ */
+function esFichaAjena(d: DocumentoVencimiento, userId: string | undefined): boolean {
+  return d.ambito !== 'vehiculo' && d.duenioId !== userId && Object.values(TIPO_PAPEL).includes(d.tipo);
+}
+
+/** Días de hoy al vencimiento (negativo = ya venció), contando días de aquí. */
+function diasPara(iso: string): number {
+  const vence = new Date(`${iso.slice(0, 10)}T00:00:00`);
+  const hoy = new Date();
+  hoy.setHours(0, 0, 0, 0);
+  return Math.round((vence.getTime() - hoy.getTime()) / 86_400_000);
+}
+
+/** «Vencido hace 42 días», «Vence en 5 días» o, si está al día, el mes. */
+function textoVence(d: DocumentoVencimiento): string {
+  const dias = diasPara(d.venceEn);
+  // El estado manda, pero si la fecha es hoy no hay «hace 0 días»: vence hoy.
+  if (d.estado === 'vencido' && dias >= 0) return 'Vence hoy';
+  if (d.estado === 'vencido') return `Vencido hace ${-dias} ${dias === -1 ? 'día' : 'días'}`;
+  if (d.estado === 'por_vencer') {
+    if (dias <= 0) return 'Vence hoy';
+    if (dias === 1) return 'Vence mañana';
+    return `Vence en ${dias} días`;
+  }
+  return `Vence ${formatVencimiento(d.venceEn)}`;
+}
+
+/** Una de las 4 cifras: caja de ícono, nombre, número y una línea de ayuda. */
+function Cifra({
+  icon,
+  tono,
+  fondo,
+  label,
+  valor,
+  ayuda,
+  activo,
+  onPress,
+}: {
+  icon: TabIconName;
+  tono: keyof ColorTokens;
+  fondo: keyof ColorTokens;
+  label: string;
+  valor: number;
+  ayuda: string;
+  activo: boolean;
+  onPress: () => void;
+}) {
+  const { colors, spacing, radii } = useTheme();
+  return (
+    <PressableScale
+      onPress={onPress}
+      accessibilityRole="button"
+      accessibilityState={{ selected: activo }}
+      accessibilityLabel={`${label}: ${valor}`}
+      style={styles.cifra}>
+      <Card style={[styles.cifraCaja, { gap: 2 }, activo ? { borderColor: colors.borderStrong } : null]}>
+        <View style={[styles.ibox, { backgroundColor: colors[fondo], borderRadius: radii.sm, marginBottom: spacing.sm + 2 }]}>
+          <TabIcon name={icon} color={colors[tono]} size={18} />
+        </View>
+        <ThemedText variant="caption" color="textSecondary" numberOfLines={1}>
+          {label}
+        </ThemedText>
+        <ThemedText tabular style={styles.numero}>
+          {`${valor}`}
+        </ThemedText>
+        <ThemedText variant="caption" color="textMuted" style={styles.ayuda}>
+          {ayuda}
+        </ThemedText>
+      </Card>
+    </PressableScale>
+  );
+}
+
+/**
+ * DOCUMENTOS DE LA EMPRESA — lo que ve el supervisor, como en la web.
+ *
+ * No vigila «papeles»: vigila QUÉ se le vence y A QUIÉN. Por eso arriba van
+ * las 4 cifras, luego lo que pide atención con su «Renovar» y al final cuánto
+ * vence cada mes, para ver venir los meses cargados.
+ *
+ * Sale de la misma lectura que el Resumen del panel (`getVencimientosDeEmpresa`),
+ * así la cifra que te trajo hasta aquí es la misma que ves al llegar.
+ */
+export function DocumentosEmpresa({ companyId }: { companyId: string }) {
+  const { colors, spacing, radii, borderWidths } = useTheme();
+  const { user } = useAuth();
+  const router = useRouter();
+  const [filtro, setFiltro] = useState<Filtro>('todos');
+  const [verTodos, setVerTodos] = useState(false);
+
+  // Al volver de renovar uno, la lista ya trae la fecha nueva.
+  const { data, estado, recargar } = useAsyncData(() => getVencimientosDeEmpresa(companyId), [companyId], {
+    onFocus: true,
+  });
+  const docs = useMemo(() => data ?? [], [data]);
+
+  const cuenta = useMemo(() => {
+    const c: Record<Filtro, number> = { todos: 0, vencido: 0, por_vencer: 0, vigente: 0, vehiculo: 0, persona: 0 };
+    for (const d of docs) for (const f of FILTROS) if (pasaFiltro(d, f.id)) c[f.id] += 1;
+    return c;
+  }, [docs]);
+
+  const lista = useMemo(
+    () =>
+      docs
+        .filter((d) => pasaFiltro(d, filtro))
+        .sort((a, b) => ORDEN_ESTADO[a.estado] - ORDEN_ESTADO[b.estado] || a.venceEn.localeCompare(b.venceEn)),
+    [docs, filtro],
+  );
+  const vistos = verTodos ? lista : lista.slice(0, TOPE_LISTA);
+  const titulo = FILTROS.find((f) => f.id === filtro)?.titulo ?? '';
+
+  /** Cuántos vencen en este mes y los 5 siguientes. */
+  const meses = useMemo(() => {
+    const hoy = new Date();
+    return Array.from({ length: 6 }, (_, k) => {
+      const m = new Date(hoy.getFullYear(), hoy.getMonth() + k, 1);
+      const clave = `${m.getFullYear()}-${String(m.getMonth() + 1).padStart(2, '0')}`;
+      return { mes: m.getMonth(), n: docs.filter((d) => d.venceEn.slice(0, 7) === clave).length };
+    });
+  }, [docs]);
+  const tope = Math.max(1, ...meses.map((m) => m.n));
+  const cargado = meses.reduce((a, b) => (b.n > a.n ? b : a), meses[0]);
+
+  function elegir(f: Filtro) {
+    setFiltro(f);
+    setVerTodos(false);
+  }
+
+  /** Abre el papel para renovarlo: su fecha y sus fotos se cambian en su detalle. */
+  function abrir(d: DocumentoVencimiento) {
+    const ajeno = esFichaAjena(d, user?.id);
+    router.navigate({ pathname: '/documento', params: { id: d.id, ...(ajeno ? { ajeno: '1' } : {}) } });
+  }
+
+  return (
+    <ThemedView style={styles.root} ambient>
+      <SafeAreaView style={styles.safeArea} edges={['top']}>
+        <ScreenHeader title="Documentos" />
+
+        {estado === 'error' ? (
+          <ErrorState description="No pudimos cargar los documentos de la empresa." onRetry={recargar} />
+        ) : !data ? (
+          <View style={[styles.content, { padding: spacing.lg, gap: spacing.md }]}>
+            <Skeleton height={60} width="70%" />
+            <View style={[styles.cifras, { gap: spacing.md }]}>
+              {[0, 1, 2, 3].map((i) => (
+                <View key={i} style={styles.cifra}>
+                  <Skeleton height={132} radius={radii.lg} />
+                </View>
+              ))}
+            </View>
+            <Skeleton height={220} radius={radii.lg} />
+          </View>
+        ) : (
+          <ScrollVisible
+            contentContainerStyle={[
+              styles.content,
+              { paddingHorizontal: spacing.lg, paddingTop: spacing.xs, gap: spacing.lg },
+            ]}>
+            <View style={{ gap: spacing.xs + 2 }}>
+              <ThemedText variant="title" style={styles.titulo}>
+                Documentos
+              </ThemedText>
+              <ThemedText variant="body" color="textSecondary" style={styles.bajada}>
+                Pólizas, certificados y licencias con su fecha de vencimiento al día.
+              </ThemedText>
+            </View>
+
+            {/* Las mismas 4 cifras que la web. Tocar una filtra la lista. */}
+            <View style={[styles.cifras, { gap: spacing.md }]} accessibilityLabel="Cifras de documentos">
+              <Cifra
+                icon="aviso"
+                tono="danger"
+                fondo="dangerSurface"
+                label="Vencidos"
+                valor={cuenta.vencido}
+                ayuda="Regularízalos cuanto antes"
+                activo={filtro === 'vencido'}
+                onPress={() => elegir('vencido')}
+              />
+              <Cifra
+                icon="calendario"
+                tono="warning"
+                fondo="warningSurface"
+                label="Por vencer en 30 días"
+                valor={cuenta.por_vencer}
+                ayuda="Programa la renovación"
+                activo={filtro === 'por_vencer'}
+                onPress={() => elegir('por_vencer')}
+              />
+              <Cifra
+                icon="check"
+                tono="success"
+                fondo="successSurface"
+                label="Vigentes"
+                valor={cuenta.vigente}
+                ayuda="Con más de 30 días de vigencia"
+                activo={filtro === 'vigente'}
+                onPress={() => elegir('vigente')}
+              />
+              <Cifra
+                icon="inspeccion"
+                tono="primary"
+                fondo="infoSurface"
+                label="Total"
+                valor={cuenta.todos}
+                ayuda="Documentos bajo control"
+                activo={filtro === 'todos'}
+                onPress={() => elegir('todos')}
+              />
+            </View>
+
+            <RielOpciones seleccion={filtro} contentContainerStyle={[styles.filtros, { gap: spacing.sm }]}>
+              {FILTROS.map((f) => (
+                <OpcionRiel key={f.id} id={f.id}>
+                  <PastillaFiltro
+                    label={f.label}
+                    activo={filtro === f.id}
+                    cuenta={cuenta[f.id]}
+                    onPress={() => elegir(f.id)}
+                  />
+                </OpcionRiel>
+              ))}
+            </RielOpciones>
