+/**
+ * Aviso de SESIÓN PERDIDA.
+ *
+ * El cliente de FOM (`fom-api`) es quien se entera de que la sesión murió del
+ * otro lado —el refresh respondió 401/403: revocada, vencida o reutilizada—,
+ * pero no sabe nada de pantallas ni de navegación. Antes borraba la sesión y
+ * nadie llevaba a la persona al login: cada pantalla quedaba fallando con
+ * «no hay sesión». Este emisor es el puente: `fom-api` avisa y el proveedor de
+ * autenticación, que sí manda en la app, cierra la sesión.
+ *
+ * Es un archivo aparte, sin dependencias, para que `fom-api` no tenga que
+ * importar nada de React ni del contexto de autenticación.
+ */
+
+type Oyente = () => void;
+
+const oyentes = new Set<Oyente>();
+
+/** Se suscribe al aviso. Devuelve la función que lo desuscribe. */
+export function alSesionPerdida(fn: Oyente): () => void {
+  oyentes.add(fn);
+  return () => {
+    oyentes.delete(fn);
+  };
+}
+
+/**
+ * Avisa a todos los suscritos de que la sesión se perdió.
+ *
+ * Un oyente que falla no impide que los demás se enteren: el aviso tiene que
+ * llegar a quien lleva al login.
+ */
+export function avisarSesionPerdida(): void {
+  for (const fn of [...oyentes]) {
+    try {
+      fn();
+    } catch {
+      // Ver arriba: los demás oyentes siguen.
+    }
+  }
+}
