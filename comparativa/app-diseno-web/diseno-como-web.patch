+++ b/src/lib/informe-html.ts
@@ -0,0 +1,684 @@
+/**
+ * El INFORME EMPRESARIAL en A4: portada, resumen ejecutivo, una sección por
+ * formato y el cierre con notas y firmas; cada hoja con su encabezado (logo
+ * FOM sobre caja oscura) y su pie («Página N de M», período, fecha y
+ * «Confidencial · uso interno»).
+ *
+ * Por qué se pagina A MANO: el «Página N de M» con contadores CSS (`@page` y
+ * sus cajas de margen) no existe en el WebKit de iOS, que es quien imprime en
+ * el iPhone. Así que cada hoja es una caja de 793 × 1120 px (A4 a 96 px por
+ * pulgada, con un margen de redondeo) que termina con un salto de página, y
+ * aquí se decide qué cabe en cada una. Las tablas largas siguen en la hoja
+ * siguiente con su encabezado repetido.
+ */
+
+import { ISOTIPO_FOM, WORDMARK_FOM } from './logos';
+import { fechaHora } from './informe-numeros';
+import {
+  ALTO_ENCABEZADO,
+  ALTO_TITULO_TABLA,
+  ALTO_TOTAL,
+  PARES_POR_BLOQUE,
+  altoFila,
+  barraHtml,
+  bloque,
+  esc,
+  etiqueta,
+  lineas,
+  marca,
+  medidorHtml,
+  nota,
+  palabraDe,
+  tabla,
+  tablaHtml,
+  tituloSeccion,
+  trozos,
+  type ColumnaTabla,
+  type FilaTabla,
+  type Pieza,
+  type TablaInforme,
+} from './informe-piezas';
+import { cierre, fuentesDe, hayComparacion, piezasFicha, queTrae, resumenEjecutivo, seccionDe } from './informe-secciones';
+import type { DatosInforme } from './informe-tipos';
+import type { CeldaPdf, FormatoPdf, PortadaPdf, SeccionPdf, Semaforo } from './pdf';
+
+/**
+ * Alto útil del cuerpo de una hoja, en px (el diseño deja 886). Las alturas
+ * de las piezas se estiman algo por encima de lo real, así que basta poca holgura.
+ */
+const ALTO_UTIL = 882;
+/** Separación entre bloques del cuerpo. */
+const GAP = 12;
+
+// ─────────────────────────────── Paginar ───────────────────────────────
+
+/** El cuerpo de una hoja, todavía sin número. */
+interface Hoja {
+  etiqueta: string;
+  cuerpo: string;
+}
+
+/** Reparte las piezas de una sección en hojas. */
+function paginar(etiquetaHoja: string, piezas: Pieza[]): Hoja[] {
+  const hojas: Hoja[] = [];
+  let actual: string[] = [];
+  let usado = 0;
+  const cerrar = () => {
+    if (actual.length) hojas.push({ etiqueta: etiquetaHoja, cuerpo: actual.join('') });
+    actual = [];
+    usado = 0;
+  };
+  const libre = () => ALTO_UTIL - usado - (actual.length ? GAP : 0);
+  const poner = (alto: number, html: string) => {
+    usado += (actual.length ? GAP : 0) + alto;
+    actual.push(html);
+  };
+
+  for (const p of piezas) {
+    if (p.tipo === 'bloque') {
+      if (p.bloque.alto > libre() && actual.length) cerrar();
+      if (p.bloque.alto > ALTO_UTIL) {
+        // Más alto que una hoja entera: la hoja lo cortaría por abajo sin
+        // avisar. Los bloques que pueden crecer (fichas, pares de datos) ya
+        // vienen partidos; si aun así uno no cabe, se reduce hasta que quepa.
+        const escala = ALTO_UTIL / p.bloque.alto;
+        poner(ALTO_UTIL, `<div style="zoom:${escala.toFixed(3)}">${p.bloque.html}</div>`);
+        continue;
+      }
+      poner(p.bloque.alto, p.bloque.html);
+      continue;
+    }
+    const t = p.tabla;
+    if (t.filas.length === 0) {
+      const html = `<div>${t.titulo ? `<div class="sub"><h2>${esc(t.titulo)}</h2></div>` : ''}<p class="lec">${esc(
+        t.vacia ?? 'Sin datos.',
+      )}</p></div>`;
+      const alto = (t.titulo ? ALTO_TITULO_TABLA : 0) + 20;
+      if (alto > libre() && actual.length) cerrar();
+      poner(alto, html);
+      continue;
+    }
+    let resto = t.filas;
+    let continua = false;
+    for (;;) {
+      const cabeza = (t.titulo ? ALTO_TITULO_TABLA : 0) + ALTO_ENCABEZADO;
+      const disp = libre() - cabeza;
+      const altoDe = (fs: FilaTabla[]) => fs.reduce((a, f) => a + altoFila(t, f), 0);
+      const todo = altoDe(resto) + (t.total ? ALTO_TOTAL : 0);
+      if (todo <= disp) {
+        poner(cabeza + todo, tablaHtml(t, resto, true, continua));
+        break;
+      }
+      let n = 0;
+      let acum = 0;
+      while (n < resto.length && acum + altoFila(t, resto[n]) <= disp) {
+        acum += altoFila(t, resto[n]);
+        n++;
+      }
+      // Si caben todas menos el total, una fila pasa a la hoja siguiente con él.
+      if (n >= resto.length) n = resto.length - 1;
+      // No empezar una tabla con una o dos filas sueltas al pie de la hoja.
+      if (n < 3 && actual.length) {
+        cerrar();
+        continue;
+      }
+      n = Math.max(1, n);
+      const trozo = resto.slice(0, n);
+      poner(cabeza + altoDe(trozo), tablaHtml(t, trozo, false, continua));
+      resto = resto.slice(n);
+      continua = true;
+      cerrar();
+    }
+  }
+  cerrar();
+  return hojas;
+}
+
+// ─────────────────────────── Formatos genéricos ───────────────────────────
+
+/** ¿La columna es de cifras? (su primera celda viene alineada a la derecha). */
+function esDerecha(s: Extract<SeccionPdf, { tipo: 'tabla' }>, i: number): boolean {
+  const c = s.rows[0]?.[i] ?? s.totales?.[i];
+  return typeof c === 'object' && c.alinear === 'der';
+}
+
+function textoDe(c: CeldaPdf | undefined): string {
+  if (c === undefined) return '';
+  return typeof c === 'string' ? c : c.texto;
+}
+
+/** Una celda del modelo genérico, ya en HTML del informe. */
+function celdaHtml(c: CeldaPdf): string {
+  if (typeof c === 'string') return esc(c);
+  if (c.barra !== undefined) {
+    const ancho = c.barra > 0 ? Math.max(1, Math.min(100, c.barra)) : 0;
+    return `<span class="cb"><i style="width:${ancho}%"></i></span>`;
+  }
+  const texto = c.tono ? etiqueta(c.tono, c.texto) : esc(c.texto);
+  return c.fuerte ? `<b>${texto}</b>` : texto;
+}
+
+/** Ancho de cada columna según lo que traen (para tablas que no se diseñaron una a una). */
+function anchosDe(s: Extract<SeccionPdf, { tipo: 'tabla' }>): number[] {
+  return s.headers.map((h, i) => {
+    let largo = h.length;
+    for (const r of s.rows) largo = Math.max(largo, textoDe(r[i]).length);
+    largo = Math.max(largo, textoDe(s.totales?.[i]).length);
+    const c = s.rows[0]?.[i];
+    if (typeof c === 'object' && c.barra !== undefined) largo = 12;
+    return Math.min(36, Math.max(4, largo)) * 7 + 14;
+  });
+}
+
+/** Las piezas de las secciones genéricas (las de los formatos sin informe propio). */
+export function piezasGenericas(secciones: SeccionPdf[]): Pieza[] {
+  const piezas: Pieza[] = [];
+  const sub = (t?: string, aclaracion?: string) =>
+    t ? `<div class="sub"><h2>${esc(t)}</h2>${aclaracion ? `<span>${esc(aclaracion)}</span>` : ''}</div>` : '';
+  for (const s of secciones) {
+    if (s.tipo === 'texto') {
+      piezas.push(
+        bloque((s.titulo ? ALTO_TITULO_TABLA : 0) + lineas(s.texto, 682, 7) * 20, `<div>${sub(s.titulo)}<p class="txt">${esc(s.texto)}</p></div>`),
+      );
+    } else if (s.tipo === 'datos') {
+      // En trozos que quepan en una hoja: una lista larga de pares sigue en la
+      // siguiente en vez de quedar cortada al pie.
+      trozos(s.filas, PARES_POR_BLOQUE).forEach((filas, i) => {
+        const titulo = s.titulo && i > 0 ? `${s.titulo} (continúa)` : s.titulo;
+        const pares = filas.map(([k, v]) => `<div class="par"><span>${esc(k)}</span><b>${esc(v)}</b></div>`).join('');
+        piezas.push(
+          bloque(
+            (titulo ? ALTO_TITULO_TABLA : 0) + Math.ceil(filas.length / 2) * 22 + 30,
+            `<div>${sub(titulo)}<div class="box pares2">${pares}</div></div>`,
+          ),
+        );
+      });
+    } else if (s.tipo === 'tabla') {
+      const anchos = anchosDe(s);
+      const columnas: ColumnaTabla[] = s.headers.map((h, i) => ({ titulo: h, ancho: anchos[i], der: esDerecha(s, i) }));
+      const t: TablaInforme = {
+        titulo: s.titulo,
+        columnas,
+        filas: s.rows.map((r) => ({ celdas: r.map(celdaHtml) })),
+        total: s.totales ? { celdas: s.totales.map(celdaHtml) } : undefined,
+        compacta: s.rows.length > 30,
+      };
+      piezas.push(tabla(t));
+      if (s.nota) piezas.push(nota(esc(s.nota)));
+    } else if (s.tipo === 'indicadores') {
+      piezas.push(
+        tabla({
+          titulo: s.titulo,
+          columnas: [
+            { titulo: 'Indicador', ancho: 220 },
+            { titulo: 'Valor', ancho: 80, der: true },
+            { titulo: 'Óptimo', ancho: 100 },
+            { titulo: 'Escala', ancho: 150 },
+            { titulo: 'Resultado', ancho: 110 },
+          ],
+          filas: s.items.map((i) => ({
+            alto: 34,
+            celdas: [
+              `<b>${esc(i.nombre)}</b>`,
+              `<span class="vg">${esc(i.valor)}</span>`,
+              esc(i.optimo ?? '—'),
+              i.medidor ? medidorHtml(i.medidor, i.tono !== 'neutro') : '',
+              etiqueta(i.tono),
+            ],
+          })),
+        }),
+      );
+    } else if (s.tipo === 'kpis') {
+      const cards = s.items
+        .map(
+          (k) =>
+            `<div class="kp"><span class="l">${esc(k.label)}</span><span class="v">${esc(k.valor)}${
+              k.tono ? marca(k.tono) : ''
+            }</span>${k.sub ? `<span class="p">${esc(k.sub)}</span>` : ''}</div>`,
+        )
+        .join('');
+      const filas = Math.ceil(s.items.length / 4);
+      piezas.push(bloque((s.titulo ? ALTO_TITULO_TABLA : 0) + filas * 96 + (filas - 1) * 10, `<div>${sub(s.titulo)}<div class="g4">${cards}</div></div>`));
+    } else {
+      const mayor = Math.max(1, ...s.barras.map((b) => b.valor));
+      const barras = s.barras
+        .map((b) => barraHtml(b.label, b.valor / mayor, b.etiqueta ?? String(b.valor), b.tono ? palabraDe(b.tono) : undefined))
+        .join('');
+      piezas.push(
+        bloque(
+          (s.titulo ? ALTO_TITULO_TABLA : 0) + s.barras.length * 26 + 30,
+          `<div>${sub(s.titulo, s.unidad)}<div class="box"><div class="bars">${barras}</div></div></div>`,
+        ),
+      );
+      if (s.nota) piezas.push(nota(esc(s.nota)));
+    }
+  }
+  return piezas;
+}
+
+/** La leyenda del semáforo, para los formatos genéricos que lo usan. */
+function leyenda(): Pieza {
+  const tonos: Semaforo[] = ['verde', 'amarillo', 'rojo', 'neutro'];
+  return bloque(22, `<p class="ley">${tonos.map((t) => etiqueta(t)).join('')}</p>`);
+}
+
+// ─────────────────────────────── Hoja ───────────────────────────────
+
+/** El logo completo de FOM (símbolo + letras) en texto SVG, para la caja oscura. */
+function logoFom(): string {
+  const simbolo = (ISOTIPO_FOM.trazos ?? []).map((t) => `<path d="${t.d}" fill="${t.color}"/>`).join('');
+  const letras = WORDMARK_FOM.map((t) => `<path d="${t.d}" fill="${t.color}" fill-rule="evenodd"/>`).join('');
+  return `<svg xmlns="http://www.w3.org/2000/svg" width="93" height="28" viewBox="0 0 280 84" aria-label="FOM"><g transform="translate(0 1)">${simbolo}</g>${letras}</svg>`;
+}
+
+/** Lo que se repite en todas las hojas. */
+interface Marco {
+  titulo: string;
+  empresa?: string;
+  periodo?: string;
+  generado: string;
+  generadoPor?: string;
+}
+
+function hojaHtml(h: Hoja, n: number, total: number, m: Marco): string {
+  const pieIzq = [
+    m.periodo ? `<span>Período <b>${esc(m.periodo)}</b></span>` : '',
+    `<span>Generado el ${esc(m.generado)}${m.generadoPor ? ` · ${esc(m.generadoPor)}` : ''}</span>`,
+  ].join('');
+  return `<div class="pg">
+<header class="hd"><div class="hd-row"><div class="logo">${logoFom()}</div><div class="hd-t"><b>${esc(m.titulo)}</b>${
+    m.empresa ? `<span>${esc(m.empresa)}</span>` : ''
+  }</div><div class="hd-r"><b>${esc(h.etiqueta)}</b><span>Fleet Operations &amp; Maintenance</span></div></div><div class="rule"><i></i><s></s></div></header>
+<main class="mn">${h.cuerpo}</main>
+<footer class="ft"><span>${pieIzq}</span><span>Confidencial · uso interno</span><span><b>Página ${n} de ${total}</b></span></footer>
+</div>`;
+}
+
+// ─────────────────────────────── Documento ───────────────────────────────
+
+/** Una sección del índice, con sus hojas. */
+interface Parte {
+  nombre: string;
+  corto: string;
+  descripcion: string;
+  hojas: Hoja[];
+}
+
+export interface OpcionesInforme {
+  /** 0.75 en iOS: allí 1 px de CSS se imprime como 1 punto (ver `pdf.ts`). */
+  escala?: number;
+  /** Fecha de generación (por defecto, ahora). */
+  ahora?: Date;
+}
+
+/** El título fijo del documento, el que va en cada encabezado. */
+const TITULO = 'Informe de gestión de flota';
+
+/**
+ * El documento entero: portada + resumen (si hay datos de origen) + una
+ * sección por formato + notas y firmas.
+ */
+export function documentoInforme(portada: PortadaPdf, formatos: FormatoPdf[], opc: OpcionesInforme = {}): string {
+  const ahora = opc.ahora ?? new Date();
+  const generado = fechaHora(ahora);
+  const datos = formatos.flatMap((f) => (f.informe ? [f.informe] : []));
+  // Hay resumen si hay datos de origen o si la pantalla mandó el suyo.
+  const conResumen = datos.some((d) => d.tipo !== 'ficha') || !!portada.resumen;
+  const comparado =
+    hayComparacion(fuentesDe(datos)) || !!portada.resumen?.cifras.some((c) => c.delta && !c.ahora);
+  const periodoAnterior = portada.periodoAnterior || portada.resumen?.comparadoCon || undefined;
+
+  // ── Secciones de los formatos (las fichas van dentro de Vehículos). ──
+  const partes: Parte[] = [];
+  const piezasDe: { nombre: string; corto: string; descripcion: string; piezas: Pieza[]; vehiculos: boolean; fichas: number }[] = [];
+  let numero = conResumen ? 3 : 2;
+  for (const f of formatos) {
+    const d: DatosInforme | undefined = f.informe;
+    if (d?.tipo === 'ficha') {
+      let dueña = piezasDe[piezasDe.length - 1];
+      if (!dueña || !dueña.vehiculos) {
+        dueña = {
+          nombre: 'Fichas de unidades',
+          corto: 'Fichas',
+          descripcion: 'Lo abierto y lo realizado en cada unidad elegida.',
+          piezas: [tituloSeccion(`Sección ${numero}`, 'Fichas de unidades')],
+          vehiculos: true,
+          fichas: 0,
+        };
+        piezasDe.push(dueña);
+        numero++;
+      }
+      dueña.piezas.push(...piezasFicha(d.ficha, dueña.fichas === 0));
+      dueña.fichas++;
+      continue;
+    }
+    if (d) {
+      const s = seccionDe(d, numero);
+      piezasDe.push({ ...s, corto: s.nombre, vehiculos: d.tipo === 'vehiculos', fichas: 0 });
+    } else {
+      piezasDe.push({
+        nombre: f.nombre,
+        corto: f.nombre.length > 18 ? 'Formato' : f.nombre,
+        descripcion: `Formato ${f.codigo}.`,
+        piezas: [
+          tituloSeccion(`Sección ${numero} · ${f.codigo}`, f.nombre),
+          ...(f.semaforo ? [leyenda()] : []),
+          ...piezasGenericas(f.secciones),
+        ],
+        vehiculos: false,
+        fichas: 0,
+      });
+    }
+    numero++;
+  }
+
+  const n0 = conResumen ? 3 : 2;
+  piezasDe.forEach((s, i) => {
+    partes.push({ nombre: s.nombre, corto: s.corto, descripcion: s.descripcion, hojas: paginar(`${n0 + i} · ${s.corto}`, s.piezas) });
+  });
+
+  const resumen: Parte | null = conResumen
+    ? {
+        nombre: 'Resumen ejecutivo',
+        corto: 'Resumen',
+        descripcion: 'En pocas palabras, indicadores clave y puntos de atención.',
+        hojas: paginar(
+          '2 · Resumen',
+          resumenEjecutivo(datos, {
+            conclusion: portada.conclusion,
+            periodoAnterior,
+            generado,
+            resumen: portada.resumen,
+          }),
+        ),
+      }
+    : null;
+
+  const nCierre = n0 + piezasDe.length;
+  const final: Parte = {
+    nombre: 'Notas y firmas',
+    corto: 'Cierre',
+    descripcion: 'Origen de cada dato, glosario y firmas.',
+    hojas: paginar(
+      `${nCierre} · Cierre`,
+      cierre(datos, {
+        numero: nCierre,
+        periodo: portada.periodo,
+        periodoAnterior,
+        generado,
+        generadoPor: portada.generadoPor,
+        anio: ahora.getFullYear(),
+        comparado,
+      }),
+    ),
+  };
+
+  const cuerpo = [...(resumen ? [resumen] : []), ...partes, final];
+
+  // ── Índice con la página de inicio de cada parte. ──
+  const entradas: { nombre: string; descripcion: string; pagina: number }[] = [
+    { nombre: 'Portada', descripcion: 'Empresa, período, alcance y contenido.', pagina: 1 },
+  ];
+  let pagina = 2;
+  for (const p of cuerpo) {
+    entradas.push({ nombre: p.nombre, descripcion: p.descripcion, pagina });
+    pagina += p.hojas.length;
+  }
+  const total = pagina - 1;
+
+  const marco: Marco = {
+    titulo: TITULO,
+    empresa: portada.empresa,
+    periodo: portada.periodo,
+    generado,
+    generadoPor: portada.generadoPor?.nombre,
+  };
+
+  const hojas = [
+    portadaHoja(portada, formatos, datos, entradas, { generado, comparado, periodoAnterior }),
+    ...cuerpo.flatMap((p) => p.hojas),
+  ];
+  return documentoHtml(
+    hojas.map((h, i) => hojaHtml(h, i + 1, total, marco)).join(''),
+    opc.escala,
+  );
+}
+
+/** La primera hoja: de quién es, de cuándo, qué alcance y qué trae. */
+function portadaHoja(
+  p: PortadaPdf,
+  formatos: FormatoPdf[],
+  datos: DatosInforme[],
+  entradas: { nombre: string; descripcion: string; pagina: number }[],
+  opc: { generado: string; comparado: boolean; periodoAnterior?: string },
+): Hoja {
+  const { generado } = opc;
+  // El título que pasa la pantalla es «<formato> — <empresa>»: aquí van por separado.
+  const formato = p.titulo.split(' — ')[0].trim() || p.titulo;
+  const propios = formatos.filter((f) => f.informe?.tipo !== 'ficha').length;
+  // El completo ya se llama como el documento: arriba no se repite el título.
+  const antetitulo = [formato === TITULO ? 'Reporte completo' : formato, p.subtitulo].filter(Boolean).join(' · ');
+  const trae = queTrae(datos, opc.comparado);
+
+  const meta: [string, string, string?][] = [];
+  if (p.periodo) meta.push(['Período del informe', p.periodo]);
+  if (opc.comparado && opc.periodoAnterior) meta.push(['Comparado con', opc.periodoAnterior, 'Período anterior']);
+  if (p.subtitulo) meta.push(['Alcance', p.subtitulo]);
+  if (p.generadoPor) meta.push(['Generado por', p.generadoPor.nombre, p.generadoPor.cargo]);
+  meta.push(['Fecha de generación', generado, 'Hora del equipo']);
+  meta.push(['Formato', formato, propios > 1 ? `${propios} formatos en un PDF` : undefined]);
+  for (const [k, v] of p.meta ?? []) meta.push([k, v]);
+  const metaHtml = meta
+    .map(
+      ([k, v, s]) =>
+        `<div><p class="eb mut">${esc(k)}</p><p class="mv">${esc(v)}</p>${s ? `<p class="ms">${esc(s)}</p>` : ''}</div>`,
+    )
+    .join('');
+
+  const toc = entradas
+    .map(
+      (e, i) =>
+        `<li><span class="tn${i === 0 ? ' on' : ''}">${i + 1}</span><span class="tt"><b>${esc(e.nombre)}</b><span>${esc(
+          e.descripcion,
+        )}</span></span><span class="tp">Página ${e.pagina}</span></li>`,
+    )
+    .join('');
+
+  const tieneVeh = datos.some((d) => d.tipo === 'vehiculos');
+  const aclaracion = tieneVeh
+    ? 'Estado de marcha, conductor titular, papeles y ODT abiertas corresponden a la vista al generar el informe; kilómetros, eventos y gastos, al período elegido.'
+    : 'Las cifras corresponden al período elegido, consultadas en FOM al generar el informe.';
+
+  return {
+    etiqueta: '1 · Portada',
+    cuerpo: `<div class="por">
+  ${antetitulo ? `<p class="eb">${esc(antetitulo)}</p>` : ''}
+  <h1 class="pt">Informe de gestión<br>de flota</h1>
+  ${p.empresa ? `<p class="pemp">${esc(p.empresa)}</p>` : ''}
+  ${trae ? `<p class="pd">${esc(trae)}</p>` : ''}
+</div>
+<div class="meta">${metaHtml}</div>
+<div><h2 class="h2g mb8">Contenido</h2><ol class="toc">${toc}</ol></div>
+<p class="nota abajo">${esc(aclaracion)}</p>`,
+  };
+}
+
+/** Un reporte suelto (sin portada ni resumen): título, secciones y sus hojas numeradas. */
+export function documentoSimple(
+  opts: { titulo: string; subtitulo?: string; secciones: SeccionPdf[] },
+  opc: OpcionesInforme = {},
+): string {
+  const generado = fechaHora(opc.ahora ?? new Date());
+  const piezas: Pieza[] = [tituloSeccion('FOM · Fleet Operations & Maintenance', opts.titulo, opts.subtitulo), ...piezasGenericas(opts.secciones)];
+  const hojas = paginar('Reporte', piezas);
+  const marco: Marco = { titulo: opts.titulo, empresa: opts.subtitulo, generado };
+  return documentoHtml(hojas.map((h, i) => hojaHtml(h, i + 1, hojas.length, marco)).join(''), opc.escala);
+}
+
+// ─────────────────────────────── Estilos ───────────────────────────────
+
+function documentoHtml(hojas: string, escala = 1): string {
+  const zoom = escala !== 1 ? `body{zoom:${escala};}` : '';
+  return `<!DOCTYPE html><html lang="es"><head><meta charset="utf-8" />
+<meta name="viewport" content="width=device-width, initial-scale=1" />
+<title>${TITULO}</title>
+<style>${ESTILOS}${zoom}</style></head><body>${hojas}</body></html>`;
+}
