+// ─────────────────────────── Estadístico ───────────────────────────
+
+/** Qué mide cada indicador, en una línea (por su nombre). */
+function queMide(nombre: string): string {
+  const n = nombre.toLowerCase();
+  if (n.includes('score')) return 'Eventos ÷ km × 100';
+  if (n.includes('registro') || n.includes('conductor')) return 'Km con conductor identificado';
+  if (n.includes('kilómetros') || n.includes('km')) return 'Con GPS en el período';
+  return '';
+}
+
+/**
+ * Lo que se sabe del período anterior en el estadístico. Sale del MISMO
+ * informe estadístico que el actual, pedido para el período de antes: así km,
+ * eventos y unidades se cuentan igual en los dos lados.
+ */
+interface AntesEstadistico {
+  km: number;
+  eventos: number;
+  pctIdentificado: number | null;
+  conKm: number;
+  unidades: number;
+}
+
+function antesEstadistico(a: FormatoPredefReporte | undefined): AntesEstadistico | null {
+  if (!a) return null;
+  const t = a.alertasPorVehiculo.reduce(
+    (x, v) => ({ km: x.km + v.km, eventos: x.eventos + v.aceleraciones + v.frenadas + v.excesos }),
+    { km: 0, eventos: 0 },
+  );
+  return {
+    ...t,
+    pctIdentificado: pctIdentificado(a),
+    conKm: a.alertasPorVehiculo.filter((v) => v.km > 0).length,
+    unidades: a.alertasPorVehiculo.length,
+  };
+}
+
+function seccionEstadistico(r: FormatoPredefReporte, ant: FormatoPredefReporte | undefined, n: number): SeccionInforme {
+  const piezas: Pieza[] = [
