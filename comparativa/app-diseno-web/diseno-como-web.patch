+}
+
+/**
+ * El responsable inicia, pausa, reanuda o entrega su ODT.
+ *
+ * `clave` identifica el INTENTO: viaja como `clientEventId` y como cabecera
+ * `Idempotency-Key`. Si un reintento llega con la misma clave y lo mismo, FOM
+ * contesta el evento ya guardado en vez de registrar otro; por eso quien llama
+ * la conserva hasta que sale bien.
+ */
+export async function registrarEventoOdt(
+  id: string,
+  evento: { accion: EventoTaller; desde: EstadoTaller; nota?: string; clave: string },
+): Promise<void> {
+  const nota = evento.nota?.trim();
+  try {
+    await pedir(`/api/v1/mobile/work-orders/${id}/execution-events`, {
+      metodo: 'POST',
+      idempotencia: evento.clave,
+      cuerpo: {
+        clientEventId: evento.clave,
+        action: evento.accion,
+        expectedStatus: evento.desde,
+        ...(nota ? { note: nota.slice(0, 1000) } : {}),
+      },
+    });
+  } catch (e) {
+    if (e instanceof ErrorFom && e.code !== 'respuesta_no_json') {
+      if (e.statusCode === 404) throw new Error('Ya no tienes esta ODT asignada. Vuelve a cargarla.');
+      if (e.statusCode === 403) throw new Error('Tu rol no puede trabajar ODT desde la app.');
+      if (e.statusCode === 400 && /note/i.test(e.message)) throw new Error('Escribe una nota de al menos 3 letras.');
+      if (e.statusCode === 409 && /different content|in use/i.test(e.message)) {
