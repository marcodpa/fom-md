+
+  piezas.push(
+    tabla({
+      titulo: 'Ranking de usuarios',
+      aclaracion: 'Licencia y carta médica: mes de vencimiento',
+      columnas: [
+        { titulo: '#', ancho: 22, der: true },
+        { titulo: 'Nombre', ancho: 130, envolver: true },
