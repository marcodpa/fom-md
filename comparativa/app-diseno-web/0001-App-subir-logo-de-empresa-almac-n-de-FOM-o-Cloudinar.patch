@@ -0,0 +1,68 @@
+import { Image } from 'expo-image';
+import { useEffect, useState, type ReactNode } from 'react';
+import { StyleSheet, View } from 'react-native';
+
+import { LogoFomCuadrado } from '@/components/logo-fom';
+import { alCambiarLogos, fuenteLogoDe, type FuenteLogo } from '@/services/fomLogos';
+
+/**
+ * El LOGO de una empresa, para saber de una vez dónde estás (igual que la web).
+ *
+ * - FOM Operations lleva el logo de FOM.
+ * - Si la empresa tiene logo en el almacén de FOM, se pinta ese; si no, el que
+ *   se subió a Cloudinary (su dirección sale del id de la empresa).
+ * - Si no tiene, se pinta `children` (el icono o las iniciales que tenía la
+ *   pantalla), nunca el logo de FOM: una empresa ajena sin logo no es FOM.
+ */
+export function LogoDeEmpresa({
+  empresaId,
+  nombre = '',
+  size = 48,
+  children = null,
+}: {
+  empresaId: string | null | undefined;
+  nombre?: string;
+  size?: number;
+  /** Lo que se ve mientras no hay logo. */
+  children?: ReactNode;
+}) {
+  const [fuente, setFuente] = useState<FuenteLogo>(null);
+  const [fallo, setFallo] = useState(false);
+  // Se subió un logo desde esta app: se vuelve a buscar el de la empresa.
+  const [cambio, setCambio] = useState(0);
+  useEffect(() => alCambiarLogos(() => setCambio((n) => n + 1)), []);
+
+  useEffect(() => {
+    let vivo = true;
+    fuenteLogoDe(empresaId)
+      .catch(() => null)
+      .then((f) => {
+        if (!vivo) return;
+        setFallo(false);
+        setFuente(f);
+      });
+    return () => {
+      vivo = false;
+    };
+  }, [empresaId, cambio]);
+
+  if (fuente === 'fom') return <LogoFomCuadrado size={size} />;
+  if (fuente && !fallo) {
+    return (
+      <View style={{ width: size, height: size }}>
+        <Image
+          source={{ uri: fuente.uri, headers: fuente.headers }}
+          style={styles.imagen}
+          contentFit="contain"
+          accessibilityLabel={nombre ? `Logo de ${nombre}` : undefined}
+          onError={() => setFallo(true)}
+        />
+      </View>
+    );
+  }
+  return <>{children}</>;
+}
+
+const styles = StyleSheet.create({
+  imagen: { width: '100%', height: '100%' },
+});
