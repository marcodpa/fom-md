+}
+
+/** El contenido de la pestaña elegida. */
+export function ContenidoVista({
+  datos,
+  periodo,
+  onVerOdt,
+}: {
+  datos: DatosVista;
+  periodo: ReportPeriod;
+  onVerOdt?: () => void;
+}) {
+  if (datos.tipo === 'vehiculos') return <PestanaVehiculos d={datos} periodo={periodo} onVerOdt={onVerOdt} />;
+  if (datos.tipo === 'usuarios') return <PestanaUsuarios d={datos} />;
+  if (datos.tipo === 'costos') return <PestanaCostos d={datos} />;
+  return <PestanaEstadistico d={datos} />;
+}
+
+/** Esqueletos con la FORMA de lo que viene: la franja de cifras y dos tarjetas. */
+export function EsqueletoVista() {
