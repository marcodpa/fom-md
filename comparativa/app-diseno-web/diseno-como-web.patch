+import { useRef, useState } from 'react';
+import { Alert, StyleSheet, View } from 'react-native';
+
+import { Button } from '@/components/button';
+import { Card } from '@/components/card';
+import { InspeccionesResultado, VISTA_INSPECCION } from '@/components/inspecciones-resultado';
+import { Pastilla } from '@/components/pastilla';
+import { normalizar } from '@/components/search-bar';
+import { TabIcon } from '@/components/tab-icon';
+import { ThemedText } from '@/components/themed-text';
+import { exportarPdf } from '@/lib/pdf';
+import { htmlInspecciones } from '@/lib/pdf-inspeccion';
+import {
+  getAyudasFormatoFom,
+  getInspeccionFom,
+  type InspeccionDetalle,
+  type InspeccionResumen,
+} from '@/services';
+import { useTheme } from '@/theme';
+import { formatHora } from '@/utils/date';
+
+/**
+ * LA INSPECCIÓN DE HOY YA ESTÁ HECHA: lo que ve el conductor en vez del
+ * formulario. Es una por unidad y día, la haga quien la haga.
+ *
+ * Dice cuándo, quién y cómo salió, y deja ver el resultado. Si la hizo otra
+ * persona de la unidad se nombra, para que nadie piense que se perdió la suya.
+ * Sin `inspeccion` solo se sabe que existe (FOM rechazó el envío con 409).
+ */
+export function InspeccionHechaHoy({
+  inspeccion,
+  detalle,
+  yo,
+  aviso,
+}: {
+  inspeccion: InspeccionResumen | null;
+  /** Lo respondido, si ya se tiene: así «Ver resultado» no lo pide a FOM. */
+  detalle?: InspeccionDetalle;
+  /** Quien mira, para decir «la hiciste» o «la hizo …». */
+  yo: { id: string; nombre: string };
+  /** Una línea de arriba, en aviso: por qué se ve esto en vez de lo enviado. */
+  aviso?: string;
+}) {
+  const { colors, spacing, radii } = useTheme();
+  const [abierta, setAbierta] = useState<InspeccionResumen | null>(null);
+  const imprimiendo = useRef(false);
+
+  const v = inspeccion ? VISTA_INSPECCION[inspeccion.resultado] : null;
+  const bloqueada = inspeccion?.resultado === 'bloqueada';
+  const tono = v?.tono ?? 'success';
+  const fondo = bloqueada
+    ? colors.dangerSurface
+    : tono === 'warning'
+      ? colors.warningSurface
+      : colors.successSurface;
+
+  // Con el id se sabe seguro; sin él (servidor viejo), por el nombre.
+  const mia =
+    !!inspeccion &&
+    (inspeccion.conductorId
+      ? inspeccion.conductorId === yo.id
+      : normalizar(inspeccion.conductor) === normalizar(yo.nombre));
+  const hora = inspeccion?.enviadaEn ? `a las ${formatHora(inspeccion.enviadaEn)}` : 'hoy';
+  const titulo = !inspeccion
+    ? 'La inspección de hoy de esta unidad ya está hecha'
+    : mia
+      ? 'Ya hiciste la inspección de hoy'
+      : 'La inspección de hoy ya está hecha';
+  const quien = !inspeccion ? null : mia ? `La hiciste ${hora}.` : `La hizo ${inspeccion.conductor} ${hora}.`;
+
+  /** La hoja impresa de esta inspección, con las viñetas de su formato. */
+  async function imprimir(id: string) {
+    if (imprimiendo.current) return;
+    imprimiendo.current = true;
+    try {
+      const d = detalle?.id === id ? detalle : await getInspeccionFom(id);
+      await exportarPdf(htmlInspecciones([d], await getAyudasFormatoFom(d.vehicleId)));
+    } catch (e) {
+      Alert.alert('No pudimos armar el PDF', e instanceof Error ? e.message : 'Intenta de nuevo.');
+    } finally {
+      imprimiendo.current = false;
+    }
+  }
+
+  return (
+    <>
+      <Card style={{ gap: spacing.md }}>
+        {aviso ? (
+          <ThemedText variant="caption" color="warning">
+            {aviso}
+          </ThemedText>
+        ) : null}
+
+        <View style={[styles.cabeza, { gap: spacing.md }]}>
+          <View style={[styles.circulo, { backgroundColor: fondo, borderRadius: radii.pill }]}>
+            <TabIcon name={bloqueada ? 'aviso' : 'check'} color={colors[tono]} size={22} />
+          </View>
+          <View style={[styles.flex1, { gap: 2 }]}>
+            <ThemedText variant="subtitle">{titulo}</ThemedText>
+            {quien ? (
+              <ThemedText variant="caption" color="textSecondary">
+                {quien}
+              </ThemedText>
+            ) : null}
+          </View>
+        </View>
+
+        {inspeccion && v ? (
+          <View style={[styles.fila, { gap: spacing.sm }]}>
+            <ThemedText variant="caption" color="textMuted" style={styles.flex1} numberOfLines={1}>
+              {[inspeccion.unidad, inspeccion.placa].filter(Boolean).join(' · ')}
+            </ThemedText>
+            <Pastilla tono={v.tono} label={v.label} conPunto />
+          </View>
+        ) : null}
+
+        {inspeccion ? (
+          <Button label="Ver resultado" variant="secondary" onPress={() => setAbierta(inspeccion)} />
+        ) : null}
+
+        <ThemedText variant="caption" color="textMuted">
+          La próxima la puedes hacer mañana.
+        </ThemedText>
+      </Card>
+
+      <InspeccionesResultado
+        inspeccion={abierta}
+        detalleLeido={detalle}
+        onClose={() => setAbierta(null)}
+        onImprimir={(id) => void imprimir(id)}
+      />
+    </>
+  );
+}
+
+const styles = StyleSheet.create({
+  cabeza: { flexDirection: 'row', alignItems: 'center' },
+  fila: { flexDirection: 'row', alignItems: 'center' },
+  circulo: { width: 48, height: 48, alignItems: 'center', justifyContent: 'center' },
+  flex1: { flex: 1, minWidth: 0 },
+});
