--- /dev/null
+++ b/test/regla-senal.test.mjs
@@ -0,0 +1,242 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readdirSync, readFileSync, statSync } from 'node:fs';
+import { registerHooks } from 'node:module';
+import { join, relative } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+// ============================================================
+// UNA SOLA REGLA PARA EL ESTADO DE LA UNIDAD, SU NOMBRE Y SU PLACA
+// ------------------------------------------------------------
+// Espejo de `test/regla-senal.test.js` del panel web. El mismo carro salía
+// «Detenido» en una pantalla, «Parado» en otra y «Sin señal» en una tercera:
+// cada pantalla decidía por su cuenta. Ahora deciden `lib/sin-senal.ts`
+// (`estadoSenal`), `lib/estado-unidad.ts`, `lib/nombre-unidad.ts` y
+// `lib/placas.ts`. Estas pruebas fallan si alguien vuelve a decidirlo fuera.
+//
+// Se corre con `node --test test/` (Node 24 carga los .ts sin compilar).
+// ============================================================
+
+// Los .ts de la app se importan sin extensión (así lo pide TypeScript): se le
+// enseña a Node a probar con «.ts» cuando la ruta relativa no existe.
+registerHooks({
+  resolve(especificador, contexto, siguiente) {
+    try {
+      return siguiente(especificador, contexto);
+    } catch (e) {
+      if (/^\.\.?\//u.test(especificador) && !/\.[cm]?[jt]s$/u.test(especificador)) {
+        return siguiente(`${especificador}.ts`, contexto);
+      }
+      throw e;
+    }
+  },
+});
+
+const { estadoSenal, haceCuanto, SIN_SENAL_MS, SIN_UBICACION_MS, VEL_MARCHA_KMH } = await import('../src/lib/sin-senal.ts');
+const { datosSenal, estadoUnidad, TONO_ESTADO, ETIQUETA_ESTADO } = await import('../src/lib/estado-unidad.ts');
+const { etiquetaUnidad, identidadDeServidor, nombreUnidad } = await import('../src/lib/nombre-unidad.ts');
+const { normalizarPlaca } = await import('../src/lib/placas.ts');
+
+const raiz = fileURLToPath(new URL('..', import.meta.url));
+const SRC = join(raiz, 'src');
+
+function archivos(dir) {
+  return readdirSync(dir).flatMap((n) => {
+    const r = join(dir, n);
+    if (statSync(r).isDirectory()) return archivos(r);
+    return /\.(tsx?|jsx?|mjs)$/u.test(n) ? [r] : [];
+  });
+}
+const FUENTES = archivos(SRC).map((r) => ({ ruta: relative(raiz, r).replace(/\\/g, '/'), texto: readFileSync(r, 'utf8') }));
+
+/** Las líneas de código, sin los comentarios de línea ni de bloque (los comentarios pueden nombrar la regla). */
+function lineasDeCodigo(texto) {
+  const sinBloques = texto.replace(/\/\*[\s\S]*?\*\//gu, (m) => m.replace(/[^\n]/gu, ' '));
+  // Hay archivos con fin de línea de Windows: sin quitar el \r, `.*$` no llega al final.
+  return sinBloques.split(/\r?\n/u).map((l) => l.replace(/(^|[^:'"`])\/\/.*$/u, '$1'));
+}
+
+function buscar(patron, { excepto = [], permitida = () => false } = {}) {
+  const hallazgos = [];
+  for (const f of FUENTES) {
+    if (excepto.includes(f.ruta)) continue;
+    lineasDeCodigo(f.texto).forEach((l, i) => {
+      if (patron.test(l) && !permitida(l, f.ruta)) hallazgos.push(`${f.ruta}:${i + 1}: ${l.trim().slice(0, 120)}`);
+    });
+  }
+  return hallazgos;
+}
+
+// ------------------------------------------------------------
+// NADIE MÁS DECIDE
+// ------------------------------------------------------------
+
+/**
+ * Cachés, refrescos y esperas que duran 5 min y NO deciden la señal: se nombran
+ * y se aceptan uno por uno, con su motivo.
+ */
+const CINCO_MIN_QUE_NO_SON_SENAL = [
+  'REFRESCO_DIA', // cada cuánto se relee el recorrido de hoy (use-recorrido-hoy)
+  'CONDUCTORES_VIGENTE_MS', // caché de quién lleva cada unidad (fomDirectorio)
+  'VIGENCIA_MANEJO_MS', // caché de las métricas de manejo (fomMetricasConductor)
+  'ESPERA_MAX', // espera máxima entre reintentos de la cola sin red (outbox)
+];
+/** La caché del logo de cada empresa (fomLogos): `hasta: Date.now() + 5 min`. */
+const CACHE_DE_LOGOS = /\bhasta:\s*Date\.now\(\)\s*\+\s*5\s*\*\s*60_000/u;
+
+test('el umbral de 5 minutos vive solo en lib/sin-senal.ts', () => {
+  const cinco = /(?<![\d.])(300000|300_000)(?![\d_])|\b5\s*\*\s*60\s*\*\s*1_?000\b|\b5\s*\*\s*60_000\b|\b5\s*\*\s*60000\b|\b5\s*\*\s*MIN(_MS)?\b/u;
+  const hallazgos = buscar(cinco, {
+    excepto: ['src/lib/sin-senal.ts'],
+    permitida: (l) =>
+      CACHE_DE_LOGOS.test(l) || CINCO_MIN_QUE_NO_SON_SENAL.some((n) => new RegExp(`\\bconst\\s+${n}\\s*=`, 'u').test(l)),
+  });
+  assert.deepEqual(hallazgos, [], 'Usa SIN_SENAL_MS / transmitiendo de lib/sin-senal.ts (o, si es una caché, nómbrala y súmala a la lista)');
+});
+
+test('una unidad está «Detenida», nunca «Detenido» ni «Parado»', () => {
+  assert.deepEqual(buscar(/\b(Detenido|Parado)\b/u), []);
+});
+
+test('solo lib/placas.ts pasa una placa a mayúsculas', () => {
+  const hallazgos = buscar(/(placa|plate)[\w$.?()[\]'"]*\.(trim\(\)\s*\.\s*)?to(Locale)?UpperCase\(|to(Locale)?UpperCase\([^)]*\)[^;]*\b(placa|plate)/iu, {
+    excepto: ['src/lib/placas.ts'],
+  });
+  assert.deepEqual(hallazgos, [], 'Usa normalizarPlaca de lib/placas.ts, al leer del servidor');
+});
+
+test('ninguna pantalla define su propia tabla de estado', () => {
+  const propia = /\b(const|let|var)\s+(ESTADO_VISTA|TEXTO_ESTADO|COLOR_ESTADO|TONO_ESTADO|ETIQUETA_ESTADO)\b/u;
+  const hallazgos = buscar(propia, { excepto: ['src/lib/estado-unidad.ts'] });
+  assert.deepEqual(hallazgos, [], 'Usa TONO_ESTADO / ETIQUETA_ESTADO de lib/estado-unidad.ts');
+});
+
+test('ninguna pantalla vuelve a calcular la señal ni la marcha', () => {
+  const propia = /\b(const|let|function)\s+(DETENIDA_MS|EN_MARCHA_KMH|UMBRAL_MARCHA_KMH|UMBRAL_MOVIMIENTO_M|SENAL_VIGENTE_MS|tiempoSinSenal|textoSinSenal|veredictoDeMovimiento)\b/u;
+  assert.deepEqual(buscar(propia), [], 'Usa estadoSenal (lib/sin-senal.ts) o estadoUnidad (lib/estado-unidad.ts)');
+});
+
+test('lastReportAt, lastPositionAt y motionState solo se leen al traducir la API', () => {
+  const hallazgos = buscar(/\.(lastReportAt|lastPositionAt|motionState)\b/u, { excepto: ['src/services/fomVehiculos.ts'] });
+  assert.deepEqual(hallazgos, [], 'Las pantallas leen ultimoReporte y posicionEn, y la señal la decide estadoSenal');
+});
+
+// ------------------------------------------------------------
+// LA REGLA (los mismos casos que la web)
+// ------------------------------------------------------------
+const AHORA = Date.UTC(2026, 10, 4, 15, 0, 0);
+const hace = (min) => new Date(AHORA - min * 60_000).toISOString();
+
+test('las constantes son las del servidor y la web', () => {
+  assert.equal(SIN_SENAL_MS, 5 * 60_000);
+  assert.equal(SIN_UBICACION_MS, 30 * 60_000);
+  assert.equal(VEL_MARCHA_KMH, 3);
+});
+
+test('el Camry: latidos frescos y la última posición de ayer → sin ubicación (ámbar)', () => {
+  const camry = { ultimoReporte: hace(0.5), posicionEn: hace(26 * 60), velocidadKmh: 0 };
+  const s = estadoSenal(camry, AHORA);
+  assert.equal(s.clave, 'sin_ubicacion');
+  assert.equal(s.color, 'ambar');
+  assert.equal(s.texto, 'Sin ubicación · última hace 1 d');
+  assert.equal(s.marcha, null);
+  assert.equal(s.velocidadKmh, null);
+  const e = estadoUnidad(camry, AHORA);
+  assert.equal(e.clave, 'sin_ubicacion');
+  assert.equal(e.tono, 'warning');
+  assert.equal(estadoSenal({ ultimoReporte: hace(1) }, AHORA).texto, 'Sin ubicación · nunca');
+});
+
+test('mensaje de hace 10 min → sin señal, aunque motionState diga en marcha', () => {
+  const v = { ultimoReporte: hace(10), posicionEn: hace(10), estadoMarcha: 'en_marcha', velocidadKmh: 62 };
+  const s = estadoSenal(v, AHORA);
+  assert.equal(s.clave, 'sin_senal');
+  assert.equal(s.color, 'gris');
+  assert.equal(s.texto, 'Sin señal · hace 10 min');
+  assert.equal(s.marcha, null);
+  assert.equal(s.velocidadKmh, null);
+  assert.equal(estadoUnidad(v, AHORA).clave, 'sin_senal');
+  assert.equal(estadoUnidad(v, AHORA).tono, 'textMuted');
+});
+
+test('nunca reportó → sin GPS (gris); sin equipo, «Sin GPS»', () => {
+  const s = estadoSenal({}, AHORA);
+  assert.equal(s.clave, 'sin_gps');
+  assert.equal(s.texto, 'Nunca reportó');
+  assert.equal(s.color, 'gris');
+  assert.equal(estadoSenal(null, AHORA).clave, 'sin_gps');
+  assert.equal(estadoSenal({ sinGps: true }, AHORA).texto, 'Sin GPS');
+  assert.equal(estadoUnidad({}, AHORA).clave, 'sin_gps');
+});
+
+test('a 2 km/h → Detenida (verde); desde 3 km/h o con motionState, En marcha', () => {
+  const alDia = { ultimoReporte: hace(1), posicionEn: hace(1) };
+  const lenta = estadoSenal({ ...alDia, velocidadKmh: 2 }, AHORA);
+  assert.equal(lenta.clave, 'reportando');
+  assert.equal(lenta.marcha, 'parada');
+  assert.equal(lenta.texto, 'Detenida');
+  assert.equal(lenta.color, 'verde');
+  assert.equal(estadoUnidad({ ...alDia, velocidadKmh: 2 }, AHORA).tono, 'success');
+  assert.equal(estadoSenal({ ...alDia, velocidadKmh: 3 }, AHORA).marcha, 'en_marcha');
+  assert.equal(estadoSenal({ ...alDia, estadoMarcha: 'en_marcha' }, AHORA).texto, 'En marcha');
+  assert.equal(ETIQUETA_ESTADO.parada, 'Detenida');
+  assert.equal(TONO_ESTADO.parada, TONO_ESTADO.en_marcha);
+});
+
+test('un solo «hace X»', () => {
+  const seg = (s) => new Date(AHORA - s * 1000).toISOString();
+  assert.equal(haceCuanto(seg(40), AHORA), 'hace 40 s');
+  assert.equal(haceCuanto(hace(12), AHORA), 'hace 12 min');
+  assert.equal(haceCuanto(hace(3 * 60), AHORA), 'hace 3 h');
+  assert.equal(haceCuanto(hace(2 * 24 * 60), AHORA), 'hace 2 d');
+  assert.equal(haceCuanto(new Date(2026, 8, 12, 12).toISOString(), AHORA), 'desde el 12 sep');
+  assert.equal(haceCuanto(null, AHORA), 'Nunca reportó');
+});
+
+test('sin lastReportAt ni lastPositionAt, la señal sale de latestPosition.receivedAt', () => {
+  // Lo que hoy manda el servidor móvil: solo la posición.
+  const pos = { recibidaEn: hace(1), valida: true, velocidadKmh: 45 };
+  assert.deepEqual(datosSenal({}, pos), {
+    ultimoReporte: hace(1),
+    posicionEn: hace(1),
+    velocidadKmh: 45,
+    estadoMarcha: null,
+    sinGps: undefined,
+  });
+  assert.equal(estadoUnidad(datosSenal(null, pos), AHORA).clave, 'en_marcha');
+  // Una posición no válida cuenta como mensaje, no como posición.
+  assert.equal(datosSenal(null, { ...pos, valida: false }).posicionEn, null);
+  // Cuando el servidor mande las dos fechas, mandan ellas (si son más nuevas).
+  const camry = datosSenal({ ultimoReporte: hace(0.5), posicionEn: hace(26 * 60) }, { recibidaEn: hace(26 * 60), velocidadKmh: 0 });
+  assert.equal(estadoUnidad(camry, AHORA).clave, 'sin_ubicacion');
+});
+
+// ------------------------------------------------------------
+// EL NOMBRE Y LA PLACA
+// ------------------------------------------------------------
+
+test('nombreUnidad: alias, número interno en mayúsculas, placa o «Unidad»', () => {
+  assert.equal(nombreUnidad({ alias: ' Hilux 27 ', numero: 'svl-012', placa: 'a12bc3d' }), 'Hilux 27');
+  assert.equal(nombreUnidad({ alias: '', numero: 'svl-012', placa: 'a12bc3d' }), 'SVL-012');
+  assert.equal(nombreUnidad({ numero: '—', placa: ' a12bc3d ' }), 'A12BC3D');
+  assert.equal(nombreUnidad({}), 'Unidad');
+  assert.equal(nombreUnidad(null), 'Unidad');
+});
+
+test('etiquetaUnidad: «nombre · PLACA», sin repetir la placa', () => {
+  assert.equal(etiquetaUnidad({ alias: 'Hilux 27', placa: 'a12bc3d' }), 'Hilux 27 · A12BC3D');
+  assert.equal(etiquetaUnidad({ numero: 'svl-012', placa: 'A12BC3D' }), 'SVL-012 · A12BC3D');
+  assert.equal(etiquetaUnidad({ placa: 'a12bc3d' }), 'A12BC3D');
+  assert.equal(etiquetaUnidad({ alias: 'Camry' }), 'Camry');
+});
+
+test('identidadDeServidor: alias, número de flota o code, placa normalizada', () => {
+  assert.deepEqual(identidadDeServidor({ alias: ' Camry ', code: 'u-7', plate: ' ab 123 ' }), { alias: 'Camry', placa: 'AB 123', numero: 'u-7' });
+  assert.deepEqual(identidadDeServidor({ fleetNumber: '27', code: 'u-7', plate: null }), { alias: '', placa: '', numero: '27' });
+});
+
+test('normalizarPlaca: recorta y pasa a mayúsculas', () => {
+  assert.equal(normalizarPlaca(' a12bc3d '), 'A12BC3D');
+  assert.equal(normalizarPlaca(null), '');
+  assert.equal(normalizarPlaca(undefined), '');
+});
