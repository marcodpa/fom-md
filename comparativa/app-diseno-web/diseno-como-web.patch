index 0000000..4e0f4e2
--- /dev/null
+++ b/src/components/map-vehiculo-mapbox.tsx
@@ -0,0 +1,329 @@
+import Mapbox, { Camera, LineLayer, LocationPuck, MapView, MarkerView, ShapeSource, StyleImport } from '@rnmapbox/maps';
+import * as Location from 'expo-location';
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { ActivityIndicator, Pressable, StyleSheet, View } from 'react-native';
+
+import { PulseDot } from '@/components/pulse-dot';
+import { ThemedText } from '@/components/themed-text';
+import { useMapaPrefs } from '@/hooks/use-map-prefs';
+import { PITCH_3D } from '@/lib/map-prefs';
+import { configStandard, ESTILO_MAPBOX, MAPBOX_TOKEN } from '@/lib/mapbox';
+import { useTheme } from '@/theme';
+import type { MapMarker } from '@/types';
+import { colorApagado } from '@/utils/paleta-flota';
+
+import { ControlesMapa, CuerpoMarcador, estilosMapa as styles, type MapaVehiculoProps } from './map-vehiculo-clasico';
+
+// ============================================================
+// MAPA CON MAPBOX (el mismo proveedor que el panel web de FOM)
+// ------------------------------------------------------------
+// Mismas props y mismo comportamiento que `map-vehiculo-clasico.tsx`:
+// modo flota (todos los vehículos, su estela, placa y rumbo) y modo de una
+// unidad, tu ubicación, capa estándar/satélite, 2D/3D y encuadre. Lo que
+// cambia es debajo: estilo Standard de Mapbox con luz de día o de noche según
+// el tema de la app, y con los mismos colores de noche que la web.
+// ============================================================
+
+Mapbox.setAccessToken(MAPBOX_TOKEN);
+
+type Coords = { latitude: number; longitude: number };
+type Permiso = 'pendiente' | 'ok' | 'denegado';
+type Posicion = [number, number];
+
+const enLngLat = (c: { lat: number; lng: number }): Posicion => [c.lng, c.lat];
+
+/** Las esquinas noreste y suroeste que encierran todos los marcadores. */
+function esquinas(markers: MapMarker[]): { ne: Posicion; sw: Posicion } {
+  const lats = markers.map((m) => m.coords.lat);
+  const lngs = markers.map((m) => m.coords.lng);
+  return { ne: [Math.max(...lngs), Math.max(...lats)], sw: [Math.min(...lngs), Math.min(...lats)] };
+}
+
+export function MapaVehiculoMapbox({
+  vehicleName,
+  live = false,
+  markerColor,
+  vehicleCoords,
+  markers,
+  onMarkerPress,
+  hideOverlays = false,
+  soloUsuario = false,
+  sinUsuario = false,
+  insetBottom = 0,
+  controlesArriba = false,
+  encuadreClave,
+  resaltadoId = null,
+  onMapaPress,
+  style,
+}: MapaVehiculoProps) {
+  const { colors, radii, spacing, colorScheme } = useTheme();
+  const esMulti = Array.isArray(markers);
+  const conCoordsVehiculo = !!vehicleCoords;
+  const dotColor = markerColor ?? colors.primary;
+  const camara = useRef<Camera>(null);
+  const [permiso, setPermiso] = useState<Permiso>('pendiente');
+  const [coords, setCoords] = useState<Coords | null>(null);
+  const { prefs, actualizar } = useMapaPrefs();
+  const estilo = ESTILO_MAPBOX[prefs.tipo];
+  const config = configStandard(prefs.tipo, colorScheme);
+
+  const aplicarInclinacion = useCallback(() => {
+    camara.current?.setCamera({ pitch: prefs.tresD ? PITCH_3D : 0, animationDuration: 400 });
+  }, [prefs.tresD]);
+
+  useEffect(() => {
+    aplicarInclinacion();
+  }, [aplicarInclinacion]);
+
+  const marcadoresRef = useRef<MapMarker[] | undefined>(markers);
+  useEffect(() => {
+    marcadoresRef.current = markers;
+  }, [markers]);
+  const tresDRef = useRef(prefs.tresD);
+  useEffect(() => {
+    tresDRef.current = prefs.tresD;
+  }, [prefs.tresD]);
+
+  /** Encuadra todos los marcadores con margen y, si la vista es 3D, vuelve a inclinarla. */
+  const encuadrar = useCallback(() => {
+    const ms = marcadoresRef.current;
+    if (!ms || ms.length === 0) return;
+    if (ms.length === 1) {
+      camara.current?.setCamera({ centerCoordinate: enLngLat(ms[0].coords), zoomLevel: 14, animationDuration: 600 });
+    } else {
+      const { ne, sw } = esquinas(ms);
+      camara.current?.fitBounds(ne, sw, [72, 48, 72, 48], 600);
+    }
+    if (tresDRef.current) {
+      setTimeout(() => camara.current?.setCamera({ pitch: PITCH_3D, animationDuration: 300 }), 650);
+    }
+  }, []);
+
+  /** Va al marcador destacado; sin uno, encuadra todo. */
+  const recentrar = useCallback(() => {
+    const m = marcadoresRef.current?.find((x) => x.id === resaltadoId);
+    if (!m) {
+      encuadrar();
+      return;
+    }
+    camara.current?.setCamera({ centerCoordinate: enLngLat(m.coords), animationDuration: 500 });
+  }, [resaltadoId, encuadrar]);
+
+  useEffect(() => {
+    if (encuadreClave === undefined) return;
+    encuadrar();
+  }, [encuadreClave, encuadrar]);
+
+  // §8-8: siempre se pide la ubicación de la persona. Igual que el mapa clásico.
+  useEffect(() => {
+    let active = true;
+    let sub: Location.LocationSubscription | null = null;
+    (async () => {
+      const { status } = await Location.requestForegroundPermissionsAsync();
+      if (!active) return;
+      if (status !== 'granted') {
+        setPermiso('denegado');
+        return;
+      }
+      setPermiso('ok');
+      if (esMulti || conCoordsVehiculo) return;
+      const current = await Location.getCurrentPositionAsync({ accuracy: Location.Accuracy.Balanced });
+      if (!active) return;
+      setCoords({ latitude: current.coords.latitude, longitude: current.coords.longitude });
+      const suscripcion = await Location.watchPositionAsync(
+        { accuracy: Location.Accuracy.Balanced, distanceInterval: 5 },
+        (loc) => {
+          const next = { latitude: loc.coords.latitude, longitude: loc.coords.longitude };
+          setCoords(next);
+          camara.current?.setCamera({ centerCoordinate: [next.longitude, next.latitude], animationDuration: 500 });
+        },
+      );
+      if (!active) {
+        suscripcion.remove();
+        return;
+      }
+      sub = suscripcion;
+    })();
+    return () => {
+      active = false;
+      sub?.remove();
+    };
+  }, [esMulti, conCoordsVehiculo]);
+
+  const avisoSinPermiso =
+    permiso === 'denegado' ? (
+      <View style={[styles.overlay, styles.bottomLeft, { bottom: 12 + insetBottom, right: 60 }]}>
+        <View style={[styles.pill, { backgroundColor: colors.surfaceElevated, borderColor: colors.border }]}>
+          <ThemedText variant="caption" color="textMuted" numberOfLines={2}>
+            Activa la ubicación para verte en el mapa
+          </ThemedText>
+        </View>
+      </View>
+    ) : null;
+
+  // El logo y la atribución de Mapbox son obligatorios: abajo a la izquierda, sobre lo que tape el mapa.
+  const ornamentos = {
+    logoPosition: { bottom: 8 + insetBottom, left: 8 },
+    attributionPosition: { bottom: 8 + insetBottom, left: 92 },
+  };
+
+  // ── Modo flota ─────────────────────────────────────────────────────────────
+  if (esMulti) {
+    const colorDe = (m: MapMarker): string => {
+      if (m.emergencia) return colors.danger;
+      if (m.color) return m.estado === 'sin-senal' ? colorApagado(m.color, colors.background) : m.color;
+      if (m.estado) {
+        if (m.estado === 'marcha') return colors.success;
+        return m.estado === 'detenido' ? colors.warning : colors.textMuted;
+      }
+      return m.live ? colors.success : colors.textMuted;
+    };
+    const tamDe = (m: MapMarker): number => (m.estado === 'marcha' ? 17 : m.estado === 'sin-senal' ? 14 : 16);
+    const apuntaA = (m: MapMarker): number | null =>
+      m.estado === 'marcha' && typeof m.rumbo === 'number' && Number.isFinite(m.rumbo)
+        ? ((m.rumbo % 360) + 360) % 360
+        : null;
+    const enMarcha = markers!.filter((m) => (m.estado ? m.estado === 'marcha' : m.live)).length;
+    const inicio = markers!.length > 0 ? esquinas(markers!) : null;
+
+    return (
+      <View style={[styles.container, { backgroundColor: colors.surface, borderColor: colors.border, borderRadius: radii.lg }, style]}>
+        <MapView
+          style={StyleSheet.absoluteFill}
+          styleURL={estilo}
+          projection="mercator"
+          scaleBarEnabled={false}
+          compassEnabled
+          {...ornamentos}
+          onPress={() => onMapaPress?.()}
+          onDidFinishLoadingMap={() => {
+            aplicarInclinacion();
+            encuadrar();
+          }}>
+          <StyleImport id="basemap" existing config={config} />
+          <Camera
+            ref={camara}
+            defaultSettings={
+              inicio
+                ? { bounds: { ne: inicio.ne, sw: inicio.sw, paddingTop: 72, paddingBottom: 72, paddingLeft: 48, paddingRight: 48 } }
+                : { centerCoordinate: [-71.42, 10.32], zoomLevel: 8 }
+            }
+          />
+          {permiso === 'ok' && !sinUsuario ? <LocationPuck puckBearingEnabled puckBearing="heading" pulsing={{ isEnabled: true }} /> : null}
+
+          {/* Estelas debajo de los marcadores. */}
+          {markers!
+            .filter((m) => (m.estela?.length ?? 0) > 1)
+            .map((m) => (
+              <ShapeSource
+                key={`estela-${m.id}`}
+                id={`estela-${m.id}`}
+                shape={{ type: 'Feature', properties: {}, geometry: { type: 'LineString', coordinates: m.estela!.map(enLngLat) } }}>
+                <LineLayer
+                  id={`estela-linea-${m.id}`}
+                  style={{ lineColor: colorDe(m), lineWidth: 3, lineCap: 'round', lineJoin: 'round', lineEmissiveStrength: 1 }}
+                />
+              </ShapeSource>
+            ))}
+
+          {markers!.map((m, i) => (
+            <MarkerView key={m.id} coordinate={enLngLat(m.coords)} anchor={{ x: 0.5, y: m.placa ? 0.72 : 0.5 }} allowOverlap>
+              <Pressable
+                onPress={() => onMarkerPress?.(m.id)}
+                accessibilityRole="button"
+                accessibilityLabel={[m.label, m.placa, m.detalle].filter(Boolean).join(', ')}>
+                <CuerpoMarcador m={m} i={i} color={colorDe(m)} tam={tamDe(m)} resaltado={m.id === resaltadoId} rumbo={apuntaA(m)} />
+              </Pressable>
+            </MarkerView>
+          ))}
+        </MapView>
+
+        {!hideOverlays ? (
+          <View style={[styles.overlay, styles.topLeft]}>
+            <View style={[styles.pill, { backgroundColor: colors.surfaceElevated, borderColor: colors.border }]}>
+              <ThemedText variant="caption" color="text">
+                {`${markers!.length} vehículos · ${enMarcha} en marcha`}
+              </ThemedText>
+            </View>
+          </View>
+        ) : null}
+        {avisoSinPermiso}
+        <ControlesMapa
+          prefs={prefs}
+          actualizar={actualizar}
+          insetBottom={insetBottom}
+          arriba={controlesArriba}
+          onEncuadrar={encuadrar}
+          onRecentrar={resaltadoId ? recentrar : undefined}
+        />
+      </View>
+    );
+  }
+
+  // ── Modo de una unidad ─────────────────────────────────────────────────────
+  const vehiclePoint: Coords | null = vehicleCoords ? { latitude: vehicleCoords.lat, longitude: vehicleCoords.lng } : coords;
+  const mapaListo = !!vehiclePoint;
+  const sinNada = permiso === 'denegado' && !vehicleCoords;
+
+  return (
+    <View style={[styles.container, { backgroundColor: colors.surface, borderColor: colors.border, borderRadius: radii.lg }, style]}>
+      {mapaListo ? (
+        <MapView
+          style={StyleSheet.absoluteFill}
+          styleURL={estilo}
+          projection="mercator"
+          scaleBarEnabled={false}
+          compassEnabled
+          {...ornamentos}
+          onDidFinishLoadingMap={aplicarInclinacion}>
+          <StyleImport id="basemap" existing config={config} />
+          <Camera
+            ref={camara}
+            defaultSettings={{ centerCoordinate: [vehiclePoint!.longitude, vehiclePoint!.latitude], zoomLevel: 15, pitch: prefs.tresD ? PITCH_3D : 0 }}
+          />
+          {permiso === 'ok' ? <LocationPuck puckBearingEnabled puckBearing="heading" pulsing={{ isEnabled: true }} /> : null}
+          {soloUsuario ? null : (
+            <MarkerView coordinate={[vehiclePoint!.longitude, vehiclePoint!.latitude]} anchor={{ x: 0.5, y: 0.5 }} allowOverlap>
+              <View style={styles.markerWrap} accessibilityLabel={vehicleName}>
+                <View style={[styles.markerRing, { borderColor: dotColor }]} />
+                <View style={[styles.markerDot, { backgroundColor: dotColor, borderColor: colors.background }]} />
+              </View>
+            </MarkerView>
+          )}
+        </MapView>
+      ) : (
+        <View style={styles.center}>
+          {sinNada ? (
+            <ThemedText variant="caption" color="textMuted" style={[styles.permText, { paddingHorizontal: spacing.lg }]}>
+              Activa la ubicación para ver el vehículo en el mapa
+            </ThemedText>
+          ) : (
+            <ActivityIndicator color={colors.primary} />
+          )}
+        </View>
+      )}
+
+      {!hideOverlays ? (
+        <View style={[styles.overlay, styles.topLeft]}>
+          <View style={[styles.pill, { backgroundColor: colors.surfaceElevated, borderColor: colors.border }]}>
+            <ThemedText variant="caption" color="text">
+              {vehicleName}
+            </ThemedText>
+          </View>
+        </View>
+      ) : null}
+      {!hideOverlays ? (
+        <View style={[styles.overlay, styles.topRight]}>
+          <View style={[styles.pill, styles.livePill, { backgroundColor: colors.surfaceElevated, borderColor: colors.border, gap: spacing.xs }]}>
+            <PulseDot color={live ? colors.success : colors.textMuted} active={live} />
+            <ThemedText variant="overline" color={live ? 'success' : 'textMuted'}>
+              {live ? 'EN VIVO' : 'SIN SEÑAL'}
+            </ThemedText>
+          </View>
+        </View>
+      ) : null}
+      {mapaListo ? avisoSinPermiso : null}
+      {mapaListo ? <ControlesMapa prefs={prefs} actualizar={actualizar} insetBottom={insetBottom} arriba={controlesArriba} /> : null}
+    </View>
+  );
+}
diff --git a/src/components/map-vehiculo-mapbox.web.tsx b/src/components/map-vehiculo-mapbox.web.tsx
