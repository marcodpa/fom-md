+          test "$(psql -h localhost -U fom_core_ci -d fom_core_ci -tAc "SELECT count(*) FROM fom_meta.pgmigrations WHERE name='20260825170000000_fix_work_order_insert_clock'")" = "1"
+          test "$(psql -h localhost -U fom_core_ci -d fom_core_ci -tAc "SELECT prosrc LIKE '%NEW.status_changed_at = NEW.created_at%' FROM pg_proc WHERE oid = 'fom.maintain_work_order_record()'::regprocedure")" = "t"
