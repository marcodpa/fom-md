+              <ThemedText style={[styles.placa, { color: colors.textSecondary }]} numberOfLines={1}>
+                {placaVisible}
+              </ThemedText>
+            ) : null}
+          </View>
+
+          <EstadoAhora estado={estado} velocidad={velocidad} ultimoReporte={ultimoReporte} />
