+    vehicleId: datos.workOrder.vehicleId,
+    responsable: vigente ? { userId: vigente.userId, nombre: vigente.displayName, desde: vigente.assignedAt } : null,
+    eventos: (datos.events ?? []).map((e) => ({
+      id: e.id,
+      tipo: e.eventKind as EventoTaller,
+      nota: e.note ?? null,
+      actorNombre: e.actorName ?? null,
+      en: e.occurredAt,
