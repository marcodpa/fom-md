+import { miles } from '@/utils/numero';
+
+// ─────────────────────────────── Formatos ──────────────────────────────────
+
+/** Las cuatro pestañas que se miran en pantalla. */
+export type FormatoVista = 'vehiculos' | 'usuarios' | 'costos' | 'estadistico';
+/** Lo que se puede sacar en PDF: las cuatro, o las cuatro juntas. */
+export type FormatoId = FormatoVista | 'completo';
+export type Alcance = 'general' | 'area' | 'grupo';
+
+export type Formato = {
+  id: FormatoId;
+  /** Nombre corto, el del riel. */
+  label: string;
+  /** Título completo: va en la portada del PDF y en la vista previa. */
+  titulo: string;
+  /** Qué trae. Se enseña UNA vez, bajo el riel, para el que está elegido. */
+  trae: string;
+  icon: TabIconName;
+  /** Su código en el papel (el mismo de la cabecera de cada formato). */
+  codigo: string;
+};
+
+export const FORMATOS_VISTA: (Formato & { id: FormatoVista })[] = [
+  { id: 'vehiculos', label: 'Vehículos', titulo: 'Reporte de vehículos', trae: 'Km, índice, eventos y ODT por unidad.', icon: 'flota', codigo: 'FOM-REP-03' },
+  { id: 'usuarios', label: 'Usuarios', titulo: 'Reporte de usuarios', trae: 'Km, horas, ODT e índice por persona.', icon: 'personal', codigo: 'FOM-REP-04' },
+  { id: 'costos', label: 'Costos', titulo: 'Costos y gastos', trae: 'Gasto por vehículo, producto y servicio.', icon: 'costos', codigo: 'FOM-REP-02' },
+  { id: 'estadistico', label: 'Estadístico', titulo: 'Informe estadístico de conducción', trae: 'Indicadores y distancias de la flota.', icon: 'resumen', codigo: 'FOM-REP-01' },
+];
+
+/** «Todos» ya no es una pestaña: es la opción de sacar los cuatro en un PDF. */
+export const FORMATO_COMPLETO: Formato = {
+  id: 'completo',
+  label: 'Reporte completo',
+  // Como en la web: los cuatro juntos son el informe de gestión, no «un reporte más».
+  titulo: 'Informe de gestión de flota',
+  trae: 'Los cuatro formatos en un solo PDF.',
+  icon: 'reporte',
+  codigo: '',
+};
+
+export const FORMATOS_PDF: Formato[] = [...FORMATOS_VISTA, FORMATO_COMPLETO];
+
+/** El formato elegido, siempre uno (el primero es el de partida). */
+export function formatoDe(id: FormatoId): Formato {
+  return FORMATOS_PDF.find((f) => f.id === id) ?? FORMATOS_VISTA[0];
+}
+
+/** Alcances que admite cada formato (Costos y el completo van siempre generales). */
+export function alcancesDe(formato: FormatoId): Alcance[] {
+  if (formato === 'costos' || formato === 'completo') return ['general'];
+  if (formato === 'estadistico') return ['general', 'area'];
+  return ['general', 'area', 'grupo'];
+}
+
+/**
+ * Al cambiar de formato, ¿sigue valiendo el alcance puesto?
+ *
+ * Se conserva si el nuevo formato lo admite: pasar de Vehículos a Estadístico
+ * con un área elegida no debería obligar a elegirla otra vez. Una selección a
+ * mano no viaja: unas son unidades y otras personas.
+ */
+export function conservaAlcance(antes: FormatoId, despues: FormatoId, alcance: Alcance): boolean {
+  if (!alcancesDe(despues).includes(alcance)) return false;
+  return alcance !== 'grupo' || antes === despues;
+}
+
+/** El alcance en palabras, para la portada y la vista previa. */
+export function alcanceTextoDe(opts: {
+  alcance: Alcance;
+  areaId: string | null;
+  ids: string[];
+  formato: FormatoId;
+  areas: { id: string; nombre: string }[];
+}): string {
+  const { alcance, ids } = opts;
+  if (alcance === 'general') return 'Toda la empresa';
+  if (alcance === 'area') return opts.areas.find((a) => a.id === opts.areaId)?.nombre ?? 'Un área';
+  const uno = opts.formato === 'usuarios' ? 'usuario' : 'vehículo';
+  return `${ids.length} ${ids.length === 1 ? uno : `${uno}s`}`;
+}
+
+/** ¿Está completo el alcance? Un área o una selección piden elegir algo. */
+export function alcanceListo(alcance: Alcance, areaId: string | null, ids: string[]): boolean {
+  return alcance === 'general' || (alcance === 'area' && areaId != null) || (alcance === 'grupo' && ids.length > 0);
+}
+
+// ─────────────────────────────── Períodos ──────────────────────────────────
+
+const MESES = [
+  'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
+  'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre',
+];
+const MESES_CORTOS = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
+
+/** «20 oct 2026, 09:42»: cuándo se generó. */
+export function fechaHoraCorta(d: Date = new Date()): string {
+  const hh = `${d.getHours()}`.padStart(2, '0');
+  const mm = `${d.getMinutes()}`.padStart(2, '0');
+  return `${d.getDate()} ${MESES_CORTOS[d.getMonth()]} ${d.getFullYear()}, ${hh}:${mm}`;
+}
+
+const capital = (s: string): string => s.charAt(0).toUpperCase() + s.slice(1);
+
+/**
+ * El rango en palabras: «octubre de 2026», «julio – septiembre 2026».
+ *
+ * A mano y no con `toLocaleDateString`: el motor de la app viene sin ICU
+ * completo y los meses podían salir como «M10».
+ */
+function nombreDeMeses(d: Date, h: Date): string {
+  const a = MESES[d.getMonth()];
+  const b = MESES[h.getMonth()];
+  if (d.getFullYear() !== h.getFullYear()) return `${a} ${d.getFullYear()} – ${b} ${h.getFullYear()}`;
+  if (d.getMonth() === h.getMonth()) return `${a} de ${d.getFullYear()}`;
+  return `${a} – ${b} ${h.getFullYear()}`;
+}
+
+/** El período elegido, con su etiqueta en palabras (no «2026-07 – 2026-09»). */
+export function periodoVista(preset: Preset, desde: string, hasta: string): ReportPeriod {
+  const per = periodoDe(preset, desde, hasta);
+  return { ...per, label: capital(nombreDeMeses(new Date(per.desde), new Date(per.hasta))) };
+}
+
+/** Contra qué se compara: el período, cómo se dice corto y cómo en una frase. */
+export type Comparacion = {
+  periodo: ReportPeriod;
+  /** «1–20 sep», «Abril – junio 2026». */
+  corto: string;
+  /** «del 1 al 20 de septiembre», «entre abril y junio». */
+  frase: string;
+};
+
+const DIA = 86_400_000;
+const dos = (n: number): string => `${n}`.padStart(2, '0');
+
+/** «1–20 sep» · «1 may – 20 jul 2026» · «1 nov 2025 – 20 ene 2026». */
+function rangoCorto(a: Date, b: Date, conAnio: boolean): string {
+  const ma = MESES_CORTOS[a.getMonth()];
+  const mb = MESES_CORTOS[b.getMonth()];
+  const anio = conAnio ? ` ${b.getFullYear()}` : '';
+  if (a.getFullYear() !== b.getFullYear()) return `${a.getDate()} ${ma} ${a.getFullYear()} – ${b.getDate()} ${mb} ${b.getFullYear()}`;
+  if (a.getMonth() !== b.getMonth()) return `${a.getDate()} ${ma} – ${b.getDate()} ${mb}${anio}`;
+  return a.getDate() === b.getDate() ? `${a.getDate()} ${ma}${anio}` : `${a.getDate()}–${b.getDate()} ${mb}${anio}`;
+}
+
+/** «del 1 al 20 de septiembre» · «del 1 de mayo al 20 de julio». */
+function rangoFrase(a: Date, b: Date): string {
+  const ma = MESES[a.getMonth()];
+  const mb = MESES[b.getMonth()];
+  if (a.getFullYear() !== b.getFullYear()) {
+    return `del ${a.getDate()} de ${ma} de ${a.getFullYear()} al ${b.getDate()} de ${mb} de ${b.getFullYear()}`;
+  }
+  if (a.getMonth() !== b.getMonth()) return `del ${a.getDate()} de ${ma} al ${b.getDate()} de ${mb}`;
+  return a.getDate() === b.getDate() ? `el ${a.getDate()} de ${ma}` : `del ${a.getDate()} al ${b.getDate()} de ${ma}`;
+}
+
+/**
+ * El período de antes, del mismo largo.
+ *
+ * Si el período elegido todavía corre (el mes en curso, o un rango propio que
+ * lo incluye), el de antes se recorta a lo mismo que lleva el actual: arranca
+ * los mismos meses atrás y dura los mismos días, hasta la misma hora de hoy.
+ * Comparar veinte días con un mes entero diría siempre «menos». El recorte se
+ * dice en `corto`, que es lo que sale en «Se compara con …». Con un rango ya
+ * cerrado, los mismos meses justo antes, enteros.
+ *
+ * Igual que la web: el mes en curso contra el mismo tramo del mes pasado, sin
+ * pasarse de su último día.
+ */
+export function periodoAnterior(preset: Preset, per: ReportPeriod, ahora: Date = new Date()): Comparacion {
+  const d = new Date(per.desde);
+  const h = new Date(per.hasta);
+  const meses =
+    preset === 'mes' ? 1 : (h.getFullYear() - d.getFullYear()) * 12 + (h.getMonth() - d.getMonth()) + 1;
+  const ini = new Date(d.getFullYear(), d.getMonth() - meses, 1, 0, 0, 0);
+  const corre = ahora.getTime() >= d.getTime() && ahora.getTime() < h.getTime();
+  if (corre) {
+    // Lo que lleva el actual, sin entrar en él (un segundo antes de su inicio).
+    const lleva = ahora.getTime() - d.getTime();
+    const tope = d.getTime() - 1000;
+    const recortado = ini.getTime() + lleva < tope;
+    const fin = new Date(Math.min(ini.getTime() + lleva, tope));
+    // Al minuto: así el período de antes no cambia en cada lectura de la pantalla.
+    if (recortado) fin.setSeconds(0, 0);
+    if (preset === 'mes') {
+      const tramo = rangoCorto(ini, fin, false);
+      const corto = recortado ? `${tramo}, hasta las ${dos(fin.getHours())}:${dos(fin.getMinutes())}` : tramo;
+      return { periodo: { desde: ini.toISOString(), hasta: fin.toISOString(), label: corto }, corto, frase: rangoFrase(ini, fin) };
+    }
+    if (recortado) {
+      const dias = Math.ceil(lleva / DIA);
+      const corto = `${rangoCorto(ini, fin, true)}, mismos ${dias} días`;
+      return { periodo: { desde: ini.toISOString(), hasta: fin.toISOString(), label: corto }, corto, frase: rangoFrase(ini, fin) };
+    }
+  }
+  // Día 0 del mes de inicio = último día del mes de antes.
+  const fin = new Date(d.getFullYear(), d.getMonth(), 0, 23, 59, 59);
+  const corto = capital(nombreDeMeses(ini, fin));
+  const a = MESES[ini.getMonth()];
+  const b = MESES[fin.getMonth()];
+  const frase =
+    meses === 1
+      ? `en ${a} de ${ini.getFullYear()}`
+      : ini.getFullYear() === fin.getFullYear()
+        ? `entre ${a} y ${b}`
+        : `entre ${a} de ${ini.getFullYear()} y ${b} de ${fin.getFullYear()}`;
+  return { periodo: { desde: ini.toISOString(), hasta: fin.toISOString(), label: corto }, corto, frase };
+}
+
+// ─────────────────────────────── Filtros ───────────────────────────────────
+
+export type Filtros = {
+  companyId: string;
+  alcance: Alcance;
+  areaId: string | null;
+  /** Vehículos o usuarios elegidos (alcance «los que yo elija»). */
+  ids: string[];
+  periodo: ReportPeriod;
+  anterior: Comparacion;
+};
+
+/** Una cadena que cambia cuando cambia algo que obliga a volver a pedir. */
+export function claveDe(formato: FormatoId, f: Filtros): string {
+  return [formato, f.companyId, f.periodo.desde, f.periodo.hasta, f.alcance, f.areaId ?? '', f.ids.join(',')].join('|');
+}
+
+function alcanceVehiculos(f: Filtros, periodo: ReportPeriod): ReportScope {
+  if (f.alcance === 'area') return { companyId: f.companyId, tipo: 'flota', areaId: f.areaId ?? undefined, periodo };
+  if (f.alcance === 'grupo') return { companyId: f.companyId, tipo: 'grupo', vehicleIds: f.ids, periodo };
+  return { companyId: f.companyId, tipo: 'general', periodo };
+}
+
+function alcanceUsuarios(f: Filtros, periodo: ReportPeriod): UserReportScope {
+  if (f.alcance === 'area') return { companyId: f.companyId, tipo: 'flota', areaId: f.areaId ?? undefined, periodo };
+  if (f.alcance === 'grupo') return { companyId: f.companyId, tipo: 'grupo', userIds: f.ids, periodo };
+  return { companyId: f.companyId, tipo: 'general', periodo };
+}
+
+// ─────────────────────────────── Cargas ────────────────────────────────────
+
+/**
+ * `odt` es la lista de ODT de la empresa (una lectura): de ella salen las del
+ * período y las del anterior, por fecha de creación. `periodo` es el actual,
+ * para contarlas.
+ */
+export type DatosVista =
+  | { tipo: 'vehiculos'; actual: FleetReport; anterior: FleetReport | null; odt: WorkOrderListItem[] | null; periodo: ReportPeriod }
+  | { tipo: 'usuarios'; actual: UserReport; anterior: UserReport | null }
+  | { tipo: 'costos'; actual: ReporteCostos; anterior: ReporteCostos | null; odt: WorkOrderListItem[] | null; periodo: ReportPeriod }
+  /** El anterior sale del MISMO informe estadístico, pedido para el período de antes. */
+  | { tipo: 'estadistico'; actual: FormatoPredefReporte; anterior: FormatoPredefReporte | null };
+
+/** Lo de apoyo no tumba lo principal: si falla, se sigue sin ello. */
+const opcional = <T,>(p: Promise<T>): Promise<T | null> => p.catch(() => null);
+
+/**
+ * Lo que necesita una pestaña: el período actual y el anterior, A LA VEZ.
+ *
+ * El actual es la misma lectura que va al PDF (así «Ver» y «Generar PDF» no
+ * vuelven a pedirlo). Del anterior basta lo que da las cifras: sin la última
+ * inspección de cada unidad, que es lo que más cuesta leer.
+ */
+export async function cargarVista(formato: FormatoVista, f: Filtros): Promise<DatosVista> {
+  const antes = f.anterior.periodo;
+  if (formato === 'vehiculos') {
+    const [actual, anterior, odt] = await Promise.all([
+      getReporteDeVehiculos(alcanceVehiculos(f, f.periodo)),
+      opcional(getReporte(alcanceVehiculos(f, antes), { inspecciones: false })),
+      opcional(getOrdenesDeTrabajo(f.companyId)),
+    ]);
+    return { tipo: 'vehiculos', actual, anterior, odt, periodo: f.periodo };
+  }
+  if (formato === 'usuarios') {
+    const [actual, anterior] = await Promise.all([
+      getReporteUsuarios(alcanceUsuarios(f, f.periodo)),
+      opcional(getReporteUsuarios(alcanceUsuarios(f, antes))),
+    ]);
+    return { tipo: 'usuarios', actual, anterior };
+  }
+  if (formato === 'costos') {
+    // Las ODT, para el costo de las resueltas: la misma lectura que Vehículos.
+    const [actual, anterior, odt] = await Promise.all([
+      getReporteCostos(f.companyId, f.periodo),
+      opcional(getReporteCostos(f.companyId, antes)),
+      opcional(getOrdenesDeTrabajo(f.companyId)),
+    ]);
+    return { tipo: 'costos', actual, anterior, odt, periodo: f.periodo };
+  }
+  const area = f.alcance === 'area' ? f.areaId : null;
+  // El anterior con el MISMO informe: el de flota cuenta km y unidades a su
+  // manera, y la comparación mezclaba dos cuentas distintas.
+  const [actual, anterior] = await Promise.all([
+    getReporteFormatoPredefinida(f.companyId, area, f.periodo),
+    opcional(getReporteFormatoPredefinida(f.companyId, area, antes)),
+  ]);
+  return { tipo: 'estadistico', actual, anterior };
+}
+
+/** El reporte completo: los cuatro de toda la empresa, y lo de antes para la portada. */
+type DatosCompleto = {
+  veh: FleetReport;
+  usr: UserReport;
+  cos: ReporteCostos;
+  est: FormatoPredefReporte;
+  vehAntes: FleetReport | null;
+  cosAntes: ReporteCostos | null;
+  estAntes: FormatoPredefReporte | null;
+};
+
+async function cargarCompleto(f: Filtros): Promise<DatosCompleto> {
+  const { companyId, periodo } = f;
+  const antes = f.anterior.periodo;
+  const [veh, usr, cos, est, vehAntes, cosAntes, estAntes] = await Promise.all([
+    getReporte({ companyId, tipo: 'general', periodo }),
+    getReporteUsuarios({ companyId, tipo: 'general', periodo }),
+    getReporteCostos(companyId, periodo),
+    getReporteFormatoPredefinida(companyId, null, periodo),
+    opcional(getReporte({ companyId, tipo: 'general', periodo: antes }, { inspecciones: false })),
+    opcional(getReporteCostos(companyId, antes)),
+    opcional(getReporteFormatoPredefinida(companyId, null, antes)),
+  ]);
+  return { veh, usr, cos, est, vehAntes, cosAntes, estAntes };
+}
+
+// ─────────────────────────────── Cuentas ───────────────────────────────────
+
+/** Eventos por cada 100 km. Sin kilómetros no hay índice que dar: 0. */
+export function por100(eventos: number, km: number): number {
+  return km > 0 ? (eventos / km) * 100 : 0;
+}
+
+/** Excesos + frenadas + aceleraciones. */
+export function eventosDe(m: { excesosVelocidad: number; frenadasBruscas: number; aceleracionesBruscas: number }): number {
+  return m.excesosVelocidad + m.frenadasBruscas + m.aceleracionesBruscas;
+}
+
+export const dinero = (n: number): string => `$${miles(Math.round(n))}`;
+
+export type Tono = 'success' | 'warning' | 'danger';
+
+export function tonoDeRango(r: ScoreRange | null | undefined): Tono | undefined {
+  if (r === 'verde') return 'success';
+  if (r === 'amarillo') return 'warning';
+  if (r === 'rojo') return 'danger';
+  return undefined;
+}
+
+/** «Piden atención»: índice fuera de verde o algún papel vencido. */
+export function vehiculoPideAtencion(v: VehicleReportRow): boolean {
+  return v.rango !== 'verde' || v.papeles === 'vencido';
+}
+
+/** «Piden atención»: licencia o carta médica vencida o por vencer, o manejo fuera de verde. */
+export function personaPideAtencion(f: UserReportRow): boolean {
+  const papel = (p: UserReportRow['licencia']) => p?.estado === 'vencido' || p?.estado === 'por_vencer';
+  return papel(f.licencia) || papel(f.cartaMedica) || (f.scoreRango != null && f.scoreRango !== 'verde');
+}
+
+/** «Piden atención» en el estadístico: rodó y sus alertas por 100 km no están en verde. */
+export function unidadEstadisticaPideAtencion(f: FormatoPredefFilaAlertas): boolean {
+  return f.km > 0 && f.rango !== 'verde';
+}
+
+/** El índice promedio de quienes manejaron (las personas sin índice no cuentan). */
+export function indicePersonas(filas: UserReportRow[]): number | null {
+  const con = filas.flatMap((f) => (f.score == null ? [] : [f.score]));
+  return con.length ? Math.round(con.reduce((a, b) => a + b, 0) / con.length) : null;
+}
+
+/** Lo que pasó con las ODT CREADAS en el período, según cómo están hoy. */
+export type Mantenimiento = {
+  creadas: number;
+  abiertas: number;
+  enRevision: number;
+  resueltas: number;
+  /** Lo que costaron las resueltas. */
+  costo: number;
+  /** Cuántas resueltas traen costo anotado. */
+  conCosto: number;
+};
+
+/**
+ * El mantenimiento del período, de la lista de ODT de la empresa.
+ *
+ * Se cuentan las creadas dentro del período y se reparten por su estado de
+ * hoy (Abierta / En revisión / Resuelta). `vehiculos` acota a las unidades
+ * del alcance; `null` = toda la empresa.
+ */
+export function mantenimientoDe(
+  odt: WorkOrderListItem[],
+  periodo: ReportPeriod,
+  vehiculos: Set<string> | null,
+): Mantenimiento {
+  const desde = new Date(periodo.desde).getTime();
+  const hasta = new Date(periodo.hasta).getTime();
+  const del = odt.filter((o) => {
+    const t = new Date(o.creadaEn).getTime();
+    return t >= desde && t <= hasta && (!vehiculos || vehiculos.has(o.vehicleId));
+  });
+  const resueltas = del.filter((o) => o.estado === 'cerrada');
+  return {
+    creadas: del.length,
+    abiertas: del.filter((o) => o.estado === 'abierta').length,
+    enRevision: del.filter((o) => o.estado === 'en_revision').length,
+    resueltas: resueltas.length,
+    costo: resueltas.reduce((a, o) => a + (o.costo ?? 0), 0),
+    conCosto: resueltas.filter((o) => (o.costo ?? 0) > 0).length,
+  };
+}
+
+// ─────────────────────────────── Resumen ───────────────────────────────────
+
+/** El cambio de una cifra contra el período anterior. */
+export type Delta = {
+  sentido: 'sube' | 'baja' | 'igual';
+  /** «8,3 % más», «2 más», «0,18 menos», «sin cambio». */
+  texto: string;
+  /** La cifra de antes, ya escrita. */
+  antes: string;
+  /** ¿Es buena noticia? `null` = ni buena ni mala (más kilómetros, más horas). */
+  favorable: boolean | null;
+};
+
+export type Cifra = {
+  label: string;
+  valor: string;
+  /** Lo que va pequeño al lado: «km», «/ 100», «h», «%». */
+  unidad?: string;
+  tono?: Tono;
+  /**
+   * Es de AHORA (índice, papeles vigentes): no tiene período, así que no se
+   * compara. Se dice, en vez de enseñar un «sin cambio».
+   */
+  ahora?: boolean;
+  /** `null` sin comparación posible (no hubo con qué, o falló la lectura). */
+  delta: Delta | null;
+  /**
+   * El porqué de un «—» («la app no lo mide») o el detalle que la acompaña
+   * («3 sin resolver»). Va bajo la cifra y al pie de su tarjeta en el PDF.
+   */
+  nota?: string;
+};
+
+/** Un trozo de la frase; con tono, se pinta de ese color. */
+export type TrozoFrase = { texto: string; tono?: Tono };
+
+export type Resumen = {
+  frase: TrozoFrase[];
+  cifras: Cifra[];
+  /** «1–20 sep, hasta las 09:42»: contra qué se comparó. */
+  comparadoCon: string;
+};
+
+/**
+ * Lo que viaja a la PORTADA del PDF, en el campo opcional `resumen` de
+ * `PortadaPdf`: la frase ya en texto y las mismas cuatro cifras.
+ */
+export type ResumenPortada = { frase: string; comparadoCon: string; cifras: Cifra[] };
+
+export function resumenPortada(r: Resumen): ResumenPortada {
+  return { frase: r.frase.map((t) => t.texto).join(''), comparadoCon: r.comparadoCon, cifras: r.cifras };
+}
+
+type Mejor = 'sube' | 'baja' | null;
+
+/**
+ * Compara una cifra con la de antes, con LA MISMA cuenta que el PDF
+ * (`comparar` de `informe-numeros`): «8,3 % más», «sin cambio».
+ *
+ * `pct` para lo que crece con el tamaño de la flota (km, gasto): el cambio en
+ * %. `abs` para lo que ya es una tasa o un conteo pequeño (índice, eventos por
+ * 100 km, ODT): la diferencia tal cual. `pts` para porcentajes.
+ */
+function deltaDe(
+  actual: number,
+  antes: number | null | undefined,
+  o: { modo: 'pct' | 'abs' | 'pts'; dec?: number; mejor: Mejor; fmt: (n: number) => string; moneda?: boolean },
+): Delta | null {
+  if (antes == null) return null;
+  const c = comparar(actual, antes, {
+    modo: o.modo,
+    altoEsBueno: o.mejor === null ? null : o.mejor === 'sube',
+    decimales: o.dec,
+    moneda: o.moneda,
+  });
+  if (!c) return null;
+  const sentido = c.flecha === '▲' ? 'sube' : c.flecha === '▼' ? 'baja' : 'igual';
+  return { sentido, texto: c.texto, antes: o.fmt(antes), favorable: c.favorable };
+}
+
+/** «, un 8,3 % más que del 1 al 20 de septiembre» (o nada si no hay con qué). */
+function trasComparar(actual: number, antes: number | null | undefined, comp: Comparacion): string {
+  if (antes == null || antes <= 0) return '';
+  const c = comparar(actual, antes, { modo: 'pct', altoEsBueno: null });
+  if (!c) return '';
+  if (c.flecha === '=') return `, lo mismo que ${comp.frase}`;
+  return `, un ${c.texto} que ${comp.frase}`;
+}
+
+const sinKm = 'Sin km del período no se calcula';
+
+/** Las unidades del alcance (null = toda la empresa: cuentan todas sus ODT). */
+function unidadesDe(r: FleetReport): Set<string> | null {
+  return r.scope.tipo === 'general' ? null : new Set(r.porVehiculo.map((v) => v.vehicle.id));
+}
+
+function resumenVehiculos(d: Extract<DatosVista, { tipo: 'vehiculos' }>, comp: Comparacion): Resumen {
+  const m = d.actual.metrics;
+  // Sin kilómetros antes, la tasa de antes no dice nada.
+  const a = d.anterior && d.anterior.metrics.kmRecorridos > 0 ? d.anterior.metrics : null;
+  const ev = por100(eventosDe(m), m.kmRecorridos);
+  const unidades = unidadesDe(d.actual);
+  const odt = d.odt ? mantenimientoDe(d.odt, d.periodo, unidades) : null;
+  const odtAntes = d.odt ? mantenimientoDe(d.odt, comp.periodo, unidades) : null;
+  const sinResolver = odt ? odt.abiertas + odt.enRevision : 0;
+  const frase: TrozoFrase[] = [
+    {
+      texto: `${m.vehiculos === 1 ? 'La unidad recorrió' : `Las ${miles(m.vehiculos)} unidades recorrieron`} ${miles(m.kmRecorridos)} km${trasComparar(m.kmRecorridos, d.anterior?.metrics.kmRecorridos, comp)}. `,
+    },
+  ];
+  if (m.reportesAbiertos > 0) {
+    frase.push({
+      texto: m.reportesAbiertos === 1 ? '1 ODT sigue abierta' : `${miles(m.reportesAbiertos)} ODT siguen abiertas`,
+      tono: 'warning',
+    });
+    // Dónde se juntan: la unidad con más, si tiene al menos dos.
+    const peor = [...d.actual.porVehiculo].sort((x, y) => y.otAbiertas - x.otAbiertas)[0];
+    const donde = peor && peor.otAbiertas >= 2 && m.reportesAbiertos > peor.otAbiertas ? etiquetaCortaDeUnidad(peor.vehicle) : '';
+    frase.push({ texto: donde ? `, ${peor.otAbiertas} de ellas en ${donde}.` : '.' });
+  } else {
+    frase.push({ texto: 'No hay ODT abiertas.' });
+  }
+  return {
+    comparadoCon: comp.corto,
+    frase,
+    cifras: [
+      {
+        label: 'Km recorridos',
+        valor: miles(m.kmRecorridos),
+        unidad: 'km',
+        delta: deltaDe(m.kmRecorridos, d.anterior?.metrics.kmRecorridos, { modo: 'pct', mejor: null, fmt: (n) => `${miles(n)} km` }),
+      },
+      {
+        label: 'Índice seguro prom.',
+        valor: m.kmRecorridos > 0 ? miles(m.indiceSeguroPromedio) : '—',
+        unidad: m.kmRecorridos > 0 ? '/ 100' : undefined,
+        tono: m.kmRecorridos > 0 ? tonoDeRango(m.rango) : undefined,
+        ahora: true,
+        delta: null,
+        nota: m.kmRecorridos > 0 ? undefined : 'Sin km no se califica',
+      },
+      {
+        label: 'Eventos por 100 km',
+        valor: m.kmRecorridos > 0 ? miles(ev, 2) : '—',
+        delta:
+          m.kmRecorridos > 0 && a
+            ? deltaDe(ev, por100(eventosDe(a), a.kmRecorridos), { modo: 'abs', dec: 2, mejor: 'baja', fmt: (n) => miles(n, 2) })
+            : null,
+        nota: m.kmRecorridos > 0 ? undefined : sinKm,
+      },
+      odt
+        ? {
+            label: 'ODT del período',
+            valor: miles(odt.creadas),
+            tono: sinResolver > 0 ? 'warning' : undefined,
+            delta: deltaDe(odt.creadas, odtAntes?.creadas, { modo: 'abs', mejor: 'baja', fmt: (n) => miles(n) }),
+            nota: `${miles(sinResolver)} sin resolver`,
+          }
+        : { label: 'ODT del período', valor: '—', delta: null, nota: 'No se pudieron leer las ODT' },
+    ],
+  };
+}
+
+function resumenUsuarios(d: Extract<DatosVista, { tipo: 'usuarios' }>, comp: Comparacion): Resumen {
+  const m = d.actual.metrics;
+  const a = d.anterior?.metrics ?? null;
+  const alVolante = d.actual.usuarios.filter((u) => u.metrics.horasConducidas > 0 || u.metrics.kmRecorridos > 0).length;
+  const indice = indicePersonas(d.actual.filas);
+
+  const frase: TrozoFrase[] = [
+    {
+      texto: `${miles(alVolante)} ${alVolante === 1 ? 'conductor recorrió' : 'conductores recorrieron'} ${miles(m.kmRecorridos)} km${trasComparar(m.kmRecorridos, a?.kmRecorridos, comp)}. `,
+    },
+  ];
+  const vencidas = d.actual.filas.filter((f) => f.licencia?.estado === 'vencido').length;
+  const porVencer = d.actual.filas.filter((f) => f.licencia?.estado === 'por_vencer').length;
+  const conLicencia = d.actual.filas.filter((f) => f.licencia).length;
+  if (vencidas > 0) {
+    frase.push({ texto: vencidas === 1 ? 'Una licencia ya venció' : `${miles(vencidas)} licencias ya vencieron`, tono: 'danger' });
+    frase.push({ texto: porVencer > 0 ? ` y ${miles(porVencer)} ${porVencer === 1 ? 'vence' : 'vencen'} pronto.` : '.' });
+  } else if (porVencer > 0) {
+    frase.push({
+      texto: porVencer === 1 ? 'Una licencia vence pronto' : `${miles(porVencer)} licencias vencen pronto`,
+      tono: 'warning',
+    });
+    frase.push({ texto: '.' });
+  } else if (conLicencia > 0) {
+    frase.push({ texto: 'Las licencias registradas están al día.' });
+  } else {
+    frase.push({ texto: 'No hay licencias registradas.' });
+  }
+
+  // Papeles vencidos de las personas (licencia o carta médica), para la nota.
+  const papelesVencidos = d.actual.filas.reduce(
+    (n, f) => n + (f.licencia?.estado === 'vencido' ? 1 : 0) + (f.cartaMedica?.estado === 'vencido' ? 1 : 0),
+    0,
+  );
+
+  return {
+    comparadoCon: comp.corto,
+    frase,
+    cifras: [
+      {
+        label: 'Km con conductor',
+        valor: miles(m.kmRecorridos),
+        unidad: 'km',
+        delta: deltaDe(m.kmRecorridos, a?.kmRecorridos, { modo: 'pct', mejor: null, fmt: (n) => `${miles(n)} km` }),
+      },
+      {
+        label: 'Índice seguro prom.',
+        valor: indice == null ? '—' : miles(indice),
+        unidad: indice == null ? undefined : '/ 100',
+        tono: indice == null ? undefined : tonoDeRango(rangoDeIndice(indice)),
+        ahora: true,
+        delta: null,
+        nota: indice == null ? 'Nadie condujo en el período' : undefined,
+      },
+      {
+        // La app no trae los eventos de cada persona: se dice, no se inventa.
+        label: 'Eventos por 100 km',
+        valor: '—',
+        delta: null,
+        nota: 'La app aún no los trae por persona',
+      },
+      {
+        label: 'Documentos al día',
+        valor: m.papelesAlDia == null ? '—' : miles(m.papelesAlDia),
+        unidad: m.papelesAlDia == null ? undefined : '%',
+        // Por debajo del 100 % hay alguien con un papel vencido o por vencer.
+        tono: m.papelesAlDia == null ? undefined : papelesVencidos > 0 ? 'danger' : m.papelesAlDia >= 100 ? 'success' : 'warning',
+        ahora: true,
+        delta: null,
+        nota:
+          m.papelesAlDia == null
+            ? 'Sin papeles registrados'
+            : papelesVencidos > 0
+              ? `${miles(papelesVencidos)} ${papelesVencidos === 1 ? 'vencido' : 'vencidos'}`
+              : undefined,
+      },
+    ],
+  };
+}
+
+/** Unidades con algún gasto en el período. */
+export function conGasto(c: ReporteCostos): number {
+  return c.porVehiculo.filter((v) => v.total.costo > 0).length;
+}
+
+function resumenCostos(d: Extract<DatosVista, { tipo: 'costos' }>, comp: Comparacion): Resumen {
+  const c = d.actual;
+  const a = d.anterior;
+  // Costos va siempre de toda la empresa: cuentan todas sus ODT.
+  const odt = d.odt ? mantenimientoDe(d.odt, d.periodo, null) : null;
+  const odtAntes = d.odt ? mantenimientoDe(d.odt, comp.periodo, null) : null;
+
+  const frase: TrozoFrase[] = [];
+  if (c.total.costo <= 0) {
+    frase.push({ texto: 'No hay gastos registrados en el período.' });
+  } else {
+    frase.push({
+      texto: `Se gastaron ${dinero(c.total.costo)} en ${miles(c.total.cantidad)} ${c.total.cantidad === 1 ? 'gasto' : 'gastos'}${trasComparar(c.total.costo, a?.total.costo, comp)}. `,
+    });
+    const mayor = [...c.porCategoria].sort((x, y) => y.total - x.total)[0];
+    if (mayor) frase.push({ texto: `${mayor.label} es el ${miles(Math.round(mayor.porcentaje))} % del gasto.` });
+  }
+
+  return {
+    comparadoCon: comp.corto,
+    frase,
+    cifras: [
+      {
+        label: 'Gasto del período',
+        valor: dinero(c.total.costo),
+        delta: deltaDe(c.total.costo, a?.total.costo, { modo: 'pct', mejor: 'baja', fmt: dinero, moneda: true }),
+      },
+      {
+        label: 'Gastos registrados',
+        valor: miles(c.total.cantidad),
+        delta: deltaDe(c.total.cantidad, a?.total.cantidad, { modo: 'abs', mejor: null, fmt: (n) => miles(n) }),
+      },
+      {
+        // El reporte de costos no trae los km del período; pedirlos aparte
+        // costaría una lectura por unidad solo para esta cifra.
+        label: 'Costo por km',
+        valor: '—',
+        delta: null,
+        nota: 'Este reporte no trae los km',
+      },
+      odt
+        ? {
+            label: 'Costo en ODT resueltas',
+            valor: dinero(odt.costo),
+            delta: deltaDe(odt.costo, odtAntes?.costo, { modo: 'pct', mejor: 'baja', fmt: dinero, moneda: true }),
+            nota: `${miles(odt.conCosto)} de ${miles(odt.resueltas)} resueltas con costo`,
+          }
+        : { label: 'Costo en ODT resueltas', valor: '—', delta: null, nota: 'No se pudieron leer las ODT' },
+    ],
+  };
+}
+
+/** El porcentaje de un indicador escrito («91.8%» → 91,8). */
+function numeroDe(valor: string): number | null {
+  const n = Number.parseFloat(valor.replace(',', '.'));
+  return Number.isFinite(n) ? n : null;
+}
+
+/** El indicador de registro de conductores (por su nombre; si no, el segundo). */
+function indicadorRegistro(r: FormatoPredefReporte) {
+  return r.indicadores.find((i) => /registro|conductor/i.test(i.nombre)) ?? r.indicadores[1];
+}
+
+/** Lo que el estadístico suma de sus unidades: km, eventos y cuántas rodaron. */
+function totalesEstadistico(r: FormatoPredefReporte) {
+  const filas = r.alertasPorVehiculo;
+  const km = filas.reduce((s, f) => s + f.km, 0);
+  const eventos = filas.reduce((s, f) => s + f.aceleraciones + f.frenadas + f.excesos, 0);
+  return { km, eventos, score: por100(eventos, km), conKm: filas.filter((f) => f.km > 0).length, unidades: filas.length };
+}
+
+function resumenEstadistico(d: Extract<DatosVista, { tipo: 'estadistico' }>, comp: Comparacion): Resumen {
+  const r = d.actual;
+  const t = totalesEstadistico(r);
+  const ta = d.anterior ? totalesEstadistico(d.anterior) : null;
+  const scoreAntes = ta && ta.km > 0 ? ta.score : null;
+  const indScore = r.indicadores.find((i) => /score/i.test(i.nombre)) ?? r.indicadores[0];
+  const indRegistro = indicadorRegistro(r);
+  const registro = indRegistro?.medido ? numeroDe(indRegistro.valor) : null;
+  const regAntesInd = d.anterior ? indicadorRegistro(d.anterior) : undefined;
+  const registroAntes = regAntesInd?.medido ? numeroDe(regAntesInd.valor) : null;
+
+  const frase: TrozoFrase[] = [];
+  if (t.km <= 0) {
+    frase.push({ texto: 'No hubo kilómetros medidos en el período: no hay conducción que calificar.' });
+  } else {
+    frase.push({ texto: 'La flota tuvo ' });
+    frase.push({
+      texto: `${miles(t.score, 2)} eventos por cada 100 km`,
+      tono: indScore && indScore.rango !== 'verde' ? tonoDeRango(indScore.rango) : undefined,
+    });
+    frase.push({
+      texto:
+        scoreAntes == null
+          ? '. '
+          : Math.abs(t.score - scoreAntes) < 0.005
+            ? `, igual que ${comp.frase}. `
+            : `, ${t.score < scoreAntes ? 'menos' : 'más'} que ${comp.frase} (${miles(scoreAntes, 2)}). `,
+    });
+    frase.push({ texto: `${miles(t.conKm)} de ${miles(t.unidades)} unidades con kilómetros medidos.` });
+  }
+
+  return {
+    comparadoCon: comp.corto,
+    frase,
+    cifras: [
+      {
+        label: 'Eventos de alerta',
+        valor: miles(t.eventos),
+        delta: deltaDe(t.eventos, ta?.eventos, { modo: 'abs', mejor: 'baja', fmt: (n) => miles(n) }),
+      },
+      {
+        label: 'Eventos por 100 km',
+        valor: t.km > 0 ? miles(t.score, 2) : '—',
+        tono: t.km > 0 ? tonoDeRango(indScore?.rango) : undefined,
+        delta: t.km > 0 ? deltaDe(t.score, scoreAntes, { modo: 'abs', dec: 2, mejor: 'baja', fmt: (n) => miles(n, 2) }) : null,
+        nota: t.km > 0 ? undefined : sinKm,
+      },
+      {
+        label: 'Unidades con km',
+        valor: miles(t.conKm),
+        unidad: `de ${miles(t.unidades)}`,
+        delta: deltaDe(t.conKm, ta?.conKm, { modo: 'abs', mejor: 'sube', fmt: (n) => miles(n) }),
+      },
+      {
+        label: 'Identificación de conductores',
+        valor: registro == null ? '—' : miles(registro, 1),
+        unidad: registro == null ? undefined : '%',
+        tono: registro == null ? undefined : tonoDeRango(indRegistro?.rango),
+        delta:
+          registro == null
+            ? null
+            : deltaDe(registro, registroAntes, { modo: 'pts', dec: 1, mejor: 'sube', fmt: (n) => `${miles(n, 1)} %` }),
+        nota: registro == null ? sinKm : undefined,
+      },
+    ],
+  };
+}
+
+export function resumenDe(d: DatosVista, comp: Comparacion): Resumen {
+  if (d.tipo === 'vehiculos') return resumenVehiculos(d, comp);
+  if (d.tipo === 'usuarios') return resumenUsuarios(d, comp);
+  if (d.tipo === 'costos') return resumenCostos(d, comp);
+  return resumenEstadistico(d, comp);
+}
+
+function resumenCompleto(d: DatosCompleto, comp: Comparacion): Resumen {
+  const m = d.veh.metrics;
+  const a = d.vehAntes && d.vehAntes.metrics.kmRecorridos > 0 ? d.vehAntes.metrics : null;
+  const ev = por100(eventosDe(m), m.kmRecorridos);
+  const evAntes = a ? por100(eventosDe(a), a.kmRecorridos) : null;
+  const frase: TrozoFrase[] = [
+    { texto: `La flota recorrió ${miles(m.kmRecorridos)} km y gastó ${dinero(d.cos.total.costo)}.` },
+  ];
+  if (m.kmRecorridos > 0 && evAntes != null && Math.abs(ev - evAntes) >= 0.005) {
+    frase.push({ texto: ` Hubo ${ev < evAntes ? 'menos' : 'más'} eventos por cada 100 km que ${comp.frase}.` });
+  }
+  return {
+    comparadoCon: comp.corto,
+    frase,
+    cifras: [
+      {
+        label: 'Km recorridos',
+        valor: miles(m.kmRecorridos),
+        unidad: 'km',
+        delta: deltaDe(m.kmRecorridos, d.vehAntes?.metrics.kmRecorridos, { modo: 'pct', mejor: null, fmt: (n) => `${miles(n)} km` }),
+      },
+      {
+        label: 'Índice seguro prom.',
+        valor: m.kmRecorridos > 0 ? miles(m.indiceSeguroPromedio) : '—',
+        unidad: m.kmRecorridos > 0 ? '/ 100' : undefined,
+        tono: m.kmRecorridos > 0 ? tonoDeRango(m.rango) : undefined,
+        ahora: true,
+        delta: null,
+        nota: m.kmRecorridos > 0 ? undefined : 'Sin km no se califica',
+      },
+      {
+        label: 'Gasto del período',
+        valor: dinero(d.cos.total.costo),
+        delta: deltaDe(d.cos.total.costo, d.cosAntes?.total.costo, { modo: 'pct', mejor: 'baja', fmt: dinero, moneda: true }),
+      },
+      {
+        label: 'Eventos por 100 km',
+        valor: m.kmRecorridos > 0 ? miles(ev, 2) : '—',
+        delta: m.kmRecorridos > 0 ? deltaDe(ev, evAntes, { modo: 'abs', dec: 2, mejor: 'baja', fmt: (n) => miles(n, 2) }) : null,
+        nota: m.kmRecorridos > 0 ? undefined : sinKm,
+      },
+    ],
+  };
+}
+
+// ─────────────────────────────── Documento ─────────────────────────────────
+
+/** El documento ya armado: lo que ve la vista previa y lo que sale en el PDF. */
+export type Documento = {
+  /**
+   * Dos campos opcionales y nuevos para la portada: `resumen` (la frase y las
+   * cuatro cifras de la pantalla) y `periodoAnterior` (contra qué se comparó).
+   */
+  portada: PortadaPdf & { resumen?: ResumenPortada; periodoAnterior?: string };
+  formatos: FormatoPdf[];
+};
+
+export function formatosDe(d: DatosVista): FormatoPdf[] {
+  if (d.tipo === 'vehiculos') return formatoVehiculos(d.actual, d.anterior ?? undefined);
+  if (d.tipo === 'usuarios') return [formatoUsuarios(d.actual, d.anterior ?? undefined)];
+  if (d.tipo === 'costos') return [formatoCostos(d.actual, d.anterior ?? undefined)];
+  return [formatoEstadistico(d.actual, d.anterior ?? undefined)];
+}
+
+/**
+ * El documento entero: portada y formatos.
+ *
+ * Lo arman IGUAL la vista previa y el PDF. Con dos caminos distintos, lo que
+ * se ve en pantalla y lo que sale en el archivo acabarían separándose sin que
+ * nadie lo notara hasta abrir el PDF. Si la pantalla ya tiene los datos de esa
+ * misma elección (`yaCargado`), no se vuelven a pedir.
+ */
+export async function armarDocumento(opts: {
+  formato: FormatoId;
+  filtros: Filtros;
+  alcanceTexto: string;
+  marca: { name: string; primaryColor?: string; logoKey?: string };
+  yaCargado?: DatosVista | null;
+}): Promise<Documento> {
+  const { formato, filtros, marca } = opts;
+  const portada = {
+    titulo: `${formatoDe(formato).titulo} — ${marca.name}`,
+    subtitulo: opts.alcanceTexto,
+    empresa: marca.name,
+    periodo: filtros.periodo.label,
+    periodoAnterior: filtros.anterior.corto,
+    colorMarca: marca.primaryColor,
+    logoKey: marca.logoKey,
+  };
+  if (formato === 'completo') {
+    const d = await cargarCompleto(filtros);
+    return {
+      portada: { ...portada, resumen: resumenPortada(resumenCompleto(d, filtros.anterior)) },
+      formatos: [
+        ...formatoVehiculos(d.veh, d.vehAntes ?? undefined),
+        formatoUsuarios(d.usr),
+        formatoCostos(d.cos, d.cosAntes ?? undefined),
+        formatoEstadistico(d.est, d.estAntes ?? undefined),
+      ],
+    };
+  }
+  const d = opts.yaCargado ?? (await cargarVista(formato, filtros));
+  return {
+    portada: { ...portada, resumen: resumenPortada(resumenDe(d, filtros.anterior)) },
+    formatos: formatosDe(d),
+  };
+}
+
+/** Compartir: la hoja del sistema (WhatsApp, correo, Drive…). */
+export async function compartirPdf(html: string): Promise<void> {
+  await exportarPdf(html);
+}
+
+/**
+ * Descargar: el MISMO archivo A4 que se comparte, abierto en el diálogo de
+ * impresión del sistema, que trae «Guardar como PDF». En la web, el navegador
+ * guarda o imprime.
+ */
+export async function descargarPdf(html: string): Promise<void> {
+  await guardarPdf(html, { modo: 'guardar' });
+}
