+import * as ImagePicker from 'expo-image-picker';
+import { useState } from 'react';
+import { Alert, StyleSheet, View } from 'react-native';
+
+import { Button } from '@/components/button';
+import { LogoDeEmpresa } from '@/components/logo-de-empresa';
+import { TabIcon } from '@/components/tab-icon';
+import { ThemedText } from '@/components/themed-text';
+import { textoDeError } from '@/lib/responsable-empresa';
+import { subirLogoDeEmpresa } from '@/services/fomLogos';
+import { useTheme } from '@/theme';
+
+/**
+ * El LOGO de una empresa y el botón para cambiarlo. Es lo de «Subir logo» de la
+ * web: el mismo destino (almacén de FOM y, si está apagado, Cloudinary), así que
+ * el logo que se sube aquí se ve en la web y al revés.
+ */
+export function SubirLogoEmpresa({ empresaId, nombre }: { empresaId: string; nombre: string }) {
+  const { colors, radii, spacing } = useTheme();
+  const [subiendo, setSubiendo] = useState(false);
+  const [aviso, setAviso] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  async function elegir() {
+    if (subiendo) return;
+    setAviso(null);
+    setError(null);
+    const permiso = await ImagePicker.requestMediaLibraryPermissionsAsync();
+    if (!permiso.granted) {
+      Alert.alert('Permiso necesario', 'Habilita la galería para elegir el logo.');
+      return;
+    }
+    const res = await ImagePicker.launchImageLibraryAsync({
+      mediaTypes: ['images'],
+      quality: 1,
+      // En iOS, un formato que se pueda leer en todas partes (no HEIC).
+      preferredAssetRepresentationMode: ImagePicker.UIImagePickerPreferredAssetRepresentationMode.Compatible,
+    });
+    if (res.canceled || !res.assets[0]) return;
+    setSubiendo(true);
+    try {
+      await subirLogoDeEmpresa(empresaId, { uri: res.assets[0].uri });
+      setAviso(`Logo de ${nombre} guardado.`);
+    } catch (e) {
+      setError(textoDeError(e, 'No se pudo guardar el logo. Inténtalo de nuevo.'));
+    }
+    // Después del try/catch y no en un `finally`: el compilador de React se salta los componentes con `finally`.
+    setSubiendo(false);
+  }
+
+  return (
+    <View style={{ gap: spacing.md }}>
+      <View style={[styles.fila, { gap: spacing.md }]}>
+        <View
+          style={[
+            styles.caja,
+            { backgroundColor: colors.surfaceElevated, borderColor: colors.border, borderRadius: radii.md },
+          ]}>
+          <LogoDeEmpresa empresaId={empresaId} nombre={nombre} size={56}>
+            <TabIcon name="empresa" color={colors.textMuted} size={26} />
+          </LogoDeEmpresa>
+        </View>
+        <ThemedText variant="caption" color="textMuted" style={styles.texto}>
+          PNG, JPG o WebP. Se ve en el encabezado de la empresa, también en la web.
+        </ThemedText>
+      </View>
+      <Button
+        label={subiendo ? 'Subiendo…' : 'Subir logo'}
+        variant="secondary"
+        onPress={elegir}
+        loading={subiendo}
+      />
+      {aviso ? (
+        <ThemedText variant="caption" color="success" accessibilityRole="alert">
+          {aviso}
+        </ThemedText>
+      ) : null}
+      {error ? (
+        <ThemedText variant="caption" color="danger" accessibilityRole="alert">
+          {error}
+        </ThemedText>
+      ) : null}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  fila: { flexDirection: 'row', alignItems: 'center' },
+  caja: { width: 72, height: 72, alignItems: 'center', justifyContent: 'center', borderWidth: 1 },
+  texto: { flex: 1 },
+});
