+/**
+ * Lo PENDIENTE de la unidad para la casilla «Mantenimiento» de Mi unidad. La
+ * misma regla que la web (`pendientesDeMiUnidad` en `datos/mantenimientoPendiente.js`):
+ *  - sus órdenes sin resolver: abiertas o en revisión (en el taller);
+ *  - el mantenimiento programado VENCIDO que está registrado en FOM (pendiente o
+ *    en curso, sin orden propia: esa ya cuenta arriba).
+ * No cuentan lo próximo (aún no vence), lo hecho, ni las alertas de un control
+ * que la app calcula y FOM aún no registró: la web no las ve y los dos números
+ * tienen que ser el mismo. Siguen saliendo en la pestaña de Mantenimiento.
+ */
+export function pendientesDeMiUnidad(acciones: AccionMantenimiento[]): number {
+  return acciones.filter((a) => {
+    if (a.estado === 'realizada') return false;
+    if (a.odtId) return true;
+    return a.vencida && !aunSinGuardar(a);
+  }).length;
+}
