@@ -0,0 +1,584 @@
+import { useState, type ReactNode } from 'react';
+import { StyleSheet, View } from 'react-native';
+
+import { Chip } from '@/components/chip';
+import {
+  conGasto,
+  dinero,
+  eventosDe,
+  indicePersonas,
+  mantenimientoDe,
+  personaPideAtencion,
+  tonoDeRango,
