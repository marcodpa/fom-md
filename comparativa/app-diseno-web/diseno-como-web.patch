+import { Image } from 'expo-image';
+import { StyleSheet, View } from 'react-native';
+
+import { arteDeVehiculo } from '@/components/arte-vehiculos';
+import { Chip } from '@/components/chip';
+import { TabIcon } from '@/components/tab-icon';
+import { ThemedText } from '@/components/themed-text';
+import { useTheme, type ColorTokens } from '@/theme';
+import type { Vehicle } from '@/types';
+
+/**
+ * Cabeza de la ficha, como la de la web: la foto, «Unidad NN», marca · modelo
+ * · año · placa, y debajo cómo está ahora y qué tipo es.
+ *
+ * Las unidades no tienen foto propia en la app: va el render del modelo si lo
+ * hay, y si no el recuadro «Sin foto» de la web. Nunca un hueco vacío.
+ */
+export function FichaUnidadEncabezado({
+  vehiculo,
+  titulo,
+  bajada,
+  estado,
+  tipo,
+}: {
+  vehiculo: Pick<Vehicle, 'marca' | 'modelo' | 'anio'>;
+  titulo: string;
+  bajada: string;
+  /** Cómo está ahora. `null` si no hay posición: no se adivina. */
+  estado: { label: string; tono: keyof ColorTokens } | null;
+  /** El tipo en palabras («Camioneta»). `null` si no consta. */
+  tipo: string | null;
+}) {
+  const { colors, spacing } = useTheme();
+  const arte = arteDeVehiculo(vehiculo);
+
+  return (
+    <View style={[styles.fila, { gap: spacing.md + 2 }]}>
+      <View style={[styles.foto, { backgroundColor: colors.surfaceSunken, borderColor: colors.border }]}>
+        {arte ? (
+          <Image
+            source={arte}
+            style={styles.arte}
+            contentFit="contain"
+            // Sin marca o modelo no se lee «undefined»: se dice lo que hay.
+            accessibilityLabel={
+              [vehiculo.marca, vehiculo.modelo].filter(Boolean).join(' ') || 'Imagen de la unidad'
+            }
+          />
+        ) : (
+          <>
+            <TabIcon name="flota" color={colors.textMuted} size={24} />
+            <ThemedText style={styles.sinFoto} color="textMuted">
+              Sin foto
+            </ThemedText>
+          </>
+        )}
+      </View>
+      <View style={[styles.textos, { gap: spacing.xs }]}>
+        <ThemedText style={styles.titulo} accessibilityRole="header" numberOfLines={1}>
+          {titulo}
+        </ThemedText>
+        {bajada ? (
+          <ThemedText style={styles.bajada} color="textSecondary" numberOfLines={2}>
+            {bajada}
+          </ThemedText>
+        ) : null}
+        {estado || tipo ? (
+          <View style={[styles.etiquetas, { gap: 6 }]}>
+            {estado ? <Chip tone={estado.tono} label={estado.label} dot /> : null}
+            {tipo ? <Chip tone="info" label={tipo} /> : null}
+          </View>
+        ) : null}
+      </View>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  fila: { flexDirection: 'row', alignItems: 'center' },
+  foto: {
+    width: 72,
+    height: 72,
+    borderRadius: 20,
+    borderWidth: 1,
+    alignItems: 'center',
+    justifyContent: 'center',
+    gap: 2,
+    overflow: 'hidden',
+    flexShrink: 0,
+  },
+  arte: { width: 66, height: 52 },
+  sinFoto: { fontSize: 10, lineHeight: 14, fontWeight: '600' },
+  textos: { flex: 1, minWidth: 0 },
+  titulo: { fontSize: 22, lineHeight: 26, fontWeight: '700', letterSpacing: -0.8 },
+  bajada: { fontSize: 13, lineHeight: 18 },
