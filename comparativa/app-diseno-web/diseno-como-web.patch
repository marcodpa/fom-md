+        actor: null,
+        responsable: responsable.nombre,
+        en: responsable.desde,
+        a: 'asignada',
+        notas: [],
+      });
+    }
+  }
+  return hitos.sort((x, y) => (instante(x.en) || 0) - (instante(y.en) || 0));
