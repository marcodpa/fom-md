index 0000000..9c8b367
--- /dev/null
+++ b/src/components/map-vehiculo-mapbox.web.tsx
@@ -0,0 +1,243 @@
+import 'mapbox-gl/dist/mapbox-gl.css';
+import { useEffect, useRef, useState } from 'react';
+import { Pressable, StyleSheet, View, type StyleProp, type ViewStyle } from 'react-native';
+
+import { ThemedText } from '@/components/themed-text';
+import { useMapaPrefs } from '@/hooks/use-map-prefs';
+import { opcionesMapa, PITCH_3D } from '@/lib/map-prefs';
+import { configStandard, ESTILO_MAPBOX, MAPBOX_TOKEN } from '@/lib/mapbox';
+import { useTheme } from '@/theme';
+import type { LatLng, MapMarker } from '@/types';
+import { colorApagado } from '@/utils/paleta-flota';
+
+// ============================================================
+// MAPA DE MAPBOX EN LA VERSIÓN WEB DE LA APP
+// ------------------------------------------------------------
+// La app se prueba también en el navegador; ahí no existe el SDK nativo de
+// Mapbox, así que se usa Mapbox GL JS, la misma librería del panel web. Mismo
+// estilo Standard, misma luz y mismos colores de noche que el teléfono.
+// ============================================================
+
+type Props = {
+  vehicleName?: string;
+  live?: boolean;
+  markerColor?: string;
+  vehicleCoords?: LatLng | null;
+  markers?: MapMarker[];
+  onMarkerPress?: (id: string) => void;
+  hideOverlays?: boolean;
+  soloUsuario?: boolean;
+  resaltadoId?: string | null;
+  onMapaPress?: () => void;
+  encuadreClave?: string;
+  style?: StyleProp<ViewStyle>;
+};
+
+type MapaGl = import('mapbox-gl').Map;
+type GlModulo = typeof import('mapbox-gl');
+
+const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);
+
+export function MapaVehiculoMapboxWeb({ vehicleName, live = false, markerColor, vehicleCoords, markers, onMarkerPress, hideOverlays = false, soloUsuario = false, resaltadoId = null, onMapaPress, encuadreClave, style }: Props) {
+  const { colors, radii, colorScheme } = useTheme();
+  const { prefs, actualizar } = useMapaPrefs();
+  const caja = useRef<View>(null);
+  const mapa = useRef<MapaGl | null>(null);
+  const gl = useRef<GlModulo | null>(null);
+  const marcas = useRef(new Map<string, import('mapbox-gl').Marker>());
+  const [listo, setListo] = useState(0);
+  const esMulti = Array.isArray(markers);
+  const puntos: MapMarker[] = esMulti
+    ? markers!
+    : vehicleCoords && !soloUsuario
+      ? [{ id: 'unidad', label: vehicleName ?? 'Unidad', coords: vehicleCoords, live, color: markerColor }]
+      : [];
+
+  const colorDe = (m: MapMarker): string => {
+    if (m.emergencia) return colors.danger;
+    if (m.color) return m.estado === 'sin-senal' ? colorApagado(m.color, colors.background) : m.color;
+    if (m.estado) return m.estado === 'marcha' ? colors.success : m.estado === 'detenido' ? colors.warning : colors.textMuted;
+    return m.live ? colors.success : colors.textMuted;
+  };
+
+  // Crear el mapa una vez.
+  useEffect(() => {
+    let vivo = true;
+    let observador: ResizeObserver | null = null;
+    (async () => {
+      const modulo = await import('mapbox-gl');
+      const mapboxgl = (modulo as unknown as { default?: GlModulo }).default ?? (modulo as unknown as GlModulo);
+      if (!vivo || !caja.current) return;
+      gl.current = mapboxgl;
+      // Mapbox pone `position: relative` a su contenedor, y eso anula el relleno
+      // absoluto de la vista de React Native (quedaba con 0 de alto). Se le da
+      // su propia capa, con el tamaño en línea, que gana a la hoja de estilos.
+      const lienzo = document.createElement('div');
+      lienzo.style.cssText = 'position:absolute;top:0;left:0;right:0;bottom:0;width:100%;height:100%;';
+      (caja.current as unknown as HTMLElement).appendChild(lienzo);
+      const primero = puntos[0]?.coords;
+      const m = new mapboxgl.Map({
+        container: lienzo,
+        accessToken: MAPBOX_TOKEN,
+        style: ESTILO_MAPBOX[prefs.tipo],
+        config: { basemap: configStandard(prefs.tipo, colorScheme) },
+        center: primero ? [primero.lng, primero.lat] : [-71.42, 10.32],
+        zoom: primero ? (esMulti ? 10 : 15) : 8,
+        pitch: prefs.tresD ? PITCH_3D : 0,
+        projection: 'mercator',
+        attributionControl: false,
+        language: 'es',
+      });
+      m.addControl(new mapboxgl.AttributionControl({ compact: true }), 'bottom-right');
+      m.addControl(new mapboxgl.GeolocateControl({ showUserLocation: true, trackUserLocation: false }), 'bottom-right');
+      m.on('click', () => onMapaPress?.());
+      m.on('style.load', () => setListo((n) => n + 1));
+      // La caja cambia de tamaño al abrir o cerrar la lengüeta: el mapa se reajusta.
+      observador = new ResizeObserver(() => m.resize());
+      observador.observe(lienzo);
+      mapa.current = m;
+    })();
+    return () => {
+      vivo = false;
+      observador?.disconnect();
+      marcas.current.forEach((x) => x.remove());
+      marcas.current.clear();
+      mapa.current?.remove();
+      mapa.current = null;
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  // Capa (estándar/satélite) y tema: el estilo cambia entero; la inclinación se anima.
+  useEffect(() => {
+    const m = mapa.current;
+    if (!m) return;
+    m.setStyle(ESTILO_MAPBOX[prefs.tipo], { config: { basemap: configStandard(prefs.tipo, colorScheme) } } as never);
+  }, [prefs.tipo, colorScheme]);
+  useEffect(() => {
+    mapa.current?.easeTo({ pitch: prefs.tresD ? PITCH_3D : 0, duration: 400 });
+  }, [prefs.tresD]);
+
+  // Marcadores: la placa encima y el punto (o la flecha con el rumbo) debajo, como en el teléfono.
+  useEffect(() => {
+    const m = mapa.current;
+    const mapboxgl = gl.current;
+    if (!m || !mapboxgl) return;
+    const vistos = new Set<string>();
+    puntos.forEach((p) => {
+      vistos.add(p.id);
+      const color = colorDe(p);
+      const rumbo = p.estado === 'marcha' && typeof p.rumbo === 'number' ? p.rumbo : null;
+      const html =
+        (p.placa ? `<span class="fom-placa" style="border-color:${color};background:${colors.surfaceElevated};color:${colors.text}">${esc(p.placa)}</span>` : '') +
+        (rumbo === null
+          ? `<span class="fom-punto" style="background:${color};border-color:${colors.background};box-shadow:0 0 0 ${p.id === resaltadoId ? 6 : 4}px ${color}55"></span>`
+          : `<svg class="fom-flecha" width="26" height="26" viewBox="0 0 24 24" style="transform:rotate(${rumbo}deg)"><path d="M12 2.5 L20 21 L12 16.5 L4 21 Z" fill="${color}" stroke="${colors.background}" stroke-width="2" stroke-linejoin="round"/></svg>`);
