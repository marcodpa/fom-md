+  const numero = typeof valor === 'number' ? valor : NaN;
+  const visto = useConteo(Number.isFinite(numero) ? numero : 0);
+  return (
+    <ThemedText tabular style={style}>
+      {typeof valor === 'number' ? numeroWeb(visto) : valor}
+    </ThemedText>
+  );
+}
