+  const { colors } = useTheme();
+  const tiempo = partesTiempo(minutos);
+  const tonoVel = velocidadTono(enMarcha ? velocidad : 0);
+  const titulo = [`${vehicle.marca} ${vehicle.modelo}`.trim(), vehicle.anio ? String(vehicle.anio) : null]
+    .filter(Boolean)
+    .join(' · ');
+  return (
+    <View style={[styles.franja, { height: ALTO_FRANJA }]}>
