+// SOLO PARA PROBAR LA APP EN EL NAVEGADOR: en web, expo-secure-store se cambia
+// por web-shims/secure-store.js (sessionStorage). En Android e iOS no cambia nada.
+const { getDefaultConfig } = require('expo/metro-config');
+const path = require('path');
+
+const config = getDefaultConfig(__dirname);
+const resolverOriginal = config.resolver.resolveRequest;
+
+config.resolver.resolveRequest = (context, moduleName, platform) => {
+  if (platform === 'web' && moduleName === 'expo-secure-store') {
+    return { type: 'sourceFile', filePath: path.join(__dirname, 'web-shims/secure-store.js') };
+  }
+  return resolverOriginal ? resolverOriginal(context, moduleName, platform) : context.resolveRequest(context, moduleName, platform);
+};
+
+module.exports = config;
