+const KEY = '50000000-0000-4000-8000-000000000001';
+
+async function application(role = 'supervisor') {
+  const calls = [];
+  const record = (name) => async (...args) => {
+    calls.push({ name, args });
+    return { name, replayed: false };
+  };
+  const execution = {
+    listAssigned: record('listAssigned'),
+    listAssignable: record('listAssignable'),
+    detail: record('detail'),
+    assign: record('assign'),
+    execute: record('execute'),
+    finish: record('finish'),
+  };
+  const receipts = new MobileMutationReceiptService();
+  const flow = {
+    requireIdempotencyKey: (key) => receipts.requireKey(key),
+    dispatch: record('dispatch'),
+    resolve: record('resolve'),
+    close: record('close'),
+    returnToExecution: record('returnToExecution'),
+  };
+  const operations = { getWorkOrder: record('getWorkOrder'), listWorkOrders: record('listWorkOrders') };
+  const allow = { canActivate: () => true };
+  const mobileSession = {
+    canActivate(context) {
+      context.switchToHttp().getRequest().fomMobileActor = {
+        userId: ID, tenantId: ID, role, platformAdmin: false, mustChangePassword: false,
+      };
+      return true;
+    },
+  };
+  const moduleRef = await Test.createTestingModule({
+    // Mismo orden que ConsoleApiModule: las rutas estáticas primero.
+    controllers: [
+      ConsoleWorkOrderExecutionController,
+      ConsoleOperationsController,
+      MobileWorkOrderExecutionController,
+    ],
+    providers: [
+      { provide: WorkOrderExecutionService, useValue: execution },
+      { provide: WorkOrderFlowService, useValue: flow },
+      { provide: ConsoleOperationsService, useValue: operations },
+    ],
+  })
+    .overrideGuard(ConsoleSessionGuard).useValue(allow)
+    .overrideGuard(ConsoleBrowserMutationGuard).useValue(allow)
+    .overrideGuard(MobileSessionGuard).useValue(mobileSession)
+    .compile();
+  const app = moduleRef.createNestApplication();
+  app.useGlobalPipes(new ValidationPipe({
+    transform: true, whitelist: true, forbidNonWhitelisted: true,
+  }));
+  await app.listen(0, '127.0.0.1');
+  const base = `http://127.0.0.1:${app.getHttpServer().address().port}/api/v1`;
+  const call = (method, path, body, headers = {}) => fetch(`${base}${path}`, {
+    method,
+    headers: { ...(body ? { 'content-type': 'application/json' } : {}), ...headers },
+    body: body ? JSON.stringify(body) : undefined,
+  });
+  return { app, calls, call };
+}
+
+const BODIES = {
+  dispatch: { expectedStatus: 'abierta', userId: ID },
+  resolve: { expectedStatus: 'aprobada', resolutionNote: 'Se ajustó el borne' },
+  close: {
+    expectedStatus: 'en_calidad', resolutionNote: 'Trabajo verificado',
+    resolutionCost: 40, resolutionCurrency: 'USD', completionOdometerKm: 45210,
+  },
+  return: { expectedStatus: 'en_calidad', reason: 'Falta apretar la abrazadera' },
+  finish: { clientEventId: KEY, expectedStatus: 'asignada', note: 'Correa cambiada' },
+};
+
+test('OpenAPI publica el flujo simple en consola y móvil con sus credenciales', async (t) => {
+  const { app } = await application();
+  t.after(() => app.close());
+  const document = SwaggerModule.createDocument(app, new DocumentBuilder()
+    .addCookieAuth('__Host-fom_session')
+    .addBearerAuth({ type: 'http', scheme: 'bearer' }, 'mobile-bearer')
+    .build());
+  const expected = {
+    'get /api/v1/console/work-orders/assigned': 'consoleAssignedWorkOrderList',
+    'get /api/v1/console/work-orders/assignable-people': 'consoleWorkOrderAssignableList',
+    'post /api/v1/console/work-orders/{workOrderId}/dispatch': 'consoleWorkOrderDispatch',
+    'post /api/v1/console/work-orders/{workOrderId}/resolve': 'consoleWorkOrderResolve',
+    'post /api/v1/console/work-orders/{workOrderId}/close': 'consoleWorkOrderClose',
+    'post /api/v1/console/work-orders/{workOrderId}/return': 'consoleWorkOrderReturn',
+    'post /api/v1/console/work-orders/{workOrderId}/finish': 'consoleWorkOrderFinish',
+    'get /api/v1/mobile/work-orders/assignable-people': 'mobileWorkOrderAssignableList',
+    'put /api/v1/mobile/work-orders/{workOrderId}/assignee': 'mobileWorkOrderAssign',
+    'post /api/v1/mobile/work-orders/{workOrderId}/dispatch': 'mobileWorkOrderDispatch',
+    'post /api/v1/mobile/work-orders/{workOrderId}/resolve': 'mobileWorkOrderResolve',
+    'post /api/v1/mobile/work-orders/{workOrderId}/close': 'mobileWorkOrderClose',
+    'post /api/v1/mobile/work-orders/{workOrderId}/return': 'mobileWorkOrderReturn',
+    'post /api/v1/mobile/work-orders/{workOrderId}/finish': 'mobileWorkOrderFinish',
+  };
+  for (const [key, operationId] of Object.entries(expected)) {
+    const [method, path] = key.split(' ');
+    const operation = document.paths[path]?.[method];
+    assert.equal(operation?.operationId, operationId, key);
+    const security = path.startsWith('/api/v1/console') ? '__Host-fom_session' : 'mobile-bearer';
+    assert.deepEqual(operation.security, [{ [security]: [] }], key);
+  }
+  for (const action of ['dispatch', 'resolve', 'close', 'return']) {
+    const parameters = document.paths[`/api/v1/mobile/work-orders/{workOrderId}/${action}`]
+      .post.parameters;
+    assert.ok(
+      parameters.some(({ name, required }) => name === 'Idempotency-Key' && required),
+      `${action} exige Idempotency-Key`,
+    );
+  }
+});
+
+test('consola: rutas estáticas antes de :workOrderId y acciones con 200', async (t) => {
+  const { app, calls, call } = await application();
+  t.after(() => app.close());
+  assert.equal((await call('GET', '/console/work-orders/assigned')).status, 200);
+  assert.equal((await call('GET', '/console/work-orders/assignable-people?q=Ana')).status, 200);
+  assert.deepEqual(calls.map(({ name }) => name), ['listAssigned', 'listAssignable']);
+  for (const [action, body] of Object.entries(BODIES)) {
+    const response = await call('POST', `/console/work-orders/${ID}/${action}`, body);
+    assert.equal(response.status, 200, action);
+  }
+  assert.deepEqual(
+    calls.slice(2).map(({ name, args }) => [name, args[0]]),
+    [
+      ['dispatch', ID], ['resolve', ID], ['close', ID],
+      ['returnToExecution', ID], ['finish', ID],
+    ],
+  );
+});
+
+test('los cuerpos inválidos se rechazan antes del servicio', async (t) => {
+  const { app, calls, call } = await application();
+  t.after(() => app.close());
+  const invalid = [
+    ['dispatch', { expectedStatus: 'en_ejecucion', userId: ID }],
+    ['dispatch', { expectedStatus: 'abierta', userId: 'no-uuid' }],
+    ['resolve', { expectedStatus: 'abierta' }],
+    ['resolve', { expectedStatus: 'en_calidad', resolutionNote: 'No va por aquí' }],
+    ['resolve', { expectedStatus: 'abierta', resolutionNote: 'Ok bien', resolutionCurrency: 'usd' }],
+    ['close', { expectedStatus: 'aprobada', resolutionNote: 'Trabajo verificado' }],
+    ['close', { expectedStatus: 'en_calidad', resolutionNote: 'Ok bien', resolutionCost: -1 }],
+    ['return', { expectedStatus: 'en_calidad' }],
+    ['return', { expectedStatus: 'en_calidad', reason: 'no' }],
+    ['finish', { clientEventId: KEY, expectedStatus: 'asignada' }],
+    ['finish', { clientEventId: KEY, expectedStatus: 'asignada', note: '  ' }],
+    ['finish', { clientEventId: KEY, expectedStatus: 'en_calidad', note: 'Correa cambiada' }],
+    ['dispatch', { ...BODIES.dispatch, tenantId: ID }],
+  ];
+  for (const [action, body] of invalid) {
+    const response = await call('POST', `/console/work-orders/${ID}/${action}`, body);
+    assert.equal(response.status, 400, `${action} ${JSON.stringify(body)}`);
+  }
+  // La entrega del reloj sigue exigiendo nota.
+  const delivery = await call('POST', `/console/work-orders/${ID}/execution-events`, {
+    clientEventId: KEY, action: 'entrega', expectedStatus: 'en_ejecucion',
+  });
+  assert.equal(delivery.status, 400);
+  assert.equal(calls.length, 0);
+});
+
+test('móvil: las acciones compuestas exigen Idempotency-Key UUID v4', async (t) => {
+  const { app, calls, call } = await application();
+  t.after(() => app.close());
+  for (const action of ['dispatch', 'resolve', 'close', 'return']) {
+    const path = `/mobile/work-orders/${ID}/${action}`;
+    assert.equal((await call('POST', path, BODIES[action])).status, 400, `${action} sin llave`);
+    assert.equal(
+      (await call('POST', path, BODIES[action], { 'Idempotency-Key': 'no-uuid' })).status,
+      400,
+    );
+    assert.equal(
+      (await call('POST', path, BODIES[action], { 'Idempotency-Key': KEY })).status,
+      200,
+      action,
+    );
+  }
+  assert.deepEqual(
+    calls.map(({ name, args }) => [name, args[2]]),
+    [
+      ['dispatch', KEY], ['resolve', KEY], ['close', KEY], ['returnToExecution', KEY],
+    ],
+  );
+  assert.equal((await call('PUT', `/mobile/work-orders/${ID}/assignee`, { userId: ID })).status, 200);
+  assert.equal((await call('GET', '/mobile/work-orders/assignable-people')).status, 200);
+  assert.equal((await call('POST', `/mobile/work-orders/${ID}/finish`, BODIES.finish)).status, 200);
+});
+
+test('móvil: el conductor usa sus ODT y Terminé; gestión responde 403', async (t) => {
+  const { app, calls, call } = await application('conductor');
+  t.after(() => app.close());
+  assert.equal((await call('GET', '/mobile/work-orders/assigned')).status, 200);
+  assert.equal((await call('GET', `/mobile/work-orders/${ID}/execution`)).status, 200);
+  assert.equal((await call('POST', `/mobile/work-orders/${ID}/execution-events`, {
+    clientEventId: KEY, action: 'inicio', expectedStatus: 'asignada',
+  })).status, 201);
+  assert.equal((await call('POST', `/mobile/work-orders/${ID}/finish`, BODIES.finish)).status, 200);
+  assert.deepEqual(calls.map(({ name }) => name), ['listAssigned', 'detail', 'execute', 'finish']);
+
+  const denied = [
+    ['GET', '/mobile/work-orders/assignable-people'],
+    ['PUT', `/mobile/work-orders/${ID}/assignee`, { userId: ID }],
+    ['POST', `/mobile/work-orders/${ID}/dispatch`, BODIES.dispatch],
+    ['POST', `/mobile/work-orders/${ID}/resolve`, BODIES.resolve],
+    ['POST', `/mobile/work-orders/${ID}/close`, BODIES.close],
+    ['POST', `/mobile/work-orders/${ID}/return`, BODIES.return],
+  ];
+  for (const [method, path, body] of denied) {
+    const response = await call(method, path, body, { 'Idempotency-Key': KEY });
+    assert.equal(response.status, 403, `${method} ${path}`);
+    assert.equal((await response.json()).code, 'mobile_operations_read_forbidden');
+  }
+  assert.equal(calls.length, 4, 'ninguna ruta de gestión llegó al servicio');
+});
+
+test('móvil: un usuario básico sigue fuera de la ejecución', async (t) => {
+  const { app, calls, call } = await application('usuario');
+  t.after(() => app.close());
+  assert.equal((await call('GET', '/mobile/work-orders/assigned')).status, 403);
+  assert.equal((await call('POST', `/mobile/work-orders/${ID}/finish`, BODIES.finish)).status, 403);
+  assert.equal(calls.length, 0);
+});
diff --git a/test/work-order-flow-runtime.js b/test/work-order-flow-runtime.js
new file mode 100644
