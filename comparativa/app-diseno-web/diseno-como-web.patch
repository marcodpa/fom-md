+const LIMITE = 1000;
+
+/** Llevar la cámara a un sitio o a unos límites ([lng, lat]). */
+export type Foco = { lat: number; lng: number; limites?: [number, number][]; clave: number };
+
+/**
+ * EL RECORRIDO de una unidad en un rango: las posiciones crudas, partidas en
+ * viajes y paradas, y después cada viaje pegado a las calles (Map Matching).
+ * `ruta` llega primero cruda y se cambia sola por la pegada.
+ */
+export function useRecorrido(vehicleId: string | null, horas: Rango, companyId?: string) {
+  const { data, estado, recargar } = useAsyncData(
+    async () => {
+      if (!vehicleId) return null;
+      const desde = new Date(Date.now() - horas * 3600000).toISOString();
+      const filas = await getRecorridoVehiculoFom(vehicleId, { from: desde, limit: LIMITE, companyId: companyId || undefined });
+      // FOM las devuelve de la más reciente a la más vieja.
+      const puntos: PuntoRuta[] = filas
+        .map((p) => ({
+          lat: p.lat,
+          lng: p.lng,
+          hora: p.reportadaEn ?? p.recibidaEn ?? '',
+          velocidadKmh: p.velocidadKmh ?? null,
+          ignition: p.contacto ?? null,
+        }))
+        .filter((p) => p.hora)
+        .reverse();
+      return { analisis: analizar(quitarSaltos(puntos)), truncado: filas.length >= LIMITE };
+    },
