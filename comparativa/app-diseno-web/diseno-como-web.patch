index 0000000..3385d7f
--- /dev/null
+++ b/src/components/calendario-inspecciones.tsx
@@ -0,0 +1,285 @@
+import { StyleSheet, View } from 'react-native';
+
+import { PressableScale } from '@/components/pressable-scale';
+import { TabIcon, type TabIconName } from '@/components/tab-icon';
+import { ThemedText } from '@/components/themed-text';
+import type { InspeccionResumen } from '@/services';
+import { useTheme, type ColorTokens } from '@/theme';
+
+/**
+ * CALENDARIO DE LA DIARIA: el mes de una persona, día por día.
+ *
+ * Es el mismo calendario que la web (mismos nombres, colores y leyenda). Aquí
+ * solo se pinta: qué día cuenta y cómo quedó lo decide `inspecciones-por-persona`.
+ */
+
+/**
+ * Cómo quedó un día. `no_cuenta` es el gris: futuro, sin unidad o sin
+ * jornada; `hoy` es el gris de hoy mientras la diaria todavía está a tiempo.
+ */
+export type EstadoDia = 'hecha' | 'observaciones' | 'bloqueada' | 'no_hecha' | 'hoy' | 'no_cuenta';
+
+/** Un día del calendario, ya juzgado. */
+export interface DiaCalendario {
+  /** AAAA-MM-DD. */
+  fecha: string;
+  estado: EstadoDia;
+  /** La diaria de ese día (la más grave si hubo dos). */
+  diaria?: InspeccionResumen;
+}
+
+/** Nombre, color e icono de cada estado: la leyenda y la celda salen de aquí. */
+export const VISTA_DIA: Record<
+  EstadoDia,
+  { label: string; tono: keyof ColorTokens; fondo: keyof ColorTokens; icono?: TabIconName }
+> = {
+  hecha: { label: 'Hecha', tono: 'success', fondo: 'successSurface', icono: 'check' },
+  observaciones: { label: 'Con observaciones', tono: 'warning', fondo: 'warningSurface', icono: 'editar' },
+  bloqueada: { label: 'Bloqueada', tono: 'danger', fondo: 'dangerSurface', icono: 'aviso' },
+  no_hecha: { label: 'No hecha', tono: 'danger', fondo: 'surfaceSunken', icono: 'cerrar' },
+  hoy: { label: 'Hoy, aún a tiempo', tono: 'textMuted', fondo: 'surfaceSunken' },
+  no_cuenta: { label: 'No cuenta', tono: 'textMuted', fondo: 'surfaceSunken' },
+};
+
+/** Lo que dice la leyenda, en este orden. `hoy` se explica con el anillo, no aparte. */
+const LEYENDA: EstadoDia[] = ['hecha', 'observaciones', 'bloqueada', 'no_hecha', 'no_cuenta'];
+
+const MESES = [
+  'enero',
+  'febrero',
+  'marzo',
+  'abril',
+  'mayo',
+  'junio',
+  'julio',
+  'agosto',
+  'septiembre',
+  'octubre',
+  'noviembre',
+  'diciembre',
+];
+const DIAS_SEMANA = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
+/** La semana empieza el lunes, como se trabaja aquí. */
+const CABECERA = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
+
+/** «Octubre 2026», de un mes AAAA-MM. */
+export function nombreMes(mes: string): string {
+  const [a, m] = mes.split('-').map(Number);
+  const n = MESES[m - 1] ?? '';
+  return `${n.charAt(0).toUpperCase()}${n.slice(1)} ${a}`;
+}
+
+/** «lunes 5 de octubre», para el lector de pantalla. */
+function nombreDia(fecha: string): string {
+  const [a, m, d] = fecha.split('-').map(Number);
+  return `${DIAS_SEMANA[new Date(a, m - 1, d).getDay()]} ${d} de ${MESES[m - 1]}`;
+}
+
+/** ‹ Octubre 2026 › — el mes que se mira. No deja pasar del mes en curso. */
+export function SelectorMes({
+  mes,
+  onAnterior,
+  onSiguiente,
+  haySiguiente,
+}: {
+  mes: string;
+  onAnterior: () => void;
+  onSiguiente: () => void;
+  haySiguiente: boolean;
+}) {
+  const { colors, spacing, borderWidths } = useTheme();
+  const flecha = (activo: boolean) => [
+    styles.flecha,
+    { borderColor: colors.border, borderWidth: borderWidths.hairline, opacity: activo ? 1 : 0.35 },
+  ];
+  return (
+    <View style={[styles.fila, { gap: spacing.sm }]}>
+      <PressableScale
+        onPress={onAnterior}
+        accessibilityRole="button"
+        accessibilityLabel="Mes anterior"
+        style={flecha(true)}>
+        <View style={styles.girado}>
+          <TabIcon name="chevron" color={colors.text} size={18} />
+        </View>
+      </PressableScale>
+      <ThemedText variant="button" style={[styles.flex1, styles.centro]} accessibilityRole="header">
+        {nombreMes(mes)}
+      </ThemedText>
+      <PressableScale
+        onPress={haySiguiente ? onSiguiente : undefined}
+        disabled={!haySiguiente}
+        accessibilityRole="button"
+        accessibilityLabel="Mes siguiente"
+        accessibilityState={{ disabled: !haySiguiente }}
+        style={flecha(haySiguiente)}>
+        <TabIcon name="chevron" color={colors.text} size={18} />
+      </PressableScale>
+    </View>
+  );
+}
+
+/** Una celda: el número y el icono del estado. Con diaria, se toca para ver el resultado. */
+function Celda({
+  d,
+  esHoy,
+  onAbrir,
+}: {
+  d: DiaCalendario;
+  esHoy: boolean;
+  onAbrir: (i: InspeccionResumen) => void;
+}) {
+  const { colors, radii, borderWidths } = useTheme();
+  const v = VISTA_DIA[d.estado];
+  const dia = Number(d.fecha.slice(8, 10));
+  const abrible = d.diaria;
+  const gris = d.estado === 'no_cuenta' || d.estado === 'hoy';
+  const texto = [
+    nombreDia(d.fecha),
+    v.label,
+    abrible ? 'toca para ver el resultado' : null,
+  ]
+    .filter(Boolean)
+    .join(', ');
+  const estilo = [
+    styles.celda,
+    {
+      backgroundColor: gris ? 'transparent' : colors[v.fondo],
+      borderRadius: radii.sm,
+      // «No hecha» lleva borde rojo: sin relleno, no se confunde con la bloqueada.
+      borderWidth: esHoy ? 2 : d.estado === 'no_hecha' ? borderWidths.hairline * 2 : 0,
+      borderColor: esHoy ? colors.primary : colors.danger,
+    },
+  ];
+  // Lo que se ve va por dentro; lo que se toca es la columna entera (≥ 44 de ancho).
+  const contenido = (
+    <View style={estilo}>
+      <ThemedText
+        variant="caption"
+        tabular
+        color={gris ? 'textMuted' : 'text'}
+        style={[styles.numero, esHoy && styles.fuerte]}>
+        {`${dia}`}
+      </ThemedText>
+      {v.icono ? <TabIcon name={v.icono} color={colors[v.tono]} size={14} /> : <View style={styles.sinIcono} />}
+    </View>
+  );
+  if (!abrible) {
+    return (
+      <View style={styles.toque} accessible accessibilityLabel={texto}>
+        {contenido}
+      </View>
+    );
+  }
+  return (
+    <PressableScale
+      onPress={() => onAbrir(abrible)}
+      accessibilityRole="button"
+      accessibilityLabel={texto}
+      style={styles.toque}>
+      {contenido}
+    </PressableScale>
+  );
+}
+
+/**
+ * El mes en rejilla de 7 columnas, de lunes a domingo, con su leyenda debajo.
+ *
+ * Cada celda mide al menos 44 de alto y lleva icono además del color: el
+ * estado se lee aunque no se distingan el verde y el rojo.
+ */
+export function CalendarioInspecciones({
+  mes,
+  dias,
+  hoy,
+  onAbrir,
+}: {
+  /** AAAA-MM. */
+  mes: string;
+  /** Todos los días del mes, en orden. */
+  dias: DiaCalendario[];
+  /** AAAA-MM-DD. */
+  hoy: string;
+  onAbrir: (i: InspeccionResumen) => void;
+}) {
+  const { colors, spacing, radii } = useTheme();
+  const [a, m] = mes.split('-').map(Number);
+  // Huecos antes del día 1 para que caiga en su columna (lunes = 0).
+  const huecos = (new Date(a, m - 1, 1).getDay() + 6) % 7;
+  const casillas: (DiaCalendario | null)[] = [...Array<null>(huecos).fill(null), ...dias];
+  while (casillas.length % 7 !== 0) casillas.push(null);
+  const semanas: (DiaCalendario | null)[][] = [];
+  for (let n = 0; n < casillas.length; n += 7) semanas.push(casillas.slice(n, n + 7));
+
+  return (
+    <View style={{ gap: spacing.md }}>
+      <View style={{ gap: spacing.xs }}>
+        <View style={styles.semana}>
+          {CABECERA.map((c, n) => (
+            <ThemedText key={n} variant="caption" color="textMuted" style={[styles.columna, styles.centro]}>
+              {c}
+            </ThemedText>
+          ))}
+        </View>
+        {semanas.map((s, n) => (
+          <View key={n} style={styles.semana}>
+            {s.map((d, k) => (
+              <View key={k} style={styles.columna}>
+                {d ? <Celda d={d} esHoy={d.fecha === hoy} onAbrir={onAbrir} /> : null}
+              </View>
+            ))}
+          </View>
+        ))}
+      </View>
+
+      {/* La leyenda: los mismos nombres y colores que la web. */}
+      <View style={[styles.leyenda, { rowGap: spacing.sm, columnGap: spacing.md }]}>
+        {LEYENDA.map((e) => {
+          const v = VISTA_DIA[e];
+          return (
+            <View key={e} style={[styles.fila, { gap: spacing.xs + 2 }]}>
+              <View
+                style={[
+                  styles.muestra,
+                  {
+                    backgroundColor: e === 'no_cuenta' ? colors.surfaceSunken : colors[v.fondo],
+                    borderRadius: radii.sm / 2,
+                    borderWidth: e === 'no_hecha' ? 1 : 0,
+                    borderColor: colors.danger,
+                  },
+                ]}>
+                {v.icono ? <TabIcon name={v.icono} color={colors[v.tono]} size={11} /> : null}
+              </View>
+              <ThemedText variant="caption" color="textSecondary">
+                {v.label}
+              </ThemedText>
+            </View>
+          );
+        })}
+        <View style={[styles.fila, { gap: spacing.xs + 2 }]}>
+          <View style={[styles.muestra, { borderWidth: 2, borderColor: colors.primary, borderRadius: radii.sm / 2 }]} />
+          <ThemedText variant="caption" color="textSecondary">
+            Hoy
+          </ThemedText>
+        </View>
+      </View>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  fila: { flexDirection: 'row', alignItems: 'center' },
+  flex1: { flex: 1, minWidth: 0 },
+  centro: { textAlign: 'center', alignItems: 'center', justifyContent: 'center' },
+  girado: { transform: [{ rotate: '180deg' }] },
+  flecha: { width: 44, height: 44, borderRadius: 22, alignItems: 'center', justifyContent: 'center' },
+  semana: { flexDirection: 'row' },
+  columna: { flex: 1, minWidth: 0 },
+  toque: { minHeight: 48, padding: 2 },
+  celda: { flex: 1, minHeight: 44, alignItems: 'center', justifyContent: 'center', gap: 1 },
+  numero: { fontSize: 13, lineHeight: 16 },
+  fuerte: { fontWeight: '700' },
+  sinIcono: { height: 14 },
+  leyenda: { flexDirection: 'row', flexWrap: 'wrap' },
+  muestra: { width: 18, height: 18, alignItems: 'center', justifyContent: 'center' },
+});
