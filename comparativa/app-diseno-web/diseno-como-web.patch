diff --git a/src/components/odt-asignada-acciones.tsx b/src/components/odt-asignada-acciones.tsx
new file mode 100644
index 0000000..53b35e3
--- /dev/null
+++ b/src/components/odt-asignada-acciones.tsx
@@ -0,0 +1,245 @@
+import { useEffect, useRef, useState } from 'react';
+import { StyleSheet, View } from 'react-native';
+
+import { Button } from '@/components/button';
+import { HojaModal } from '@/components/hoja-modal';
+import { PulseDot } from '@/components/pulse-dot';
+import { TabIcon } from '@/components/tab-icon';
+import { TextField } from '@/components/text-field';
+import { ThemedText } from '@/components/themed-text';
+import { uuidV4 } from '@/lib/fom-api';
+import {
+  DESDE_EVENTO,
+  esEstadoTaller,
+  eventoPideNota,
+  registrarEventoOdt,
+  type EjecucionOdt,
+  type EventoTaller,
+} from '@/services/fomOrdenes';
+import { useTheme } from '@/theme';
+import { MIN_NOTA_ODT } from '@/utils/odt';
+
+/**
+ * EL TRABAJO DE TALLER de una ODT asignada: su reloj y los botones de su
+ * responsable. Lo usan «Asignadas a ti» (Mantenimiento) y el detalle de la ODT.
+ *
+ * Los textos son los mismos de la web: «Iniciar trabajo», «Pausar»,
+ * «Reanudar», «Entregar» y «Tiempo trabajado».
+ */
+
+/** En qué momento va el trabajo, dicho en corto bajo su estado. */
+export const MOMENTO_TALLER: Record<string, string> = {
+  asignada: 'Sin iniciar',
+  en_ejecucion: 'Trabajo en curso',
+  pausada: 'Trabajo pausado',
+  en_calidad: 'Entregada: la revisa el supervisor',
+};
+
+/** Qué botón toca en cada momento, y cuál es el principal. */
+const PASOS: Record<string, { evento: EventoTaller; label: string; principal: boolean }[]> = {
+  asignada: [{ evento: 'inicio', label: 'Iniciar trabajo', principal: true }],
+  en_ejecucion: [
+    { evento: 'pausa', label: 'Pausar', principal: false },
+    { evento: 'entrega', label: 'Entregar', principal: true },
+  ],
+  pausada: [{ evento: 'reanudacion', label: 'Reanudar', principal: true }],
+};
+
+/** Lo que pide la hoja de la nota, por evento. */
+const HOJA: Partial<Record<EventoTaller, { titulo: string; placeholder: string; ayuda: string }>> = {
+  pausa: {
+    titulo: 'Pausar',
+    placeholder: 'Por qué se detiene el trabajo…',
+    ayuda: 'El reloj se detiene hasta que lo reanudes.',
+  },
+  entrega: {
+    titulo: 'Entregar',
+    placeholder: 'Qué se hizo…',
+    // FOM solo recibe la nota al entregar: el costo y la factura van al cerrarla.
+    ayuda: 'La ODT pasa a revisión del supervisor, que la cierra con el costo y la factura.',
+  },
+};
+
+/** «1:05:23»: horas sin tope, minutos y segundos con dos cifras. */
+export function formatoReloj(segundos: number): string {
+  const s = Math.max(0, Math.floor(segundos));
+  const h = Math.floor(s / 3600);
+  const m = Math.floor((s % 3600) / 60);
+  const r = s % 60;
+  return `${h}:${String(m).padStart(2, '0')}:${String(r).padStart(2, '0')}`;
+}
+
+/**
+ * Los segundos trabajados AHORA. En taller el reloj sigue corriendo desde la
+ * lectura de FOM con el reloj del teléfono; pausada o entregada, se queda en
+ * lo que dijo FOM.
+ */
+function useSegundosTrabajados(ej: Pick<EjecucionOdt, 'segundosTrabajados' | 'leidoEn' | 'estadoFom'>): number {
+  const corriendo = ej.estadoFom === 'en_ejecucion';
+  const [ahora, setAhora] = useState(() => ej.leidoEn);
+  useEffect(() => {
+    if (!corriendo) return;
+    const t = setInterval(() => setAhora(Date.now()), 1000);
+    return () => clearInterval(t);
+  }, [corriendo]);
+  return corriendo ? ej.segundosTrabajados + Math.max(0, ahora - ej.leidoEn) / 1000 : ej.segundosTrabajados;
+}
+
+/** «Tiempo trabajado 1:05:23», con un punto que late mientras corre. */
+export function RelojOdt({ ejecucion }: { ejecucion: Pick<EjecucionOdt, 'segundosTrabajados' | 'leidoEn' | 'estadoFom'> }) {
+  const { colors, spacing } = useTheme();
+  const segundos = useSegundosTrabajados(ejecucion);
+  const corriendo = ejecucion.estadoFom === 'en_ejecucion';
+  return (
+    <View
+      style={[styles.fila, { gap: spacing.sm }]}
+      accessible
+      accessibilityLabel={`Tiempo trabajado ${formatoReloj(segundos)}${corriendo ? ', corriendo' : ''}`}>
+      {corriendo ? <PulseDot color={colors.success} size={7} /> : <TabIcon name="pausa" color={colors.textMuted} size={13} />}
+      <ThemedText variant="caption" color="textSecondary" style={styles.flex1}>
+        Tiempo trabajado
+      </ThemedText>
+      <ThemedText variant="button" tabular color={corriendo ? 'text' : 'textSecondary'}>
+        {formatoReloj(segundos)}
+      </ThemedText>
+    </View>
+  );
+}
+
+/**
+ * Los botones del responsable según el momento de su ODT. Iniciar y reanudar
+ * se hacen con un toque; pausar y entregar abren una hoja con su nota, que FOM
+ * exige. Tras cada paso, `onHecho` para que quien la pinta la relea.
+ *
+ * Un reintento del MISMO paso (misma nota) reusa su clave: si el primero sí
+ * llegó, FOM no registra otro.
+ */
+export function AccionesOdtAsignada({
+  id,
+  estadoFom,
+  onHecho,
+}: {
+  id: string;
+  estadoFom: string;
+  onHecho: () => void;
+}) {
+  const { spacing } = useTheme();
+  const [enviando, setEnviando] = useState<EventoTaller | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [hoja, setHoja] = useState<EventoTaller | null>(null);
+  const [nota, setNota] = useState('');
+  const [errorNota, setErrorNota] = useState<string | undefined>();
+  const intento = useRef<{ firma: string; clave: string } | null>(null);
+
+  // Entregada (o fuera de taller) no le queda nada al responsable: su momento
+  // ya lo dice quien la pinta.
+  const pasos = esEstadoTaller(estadoFom) ? (PASOS[estadoFom] ?? []) : [];
+  if (pasos.length === 0) return null;
+
+  async function enviar(evento: EventoTaller, conNota?: string) {
+    if (enviando) return;
+    const desde = DESDE_EVENTO[evento];
+    const firma = `${id}|${evento}|${desde}|${conNota?.trim() ?? ''}`;
+    if (intento.current?.firma !== firma) intento.current = { firma, clave: uuidV4() };
+    setEnviando(evento);
+    setError(null);
+    try {
+      await registrarEventoOdt(id, { accion: evento, desde, nota: conNota, clave: intento.current.clave });
+      intento.current = null;
+      setHoja(null);
+      setNota('');
+      onHecho();
+    } catch (e) {
+      setError(e instanceof Error ? e.message : 'No pudimos registrar el paso. Intenta de nuevo.');
+    } finally {
+      setEnviando(null);
+    }
+  }
+
+  function tocar(evento: EventoTaller) {
+    setError(null);
+    if (eventoPideNota(evento)) {
+      setErrorNota(undefined);
+      setHoja(evento);
+    } else {
+      void enviar(evento);
+    }
+  }
+
+  function confirmarHoja() {
+    if (!hoja) return;
+    if (nota.trim().length < MIN_NOTA_ODT) {
+      setErrorNota(hoja === 'entrega' ? 'Cuenta qué se hizo.' : 'Escribe por qué se detiene.');
+      return;
+    }
+    void enviar(hoja, nota);
+  }
+
+  const textoHoja = hoja ? HOJA[hoja] : undefined;
+
+  return (
+    <View style={{ gap: spacing.sm }}>
+      <View style={[styles.fila, { gap: spacing.sm }]}>
+        {pasos.map((p) => (
+          <Button
+            key={p.evento}
+            label={p.label}
+            variant={p.principal ? 'primary' : 'secondary'}
+            icon={p.evento === 'pausa' ? 'pausa' : p.evento === 'entrega' ? 'check' : undefined}
+            onPress={() => tocar(p.evento)}
+            loading={enviando === p.evento && !hoja}
+            disabled={enviando !== null}
+            style={styles.flex1}
+          />
+        ))}
+      </View>
+      {error && !hoja ? (
+        <ThemedText variant="caption" color="danger">
+          {error}
+        </ThemedText>
+      ) : null}
+
+      <HojaModal
+        visible={hoja !== null}
+        onClose={() => (enviando ? undefined : setHoja(null))}
+        titulo={textoHoja?.titulo ?? ''}
+        icon={hoja === 'pausa' ? 'pausa' : 'check'}
+        tone="primary">
+        <TextField
+          label="Nota"
+          value={nota}
+          onChangeText={(t) => {
+            setNota(t);
+            if (errorNota) setErrorNota(undefined);
+          }}
+          placeholder={textoHoja?.placeholder}
+          multiline
+          maxLength={1000}
+          editable={!enviando}
+          style={styles.nota}
+          error={errorNota}
+        />
+        <ThemedText variant="caption" color="textSecondary">
+          {textoHoja?.ayuda ?? ''}
+        </ThemedText>
+        {error ? (
+          <ThemedText variant="caption" color="danger">
+            {error}
+          </ThemedText>
+        ) : null}
+        <Button
+          label={textoHoja?.titulo ?? ''}
+          icon={hoja === 'pausa' ? 'pausa' : 'check'}
+          onPress={confirmarHoja}
+          loading={enviando !== null}
+        />
+      </HojaModal>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  fila: { flexDirection: 'row', alignItems: 'center' },
+  flex1: { flex: 1, minWidth: 0 },
+  nota: { minHeight: 72 },
+});
