+            </View>
+          ) : null}
+        </View>
+      </View>
+    </PressableScale>
+  );
+});
+
+/** «● En marcha · 61 km/h», «● Detenida» o «● Sin señal · hace 2 h». */
+function EstadoAhora({
+  estado,
+  velocidad,
+  ultimoReporte,
+}: {
+  estado: EstadoFila;
+  velocidad: number;
+  ultimoReporte: string | null | undefined;
+}) {
+  const { colors } = useTheme();
+  if (!estado) {
+    return (
+      <ThemedText style={[styles.estado, { color: colors.textMuted }]} numberOfLines={1}>
+        Buscando su posición…
+      </ThemedText>
+    );
+  }
+  const tono: keyof ColorTokens = estado === 'marcha' ? 'success' : estado === 'detenido' ? 'warning' : 'textMuted';
+  return (
+    <View style={styles.fila}>
+      <PulseDot color={colors[tono]} size={7} active={estado === 'marcha'} />
+      {estado === 'sin-senal' ? (
+        <TextoVivo
+          style={[styles.estado, { color: colors.textSecondary }]}
+          numberOfLines={1}
+          texto={(ahora) => textoSinSenal(ultimoReporte ?? null, ahora)}
+        />
+      ) : (
+        <ThemedText style={[styles.estado, { color: colors[tono] }]} numberOfLines={1}>
+          {estado === 'marcha' ? 'En marcha' : 'Detenida'}
+          {estado === 'marcha' ? (
+            <ThemedText style={[styles.estado, { color: colors.text }]} tabular>{`  ${Math.round(velocidad)} km/h`}</ThemedText>
+          ) : null}
+        </ThemedText>
+      )}
+    </View>
+  );
+}
+
+/** Una opción de la fila rápida: su nombre, cuántas lleva y su color. */
+export type OpcionRapida<K extends string> = { id: K; label: string; cuenta: number; tono?: keyof ColorTokens };
+
+/**
+ * LAS PASTILLAS RÁPIDAS de arriba de la lista (Todas, En marcha, Detenidas,
+ * Sin señal, Con avisos): una sola elegida a la vez, con su cuenta. Los filtros
+ * finos (área, inspección, papeles, tipo…) siguen en la hoja del buscador.
+ */
+export function PastillasRapidas<K extends string>({
+  opciones,
+  valor,
+  onChange,
+}: {
+  opciones: OpcionRapida<K>[];
+  valor: K;
+  onChange: (k: K) => void;
+}) {
+  const { colors } = useTheme();
+  return (
+    <ScrollView
+      horizontal
+      showsHorizontalScrollIndicator={false}
+      contentContainerStyle={styles.pastillas}
+      accessibilityRole="tablist">
+      {opciones.map((o) => {
+        const activa = o.id === valor;
+        const color = o.tono ? colors[o.tono] : colors.text;
+        return (
+          <PressableScale
+            key={o.id}
+            onPress={() => onChange(o.id)}
+            accessibilityRole="tab"
+            accessibilityState={{ selected: activa }}
+            accessibilityLabel={`${o.label}, ${o.cuenta}`}>
+            <View
+              style={[
+                styles.pastilla,
+                {
+                  backgroundColor: activa ? colors.activeSurface : colors.surfaceSunken,
+                  borderColor: activa ? colors.activeBorder : colors.border,
+                },
+              ]}>
+              {o.tono ? <View style={[styles.pastillaPunto, { backgroundColor: color }]} /> : null}
+              <ThemedText style={[styles.pastillaTexto, { color: activa ? colors.onActive : colors.textSecondary }]}>
+                {o.label}
+              </ThemedText>
+              <ThemedText
+                tabular
+                style={[styles.pastillaCuenta, { color: activa ? colors.onActive : colors.textMuted }]}>
+                {String(o.cuenta)}
+              </ThemedText>
+            </View>
+          </PressableScale>
+        );
+      })}
+    </ScrollView>
+  );
+}
+
+const styles = StyleSheet.create({
+  tarjeta: {
+    height: TARJETA_ALTO,
+    flexDirection: 'row',
+    alignItems: 'center',
+    gap: 12,
+    paddingHorizontal: 12,
+    borderWidth: 1,
+  },
+  foto: { width: 96, height: 76, alignItems: 'center', justifyContent: 'center', overflow: 'hidden' },
+  textos: { flex: 1, minWidth: 0, gap: 5 },
+  fila: { flexDirection: 'row', alignItems: 'center', gap: 6, minWidth: 0 },
+  numero: { fontSize: 19, lineHeight: 24, fontWeight: '700', letterSpacing: -0.3, flexShrink: 0 },
+  placa: { fontSize: 13, lineHeight: 18, fontWeight: '600', letterSpacing: 0.4, flexShrink: 0 },
+  estado: { fontSize: 13, lineHeight: 18, fontWeight: '600', flexShrink: 1 },
+  gente: { gap: 5 },
+  detalle: { fontSize: 12.5, lineHeight: 17, fontWeight: '500', flexShrink: 1 },
+  zona: { flexShrink: 2 },
+  puntoArea: { width: 6, height: 6, borderRadius: 3, marginLeft: 4 },
+  pastillas: { gap: 8, paddingVertical: 2 },
+  pastilla: {
+    height: 36,
+    flexDirection: 'row',
+    alignItems: 'center',
+    gap: 7,
+    paddingHorizontal: 14,
+    borderRadius: 999,
+    borderWidth: 1,
+  },
+  pastillaPunto: { width: 7, height: 7, borderRadius: 4 },
+  pastillaTexto: { fontSize: 13, lineHeight: 18, fontWeight: '600' },
+  pastillaCuenta: { fontSize: 12, lineHeight: 16, fontWeight: '700' },
+});
