-/** Mínimo de una contraseña: el de fom-core (de 16 a 256 caracteres). */
-export const MIN_CLAVE = 16;
+/** Mínimo de una contraseña. fom-core debe aceptar el mismo mínimo: si exige más, rechazará la clave. */
+export const MIN_CLAVE = 5;
+export const MAX_CLAVE = 128;
+const CLAVES_COMUNES = ['password', 'contrasena', 'contraseña', 'qwerty', 'admin', 'clave', 'flotas', '12345', 'abcde', 'fom2026', 'samfor'];
 
 /**
- * Contraseña fuerte: al menos 16 caracteres, una mayúscula, un número y un
- * carácter especial.
+ * Contraseña: al menos 5 caracteres, con una mayúscula, un número y un símbolo, sin tres
+ * caracteres iguales seguidos, sin claves comunes y sin el correo adentro.
+ * (Misma regla que el panel web: fom/src/lib/clave.js.)
  */
-export function validarClave(valor: string): string | null {
+export function validarClave(valor: string, correo = ''): string | null {
   const v = valor;
   if (v.length < MIN_CLAVE) return `La contraseña debe tener al menos ${MIN_CLAVE} caracteres.`;
+  if (v.length > MAX_CLAVE) return `La contraseña no puede pasar de ${MAX_CLAVE} caracteres.`;
+  if (v !== v.trim()) return 'La contraseña no puede empezar ni terminar con espacios.';
   if (!/[A-Z]/.test(v)) return 'Incluye al menos una letra mayúscula.';
   if (!/\d/.test(v)) return 'Incluye al menos un número.';
   if (!/[^A-Za-z0-9]/.test(v)) return 'Incluye al menos un carácter especial (ej. !, @, #).';
+  if (/(.)\1\1/i.test(v)) return 'No repitas el mismo carácter tres veces seguidas.';
+  const bajo = v.toLowerCase();
+  if (CLAVES_COMUNES.some((c) => bajo.includes(c))) return 'Esa clave es demasiado común: elige otra.';
+  const usuario = correo.split('@')[0].toLowerCase();
+  if (usuario.length >= 3 && bajo.includes(usuario)) return 'La contraseña no puede contener tu correo.';
   return null;
 }
 
