@@ -0,0 +1,76 @@
+import { useId } from 'react';
+import { InputAccessoryView, Keyboard, Platform, Pressable, StyleSheet, View } from 'react-native';
+
+import { ThemedText } from '@/components/themed-text';
+import { useTheme } from '@/theme';
+
+/** Prefijo del `nativeID` de la barra «Listo» que lleva cada campo. */
+export const TECLADO_LISTO_ID = 'fom-teclado-listo';
+
+/**
+ * El `nativeID` de la barra de UN campo.
+ *
+ * No puede ser uno común para toda la app: en la arquitectura nueva, cada
+ * `InputAccessoryView` busca en la ventana el PRIMER campo con su id al
+ * montarse y se queda solo con ese. Con un id compartido, la barra saldría
+ * en un único campo de toda la app. Uno por campo y cada uno lleva la suya.
+ */
+export function useTecladoListoId(): string {
+  return `${TECLADO_LISTO_ID}-${useId()}`;
+}
+
+/**
+ * Barra «Listo» encima del teclado (solo iPhone).
+ *
+ * Es la forma obvia de bajar el teclado en cualquier campo: en los de varias
+ * líneas Enter hace salto de línea, y el teclado numérico ni siquiera tiene
+ * Enter. En Android no existe `InputAccessoryView`: allí se baja con el botón
+ * del sistema, tocando fuera o deslizando la lista.
+ */
+export function TecladoListo({ nativeID }: { nativeID: string }) {
+  const { colors, colorScheme, spacing, borderWidths } = useTheme();
+  if (Platform.OS !== 'ios') return null;
+  // En claro el azul FOM como texto sobre blanco no llega al contraste: ahí
+  // va el azul oscuro de «elegido» (lo mismo que hace la píldora).
+  const azul = colorScheme === 'light' ? colors.onActive : colors.primary;
+
+  return (
+    <InputAccessoryView nativeID={nativeID} backgroundColor={colors.surfaceElevated}>
+      <View
+        style={[
+          styles.barra,
+          {
+            backgroundColor: colors.surfaceElevated,
+            borderTopColor: colors.border,
+            borderTopWidth: borderWidths.thin,
+            paddingHorizontal: spacing.md,
+          },
+        ]}>
+        <Pressable
+          onPress={() => Keyboard.dismiss()}
+          hitSlop={8}
+          accessibilityRole="button"
+          accessibilityLabel="Listo, cerrar el teclado"
+          style={({ pressed }) => [styles.boton, { opacity: pressed ? 0.6 : 1 }]}>
+          <ThemedText variant="button" style={{ color: azul }}>
+            Listo
+          </ThemedText>
+        </Pressable>
+      </View>
+    </InputAccessoryView>
+  );
+}
+
+const styles = StyleSheet.create({
+  barra: {
+    height: 44,
+    flexDirection: 'row',
+    alignItems: 'center',
+    justifyContent: 'flex-end',
+  },
+  boton: {
+    height: 44,
+    justifyContent: 'center',
+    paddingHorizontal: 4,
+  },
+});
