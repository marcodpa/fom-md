+// ── Varios conductores de una unidad (principal y secundarios) ──────────────
+
+/** Lo que se sabe de UNA persona al pedir sus eventos. */
+export type EventosDePersona =
+  | {
+      estado: 'ok';
+      /** Del más nuevo al más viejo, tal como llegaron (sin filtrar). */
+      eventos: EventoManejo[];
+      /** Llegaron los 100 más recientes: puede haber más viejos en el período. */
+      tope: boolean;
+    }
+  /** La ruta no existe todavía en el servidor: no hay nada que pintar. */
+  | { estado: 'no-publicado' }
+  /** 404 «Driver not found»: la persona asignada ya no es conductor activo. */
+  | { estado: 'descartado' };
+
+/** Lo de todas las personas de una unidad, juntas. */
+export type EventosDeVarios =
+  | {
+      estado: 'ok';
+      /** Sin repetidos, del más nuevo al más viejo. */
+      eventos: EventoManejo[];
+      /** A alguno el servidor le cortó en 100: puede haber más viejos. */
+      tope: boolean;
+      /** Cuántos ya no son conductores activos (404): cuentan como sin eventos. */
+      descartados: number;
+      /** Cuántos no se pudieron leer (500, sin red) mientras otros sí. */
+      fallidos: number;
+    }
+  /** La ruta no existe para nadie (el servidor todavía no la publica). */
+  | { estado: 'no-publicado' };
+
+/** Del más nuevo al más viejo (a igual hora, por id); sin hora, al final. */
+const masNuevoPrimeroCualquiera = (a: EventoManejo, b: EventoManejo) =>
+  (msEvento(b) ?? -Infinity) - (msEvento(a) ?? -Infinity) || b.id.localeCompare(a.id);
+
+/**
+ * Los eventos de VARIOS conductores (los de una unidad), juntos: `pedidos` son
+ * las promesas, una por persona. Igual que `juntarDeVarios` de la web:
+ * - Un 404 de persona (`descartado`) cuenta como «sin eventos» y se anota en
+ *   `descartados` (va en una nota gris debajo de la lista).
+ * - Los demás errores solo hacen fallar el todo si no llegó nada de nadie; si
+ *   no, se anotan en `fallidos` y se enseña lo que sí llegó.
+ * - «Sin publicar» solo si la ruta no existe para NADIE; mezclado con otros que
+ *   sí respondieron, es uno que no se pudo leer.
+ */
+export async function juntarDeVarios(pedidos: readonly Promise<EventosDePersona>[]): Promise<EventosDeVarios> {
+  const resultados = await Promise.allSettled(pedidos);
+  const porId = new Map<string, EventoManejo>();
+  const sinId: EventoManejo[] = [];
+  let respondieron = 0;
+  let tope = false;
+  let descartados = 0;
+  let sinRuta = 0;
+  let fallidos = 0;
+  let primerError: unknown = null;
+  let hayError = false;
+  for (const r of resultados) {
+    if (r.status === 'rejected') {
+      fallidos += 1;
+      if (!hayError) primerError = r.reason;
+      hayError = true;
+    } else if (r.value.estado === 'descartado') descartados += 1;
+    else if (r.value.estado === 'no-publicado') sinRuta += 1;
+    else {
+      respondieron += 1;
+      tope ||= r.value.tope;
+      for (const e of r.value.eventos) {
+        if (!e) continue;
+        if (!e.id) sinId.push(e);
+        else if (!porId.has(e.id)) porId.set(e.id, e);
+      }
+    }
+  }
+  if (respondieron === 0 && descartados === 0) {
+    if (hayError) throw primerError;
+    if (sinRuta > 0) return { estado: 'no-publicado' };
+  }
+  return {
+    estado: 'ok',
+    eventos: [...porId.values(), ...sinId].sort(masNuevoPrimeroCualquiera),
+    tope,
+    descartados,
+    fallidos: fallidos + sinRuta,
+  };
+}
+
+/**
+ * La nota gris de debajo de la lista cuando alguien de la unidad no se pudo
+ * leer; '' si no hace falta. Mismos textos que la web (`CuerpoManejo`).
+ */
+export function notaDeVarios({ descartados = 0, fallidos = 0 }: { descartados?: number; fallidos?: number }): string {
+  return [
+    descartados > 0
+      ? descartados === 1
+        ? 'Una persona asignada ya no es conductor activo; sus eventos no se muestran.'
+        : `${miles(descartados)} personas asignadas ya no son conductores activos; sus eventos no se muestran.`
+      : '',
+    fallidos > 0
+      ? fallidos === 1
+        ? 'No se pudieron leer los eventos de un conductor asignado.'
+        : `No se pudieron leer los eventos de ${miles(fallidos)} conductores asignados.`
+      : '',
+  ]
+    .filter(Boolean)
+    .join(' ');
+}
+
 export type CuentaEventos = Record<TipoEvento, number>;
 
 /** Cuántos hay de cada tipo. */
