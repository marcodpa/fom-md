+  onHecho: () => void;
+}) {
+  const { colors, spacing, borderWidths } = useTheme();
+  // Manda el estado más reciente: el del detalle, si llegó.
+  const estadoFom = ejecucion?.estadoFom ?? orden.estadoFom;
+  return (
+    <View
+      style={{
+        gap: spacing.sm,
+        paddingVertical: spacing.md,
+        borderTopWidth: primera ? 0 : borderWidths.hairline,
+        borderTopColor: colors.border,
+      }}>
+      <PressableScale
+        onPress={onAbrir}
+        accessibilityRole="button"
+        accessibilityLabel={`Ver la ODT: ${orden.descripcion}, ${orden.vehicleLabel}`}>
+        <View style={[styles.fila, { gap: spacing.sm }]}>
+          <View style={[styles.flex1, { gap: 2 }]}>
+            <ThemedText variant="caption" color="textMuted" numberOfLines={1}>
+              {orden.vehicleLabel || 'Unidad'}
+            </ThemedText>
+            <ThemedText style={styles.ordenTitulo} numberOfLines={2}>
+              {orden.descripcion}
+            </ThemedText>
+          </View>
+          <TabIcon name="chevron" color={colors.textMuted} size={16} />
+        </View>
+      </PressableScale>
+      <View style={[styles.fila, { gap: spacing.sm }]}>
+        <Chip tone={otStatusColor(orden.estado)} label={ODT_ESTADO_LABEL[orden.estado]} dot />
+        <ThemedText variant="caption" color="textSecondary" style={styles.flex1} numberOfLines={1}>
+          {MOMENTO_TALLER[estadoFom] ?? ''}
+        </ThemedText>
+      </View>
+      {ejecucion ? <RelojOdt ejecucion={ejecucion} /> : null}
+      <AccionesOdtAsignada id={orden.id} estadoFom={estadoFom} onHecho={onHecho} />
+    </View>
+  );
+}
