+  const conOdt = filas.filter((v) => v.otAbiertas > 0).length;
+
+  // ── Operación de la flota (vista actual) + cifras del período. ──
+  const tramos = [
+    enMarcha > 0 ? `<span class="em" style="flex:${enMarcha}">${entero(enMarcha)}</span>` : '',
+    detenidas > 0 ? `<span class="hatch" style="flex:${detenidas}"><b>${entero(detenidas)}</b></span>` : '',
+  ].join('');
+  const cmpKm = comparar(m.kmRecorridos, ant?.metrics.kmRecorridos, { modo: 'pct', altoEsBueno: null });
+  const cmpEv = comparar(eventos, ant ? eventosDe(ant.metrics) : undefined, { modo: 'pct', altoEsBueno: false });
+  const par = (k: string, v: string, c?: Comparacion | null): string =>
+    `<div class="par"><span>${esc(k)}</span><b>${esc(v)}${c ? ` <em>${esc(comparacionTexto(c))}</em>` : ''}</b></div>`;
+  const pares = [
+    par('Km del período', `${entero(m.kmRecorridos)} km`, cmpKm),
