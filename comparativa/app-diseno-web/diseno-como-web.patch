+import { LinearGradient } from 'expo-linear-gradient';
+import { useEffect, useState, type ReactNode } from 'react';
+import { Animated, Easing, StyleSheet, View, type StyleProp, type ViewStyle } from 'react-native';
+import Svg, { Path } from 'react-native-svg';
+
+import { PressableScale } from '@/components/pressable-scale';
+import type { Alcance, Cifra, Formato, Resumen, Tono } from '@/components/reportes-datos';
+import { TabIcon, type TabIconName } from '@/components/tab-icon';
+import { ThemedText } from '@/components/themed-text';
+import { tinte } from '@/lib/color';
+import { useReducedMotion, useTheme, type ColorTokens } from '@/theme';
+
+/*
+ * Las PIEZAS de Reportes: la portada que flota, el riel de formatos, las filas
+ * de alcance, la franja «En pocas palabras» y lo que se repite en las cuatro
+ * pestañas (títulos de tarjeta, barras partidas, chips de filtro, filas).
+ */
+
+/** Alturas de las barras del mini-gráfico de la portada, en %. */
+const ALTOS = [40, 70, 55, 90];
+
+const ALCANCE_ICON: Record<Alcance, TabIconName> = {
+  general: 'empresa',
+  area: 'flota',
+  grupo: 'check',
+};
+
+export const ALCANCE_LABEL: Record<Alcance, string> = {
+  general: 'Toda la empresa',
+  area: 'Un área',
+  grupo: 'Los que yo elija',
+};
+
+/**
+ * VISTA PREVIA: qué documento va a salir, antes de generarlo.
+ *
+ * Una portada de PDF en miniatura —con la banda de la marca y un gráfico de
+ * barras— y, al lado, el título del formato con el período y el alcance
+ * elegidos. Se actualiza con cada toque.
+ *
+ * La portada FLOTA despacio. Es lo único que se mueve solo aquí, y dice "esto
+ * es un documento" mejor que cualquier rótulo.
+ */
+export function VistaPrevia({
+  titulo,
+  periodo,
+  alcance,
+  icon,
+}: {
+  titulo: string;
+  periodo: string;
+  alcance: string;
+  icon: TabIconName;
+}) {
+  const { colors, radii, spacing } = useTheme();
+  const reducido = useReducedMotion();
+  const marca = colors.primary;
+
+  // En un estado y no en una ref: el valor animado se lee al dibujar.
+  const [flote] = useState(() => new Animated.Value(0));
+  useEffect(() => {
+    if (reducido) return;
+    const anim = Animated.loop(
+      Animated.sequence([
+        Animated.timing(flote, { toValue: 1, duration: 2500, easing: Easing.inOut(Easing.ease), useNativeDriver: true }),
+        Animated.timing(flote, { toValue: 0, duration: 2500, easing: Easing.inOut(Easing.ease), useNativeDriver: true }),
+      ]),
+    );
+    anim.start();
+    return () => anim.stop();
+  }, [flote, reducido]);
+  const sube = flote.interpolate({ inputRange: [0, 1], outputRange: [0, -5] });
+
+  return (
+    <View
+      accessibilityLabel={`Vista previa: ${titulo}, ${periodo}, ${alcance}`}
+      style={[
+        styles.hero,
+        { borderColor: tinte(marca, 0.28), borderRadius: radii.xl, padding: spacing.md, gap: spacing.md },
+      ]}>
+      <LinearGradient
+        colors={[tinte(marca, 0.12), colors.surfaceSunken]}
+        locations={[0, 0.6]}
+        start={{ x: 0, y: 0 }}
+        end={{ x: 1, y: 1 }}
+        style={StyleSheet.absoluteFill}
+      />
+
+      <Animated.View style={[styles.portada, { transform: [{ translateY: sube }, { rotate: '-2deg' }] }]}>
+        <View style={[styles.hoja, { borderRadius: radii.md }]}>
+          <View style={[styles.hojaBanda, { backgroundColor: marca }]}>
+            <View style={styles.hojaPunto} />
+            <View style={styles.hojaRaya} />
+          </View>
+          <View style={styles.hojaCuerpo}>
+            <View style={[styles.hojaLinea, styles.hojaLineaLarga]} />
+            <View style={[styles.hojaLinea, styles.hojaLineaCorta]} />
+            <View style={styles.hojaBarras}>
+              {ALTOS.map((alto, i) => (
+                <View
+                  key={alto}
+                  style={[
+                    styles.hojaBarra,
+                    { height: `${alto}%`, backgroundColor: i === ALTOS.length - 1 ? marca : tinte(marca, 0.45) },
+                  ]}
+                />
+              ))}
+            </View>
+          </View>
+        </View>
+        <View
+          style={[styles.insignia, { backgroundColor: marca, borderColor: colors.surfaceSunken, borderRadius: radii.sm }]}>
+          <TabIcon name={icon} color={colors.onPrimary} size={13} />
+        </View>
+      </Animated.View>
+
+      <View style={[styles.flex1, styles.heroMeta]}>
+        <ThemedText variant="overline" style={{ color: marca }}>
+          Vista previa
+        </ThemedText>
+        <ThemedText style={styles.heroTitulo} numberOfLines={2}>
+          {titulo}
+        </ThemedText>
+        <View style={styles.heroChips}>
+          <Pastilla icon="calendario" texto={periodo} />
+          <Pastilla icon="personal" texto={alcance} />
+        </View>
+      </View>
+    </View>
+  );
+}
+
+/** Un dato de la vista previa: ícono y valor, sin rótulo. */
+export function Pastilla({ icon, texto }: { icon?: TabIconName; texto: string }) {
+  const { colors, radii } = useTheme();
+  return (
+    <View
+      style={[
+        styles.pastilla,
+        { backgroundColor: colors.surfaceElevated, borderColor: colors.border, borderRadius: radii.pill },
+      ]}>
+      {icon ? <TabIcon name={icon} color={colors.textMuted} size={11} /> : null}
+      <ThemedText variant="caption" color="textSecondary" numberOfLines={1} style={styles.pastillaTexto}>
+        {texto}
+      </ThemedText>
+    </View>
+  );
+}
+
+/**
+ * Una tarjeta del riel de formatos.
+ *
+ * Elegida, se tiñe entera y le sale un check arriba — el borde de color, solo,
+ * no se lee a la primera.
+ */
+export function TarjetaFormato({
+  formato,
+  activo,
+  onPress,
+  disabled,
+}: {
+  formato: Formato;
+  activo: boolean;
+  onPress: () => void;
+  disabled?: boolean;
+}) {
+  const { colors, radii, spacing } = useTheme();
+  const marca = colors.primary;
+  return (
+    <PressableScale
+      onPress={onPress}
+      disabled={disabled}
+      accessibilityRole="radio"
+      accessibilityState={{ selected: activo, disabled: !!disabled }}
+      accessibilityLabel={`${formato.label}. ${formato.trae}`}>
+      <View
+        style={[
+          styles.tarjeta,
+          {
+            backgroundColor: colors.surface,
+            borderColor: activo ? marca : colors.border,
+            borderRadius: radii.lg,
+            padding: spacing.lg,
+            gap: spacing.lg,
+            opacity: disabled ? 0.5 : 1,
+          },
+        ]}>
+        {activo ? (
+          <LinearGradient
+            colors={[tinte(marca, 0.16), colors.surface]}
+            locations={[0, 0.7]}
+            start={{ x: 0.2, y: 0 }}
+            end={{ x: 0.9, y: 1 }}
+            style={StyleSheet.absoluteFill}
+          />
+        ) : null}
+
+        <View
+          style={[
+            styles.tarjetaIcono,
+            { backgroundColor: activo ? marca : colors.surfaceElevated, borderRadius: radii.md },
+          ]}>
+          <TabIcon name={formato.icon} color={activo ? colors.onPrimary : colors.textMuted} size={20} />
+        </View>
+        <ThemedText variant="button" color={activo ? 'text' : 'textSecondary'} numberOfLines={2}>
+          {formato.label}
+        </ThemedText>
+
+        {activo ? (
+          <View style={[styles.check, { backgroundColor: marca, borderRadius: radii.pill }]}>
+            <TabIcon name="check" color={colors.onPrimary} size={11} />
+          </View>
+        ) : null}
+      </View>
+    </PressableScale>
+  );
+}
+
+/** Un alcance: ícono, nombre y el punto que dice cuál está puesto. */
+export function FilaAlcance({
+  alcance,
+  activo,
+  onPress,
+  disabled,
+}: {
+  alcance: Alcance;
+  activo: boolean;
+  onPress: () => void;
+  disabled?: boolean;
+}) {
+  const { colors, radii, spacing } = useTheme();
+  const marca = colors.primary;
+  return (
+    <PressableScale
+      onPress={onPress}
+      disabled={disabled}
+      accessibilityRole="radio"
+      accessibilityState={{ selected: activo, disabled: !!disabled }}
+      accessibilityLabel={ALCANCE_LABEL[alcance]}>
+      <View
+        style={[
+          styles.filaAlcance,
+          {
+            backgroundColor: activo ? tinte(marca, 0.1) : colors.surface,
+            borderColor: activo ? marca : colors.border,
+            borderRadius: radii.lg,
+            padding: spacing.md,
+            gap: spacing.md,
+            opacity: disabled ? 0.5 : 1,
+          },
+        ]}>
+        <View
+          style={[
+            styles.alcanceIcono,
+            { backgroundColor: activo ? tinte(marca, 0.18) : colors.surfaceElevated, borderRadius: radii.md },
+          ]}>
+          <TabIcon name={ALCANCE_ICON[alcance]} color={activo ? marca : colors.textMuted} size={18} />
+        </View>
+        <ThemedText variant="body" color={activo ? 'text' : 'textSecondary'} style={styles.flex1} numberOfLines={1}>
+          {ALCANCE_LABEL[alcance]}
+        </ThemedText>
+        <View
+          style={[
+            styles.radio,
+            { borderColor: activo ? marca : colors.borderStrong, backgroundColor: activo ? marca : 'transparent' },
+          ]}>
+          {activo ? <View style={[styles.radioPunto, { backgroundColor: colors.onPrimary }]} /> : null}
+        </View>
+      </View>
+    </PressableScale>
+  );
+}
+
+/** Aspa para cerrar una capa (no hay "volver": es una capa, no una pila). */
+export function BotonCerrar({ onPress, label }: { onPress: () => void; label: string }) {
+  const { colors, radii } = useTheme();
+  return (
+    <PressableScale
+      onPress={onPress}
+      accessibilityRole="button"
+      accessibilityLabel={label}
+      style={[styles.cerrar, { backgroundColor: colors.surfaceElevated, borderRadius: radii.md }]}>
+      <TabIcon name="cerrar" color={colors.textSecondary} size={19} />
+    </PressableScale>
+  );
+}
+
+// ───────────────────────── En pocas palabras ───────────────────────────────
+
+/** El triángulo de ▲▼: dice hacia dónde fue la cifra sin depender del color. */
+export function Triangulo({ sube, color, size = 9 }: { sube: boolean; color: string; size?: number }) {
+  return (
+    <Svg width={size} height={size} viewBox="0 0 10 10">
+      <Path d={sube ? 'M5 1.5 9 8.5H1z' : 'M5 8.5 1 1.5h8z'} fill={color} />
+    </Svg>
+  );
+}
+
+/** El color de un cambio: verde si es bueno, rojo si es malo, azul si no es ni lo uno ni lo otro. */
+function colorDelta(favorable: boolean | null, colors: ColorTokens): string {
+  if (favorable === true) return colors.success;
+  if (favorable === false) return colors.danger;
+  return colors.onActive;
+}
+
+/** Una cifra con su cambio contra el período anterior. */
+function CifraVista({ cifra }: { cifra: Cifra }) {
+  const { colors } = useTheme();
+  const d = cifra.delta;
+  const color = d ? colorDelta(d.favorable, colors) : colors.textMuted;
+  const lectura = [
+    cifra.ahora
+      ? 'vista actual, sin comparar'
+      : d
+        ? d.sentido === 'igual'
+          ? `sin cambio, antes ${d.antes}`
+          : `${d.texto} que antes, antes ${d.antes}`
+        : cifra.nota
+          ? ''
+          : 'sin comparación',
+    cifra.nota ?? '',
+  ]
+    .filter(Boolean)
+    .join(', ');
+  return (
+    <View
+      style={styles.cifra}
+      accessible
+      accessibilityLabel={`${cifra.label}: ${cifra.valor}${cifra.unidad ? ` ${cifra.unidad}` : ''}, ${lectura}`}>
+      <ThemedText variant="caption" color="textSecondary" numberOfLines={1}>
+        {cifra.label}
+      </ThemedText>
+      <ThemedText tabular style={styles.cifraValor} numberOfLines={1} color={cifra.tono ?? 'text'}>
+        {cifra.valor}
+        {cifra.unidad ? <ThemedText style={styles.cifraUnidad} color="textSecondary">{` ${cifra.unidad}`}</ThemedText> : null}
+      </ThemedText>
+      {cifra.ahora ? (
+        <View style={styles.deltaFila}>
+          <ThemedText style={[styles.deltaTexto, { color: colors.onActive }]}>Ahora</ThemedText>
+          <ThemedText style={[styles.deltaAntes, { color: colors.textMuted }]}>sin comparar</ThemedText>
+        </View>
+      ) : d ? (
+        <View style={styles.deltaFila}>
+          {d.sentido === 'igual' ? null : <Triangulo sube={d.sentido === 'sube'} color={color} />}
+          <ThemedText style={[styles.deltaTexto, { color }]} numberOfLines={1}>
+            {d.texto}
+          </ThemedText>
+          <ThemedText style={[styles.deltaAntes, { color: colors.textMuted }]} numberOfLines={1}>
+            {`antes ${d.antes}`}
+          </ThemedText>
+        </View>
+      ) : cifra.nota ? null : (
+        <ThemedText style={[styles.deltaAntes, { color }]}>sin comparación</ThemedText>
+      )}
+      {/* El porqué de un «—», o el detalle que acompaña a la cifra. */}
+      {cifra.nota ? (
+        <ThemedText style={[styles.deltaAntes, { color: colors.textMuted }]} numberOfLines={2}>
+          {cifra.nota}
+        </ThemedText>
+      ) : null}
+    </View>
+  );
+}
+
+/**
+ * «EN POCAS PALABRAS»: la frase que resume la pestaña y sus cuatro cifras,
+ * cada una con ▲▼ frente al período anterior. Lo de AHORA lo dice y no se
+ * compara.
+ */
+export function TarjetaResumen({ resumen }: { resumen: Resumen }) {
+  const { colors, spacing } = useTheme();
+  return (
+    <Tarjeta style={{ gap: spacing.sm }}>
+      <View style={styles.hd}>
+        <ThemedText variant="overline" color="textMuted">
+          En pocas palabras
+        </ThemedText>
+        <ThemedText variant="caption" color="textMuted" numberOfLines={2} style={styles.comparado}>
+          {`Se compara con ${resumen.comparadoCon}`}
+        </ThemedText>
+      </View>
+      <ThemedText style={styles.frase}>
+        {resumen.frase.map((t, i) => (
+          <ThemedText key={`${i}${t.texto}`} style={styles.frase} color={t.tono ?? 'text'}>
+            {t.texto}
+          </ThemedText>
+        ))}
+      </ThemedText>
+      <View style={[styles.cifras, { borderTopColor: colors.border, paddingTop: spacing.md, marginTop: spacing.xs }]}>
+        {resumen.cifras.map((c) => (
+          <CifraVista key={c.label} cifra={c} />
+        ))}
+      </View>
+    </Tarjeta>
+  );
+}
+
+// ───────────────────────── Piezas de las pestañas ──────────────────────────
+
+/** La tarjeta de Reportes: la del tema, con el relleno de la app (16). */
+export function Tarjeta({ children, style }: { children: ReactNode; style?: StyleProp<ViewStyle> }) {
+  const { colors, radii, spacing } = useTheme();
+  return (
+    <View
+      style={[
+        styles.tarjetaBase,
+        { backgroundColor: colors.surface, borderColor: colors.border, borderRadius: radii.lg, padding: spacing.lg },
+        style,
+      ]}>
+      {children}
+    </View>
+  );
+}
+
+/** Título de tarjeta (15/600, en frase normal) con algo a la derecha. */
+export function TituloTarjeta({ titulo, derecha }: { titulo: string; derecha?: ReactNode }) {
+  return (
+    <View style={styles.hd}>
+      <ThemedText style={styles.titulo} accessibilityRole="header" numberOfLines={1}>
+        {titulo}
+      </ThemedText>
+      {derecha}
+    </View>
+  );
+}
+
+/** «Ahora»: esto es de este momento, no del período. */
+export function EtiquetaAhora() {
+  const { colors, radii } = useTheme();
+  return (
+    <View style={[styles.etiqueta, { backgroundColor: colors.infoSurface, borderRadius: radii.sm }]}>
+      <View style={[styles.etiquetaPunto, { backgroundColor: colors.onActive }]} />
+      <ThemedText style={[styles.etiquetaTexto, { color: colors.onActive }]}>Ahora</ThemedText>
+    </View>
+  );
+}
+
+/** Un enlace de texto («Ver las ODT →»). */
+export function Enlace({ label, onPress }: { label: string; onPress: () => void }) {
+  const { colors } = useTheme();
+  return (
+    <PressableScale onPress={onPress} hitSlop={8} accessibilityRole="link" accessibilityLabel={label}>
+      <ThemedText style={[styles.enlace, { color: colors.onActive }]} numberOfLines={1}>
+        {`${label} →`}
+      </ThemedText>
+    </PressableScale>
+  );
+}
+
+export type Parte = { valor: number; color: string; texto?: string };
+
+/**
+ * Una barra partida: cada parte con su ancho y, si cabe, su cifra dentro.
+ * Las partes en cero no se dibujan.
+ */
+export function BarraPartes({ partes, alto = 32, etiqueta }: { partes: Parte[]; alto?: number; etiqueta: string }) {
+  const { colors, radii } = useTheme();
+  const total = partes.reduce((a, p) => a + p.valor, 0);
+  return (
+    <View accessible accessibilityRole="image" accessibilityLabel={etiqueta} style={[styles.barra, { height: alto }]}>
+      {total <= 0 ? (
+        <View style={[styles.flex1, { backgroundColor: colors.borderStrong, borderRadius: radii.sm }]} />
+      ) : (
+        partes
+          .filter((p) => p.valor > 0)
+          .map((p, i) => (
+            <View
+              key={`${i}${p.color}`}
+              style={[
+                styles.barraParte,
+                { flexGrow: p.valor, backgroundColor: p.color, borderRadius: alto >= 20 ? radii.sm : alto / 2 },
+              ]}>
+              {p.texto && alto >= 20 ? (
+                <ThemedText tabular numberOfLines={1} style={[styles.barraTexto, { color: colors.onPrimary }]}>
+                  {p.texto}
+                </ThemedText>
+              ) : null}
+            </View>
+          ))
