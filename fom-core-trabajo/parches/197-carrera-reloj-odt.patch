+          test "$(psql -h localhost -U fom_core_ci -d fom_core_ci -tAc "SELECT prosrc LIKE '%NEW.status_changed_at = NEW.created_at%' FROM pg_proc WHERE oid = 'fom.maintain_work_order_record()'::regprocedure")" = "f"
