diff --git a/test/mobile-inspection-assigned-read.test.js b/test/mobile-inspection-assigned-read.test.js
new file mode 100644
index 0000000..3881432
--- /dev/null
+++ b/test/mobile-inspection-assigned-read.test.js
@@ -0,0 +1,131 @@
+'use strict';
+
+// T-72: el conductor lee inspecciones SOLO de las unidades que tiene
+// asignadas, para saber si la inspección diaria de hoy ya la hizo otra
+// persona. Otra unidad: fuera de la lista y 404 en el detalle, sin consultar
+// hallazgos. Los demás roles conservan su alcance.
+
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { Reflector } = require('@nestjs/core');
+const {
+  runWithActorStore,
+  setCurrentActor,
+} = require('../dist/authentication/actor-context.js');
+const {
+  ConsoleOperationsService,
+} = require('../dist/console-api/console-operations.service.js');
+const {
+  MobileOperationsReadGuard,
+} = require('../dist/mobile/mobile-operations-read.guard.js');
+const {
+  MobileOperationsController,
+} = require('../dist/mobile/mobile-operations.controller.js');
+
+const TENANT = '10000000-0000-4000-8000-000000000001';
+const USER = '20000000-0000-4000-8000-000000000001';
+const INSPECTION = '30000000-0000-4000-8000-000000000001';
+const QUERY = { limit: 50, offset: 0 };
+
+function database(headerRows = []) {
+  const calls = [];
+  const client = {
+    async query(text, values) {
+      calls.push({ text, values });
+      if (text.includes('FROM fom.inspections inspection')) return { rows: headerRows };
+      return { rows: [] };
+    },
+    release() {},
+  };
+  return {
+    calls,
+    getPool: () => ({ connect: async () => client }),
+    query: (text, values) => client.query(text, values),
+  };
+}
+
+function as(role, body, platformAdmin = false) {
+  return runWithActorStore(async () => {
+    setCurrentActor({ userId: USER, tenantId: TENANT, role, platformAdmin });
+    return body();
+  });
+}
+
+test('puerta móvil: conductor y usuario básico cruzan solo las dos lecturas de inspección', () => {
+  const guard = new MobileOperationsReadGuard(new Reflector());
+  const proto = MobileOperationsController.prototype;
+  const context = (handler, role) => ({
+    getHandler: () => handler,
+    switchToHttp: () => ({
+      getRequest: () => ({
+        method: 'GET',
+        fomMobileActor: { userId: USER, tenantId: TENANT, role, platformAdmin: false },
+      }),
+    }),
+  });
+  for (const role of ['conductor', 'usuario', 'operator', 'supervisor']) {
+    assert.equal(guard.canActivate(context(proto.listInspections, role)), true, role);
+    assert.equal(guard.canActivate(context(proto.getInspection, role)), true, role);
+  }
+  // Una lectura agregada sin la marca sigue cerrada para el conductor.
+  assert.throws(
+    () => guard.canActivate(context(proto.listNotifications, 'conductor')),
+    (error) => error.getStatus() === 403,
+  );
+});
+
+test('la lista del conductor se acota a sus unidades con asignación vigente', async () => {
+  const db = database();
+  await as('conductor', () => new ConsoleOperationsService(db, {}).listInspections(QUERY, undefined, true));
+  const [call] = db.calls;
+  assert.deepEqual(call.values, [TENANT, null, 50, 0, false, USER]);
+  assert.match(call.text, /FROM fom\.vehicle_driver_assignments assignment/u);
+  assert.match(call.text, /assignment\.vehicle_id = inspection\.vehicle_id/u);
+  assert.match(call.text, /assignment\.user_id = \$6/u);
+  assert.match(call.text, /assignment\.valid_to > statement_timestamp\(\)/u);
+});
+
+test('alcance por rol: conductor siempre acotado; usuario solo en móvil; gestión completa', async () => {
+  const cases = [
+    ['conductor', true, false],
+    ['conductor', false, false],
+    ['usuario', true, false],
+    ['usuario', false, true],
+    ['operator', true, true],
+    ['supervisor', true, true],
+    ['admin_fom', true, true],
+  ];
+  for (const [role, assignedOnly, unrestricted] of cases) {
+    const db = database();
+    await as(role, () => new ConsoleOperationsService(db, {}).listInspections(QUERY, undefined, assignedOnly));
+    assert.equal(db.calls[0].values[4], unrestricted, `${role} assignedOnly=${assignedOnly}`);
+  }
+  const platform = database();
+  await as('conductor', () => new ConsoleOperationsService(platform, {}).listInspections(QUERY, undefined, true), true);
+  assert.equal(platform.calls[0].values[4], true);
+});
+
+test('detalle de otra unidad: 404 sin consultar hallazgos ni evidencia', async () => {
+  const db = database([]);
+  await assert.rejects(
+    () => as('conductor', () => new ConsoleOperationsService(db, {}).getInspection(INSPECTION, undefined, true)),
+    (error) => error.status === 404,
+  );
+  const header = db.calls.find(({ text }) => text.includes('FROM fom.inspections inspection'));
+  assert.deepEqual(header.values, [TENANT, INSPECTION, false, USER]);
+  assert.match(header.text, /FROM fom\.vehicle_driver_assignments assignment/u);
+  assert.equal(
+    db.calls.some(({ text }) => /inspection_answers|evidence/u.test(text) && !text.includes('FROM fom.inspections inspection')),
+    false,
+  );
+  assert.equal(db.calls.at(-1).text, 'ROLLBACK');
+});
+
+test('detalle de una unidad asignada se sirve con el mismo filtro', async () => {
+  const db = database([{ id: INSPECTION, vehicleId: TENANT }]);
+  const result = await as('conductor', () =>
+    new ConsoleOperationsService(db, {}).getInspection(INSPECTION, undefined, true));
+  assert.equal(result.id ?? result.inspection?.id, INSPECTION);
+  const header = db.calls.find(({ text }) => text.includes('FROM fom.inspections inspection'));
+  assert.deepEqual(header.values, [TENANT, INSPECTION, false, USER]);
+});
