+import { useEffect, useState, type ReactNode } from 'react';
+import { Animated, Easing, StyleSheet, View } from 'react-native';
+
+import { Card } from '@/components/card';
+import { ODT_ESTADO_LABEL, otStatusColor } from '@/components/ot-status-badge';
+import { PressableScale } from '@/components/pressable-scale';
+import { PulseDot } from '@/components/pulse-dot';
+import { TabIcon, type TabIconName } from '@/components/tab-icon';
+import { ThemedText } from '@/components/themed-text';
+import type { AccionMantenimiento, AccionRelevancia } from '@/services';
+import { tinte } from '@/lib/color';
+import { useReducedMotion, useTheme, type ColorTokens } from '@/theme';
+import type { FaultType, OdtEstado, OdtGravedad, OdtTipo } from '@/types';
+import { formatFecha } from '@/utils/date';
+import { etiquetaFalla } from '@/utils/odt';
+
+/** De la más nueva a la más vieja, por cuándo se reportó; lo que no trae fecha, al final. */
+export function masNuevasPrimero<T>(lista: T[], fecha: (x: T) => string | null | undefined): T[] {
+  const ms = (x: T) => {
+    const t = Date.parse(fecha(x) ?? '');
+    return Number.isFinite(t) ? t : -Infinity;
+  };
+  return [...lista].sort((a, b) => {
+    const ta = ms(a);
+    const tb = ms(b);
+    return ta === tb ? 0 : tb - ta;
+  });
+}
+
+/**
+ * LA TARJETA DE MANTENIMIENTO: la misma en todas las listas (conductor,
+ * supervisor y «Asignadas a ti»), con la vista por grupos o en lista. Marco la
+ * eligió de la pestaña del conductor: ícono del servicio en su cuadro teñido,
+ * título grande, punto que late si está vencida (o la flecha si no), la
+ * descripción en gris y abajo el estado, la prioridad y la fecha.
+ *
+ * El tono no se grita: entra por el borde, por un halo que nace en el canto
+ * izquierdo y por el anillo del ícono.
+ */
+
+/**
+ * Ícono por servicio, deducido del título. El servicio no viene tipado (los
+ * títulos los arma el motor de mantenimiento), así que se busca por palabra
+ * clave y lo que no encaje cae en la llave inglesa.
+ */
+export function iconoServicio(titulo: string): TabIconName {
+  const t = titulo.toLowerCase();
+  if (t.includes('freno')) return 'frenos';
+  if (t.includes('aceite') || t.includes('filtro')) return 'aceite';
+  if (t.includes('neumátic') || t.includes('neumatic') || t.includes('llanta') || t.includes('rueda')) {
+    return 'neumatico';
+  }
+  if (t.includes('batería') || t.includes('bateria') || t.includes('eléctric') || t.includes('electric')) {
+    return 'electrico';
+  }
+  if (t.includes('motor') || t.includes('correa') || t.includes('bujía') || t.includes('bujia')) return 'motor';
+  if (t.includes('suspensión') || t.includes('suspension') || t.includes('carroc')) return 'carroceria';
+  return 'ot';
+}
+
+const PRIORIDAD_LABEL: Record<AccionRelevancia | OdtGravedad, string> = { alta: 'Alta', media: 'Media', baja: 'Baja' };
+
+/** La prioridad en su píldora: Alta roja, Media amarilla, Baja azul. */
+export function pastillaPrioridad(p: AccionRelevancia | OdtGravedad): PastillaTarjeta {
+  return { label: PRIORIDAD_LABEL[p], tono: p === 'alta' ? 'danger' : p === 'media' ? 'warning' : 'info' };
+}
+
+/**
+ * En qué anda una acción, DICHO como se lee. Vencida manda sobre pendiente:
+ * es la misma cosa, un escalón más tarde (y debajo de VENCIDAS no puede decir
+ * «Pendiente»).
+ */
+function estadoDeAccion(a: AccionMantenimiento): PastillaTarjeta {
+  if (a.estado === 'realizada') return { label: 'Realizada', tono: 'success', conPunto: true };
+  if (a.estado === 'en_proceso') return { label: 'En proceso', tono: 'info', conPunto: true };
+  if (a.vencida) return { label: 'Vencida', tono: 'danger', conPunto: true };
+  return { label: 'Pendiente', tono: 'warning', conPunto: true };
+}
+
+/**
+ * Color de la acción: lo realizado se apaga, lo que está en taller es
+ * informativo, y lo demás habla por su urgencia real — una vencida es urgente
+ * aunque la hayan reportado como relevancia baja.
+ */
+function tonoDeAccion(a: AccionMantenimiento): keyof ColorTokens {
+  if (a.estado === 'realizada') return 'success';
+  if (a.estado === 'en_proceso') return 'info';
+  if (a.vencida) return 'danger';
+  return pastillaPrioridad(a.relevancia).tono;
+}
+
+/**
+ * Una acción de mantenimiento (preventivo, predictivo o la ODT de una falla)
+ * en su tarjeta. `antes` va delante de la descripción: la unidad, en las
+ * listas del supervisor, que mira toda la flota.
+ */
+export function TarjetaAccion({
+  accion,
+  antes,
+  onPress,
+}: {
+  accion: AccionMantenimiento;
+  antes?: string;
+  onPress: () => void;
+}) {
+  const hecha = accion.estado === 'realizada';
+  const estado = estadoDeAccion(accion);
+  return (
+    <TarjetaMantenimiento
+      icono={iconoServicio(accion.titulo)}
+      tono={tonoDeAccion(accion)}
+      titulo={accion.titulo}
+      descripcion={[antes, accion.detalle].filter(Boolean).join(' · ')}
+      progreso={accion.progreso}
+      descripcionUrgente={accion.vencida}
+      estado={estado}
+      // Una vez hecha, su urgencia ya no dice nada.
+      prioridad={hecha ? undefined : pastillaPrioridad(accion.relevancia)}
+      fecha={accion.creadaEn}
+      urgente={accion.vencida && !hecha}
+      apagada={hecha}
+      onPress={onPress}
+      accessibilityLabel={`${accion.titulo}${antes ? `, ${antes}` : ''}, ${estado.label}`}
+    />
+  );
+}
+
+/** Lo que hace falta de una ODT para su tarjeta (sirve la del listado y la asignada). */
+export type OdtParaTarjeta = {
+  descripcion: string;
+  estado: OdtEstado;
+  tipo?: OdtTipo;
+  tipoFalla?: FaultType;
+  parteFalla?: string;
+  gravedad?: OdtGravedad;
+  creadaEn?: string | null;
+};
+
+/**
+ * Una ODT en la misma tarjeta: «Falla: Eléctrico» de título si se sabe qué
+ * falló (como la ve el conductor), la unidad y lo reportado debajo, su estado
+ * en las tres palabras, la prioridad y la fecha. Sin atender (abierta), late.
+ */
+export function TarjetaOdt({
+  orden,
+  unidad,
+  onPress,
+  children,
+}: {
+  orden: OdtParaTarjeta;
+  unidad?: string;
+  onPress: () => void;
+  children?: ReactNode;
+}) {
+  const falla = etiquetaFalla(orden.tipoFalla, orden.parteFalla);
+  const titulo = falla ? `Falla: ${falla}` : orden.descripcion;
+  const resuelta = orden.estado === 'cerrada';
+  const estado: PastillaTarjeta = { label: ODT_ESTADO_LABEL[orden.estado], tono: otStatusColor(orden.estado), conPunto: true };
+  return (
+    <TarjetaMantenimiento
+      icono={falla ? iconoServicio(falla) : orden.tipo === 'preventiva' ? 'aceite' : 'ot'}
+      tono={otStatusColor(orden.estado)}
+      titulo={titulo}
+      descripcion={[unidad, falla ? orden.descripcion : orden.tipo === 'preventiva' ? 'Preventiva' : 'Correctiva']
+        .filter(Boolean)
+        .join(' · ')}
+      estado={estado}
+      prioridad={!resuelta && orden.gravedad ? pastillaPrioridad(orden.gravedad) : undefined}
+      fecha={orden.creadaEn}
+      urgente={orden.estado === 'abierta'}
+      apagada={resuelta}
+      onPress={onPress}
+      accessibilityLabel={`${titulo}${unidad ? `, ${unidad}` : ''}, ${estado.label}`}>
+      {children}
+    </TarjetaMantenimiento>
+  );
+}
+
+export type PastillaTarjeta = { label: string; tono: keyof ColorTokens; conPunto?: boolean };
+
+type Props = {
+  icono: TabIconName;
+  /** El color de la tarjeta: borde, halo y cuadro del ícono. */
+  tono: keyof ColorTokens;
+  titulo: string;
+  descripcion?: string;
+  /** Consumo del intervalo de servicio (solo preventivos): pinta la barra. */
+  progreso?: number;
+  /** La descripción en el color de la tarjeta (lo vencido de km). */
+  descripcionUrgente?: boolean;
+  estado: PastillaTarjeta;
+  prioridad?: PastillaTarjeta;
+  /** ISO: la fecha en que se reportó o se generó. */
+  fecha?: string | null;
+  /** Vencida o sin atender: el punto late en vez de la flecha. */
+  urgente?: boolean;
+  /** Lo ya resuelto se atenúa. */
+  apagada?: boolean;
+  onPress: () => void;
+  accessibilityLabel: string;
+  /** Lo que va debajo, fuera del toque de la tarjeta (el reloj y los botones de una ODT asignada). */
+  children?: ReactNode;
+};
+
+export function TarjetaMantenimiento({
+  icono,
+  tono,
+  titulo,
+  descripcion,
+  progreso,
+  descripcionUrgente,
+  estado,
+  prioridad,
+  fecha,
+  urgente,
+  apagada,
+  onPress,
+  accessibilityLabel,
+  children,
+}: Props) {
+  const { colors, spacing, radii } = useTheme();
+  const color = colors[tono];
+
+  return (
+    <Card
+      style={[
+        styles.tarjeta,
+        { borderColor: tinte(color, 0.2), borderRadius: radii.lg, opacity: apagada ? 0.66 : 1 },
+      ]}>
+      {/* Halo del tono, naciendo en el canto izquierdo. */}
+      <LinearGradient
+        colors={[tinte(color, 0.08), 'transparent']}
+        start={{ x: 0, y: 0.5 }}
+        end={{ x: 1, y: 0.5 }}
+        style={styles.halo}
+        pointerEvents="none"
+      />
+
+      <PressableScale onPress={onPress} accessibilityRole="button" accessibilityLabel={accessibilityLabel}>
+        <View style={{ padding: spacing.md, gap: spacing.sm }}>
+          <View style={[styles.filaTitulo, { gap: spacing.sm }]}>
+            {/* Ícono del servicio: capa del tono y su anillo. */}
+            <View style={[styles.icono, { borderRadius: radii.md }]}>
+              <View style={[StyleSheet.absoluteFill, { backgroundColor: color, opacity: 0.14, borderRadius: radii.md }]} />
+              <View
+                style={[
+                  StyleSheet.absoluteFill,
+                  { borderColor: color, opacity: 0.22, borderWidth: 1, borderRadius: radii.md },
+                ]}
+              />
+              <TabIcon name={icono} color={color} size={19} />
+            </View>
+            <ThemedText variant="subtitle" style={styles.flex1} numberOfLines={2}>
+              {titulo}
+            </ThemedText>
+            {/* Vencida: late. Lo demás: la flecha de que se abre. */}
+            <View style={styles.marcaDerecha}>
+              {urgente ? <PulseDot color={color} size={8} /> : <TabIcon name="chevron" color={colors.textMuted} size={19} />}
+            </View>
+          </View>
+
+          {/* El dato técnico manda: km del intervalo, con su barra. */}
+          {progreso != null ? (
+            <View style={{ gap: 6 }}>
+              <BarraIntervalo progreso={progreso} tone={tono} />
+              {descripcion ? (
+                <ThemedText variant="caption" color={descripcionUrgente ? tono : 'textSecondary'} tabular numberOfLines={1}>
+                  {descripcion}
+                </ThemedText>
+              ) : null}
+            </View>
+          ) : descripcion ? (
+            <ThemedText variant="caption" color="textSecondary" numberOfLines={2}>
+              {descripcion}
+            </ThemedText>
+          ) : null}
+
+          <View style={[styles.fila, { gap: spacing.sm }]}>
+            <Pildora {...estado} />
+            {prioridad ? <Pildora {...prioridad} /> : null}
+            <View style={styles.flex1} />
+            {fecha ? (
+              <ThemedText variant="caption" color="textMuted" tabular numberOfLines={1}>
+                {formatFecha(fecha)}
+              </ThemedText>
+            ) : null}
+          </View>
+        </View>
+      </PressableScale>
+
+      {children ? <View style={{ paddingHorizontal: spacing.md, paddingBottom: spacing.md, gap: spacing.sm }}>{children}</View> : null}
+    </Card>
+  );
+}
+
+/** Píldora de estado o prioridad: punto opcional + palabra, teñidos. */
+function Pildora({ tono, label, conPunto }: PastillaTarjeta) {
+  const { colors, radii } = useTheme();
+  const color = colors[tono];
+  return (
+    <View style={[styles.pildora, { borderRadius: radii.pill }]}>
+      <View style={[StyleSheet.absoluteFill, { backgroundColor: color, opacity: 0.12, borderRadius: radii.pill }]} />
+      {conPunto ? <View style={[styles.punto, { backgroundColor: color }]} /> : null}
+      <ThemedText variant="caption" style={[styles.pildoraTexto, { color }]} numberOfLines={1}>
+        {label}
+      </ThemedText>
+    </View>
+  );
+}
+
+/**
+ * El intervalo se dibuja hasta 1.33 para que lo VENCIDO se vea pasando la marca
+ * de "toca ahora" (que queda al 75% de la barra) en vez de toparse al final.
+ */
+const ESCALA_PROGRESO = 1.33;
+const MARCA_SERVICIO = 1 / ESCALA_PROGRESO;
+
+/** Barra del intervalo de servicio: se llena al entrar y marca el punto de servicio. */
+function BarraIntervalo({ progreso, tone }: { progreso: number; tone: keyof ColorTokens }) {
+  const { colors, radii } = useTheme();
+  const reduced = useReducedMotion();
+  const destino = Math.max(0.02, Math.min(1, progreso / ESCALA_PROGRESO));
+  // En el estado, no en una ref: leer `.current` al pintar lo prohíbe el React Compiler.
+  const [t] = useState(() => new Animated.Value(reduced ? destino : 0));
+
+  useEffect(() => {
+    if (reduced) {
+      t.setValue(destino);
+      return;
+    }
+    const anim = Animated.timing(t, {
+      toValue: destino,
+      duration: 620,
+      delay: 120,
+      easing: Easing.out(Easing.cubic),
+      useNativeDriver: true,
+    });
+    anim.start();
+    return () => anim.stop();
+  }, [t, destino, reduced]);
+
+  return (
+    <View style={[styles.pista, { backgroundColor: colors.surfaceSunken, borderRadius: radii.pill }]}>
+      <Animated.View
+        style={[
+          styles.relleno,
+          {
+            backgroundColor: colors[tone],
+            borderRadius: radii.pill,
+            // Crece desde la izquierda por el hilo nativo (sin animar layout).
+            transformOrigin: 'left',
+            transform: [{ scaleX: t }],
+          },
+        ]}
+      />
+      {/* Marca del servicio: cruzarla es ir vencido. */}
+      <View style={[styles.marca, { left: `${MARCA_SERVICIO * 100}%`, backgroundColor: colors.borderStrong }]} />
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  tarjeta: { padding: 0, overflow: 'hidden', borderWidth: StyleSheet.hairlineWidth },
+  halo: { position: 'absolute', left: 0, top: 0, bottom: 0, width: 90 },
+  flex1: { flex: 1, minWidth: 0 },
+  fila: { flexDirection: 'row', alignItems: 'center' },
+  // El título puede ir a dos líneas: el ícono y la marca se alinean arriba.
+  filaTitulo: { flexDirection: 'row', alignItems: 'flex-start' },
+  icono: { width: 36, height: 36, alignItems: 'center', justifyContent: 'center', overflow: 'hidden' },
+  marcaDerecha: { paddingTop: 8 },
+  punto: { width: 6, height: 6, borderRadius: 3 },
+  pildora: { flexDirection: 'row', alignItems: 'center', gap: 5, height: 22, paddingHorizontal: 9, overflow: 'hidden' },
+  pildoraTexto: { fontWeight: '600' },
+  pista: { height: 5, width: '100%', overflow: 'hidden', justifyContent: 'center' },
+  relleno: { position: 'absolute', top: 0, right: 0, bottom: 0, left: 0, width: '100%' },
+  marca: { position: 'absolute', width: 2, height: 9, borderRadius: 1, opacity: 0.9 },
+});
