+import { idEnPapel, placaEnPapel } from './vehiculos';
+
+/** Una sección lista para paginar: su nombre (cabecera e índice) y sus piezas. */
+export interface SeccionInforme {
+  nombre: string;
+  /** La línea bajo su nombre en el índice de la portada. */
+  descripcion: string;
+  piezas: Pieza[];
+}
+
+type DatosFormato = Exclude<DatosInforme, { tipo: 'ficha' }>;
+
+/** Los códigos de siempre de cada formato, para poder citarlos. */
+const CODIGO: Record<DatosFormato['tipo'], string> = {
+  estadistico: 'FOM-REP-01',
+  costos: 'FOM-REP-02',
+  vehiculos: 'FOM-REP-03',
+  usuarios: 'FOM-REP-04',
+};
+
+/** Un rango de semáforo; sin kilómetros no se juzga (neutro). */
+function tonoMedido(r: ScoreRange | null, km: number): Semaforo {
+  return r && km > 0 ? r : 'neutro';
+}
+
+/** El semáforo del score (eventos/100 km; óptimo menor a 1,5). */
+function rangoScore(score: number): ScoreRange {
+  if (score < 1.5) return 'verde';
+  if (score < 3.5) return 'amarillo';
+  return 'rojo';
+}
+
+function eventosDe(v: { excesosVelocidad: number; frenadasBruscas: number; aceleracionesBruscas: number }): number {
+  return v.excesosVelocidad + v.frenadasBruscas + v.aceleracionesBruscas;
+}
+
+/** Los papeles de una unidad o persona, como etiqueta. */
+function papelEtiqueta(estado: DocumentoEstado | null, texto?: string, sinDato = 'Sin papeles'): string {
+  if (!estado) return etiqueta('neutro', sinDato);
+  if (estado === 'vencido') return etiqueta('rojo', texto ?? 'Vencido');
+  if (estado === 'por_vencer') return etiqueta('amarillo', texto ?? 'Por vencer');
+  return etiqueta('verde', texto ?? 'Al día');
+}
+
+/** «A y B» / «A, B y C». */
+function enumerar(partes: string[]): string {
+  if (partes.length <= 1) return partes.join('');
+  return `${partes.slice(0, -1).join(', ')} y ${partes[partes.length - 1]}`;
+}
+
+/** Hasta `n` ids y «y N más». */
+function listaCorta(ids: string[], n = 4): string {
+  if (ids.length <= n) return enumerar(ids);
+  return `${ids.slice(0, n).join(', ')} y ${ids.length - n} más`;
+}
+
+// ───────────────────────────── Vehículos ─────────────────────────────
+
+function seccionVehiculos(r: FleetReport, ant: FleetReport | undefined, n: number): SeccionInforme {
+  const m = r.metrics;
+  const filas = r.porVehiculo;
+  const total = filas.length;
+  const piezas: Pieza[] = [
+    tituloSeccion(`Sección ${n} · Formato de vehículos · ${CODIGO.vehiculos}`, 'Vehículos'),
+  ];
+  const descripcion = `Operación de la flota y detalle de ${entero(total)} ${total === 1 ? 'unidad' : 'unidades'}${
+    r.fichas.length > 0 ? ', con la ficha de cada una' : ''
+  }.`;
+
+  if (total === 0) {
+    piezas.push(bloque(24, '<p class="lec">Sin vehículos en el alcance seleccionado.</p>'));
+    return { nombre: 'Vehículos', descripcion, piezas };
+  }
+
+  const enMarcha = filas.filter((v) => v.estado === 'en_marcha').length;
+  const detenidas = total - enMarcha;
+  const conConductor = filas.filter((v) => v.titular).length;
+  const lecturas = filas.flatMap((v) => (v.vehicle.odometroKm != null ? [v.vehicle.odometroKm] : []));
+  const eventos = eventosDe(m);
+  const vencidos = filas.filter((v) => v.papeles === 'vencido').length;
