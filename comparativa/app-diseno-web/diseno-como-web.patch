+import { useState } from 'react';
+import { Image, Pressable, ScrollView, StyleSheet, View } from 'react-native';
+
+import { Button } from '@/components/button';
+import { Card } from '@/components/card';
+import { EvidenceField } from '@/components/evidence-field';
+import { HojaModal } from '@/components/hoja-modal';
+import { PressableScale } from '@/components/pressable-scale';
+import { TabIcon } from '@/components/tab-icon';
+import { ThemedText } from '@/components/themed-text';
+import { validarTituloEvidencia } from '@/lib/validate';
+import { agregarFotosOrden } from '@/services/fomOrdenes';
+import { useTheme } from '@/theme';
+
+/**
+ * UNA GALERÍA DE FOTOS de la ODT, con su «Agregar»: «Fotos del reporte» o
+ * «Fotos del trabajo terminado», igual que en la web.
+ *
+ * Agregar abre una hoja para tomar o elegir fotos, cada una con su título, y
+ * las sube ya (la foto es la acción entera: si no sube, se dice). Las fotos del
+ * reporte piden título, como al reportar; las del trabajo terminado, no.
+ */
+export function GaleriaOdt({
+  id,
+  galeria,
+  titulo,
+  urls,
+  titulos,
+  puedeAgregar,
+  vacio,
+  onAbrir,
+  onAgregadas,
+}: {
+  id: string;
+  galeria: 'reporte' | 'cierre';
+  titulo: string;
+  urls: string[];
+  titulos?: string[];
+  puedeAgregar: boolean;
+  /** Qué se dice sin fotos. */
+  vacio: string;
+  onAbrir: (url: string) => void;
+  /** Las direcciones ya subidas, con su título: la lista de la nube tarda un momento en verlas. */
+  onAgregadas: (urls: string[], titulos: string[]) => void;
+}) {
+  const { colors, spacing, radii } = useTheme();
+  const [abierta, setAbierta] = useState(false);
+  const [fotos, setFotos] = useState<string[]>([]);
+  const [nombres, setNombres] = useState<string[]>([]);
+  const [subiendo, setSubiendo] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const validar = galeria === 'reporte' ? validarTituloEvidencia : (v: string) => (v.trim() ? validarTituloEvidencia(v) : null);
+
+  async function subir() {
+    if (subiendo) return;
+    if (fotos.length === 0) {
+      setError('Toma o elige al menos una foto.');
+      return;
+    }
+    const mal = fotos.findIndex((_, i) => validar(nombres[i] ?? '') !== null);
+    if (mal >= 0) {
+      setError(`Revisa el título de la foto ${mal + 1}.`);
+      return;
+    }
+    setSubiendo(true);
+    setError(null);
+    try {
+      const limpios = nombres.map((t) => t.trim());
+      const subidas = await agregarFotosOrden(id, galeria, fotos, limpios);
+      onAgregadas(subidas, limpios);
+      setFotos([]);
+      setNombres([]);
+      setAbierta(false);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : 'No se pudieron subir las fotos. Intenta de nuevo.');
+    } finally {
+      setSubiendo(false);
+    }
+  }
+
+  return (
+    <View style={{ gap: spacing.sm }}>
+      <View style={[styles.fila, { gap: spacing.sm }]}>
+        <ThemedText variant="overline" color="textMuted" style={styles.flex1}>
+          {titulo}
+        </ThemedText>
+        {puedeAgregar ? (
+          <PressableScale
+            onPress={() => {
+              setError(null);
+              setAbierta(true);
+            }}
+            hitSlop={8}
+            accessibilityRole="button"
+            accessibilityLabel={`Agregar ${titulo.toLowerCase()}`}>
+            <View style={[styles.fila, { gap: 4 }]}>
+              <TabIcon name="anadir" color={colors.primary} size={14} />
+              <ThemedText variant="caption" color="primary">
+                Agregar
+              </ThemedText>
+            </View>
+          </PressableScale>
+        ) : null}
+      </View>
+
+      {urls.length > 0 ? (
+        <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={{ gap: spacing.md }}>
+          {urls.map((url, i) => {
+            // El título que escribió quien la tomó: dice POR QUÉ está esa foto ahí.
+            const nombre = titulos?.[i]?.trim();
+            return (
+              <View key={`${url}-${i}`} style={styles.fotoItem}>
+                <Pressable
+                  onPress={() => onAbrir(url)}
+                  accessibilityRole="imagebutton"
+                  accessibilityLabel={nombre ? `Ver a pantalla completa: ${nombre}` : 'Ver la foto a pantalla completa'}>
+                  <Image
+                    source={{ uri: url }}
+                    style={[styles.foto, { backgroundColor: colors.surface, borderColor: colors.border, borderRadius: radii.lg }]}
+                  />
+                </Pressable>
+                {nombre ? (
+                  <ThemedText variant="caption" color="textSecondary" numberOfLines={2}>
+                    {nombre}
+                  </ThemedText>
+                ) : null}
+              </View>
+            );
+          })}
+        </ScrollView>
+      ) : (
+        <Card>
+          <ThemedText variant="body" color="textMuted">
+            {vacio}
+          </ThemedText>
+        </Card>
+      )}
+
+      <HojaModal
+        visible={abierta}
+        onClose={() => (subiendo ? undefined : setAbierta(false))}
+        titulo={titulo}
+        icon="camara"
+        tone="primary">
+        <EvidenceField
+          uris={fotos}
+          onChange={setFotos}
+          titulos={nombres}
+          onTitulos={setNombres}
+          validarTitulo={validar}
+          editable={!subiendo}
+        />
+        {error ? (
+          <ThemedText variant="caption" color="danger">
+            {error}
+          </ThemedText>
+        ) : null}
+        <Button label={subiendo ? 'Subiendo…' : 'Subir fotos'} icon="camara" onPress={() => void subir()} loading={subiendo} />
+      </HojaModal>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  fila: { flexDirection: 'row', alignItems: 'center' },
+  flex1: { flex: 1, minWidth: 0 },
+  foto: { width: 220, height: 150, borderWidth: StyleSheet.hairlineWidth },
+  fotoItem: { width: 220, gap: 6 },
+});
