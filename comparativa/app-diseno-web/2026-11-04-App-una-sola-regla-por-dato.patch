--- ============================================================================
--- VACIAR las ODT de prueba
--- ============================================================================
--- Esto BORRA datos, no cambia el esquema: por eso vive en `scripts/` y no en
--- `migrations/`. Se ejecuta a mano en el SQL Editor de Supabase, cuando se
--- quiere volver a empezar con las órdenes.
---
--- QUÉ SE LLEVA POR DELANTE, para que no sorprenda:
---
---  · Todas las filas de `odts`, las de conductores y las preventivas que abrió
---    el motor de reglas.
---  · Sus notificaciones del panel: `notificaciones.odt_id` es
---    `on delete cascade`, así que se van solas con su orden.
---  · Las notificaciones SIN odt (alertas de velocidad, mantenimiento cumplido):
---    esas NO se tocan aquí. Si también las quieres fuera, descomenta el último
---    bloque.
---  · La evidencia que el conductor cargó sobre acciones derivadas de una ODT
---    (`acciones_mantenimiento` con `accion_id` que empieza por `odt-`): queda
---    huérfana, apuntando a una orden que ya no existe, así que se limpia.
---
--- Las fotos ya subidas a Cloudinary NO se borran desde aquí: viven fuera de la
--- base. Quedan sin usar, que es inofensivo.
--- ============================================================================
-
-begin;
-
--- 1 · La evidencia colgada de acciones que salían de una ODT.
-delete from public.acciones_mantenimiento
- where accion_id like 'odt-%';
-
--- 2 · Las órdenes. Sus notificaciones caen solas por la cascada.
-delete from public.odts;
-
--- 3 · Contadores de km por vehículo. Cerrar una ODT preventiva es lo que los
---     reinicia (trigger V4); si las órdenes desaparecen sin cerrarse, quedan
---     pasados de vuelta y el motor volvería a disparar de inmediato.
-update public.regla_vehiculos
-   set progreso_km = 0;
-
-commit;
-
--- Comprobación: las tres tienen que dar 0 (la tercera, 0 con odt).
-select 'odts' as tabla, count(*) from public.odts
-union all
-select 'acciones odt', count(*) from public.acciones_mantenimiento where accion_id like 'odt-%'
-union all
-select 'notificaciones con odt', count(*) from public.notificaciones where odt_id is not null;
-
--- ── OPCIONAL: dejar también el buzón del panel en blanco ────────────────────
--- delete from public.notificaciones;
diff --git a/test/regla-conteos.test.mjs b/test/regla-conteos.test.mjs
new file mode 100644
index 0000000..bfe535d
--- /dev/null
+++ b/test/regla-conteos.test.mjs
@@ -0,0 +1,244 @@
+// Una sola regla por dato (ver docs/UNA-SOLA-REGLA.md de la web).
+// Se corre con `node --test test/` (Node 24 lee el .ts quitando los tipos, por
+// eso los utils nuevos son puros y se importan con ruta relativa y extensión).
+import assert from 'node:assert/strict';
+import { readdirSync, readFileSync, statSync } from 'node:fs';
+import { dirname, join, relative } from 'node:path';
+import { test } from 'node:test';
+import { fileURLToPath } from 'node:url';
+
+import { contarSinLeer, estaLeida } from '../src/utils/alertasSinLeer.ts';
+import { atencionDeUnidad } from '../src/utils/atencionUnidad.ts';
+import { contarEmpresas, estaActiva, estaSuspendida } from '../src/utils/contarEmpresas.ts';
+import { diariasHechasHoy, esDiaria, hoyISO, unidadesSinDiariaHoy } from '../src/utils/inspeccionesHoy.ts';
+import {
+  contarOdt,
+  estaAbierta,
+  estaEnRevision,
+  estaResuelta,
+  estaSinResolver,
+  estadoVisible,
+  etiquetaOdt,
+  grupoOdt,
+  tonoOdt,
+} from '../src/utils/odtGrupos.ts';
+import {
+  UMBRAL_POR_VENCER_DIAS,
+  UMBRAL_URGENTE_DIAS,
+  clasificarVencimiento,
+  contarVencimientos,
+  diasDeCalendario,
+  diasParaVencer,
+  esUrgente,
+} from '../src/utils/vencimientos.ts';
+
+const RAIZ = join(dirname(fileURLToPath(import.meta.url)), '..', 'src');
+
+function archivos(dir) {
+  return readdirSync(dir).flatMap((n) => {
+    const ruta = join(dir, n);
+    return statSync(ruta).isDirectory() ? archivos(ruta) : /\.(ts|tsx)$/.test(n) ? [ruta] : [];
+  });
+}
+const rel = (ruta) => relative(RAIZ, ruta).replaceAll('\\', '/');
+/** Líneas de código (sin comentarios de línea ni de bloque) con su número. */
+function lineas(ruta) {
+  const sinBloques = readFileSync(ruta, 'utf8').replace(/\/\*[\s\S]*?\*\//g, (m) => m.replace(/[^\n]/g, ' '));
+  return sinBloques.split('\n').map((t, i) => ({ n: i + 1, t: t.replace(/\/\/.*$/, '') }));
+}
+function buscar(patron, permitidos) {
+  const hallazgos = [];
+  for (const ruta of archivos(RAIZ)) {
+    if (permitidos.includes(rel(ruta))) continue;
+    for (const { n, t } of lineas(ruta)) if (patron.test(t)) hallazgos.push(`${rel(ruta)}:${n}  ${t.trim()}`);
+  }
+  return hallazgos;
+}
+
+// ───────────────────────── Las pruebas de código ─────────────────────────
+
+test('ningún estado de ODT se compara fuera de odtGrupos.ts y fomOrdenes.ts', () => {
+  // `.estado` / `estado` contra 'abierta' | 'en_revision' | 'cerrada', en cualquier orden.
+  // No entran los estados REALES de FOM (`estadoFom`, `hacia`, `desde`, `de`, `a`):
+  // ahí 'cerrada' y 'cancelada' son distintos y la transición los necesita.
+  const est = String.raw`(?:\w+\.)*estado(?:Visto)?`;
+  const lit = String.raw`'(?:abierta|en_revision|cerrada)'`;
+  const patron = new RegExp(String.raw`\b${est}\s*[!=]==?\s*${lit}|${lit}\s*[!=]==?\s*${est}\b`);
+  const sueltos = buscar(patron, ['utils/odtGrupos.ts', 'services/fomOrdenes.ts']);
+  assert.deepEqual(sueltos, [], `Usa grupoOdt/estaResuelta/contarOdt de utils/odtGrupos.ts:\n${sueltos.join('\n')}`);
+});
+
+test('el umbral 30/7 de los documentos solo vive en utils/vencimientos.ts', () => {
+  // Una comparación con 30 o 7 en una línea que habla de vencer, o la división entre
+  // 86400000 en un archivo de papeles. Los demás usos de 86400000 (ventanas de
+  // reportes, costos, manejo) no son vencimientos y no se vigilan.
+  const venc = /venc|vigenc|papel|documento/i;
+  const comparaUmbral = /[<>]=?\s*(?:30|7)\b/;
+  const dias = /Math\.(?:round|floor|ceil)\(.*86_?400_?000/;
+  const sueltos = [];
+  for (const ruta of archivos(RAIZ)) {
+    if (rel(ruta) === 'utils/vencimientos.ts') continue;
+    const ls = lineas(ruta);
+    const esDePapeles = /vigenciaDeFecha|estadoDeDocumento|clasificarVencimiento|DocumentoEstado/.test(
+      ls.map((l) => l.t).join('\n'),
+    );
+    for (const { n, t } of ls) {
+      if ((venc.test(t) && comparaUmbral.test(t)) || (esDePapeles && dias.test(t))) {
+        sueltos.push(`${rel(ruta)}:${n}  ${t.trim()}`);
+      }
+    }
+  }
+  assert.deepEqual(sueltos, [], `Usa clasificarVencimiento/diasDeCalendario de utils/vencimientos.ts:\n${sueltos.join('\n')}`);
+});
+
+test('el texto «N días» de por vencer sale de la constante', () => {
