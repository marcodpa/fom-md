diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..b58087f
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,8 @@
+# Copia este archivo como .env.local y llena los valores. El .env.local no se sube.
+# URL del servidor de FOM (fom-core).
+EXPO_PUBLIC_FOM_API_URL=https://…
+# Mapbox, el mismo proveedor de mapas del panel web. Token PÚBLICO (pk.) de la
+# cuenta de FOM con solo styles:read, fonts:read y styles:tiles. Nunca un sk.
+# Para el teléfono conviene un token SIN restricción de URL (las restricciones
+# de URL son para páginas web). Sin este valor la app usa el mapa de siempre.
+EXPO_PUBLIC_MAPBOX_TOKEN=pk.…
