@@ -0,0 +1,279 @@
+import { useRef, useState } from 'react';
+import { StyleSheet, View } from 'react-native';
+
+import { Button } from '@/components/button';
+import { EvidenceField } from '@/components/evidence-field';
+import { HojaModal } from '@/components/hoja-modal';
+import { TextField } from '@/components/text-field';
+import { ThemedText } from '@/components/themed-text';
+import { uuidV4 } from '@/lib/fom-api';
+import { validarTituloEvidencia } from '@/lib/validate';
+import { cambiarEstadoOrdenFom } from '@/services/fomOrdenes';
+import { encolarFotosCierre } from '@/services/workOrderService';
+import { useTheme } from '@/theme';
+import type { OdtEstadoFom, OdtTipo } from '@/types';
+import { MIN_NOTA_ODT, PASO_ODT, pasosDelGestor, type PasoOdt } from '@/utils/odt';
+
+/**
+ * LOS PASOS DEL GESTOR (supervisor o admin) en el detalle de una ODT: un botón
+ * por paso según su estado REAL, con los mismos nombres que la web. Sustituye
+ * al selector de estatus + «Guardar cambios».
+ *
+ * Cada botón abre una hoja con lo que pide su paso:
+ * - Pasar a revisión y Aprobar: nota opcional.
+ * - Devolver, Cancelar y Reabrir: nota obligatoria (3 letras como mínimo).
+ * - Cerrar y Resolver sin taller: qué se hizo, costo en USD, fotos del trabajo
+ *   terminado (opcionales) y, en una preventiva de un mantenimiento
+ *   programado, el kilometraje con que se cerró (FOM lo exige).
+ *
+ * Asignar y Reasignar responsable NO tienen ruta móvil en FOM (solo la de la
+ * consola web): el botón sale apagado y se dice dónde hacerlo.
+ */
+
+/** Un monto en USD: hasta diez cifras y dos decimales, con punto o coma. */
+const MONTO = /^\d{1,10}([.,]\d{1,2})?$/;
+/** Un kilometraje: hasta diez cifras y dos decimales, con punto o coma. */
+const KM = /^\d{1,10}([.,]\d{1,2})?$/;
+
+/** El título de una foto de cierre: opcional, pero si se escribe, que sirva. */
+function tituloOpcional(v: string): string | null {
+  return v.trim() ? validarTituloEvidencia(v) : null;
+}
+
+/** Lo que se escribe en la hoja de un paso. */
+type Formulario = {
+  nota: string;
+  costo: string;
+  km: string;
+  fotos: string[];
+  titulos: string[];
+};
+
+const VACIO: Formulario = { nota: '', costo: '', km: '', fotos: [], titulos: [] };
+
+/** El aviso que confirma cada paso. */
+const AVISO: Partial<Record<PasoOdt, string>> = {
+  revision: 'Pasada a revisión',
+  aprobar: 'ODT aprobada',
+  resolver: 'ODT resuelta',
+  cerrar: 'ODT resuelta',
+  devolver_abierta: 'Devuelta a abierta',
+  devolver_ejecucion: 'Devuelta a ejecución',
+  cancelar: 'ODT cancelada',
+  reabrir: 'ODT reabierta',
+};
+
+export function AccionesOdtGestor({
+  id,
+  estadoFom,
+  tipo,
+  conMantenimiento,
+  odometro,
+  onHecho,
+}: {
+  id: string;
+  /** El estado REAL que se leyó: es el que se manda como estado de partida. */
+  estadoFom: OdtEstadoFom;
+  tipo?: OdtTipo;
+  /** ¿Sale de un mantenimiento programado? Pide km al cerrarla y no se reabre. */
+  conMantenimiento: boolean;
+  /** El odómetro de la unidad, para proponer el km del cierre. */
+  odometro: number | null;
+  /** Tras el paso: qué se hizo (para el aviso) y a qué estado quedó. */
+  onHecho: (mensaje: string, hacia: OdtEstadoFom) => void;
+}) {
+  const { spacing } = useTheme();
+  const [paso, setPaso] = useState<PasoOdt | null>(null);
+  const [form, setForm] = useState<Formulario>(VACIO);
+  const [errores, setErrores] = useState<Partial<Record<keyof Formulario, string>>>({});
+  const [enviando, setEnviando] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  // Un reintento del MISMO paso con lo mismo reusa su clave: si el primero
+  // llegó, FOM no registra el cambio dos veces.
+  const intento = useRef<{ firma: string; clave: string } | null>(null);
+
+  const pasos = pasosDelGestor(estadoFom, { conMantenimiento });
+  if (pasos.length === 0) return null;
+
+  // El km solo lo lleva una preventiva enlazada a su acción de mantenimiento:
+  // a una orden sin ella FOM se lo rechaza, y lo exige si su plan va por km
+  // (eso la app no lo sabe: se propone el odómetro y, si falta, FOM lo dice).
+  const pideKm = tipo === 'preventiva' && conMantenimiento;
+  const def = paso ? PASO_ODT[paso] : null;
+  const hayPersona = pasos.some((p) => PASO_ODT[p].datos === 'persona');
+
+  function abrir(p: PasoOdt) {
+    setError(null);
+    setErrores({});
+    setForm({ ...VACIO, km: pideKm && odometro != null ? String(Math.round(odometro)) : '' });
+    setPaso(p);
+  }
+
+  function editar<K extends keyof Formulario>(campo: K, valor: Formulario[K]) {
+    setForm((f) => ({ ...f, [campo]: valor }));
+    if (errores[campo]) setErrores((x) => ({ ...x, [campo]: undefined }));
+  }
+
+  async function confirmar() {
+    if (!paso || !def?.hacia || enviando) return;
+    const cierre = def.datos === 'cierre';
+    const nota = form.nota.trim();
+    const costo = form.costo.trim();
+    const km = form.km.trim();
+    const faltan: Partial<Record<keyof Formulario, string>> = {};
+    if (def.datos === 'nota' && nota.length < MIN_NOTA_ODT) faltan.nota = `Escribe ${def.etiquetaNota.toLowerCase()}.`;
+    if (def.datos === 'nota_opcional' && nota.length > 0 && nota.length < MIN_NOTA_ODT) {
+      faltan.nota = `Al menos ${MIN_NOTA_ODT} letras, o déjala vacía.`;
+    }
+    if (cierre) {
+      if (nota.length < MIN_NOTA_ODT) faltan.nota = 'Cuenta qué se hizo.';
+      if (costo && !MONTO.test(costo)) faltan.costo = 'Monto no válido.';
+      if (pideKm && km && !KM.test(km)) faltan.km = 'Kilometraje no válido.';
+      if (form.fotos.some((_, i) => tituloOpcional(form.titulos[i] ?? '') !== null)) faltan.fotos = 'Revisa los títulos.';
+    }
+    if (Object.values(faltan).some(Boolean)) {
+      setErrores(faltan);
+      return;
+    }
+    const enviar = {
+      desde: estadoFom,
+      hacia: def.hacia,
+      nota: nota || def.notaPorDefecto || '',
+      ...(cierre && costo ? { costo: Number(costo.replace(',', '.')) } : {}),
+      ...(cierre && pideKm && km ? { odometroKm: Number(km.replace(',', '.')) } : {}),
+    };
+    const firma = JSON.stringify([id, enviar]);
+    if (intento.current?.firma !== firma) intento.current = { firma, clave: uuidV4() };
+    setEnviando(true);
+    setError(null);
+    try {
+      await cambiarEstadoOrdenFom(id, { ...enviar, clave: intento.current.clave });
+      intento.current = null;
+      if (cierre && form.fotos.length > 0) {
+        await encolarFotosCierre(
+          id,
+          form.fotos,
+          form.titulos.map((t) => t.trim()),
+        );
+      }
+      setPaso(null);
+      onHecho(AVISO[paso] ?? 'Listo', def.hacia);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : 'No pudimos registrar el paso. Intenta de nuevo.');
+    } finally {
+      setEnviando(false);
+    }
+  }
+
+  return (
+    <View style={{ gap: spacing.sm }}>
+      <View style={[styles.botones, { gap: spacing.sm }]}>
+        {pasos.map((p) => {
+          const d = PASO_ODT[p];
+          return (
+            <Button
+              key={p}
+              label={d.label}
+              variant={d.variante}
+              icon={p === 'cerrar' || p === 'resolver' ? 'check' : p === 'cancelar' ? 'cerrar' : undefined}
+              onPress={() => abrir(p)}
+              // Asignar no tiene ruta móvil en FOM: se hace desde la web.
+              disabled={d.datos === 'persona' || enviando}
+              style={styles.boton}
+            />
+          );
+        })}
+      </View>
+      {hayPersona ? (
+        <ThemedText variant="caption" color="textSecondary">
+          Asignar o cambiar el responsable todavía se hace desde la web: FOM aún no lo permite desde la app.
+        </ThemedText>
+      ) : null}
+
+      <HojaModal
+        visible={paso !== null}
+        onClose={() => (enviando ? undefined : setPaso(null))}
+        titulo={def?.label.replace(' →', '') ?? ''}
+        icon={def?.datos === 'cierre' ? 'check' : paso === 'cancelar' ? 'cerrar' : 'ot'}
+        tone={def?.variante === 'danger' ? 'danger' : 'primary'}>
+        <TextField
+          label={def?.etiquetaNota ?? 'Nota'}
+          nombre="nota"
+          value={form.nota}
+          onChangeText={(t) => editar('nota', t)}
+          placeholder={def?.placeholder}
+          multiline
+          maxLength={def?.datos === 'cierre' ? 2000 : 1000}
+          editable={!enviando}
+          style={styles.nota}
+          error={errores.nota}
+        />
+        {def?.datos === 'cierre' ? (
+          <>
+            <TextField
+              label="Costo (USD)"
+              nombre="costo"
+              value={form.costo}
+              onChangeText={(t) => editar('costo', t)}
+              placeholder="0.00"
+              keyboardType="decimal-pad"
+              inputMode="decimal"
+              editable={!enviando}
+              error={errores.costo}
+            />
+            {pideKm ? (
+              <TextField
+                label="Kilometraje al cerrar"
+                nombre="km"
+                value={form.km}
+                onChangeText={(t) => editar('km', t)}
+                placeholder="Ej. 125400"
+                keyboardType="decimal-pad"
+                inputMode="decimal"
+                editable={!enviando}
+                error={errores.km}
+              />
+            ) : null}
+            <View style={{ gap: spacing.sm }}>
+              <ThemedText variant="caption" color="textSecondary">
+                Fotos del trabajo terminado (opcional)
+              </ThemedText>
+              <EvidenceField
+                uris={form.fotos}
+                onChange={(u) => editar('fotos', u)}
+                titulos={form.titulos}
+                onTitulos={(t) => editar('titulos', t)}
+                validarTitulo={tituloOpcional}
+                editable={!enviando}
+              />
+              {errores.fotos ? (
+                <ThemedText variant="caption" color="danger">
+                  {errores.fotos}
+                </ThemedText>
+              ) : null}
+            </View>
+          </>
+        ) : null}
+        {error ? (
+          <ThemedText variant="caption" color="danger">
+            {error}
+          </ThemedText>
+        ) : null}
+        <Button
+          label={def?.label.replace(' →', '') ?? ''}
+          variant={def?.variante === 'danger' ? 'danger' : 'primary'}
+          icon={def?.datos === 'cierre' ? 'check' : undefined}
+          onPress={() => void confirmar()}
+          loading={enviando}
+        />
+      </HojaModal>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  // Los botones se acomodan de dos en dos y bajan de línea si no caben.
+  botones: { flexDirection: 'row', flexWrap: 'wrap' },
+  boton: { flexGrow: 1, flexBasis: '45%' },
+  nota: { minHeight: 72 },
+});
