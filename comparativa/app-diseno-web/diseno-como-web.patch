diff --git a/src/components/escalonado.tsx b/src/components/escalonado.tsx
new file mode 100644
index 0000000..798101f
--- /dev/null
+++ b/src/components/escalonado.tsx
@@ -0,0 +1,138 @@
+import { useRoute } from 'expo-router';
+import { useState, type ReactNode } from 'react';
+import type { StyleProp, ViewProps, ViewStyle } from 'react-native';
+import Animated, {
+  Easing,
+  useReducedMotion,
+  withDelay,
+  withTiming,
+  type EntryExitAnimationFunction,
+} from 'react-native-reanimated';
+
+/** Lo que sube cada bloque al entrar (px). */
+const SUBIDA = 10;
+/** Lo que dura la entrada de cada bloque (ms). */
+const DURACION = 240;
+/** El escalón entre un bloque y el siguiente (ms). */
+const ESCALON = 45;
+/** Solo los primeros entran escalonados (la cabecera y ~8 filas): el resto ya está fuera de la vista. */
+const MAX_ESCALONES = 12;
+/**
+ * Cuánto dura "la primera vez" de un grupo desde que monta su primer bloque.
+ * Lo que monte después (un refresco, el scroll de la lista, un filtro) ya no
+ * anima: entra de una.
+ */
+const VENTANA = 900;
+
+/**
+ * Cuándo montó el primer bloque de cada grupo, por pantalla (la `key` de su
+ * ruta). Una pantalla que se vuelve a abrir es otra ruta: vuelve a animar.
+ */
+const inicios = new Map<string, number>();
+
+/** La entrada de un bloque: fundido + leve subida, con su retardo. Hilo de UI. */
+function entradaBloque(retardo: number): EntryExitAnimationFunction {
+  return () => {
+    'worklet';
+    const curva = { duration: DURACION, easing: Easing.out(Easing.cubic) };
+    return {
+      initialValues: { opacity: 0, transform: [{ translateY: SUBIDA }] },
+      animations: {
+        opacity: withDelay(retardo, withTiming(1, curva)),
+        transform: [{ translateY: withDelay(retardo, withTiming(0, curva)) }],
+      },
+    };
+  };
+}
+
+/** ¿Este bloque es de la primera vez de su grupo? Se decide UNA vez, al montar. */
+function usePrimeraVez(grupo: string): boolean {
+  const ruta = useRoute();
+  const [primera] = useState(() => {
+    const clave = `${ruta.key}:${grupo}`;
+    const ahora = Date.now();
+    const inicio = inicios.get(clave);
+    if (inicio === undefined) {
+      inicios.set(clave, ahora);
+      return true;
+    }
+    return ahora - inicio < VENTANA;
+  });
+  return primera;
+}
+
+type EscalonadoProps = {
+  children: ReactNode;
+  /** Su lugar en la cascada (0 = el primero). Del 12 en adelante no anima. */
+  indice?: number;
+  /**
+   * La cascada a la que pertenece. Los bloques de la pantalla van en
+   * "pantalla"; una lista que llega después con sus datos lleva el suyo
+   * ("lista") para tener también su primera vez.
+   */
+  grupo?: string;
+  style?: StyleProp<ViewStyle>;
+};
+
+/**
+ * ENTRADA ESCALONADA de los bloques de una pantalla, como en el panel web:
+ * cada bloque se funde y sube 10 px, uno tras otro (45 ms de escalón, 240 ms).
+ *
+ * Solo la PRIMERA vez que se monta la pantalla: un refresco, volver a la
+ * pestaña o un re-render no la repiten. Corre en el hilo de UI (animación de
+ * entrada de Reanimated) y con "reducir movimiento" no anima nada.
+ */
+export function Escalonado({ children, indice = 0, grupo = 'pantalla', style }: EscalonadoProps) {
+  const reducido = useReducedMotion();
+  const primera = usePrimeraVez(grupo);
+  const [entrada] = useState(() =>
+    primera && !reducido && indice < MAX_ESCALONES ? entradaBloque(indice * ESCALON) : undefined,
+  );
+  return (
+    <Animated.View entering={entrada} style={style}>
+      {children}
+    </Animated.View>
+  );
+}
+
+/**
+ * Las tarjetas y paneles que APARECEN sobre la pantalla (la ficha de una
+ * unidad al tocarla, el panel del recorrido): suben 16 px y se funden en
+ * 200 ms; al irse, bajan un poco y se apagan, más rápido.
+ * Con "reducir movimiento" Reanimated las deja de una (`ReduceMotion.System`).
+ */
+export const entradaFlotante: EntryExitAnimationFunction = () => {
+  'worklet';
+  const curva = { duration: 200, easing: Easing.out(Easing.cubic) };
+  return {
+    initialValues: { opacity: 0, transform: [{ translateY: 16 }] },
+    animations: {
+      opacity: withTiming(1, curva),
+      transform: [{ translateY: withTiming(0, curva) }],
+    },
+  };
+};
+
+export const salidaFlotante: EntryExitAnimationFunction = () => {
+  'worklet';
+  const curva = { duration: 140, easing: Easing.in(Easing.cubic) };
+  return {
+    initialValues: { opacity: 1, transform: [{ translateY: 0 }] },
+    animations: {
+      opacity: withTiming(0, curva),
+      transform: [{ translateY: withTiming(8, curva) }],
+    },
+  };
+};
+
+/**
+ * Una tarjeta o panel que aparece y se va con `entradaFlotante` /
+ * `salidaFlotante`. Se monta y desmonta condicionalmente: `{x ? <Flotante… /> : null}`.
+ */
+export function Flotante({ children, ...rest }: ViewProps) {
+  return (
+    <Animated.View entering={entradaFlotante} exiting={salidaFlotante} {...rest}>
+      {children}
+    </Animated.View>
+  );
+}
