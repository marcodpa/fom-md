@@ -0,0 +1,98 @@
+import { Image } from 'expo-image';
+import type { ImageSourcePropType } from 'react-native';
+
+import type { Vehicle, VehicleType } from '@/types';
+
+/**
+ * FOTOS SIN FONDO de cada modelo, para montarlas sobre la hoja de «Mi unidad».
+ *
+ * Viven en `assets/images/vehiculos/sin-fondo/<marca>-<modelo>.png`
+ * (minúsculas, sin acentos: `toyota-hilux.png`). Todas en el mismo lienzo de
+ * 800 × 500 (8:5), tres cuartos delantero izquierdo, con el suelo al 92 % del
+ * alto y su sombra ya puesta: quien las monta no les añade otra. La web tiene
+ * el mismo catálogo en `src/assets/vehiculos/`, con los mismos nombres.
+ *
+ * Metro resuelve los `require` al compilar: cada foto nueva se declara aquí,
+ * en una línea. Lo que no esté cae en la silueta de su tipo.
+ */
+const FOTOS: Record<string, ImageSourcePropType> = {
+  'chevrolet-aveo': require('../../assets/images/vehiculos/sin-fondo/chevrolet-aveo.png'),
+  'chevrolet-silverado': require('../../assets/images/vehiculos/sin-fondo/chevrolet-silverado.png'),
+  'ford-f-150': require('../../assets/images/vehiculos/sin-fondo/ford-f-150.png'),
+  'foton-aumark': require('../../assets/images/vehiculos/sin-fondo/foton-aumark.png'),
+  'iveco-daily': require('../../assets/images/vehiculos/sin-fondo/iveco-daily.png'),
+  'jac-x200': require('../../assets/images/vehiculos/sin-fondo/jac-x200.png'),
+  'kenworth-t800': require('../../assets/images/vehiculos/sin-fondo/kenworth-t800.png'),
+  'mack-granite': require('../../assets/images/vehiculos/sin-fondo/mack-granite.png'),
+  'mitsubishi-l200': require('../../assets/images/vehiculos/sin-fondo/mitsubishi-l200.png'),
+  'nissan-frontier': require('../../assets/images/vehiculos/sin-fondo/nissan-frontier.png'),
+  'toyota-corolla': require('../../assets/images/vehiculos/sin-fondo/toyota-corolla.png'),
+  'toyota-fortuner': require('../../assets/images/vehiculos/sin-fondo/toyota-fortuner.png'),
+  'toyota-hilux': require('../../assets/images/vehiculos/sin-fondo/toyota-hilux.png'),
+};
+
+/** La silueta de cada tipo, en el mismo lienzo que las fotos. «Otro» va como camioneta. */
+const SILUETAS: Record<VehicleType, ImageSourcePropType> = {
+  camioneta: require('../../assets/images/vehiculos/sin-fondo/silueta-camioneta.png'),
+  camion: require('../../assets/images/vehiculos/sin-fondo/silueta-camion.png'),
+  auto: require('../../assets/images/vehiculos/sin-fondo/silueta-auto.png'),
+  otro: require('../../assets/images/vehiculos/sin-fondo/silueta-camioneta.png'),
+};
+
+/** Proporción del lienzo de las fotos (ancho / alto). */
+export const PROPORCION_FOTO = 8 / 5;
+
+/** Deja el texto en la forma de las claves: minúsculas, sin acentos ni signos. */
+function clave(texto: string): string {
+  return (texto ?? '')
+    .toLowerCase()
+    .normalize('NFD')
+    // Marcas diacríticas combinantes, con escapes (ver `arte-vehiculos.ts`).
+    .replace(/[̀-ͯ]/g, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+}
+
+/** Sin guiones: «F150», «F 150» y «F-150» son el mismo modelo. */
+const junto = (texto: string) => texto.replace(/-/g, '');
+
+/**
+ * La foto sin fondo de una marca y modelo y, si no la hay, la silueta de su
+ * tipo (camioneta, camión, auto). Siempre devuelve una imagen.
+ *
+ * El modelo casa por INCLUSIÓN («Hilux 4x4 doble cabina» encuentra
+ * `toyota-hilux`), porque los modelos se escriben a mano al dar de alta.
+ */
+export function fotoSinFondo(
+  marca: string,
+  modelo: string,
+  tipo?: VehicleType | null,
+): { fuente: ImageSourcePropType; silueta: boolean } {
+  const m = clave(marca);
+  const mod = junto(clave(modelo));
+  if (m) {
+    const k = Object.keys(FOTOS).find((c) => c.startsWith(`${m}-`) && mod.includes(junto(c.slice(m.length + 1))));
+    if (k) return { fuente: FOTOS[k], silueta: false };
+  }
+  return { fuente: SILUETAS[tipo ?? 'camioneta'] ?? SILUETAS.camioneta, silueta: true };
+}
+
+/** La unidad sin fondo (su foto o la silueta de su tipo), en un lienzo 8:5. */
+export function FotoSinFondo({
+  vehicle,
+  ancho,
+}: {
+  vehicle: Pick<Vehicle, 'marca' | 'modelo' | 'tipo'>;
+  ancho: number;
+}) {
+  const { fuente, silueta } = fotoSinFondo(vehicle.marca, vehicle.modelo, vehicle.tipo);
+  const nombre = `${vehicle.marca} ${vehicle.modelo}`.trim();
+  return (
+    <Image
+      source={fuente}
+      style={{ width: ancho, height: Math.round(ancho / PROPORCION_FOTO) }}
+      contentFit="contain"
+      accessibilityLabel={silueta ? `Silueta de ${nombre || 'la unidad'}` : nombre}
+    />
+  );
+}
