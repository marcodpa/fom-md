       allowsMultipleSelection: true,
+      // En iOS, JPEG en vez de HEIC: es lo que la subida y la web saben leer.
+      // (Igual se convierte y reduce antes de subir, en `lib/cloudinary`.)
+      preferredAssetRepresentationMode: ImagePicker.UIImagePickerPreferredAssetRepresentationMode.Compatible,
     });
     if (!res.canceled) agregar(res.assets.map((a) => a.uri));
   }
