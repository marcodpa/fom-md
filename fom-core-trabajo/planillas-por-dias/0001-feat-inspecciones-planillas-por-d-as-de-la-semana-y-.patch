+import type { MigrationBuilder } from 'node-pg-migrate/dist/bundle/index';
+
+/**
+ * Planillas por días de la semana — T-200.
+ *
+ * Cada plantilla declara los días en que toca llenarla. Un conductor puede
+ * deber varias planillas el mismo día para la misma unidad, así que la diaria
+ * deja de ser «una por unidad y día» y pasa a ser «una por unidad, planilla y
+ * día». Los días son configuración de calendario, no contenido del checklist:
+ * por eso pueden cambiarse en una versión publicada sin tocar sus ítems.
+ */
+export const up = (pgm: MigrationBuilder): void => {
+  pgm.sql(`SET LOCAL lock_timeout = '3s';`);
+  pgm.sql(`
+    ALTER TABLE fom.inspection_templates
+      ADD COLUMN weekdays jsonb NOT NULL DEFAULT '[]'::jsonb,
+      ADD CONSTRAINT inspection_templates_weekdays_check CHECK (
+        jsonb_typeof(weekdays) = 'array'
+        AND weekdays <@ '["lunes","martes","miercoles","jueves","viernes","sabado","domingo"]'::jsonb
+      );
+
+    -- La regla nueva es más laxa que la anterior: no puede haber filas que
+    -- la violen, así que no hace falta un guardián en la subida.
+    DROP INDEX fom.inspections_daily_unique_idx;
+    CREATE UNIQUE INDEX inspections_daily_unique_idx
+      ON fom.inspections (tenant_id, vehicle_id, template_id, inspection_date)
+      WHERE kind = 'daily';
+
+    GRANT SELECT (weekdays), INSERT (weekdays), UPDATE (weekdays)
+      ON fom.inspection_templates TO fom_app;
+
+    COMMENT ON COLUMN fom.inspection_templates.weekdays IS
+      'Days of the week the checklist is due (lunes..domingo); an empty array means every day. Calendar configuration, editable while published';
+    COMMENT ON TABLE fom.inspections IS
+      'One daily inspection per vehicle, template and date, bound to a template version';
+  `);
+};
+
+export const down = (pgm: MigrationBuilder): void => {
+  pgm.sql(`SET LOCAL lock_timeout = '3s';`);
+  pgm.sql(`
+    DO $guard$
+    BEGIN
+      IF EXISTS (
+        SELECT 1
+          FROM fom.inspections
+         WHERE kind = 'daily'
+         GROUP BY tenant_id, vehicle_id, inspection_date
+        HAVING count(*) > 1
+      ) THEN
+        RAISE EXCEPTION
+          'cannot restore one daily inspection per vehicle and day while several templates were submitted the same day'
+          USING ERRCODE = '55000';
+      END IF;
+    END
+    $guard$;
+
+    DROP INDEX fom.inspections_daily_unique_idx;
+    CREATE UNIQUE INDEX inspections_daily_unique_idx
+      ON fom.inspections (tenant_id, vehicle_id, inspection_date)
+      WHERE kind = 'daily';
+
+    REVOKE SELECT (weekdays), INSERT (weekdays), UPDATE (weekdays)
+      ON fom.inspection_templates FROM fom_app;
+
+    ALTER TABLE fom.inspection_templates
+      DROP CONSTRAINT inspection_templates_weekdays_check,
+      DROP COLUMN weekdays;
+
+    COMMENT ON TABLE fom.inspections IS
+      'One daily inspection per vehicle, driver and date, bound to a template version';
+  `);
+};
