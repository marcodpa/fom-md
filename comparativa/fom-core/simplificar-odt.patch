@@ -959,6 +959,26 @@ location ~ ^/api/v1/mobile/work-orders/[^/]+/execution-events$ {
     include /etc/nginx/fom-mobile-proxy-params.conf;
 }
 
+# Flujo simple de ODT (T-72). Asignar responsable admite solo PUT; las
+# acciones compuestas (incluido «Terminé» del responsable) solo POST. La API vuelve a validar Bearer, rol gestor,
+# tenant, estado observado e Idempotency-Key. La lectura de personas
+# asignables queda cubierta por la location GET de work-orders/[^/]+.
+location ~ ^/api/v1/mobile/work-orders/[^/]+/assignee$ {
+    limit_except PUT { deny all; }
+    limit_req zone=fom_mobile_session_v2 burst=20 nodelay;
+    limit_req_status 429;
+    proxy_pass http://fom_mobile_api;
+    include /etc/nginx/fom-mobile-proxy-params.conf;
+}
+
+location ~ ^/api/v1/mobile/work-orders/[^/]+/(dispatch|resolve|close|return|finish)$ {
+    limit_except POST { deny all; }
+    limit_req zone=fom_mobile_session_v2 burst=20 nodelay;
+    limit_req_status 429;
+    proxy_pass http://fom_mobile_api;
+    include /etc/nginx/fom-mobile-proxy-params.conf;
+}
+
 # Escrituras de campo por vehículo. NestJS vuelve a validar tenant, rol,
 # asignación vigente e idempotencia; Nginx publica únicamente estos contratos.
 location ~ ^/api/v1/mobile/vehicles/[^/]+/work-orders$ {
