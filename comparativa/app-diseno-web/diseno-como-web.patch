--- /dev/null
+++ b/src/lib/informe-numeros.ts
@@ -0,0 +1,131 @@
+/**
+ * Cifras del INFORME en formato es-VE: miles con punto y decimales con coma
+ * («38.640», «1,21», «$0,032», «91,8 %»).
+ *
+ * Todo pasa por `miles` (que no depende del ICU del motor de la app) para que
+ * el papel y la vista previa cuenten igual.
+ */
+
+import { miles } from '@/utils/numero';
+
+/** Entero con punto de miles: 38640 → «38.640». */
+export function entero(n: number): string {
+  return miles(Math.round(n));
+}
+
+/** Decimal con coma: 1.21 → «1,21». */
+export function decimal(n: number, decimales = 2): string {
+  return miles(n, decimales);
+}
+
+/** Monto en USD: «$1.245»; con decimales para lo pequeño (costo por km: «$0,032»). */
+export function usd(n: number, decimales = 0): string {
+  return `$${miles(n, decimales)}`;
+}
+
+/** Porcentaje con su espacio: «63 %», «91,8 %». */
+export function porcentaje(n: number, decimales = 0): string {
+  return `${miles(n, decimales)} %`;
+}
+
+/** Minutos → «h:mm», con miles en las horas: 63260 → «1.054:20». */
+export function hhmm(minutos: number): string {
+  const h = Math.floor(minutos / 60);
+  const m = Math.round(minutos % 60);
+  return `${entero(h)}:${String(m).padStart(2, '0')}`;
+}
+
+/** Eventos por cada 100 km; sin kilómetros no hay cuenta posible. */
+export function por100(eventos: number, km: number): number | null {
+  return km > 0 ? (eventos / km) * 100 : null;
+}
+
+/**
+ * Un texto que ya viene con números escritos a la inglesa («1.21», «91.8%»,
+ * «< 1.5», «≥ 85%») pasado a como se lee aquí («1,21», «91,8 %», «menor a
+ * 1,5», «85 % o más»).
+ *
+ * Solo toca el punto seguido de una o dos cifras: un «1.234» de miles (tres
+ * cifras) se queda como está.
+ */
+export function textoVE(s: string): string {
+  let t = s
+    .trim()
+    .replace(/(\d)\.(\d{1,2})(?!\d)/g, '$1,$2')
+    .replace(/(\d)\s?%/g, '$1 %');
+  const m = /^(<|>|≤|≥|<=|>=)\s*(.+)$/.exec(t);
+  if (m) {
+    const [, signo, resto] = m;
+    if (signo === '<') t = `menor a ${resto}`;
+    else if (signo === '>') t = `mayor a ${resto}`;
+    else if (signo === '≤' || signo === '<=') t = `${resto} o menos`;
+    else t = `${resto} o más`;
+  }
+  return t;
+}
+
+const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
+
+/** «20 oct 2026, 08:15», a mano (sin depender del ICU del motor). */
+export function fechaHora(d: Date): string {
+  const hh = String(d.getHours()).padStart(2, '0');
+  const mm = String(d.getMinutes()).padStart(2, '0');
+  return `${d.getDate()} ${MESES[d.getMonth()]} ${d.getFullYear()}, ${hh}:${mm}`;
+}
+
+/** Cómo se compara una cifra con la del período anterior. */
+export interface Comparacion {
+  /** ▲ subió, ▼ bajó, = igual. */
+  flecha: '▲' | '▼' | '=';
+  /** La diferencia ya escrita, con su palabra: «8,3 % más», «0,18 menos», «2 pts más», «sin cambio». */
+  texto: string;
+  /** ¿Es buena noticia? `null` cuando no cambió o no se juzga. */
+  favorable: boolean | null;
+}
+
+/**
+ * Compara una cifra con la del período anterior. Es LA comparación: la usan
+ * la pantalla, la portada pequeña y el PDF, para que digan lo mismo.
+ *
+ * - `pct`: variación porcentual, con un decimal por debajo del 10 % y entera
+ *   desde el 10 % («8,3 % más», «12 % menos»). Sin base (antes 0), la
+ *   diferencia tal cual, como en la web.
+ * - `abs`: diferencia en las mismas unidades.
+ * - `pts`: diferencia de puntos porcentuales.
+ *
+ * `altoEsBueno` dice si subir es buena noticia (identificación, índice) o mala
+ * (eventos, gasto); `null` = ni buena ni mala (km, horas).
+ */
+export function comparar(
+  actual: number | null,
+  antes: number | null | undefined,
+  opciones: { modo: 'pct' | 'abs' | 'pts'; altoEsBueno: boolean | null; decimales?: number; moneda?: boolean },
+): Comparacion | null {
+  if (actual === null || antes === null || antes === undefined) return null;
+  if (!Number.isFinite(actual) || !Number.isFinite(antes)) return null;
+  const modo = opciones.modo === 'pct' && antes === 0 ? 'abs' : opciones.modo;
+  const delta = modo === 'pct' ? ((actual - antes) / Math.abs(antes)) * 100 : actual - antes;
+  const abs = Math.abs(delta);
+  const dec = modo === 'pct' ? (abs < 10 ? 1 : 0) : (opciones.decimales ?? 0);
+  const redondo = Number(abs.toFixed(dec));
+  if (redondo === 0) return { flecha: '=', texto: 'sin cambio', favorable: null };
+  const sube = delta > 0;
+  const cifra =
+    modo === 'pct'
+      ? porcentaje(redondo, dec)
+      : modo === 'pts'
+        ? `${decimal(redondo, dec)} pts`
+        : opciones.moneda
+          ? usd(redondo, dec)
+          : decimal(redondo, dec);
+  return {
+    flecha: sube ? '▲' : '▼',
+    texto: `${cifra} ${sube ? 'más' : 'menos'}`,
+    favorable: opciones.altoEsBueno === null ? null : sube === opciones.altoEsBueno,
+  };
+}
+
+/** La comparación en una línea: «▲ 8,3 % más» o «sin cambio» (sin flecha). */
+export function comparacionTexto(c: Comparacion): string {
+  return c.flecha === '=' ? c.texto : `${c.flecha} ${c.texto}`;
+}
diff --git a/src/lib/informe-piezas.ts b/src/lib/informe-piezas.ts
