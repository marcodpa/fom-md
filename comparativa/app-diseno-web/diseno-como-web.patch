+                        ]}
+                      />
+                    </View>
+                  ))}
+                </View>
+                <View style={[styles.fila, styles.meses, { gap: spacing.sm + 2, paddingTop: spacing.xs + 2 }]}>
+                  {meses.map((m) => (
+                    <ThemedText key={m.mes} variant="caption" color="textMuted" style={styles.mes}>
