@@ -0,0 +1,284 @@
+import { File } from 'expo-file-system';
+import { ImageManipulator, SaveFormat } from 'expo-image-manipulator';
+
+import {
+  cloudinaryConfigurado,
+  etiquetas,
+  ids,
+  subirFotoEn,
+  ultimaVersion,
+  urlDe,
+} from '@/lib/cloudinary';
+import { ErrorFom, pedir } from '@/lib/fom-api';
+import { textoDeError } from '@/lib/responsable-empresa';
+import { sha256Hex } from '@/lib/sha256';
+
+import { todoFom } from './fomListas';
+
+/**
+ * LOGO DE LA EMPRESA — igual que la web (`panel/datos/logos.js`).
+ *
+ * Dos sitios donde puede vivir, y se mira en este orden:
+ *  1. El almacén de FOM: un objeto (`purpose: tenant_logo`) que el ente
+ *     referencia con `logoObjectId`. Subirlo son tres pasos: pedir la carga,
+ *     poner los bytes en la URL que devuelve y darla por completa.
+ *  2. Cloudinary: en producción ese almacén sigue APAGADO (503
+ *     `object_storage_unavailable`) y el servidor no tiene dónde guardar una
+ *     URL. Entonces el logo va a Cloudinary bajo una dirección fija con el id de
+ *     la empresa (`fom/logo-empresa/<id>/<n>`, versiones numeradas) que la web
+ *     calcula igual: un logo subido desde la app se ve en la web y al revés.
+ *
+ * Al mostrarlo: primero el del servidor, si no el de Cloudinary, si no el icono.
+ * FOM Operations lleva siempre el logo de FOM.
+ */
+
+const API = '/api/v1/mobile';
+const CODIGO_FOM = 'fom-operations';
+/** Lado mayor del logo: de sobra para una insignia, y el PNG queda muy por debajo de los 2 MB. */
+const LADO_LOGO = 512;
+
+// --- Qué logo tiene cada ente (una lectura, recordada un minuto) -------------
+interface EnteLogo {
+  id: string;
+  name?: string | null;
+  code?: string | null;
+  logoObjectId?: string | null;
+}
+
+interface DatosLogo {
+  logoObjectId: string | null;
+  esFom: boolean;
+}
+
+let entes: Map<string, DatosLogo> | null = null;
+let entesDesde = 0;
+
+async function logosDeEntes(): Promise<Map<string, DatosLogo>> {
+  if (entes && Date.now() - entesDesde < 60_000) return entes;
+  const lista = await todoFom<EnteLogo>('/tenants');
+  entes = new Map(
+    lista.map((t) => {
+      const nombre = (t.name ?? '').trim().toLowerCase();
+      return [
+        t.id,
+        { logoObjectId: t.logoObjectId ?? null, esFom: t.code === CODIGO_FOM || nombre === 'fom operations' },
+      ];
+    }),
+  );
+  entesDesde = Date.now();
+  return entes;
+}
+
+// --- Aviso de cambios: las pantallas con un logo a la vista lo vuelven a pedir ---
+const oyentes = new Set<() => void>();
+export function alCambiarLogos(f: () => void): () => void {
+  oyentes.add(f);
+  return () => {
+    oyentes.delete(f);
+  };
+}
+
+// --- La imagen del servidor: una dirección firmada por logo, recordada un rato ---
+/** Lo que necesita una imagen para pintarse. Las del servidor llevan sus cabeceras. */
+export interface FuenteImagen {
+  uri: string;
+  headers?: Record<string, string>;
+}
+/** `fom` = el logo de FOM; `null` = sin logo (se pinta el icono de respaldo). */
+export type FuenteLogo = FuenteImagen | 'fom' | null;
+
+interface PeticionDescarga {
+  request?: { url?: string; method?: string; requiredHeaders?: Record<string, string> };
+}
+
+// La dirección es firmada y caduca: se vuelve a pedir pasados unos minutos.
+const DURA_DIRECCION = 4 * 60_000;
+const direcciones = new Map<string, { hasta: number; fuente: Promise<FuenteImagen | null> }>();
+
+function fuenteDelServidor(tenantId: string, objectId: string): Promise<FuenteImagen | null> {
+  const guardada = direcciones.get(objectId);
+  if (guardada && guardada.hasta > Date.now()) return guardada.fuente;
+  const fuente = (async () => {
+    try {
+      const r = (await pedir(`${API}/tenants/${tenantId}/objects/${objectId}/downloads`, {
+        metodo: 'POST',
+        cuerpo: {},
+        invalidar: false,
+      })) as PeticionDescarga;
+      const peticion = r?.request;
+      if (!peticion?.url) return null;
+      return { uri: peticion.url, headers: peticion.requiredHeaders };
+    } catch {
+      return null;
+    }
+  })();
+  direcciones.set(objectId, { hasta: Date.now() + DURA_DIRECCION, fuente });
+  return fuente;
+}
+
+/** El logo en Cloudinary, o `null` si todavía no tiene (o no hay Cloudinary). */
+async function fuenteEnNube(tenantId: string): Promise<FuenteImagen | null> {
+  if (!cloudinaryConfigurado()) return null;
+  try {
+    const base = ids.logoEmpresa(tenantId);
+    const n = await ultimaVersion(base);
+    return n ? { uri: urlDe(`${base}/${n}`, 256, 0, { ajuste: 'contener' }) } : null;
+  } catch {
+    return null;
+  }
+}
+
+const fuentes = new Map<string, { hasta: number; fuente: Promise<FuenteLogo> }>();
+
+/** Qué pintar para el logo de una empresa: el del servidor, si no el de Cloudinary, si no nada. */
+export function fuenteLogoDe(tenantId: string | null | undefined): Promise<FuenteLogo> {
+  if (!tenantId) return Promise.resolve(null);
+  const guardada = fuentes.get(tenantId);
+  if (guardada && guardada.hasta > Date.now()) return guardada.fuente;
+  const fuente = (async (): Promise<FuenteLogo> => {
+    const datos = (await logosDeEntes().catch(() => null))?.get(tenantId);
+    if (datos?.esFom) return 'fom';
+    const delServidor = datos?.logoObjectId ? await fuenteDelServidor(tenantId, datos.logoObjectId) : null;
+    return delServidor ?? (await fuenteEnNube(tenantId));
+  })();
+  fuentes.set(tenantId, { hasta: Date.now() + 5 * 60_000, fuente });
+  return fuente;
+}
+
+function olvidarLogoDe(tenantId: string): void {
+  fuentes.delete(tenantId);
+  entes = null;
+  oyentes.forEach((f) => f());
+}
+
+// --- Subir el logo de una empresa -------------------------------------------
+/** ¿El almacén de FOM no está disponible (apagado o la ruta no está publicada)? */
+function esAlmacenApagado(e: unknown): boolean {
+  if (!(e instanceof ErrorFom)) return false;
+  return (
+    e.statusCode === 503 ||
+    e.statusCode === 404 ||
+    e.statusCode === 405 ||
+    e.code === 'respuesta_no_json' ||
+    /object_storage_unavailable/i.test(`${e.code ?? ''} ${e.message}`)
+  );
+}
+
+// Si FOM ya dijo que su almacén está apagado, no se le vuelve a preguntar en esta sesión.
+let almacenApagado = false;
+
+interface PeticionSubida {
+  upload?: { id?: string; request?: { url?: string; method?: string; requiredHeaders?: Record<string, string> } };
+}
+
+async function esperarDisponible(tenantId: string, objectId: string): Promise<void> {
+  // El objeto queda en cuarentena hasta que FOM lo revisa: se espera un rato corto y, si no llega, se intenta igual.
+  for (let i = 0; i < 8; i += 1) {
+    try {
+      const r = (await pedir(`${API}/tenants/${tenantId}/objects`, { fresco: true })) as {
+        items?: { id: string; status?: string; availableAt?: string | null; rejectionCode?: string | null }[];
+      };
+      const o = (r?.items ?? []).find((x) => x.id === objectId);
+      if (o && (o.status === 'available' || o.availableAt)) return;
+      if (o?.rejectionCode) throw new Error(`El servidor rechazó el archivo (${o.rejectionCode}).`);
+    } catch (e) {
+      if (e instanceof Error && /rechaz/i.test(e.message)) throw e;
+    }
+    await new Promise((fin) => setTimeout(fin, 1500));
+  }
+}
+
+/** Los tres pasos del servidor. Lanza el error de FOM si no puede. */
+async function subirAlServidor(tenantId: string, uri: string): Promise<void> {
+  const bytes = await new File(uri).bytes();
+  const alta = (await pedir(`${API}/tenants/${tenantId}/uploads`, {
+    metodo: 'POST',
+    invalidar: false,
+    cuerpo: {
+      contentType: 'image/png',
+      byteSize: bytes.length,
+      checksumSha256: sha256Hex(bytes),
+      purpose: 'tenant_logo',
+    },
+  })) as PeticionSubida;
+  const subida = alta?.upload;
+  const peticion = subida?.request;
+  if (!subida?.id || !peticion?.url) throw new Error('El servidor no dijo dónde subir el archivo.');
+
+  const puesta = await fetch(peticion.url, {
+    method: peticion.method || 'PUT',
+    headers: { 'content-type': 'image/png', ...(peticion.requiredHeaders ?? {}) },
+    body: bytes as unknown as BodyInit,
+  });
+  if (!puesta.ok) throw new Error(`No se pudo subir el archivo (respuesta ${puesta.status}).`);
+
+  const fin = (await pedir(`${API}/uploads/${subida.id}/complete`, {
+    metodo: 'POST',
+    cuerpo: {},
+    invalidar: false,
+  })) as { object?: { id?: string } };
+  const objectId = fin?.object?.id ?? subida.id;
+
+  await esperarDisponible(tenantId, objectId);
+  await pedir(`${API}/tenants/${tenantId}`, { metodo: 'PATCH', cuerpo: { logoObjectId: objectId } });
+  direcciones.delete(objectId);
+}
+
+/** Deja la imagen lista: un PNG local de hasta 512 px (sin perder el fondo transparente). */
+async function prepararLogo(uri: string): Promise<string> {
+  const original = await ImageManipulator.manipulate(uri).renderAsync();
+  const lado = Math.max(original.width, original.height);
+  const lista =
+    lado > LADO_LOGO
+      ? await ImageManipulator.manipulate(uri)
+          .resize(original.width >= original.height ? { width: LADO_LOGO } : { height: LADO_LOGO })
+          .renderAsync()
+      : original;
+  return (await lista.saveAsync({ format: SaveFormat.PNG })).uri;
+}
+
+/**
+ * Sube el logo de una empresa. Primero al almacén de FOM; si está apagado, a
+ * Cloudinary (la misma dirección que usa la web). Los errores salen ya en español
+ * llano: el código crudo del servidor (`object_storage_unavailable`) nunca llega a la pantalla.
+ */
+export async function subirLogoDeEmpresa(
+  tenantId: string,
+  imagen: { uri: string },
+): Promise<{ via: 'servidor' | 'cloudinary' }> {
+  if (!tenantId) throw new Error('Falta saber de qué empresa es el logo.');
+  if (!imagen?.uri) throw new Error('Elige un archivo de imagen.');
+  try {
+    let archivo: string;
+    try {
+      archivo = await prepararLogo(imagen.uri);
+    } catch {
+      throw new Error('No se pudo leer esa imagen. Elige un archivo PNG, JPG o WebP.');
+    }
+
+    if (!almacenApagado) {
+      try {
+        await subirAlServidor(tenantId, archivo);
+        olvidarLogoDe(tenantId);
+        return { via: 'servidor' };
+      } catch (e) {
+        if (!esAlmacenApagado(e)) throw e;
+        almacenApagado = true;
+      }
+    }
+    if (!cloudinaryConfigurado()) {
+      throw new Error(
+        'Por ahora no hay dónde guardar el logo: el almacén del servidor está apagado y Cloudinary no está configurado en esta app.',
+      );
+    }
+    await subirFotoEn(
+      archivo,
+      { base: ids.logoEmpresa(tenantId), etiqueta: etiquetas.logoEmpresa(tenantId) },
+      { exigirRemoto: true, titulo: 'Logo de la empresa', formato: 'png' },
+    );
+    olvidarLogoDe(tenantId);
+    return { via: 'cloudinary' };
+  } catch (e) {
+    throw new Error(textoDeError(e, 'No se pudo guardar el logo. Inténtalo de nuevo.'));
+  }
+}
