+// Una sola regla para hora, fecha, número, roles y constantes del GPS (copia de
+// `test/regla-formatos.test.js` de la web). Si una prueba falla, no la apagues:
+// usa la función de `utils/date.ts`, `utils/numero.ts`, `auth/permissions.ts`
+// o `lib/gps-alta.ts`. Solo se agrega una excepción con su motivo escrito.
+import assert from 'node:assert/strict';
+import { readdirSync, readFileSync, statSync } from 'node:fs';
+import { join, relative, sep } from 'node:path';
+import { test } from 'node:test';
+import { fileURLToPath } from 'node:url';
+
+import { colorRol, etiquetaRol, rangoDe, tonoDeRol } from '../src/auth/permissions.ts';
+import {
+  diaLocal,
+  fechaLarga,
+  finDelDia,
+  formatDuracion,
+  formatFecha,
+  formatFechaCorta,
+  formatFechaHora,
+  formatFechaHoraAnio,
+  formatHora,
+  formatReloj,
+  formatVencimiento,
+  hoyISO,
+  mesAnio,
+  mesLocal,
+  moverMes,
+} from '../src/utils/date.ts';
+import { miles, numero } from '../src/utils/numero.ts';
+
+const SRC = fileURLToPath(new URL('../src', import.meta.url));
+
+function archivos(dir) {
+  return readdirSync(dir).flatMap((n) => {
+    const p = join(dir, n);
+    if (statSync(p).isDirectory()) return archivos(p);
+    return /\.(ts|tsx)$/.test(n) ? [p] : [];
+  });
+}
+
+/**
+ * Separa un archivo en `codigo` (sin comentarios, con las cadenas tal cual) y
+ * `fuera` (el código con las cadenas vaciadas), y devuelve también las cadenas.
+ */
+function leer(texto) {
+  let codigo = '';
+  let fuera = '';
+  const cadenas = [];
+  for (let i = 0; i < texto.length; ) {
+    const c = texto[i];
+    const dos = texto.slice(i, i + 2);
+    if (dos === '//') {
+      while (i < texto.length && texto[i] !== '\n') i += 1;
+    } else if (dos === '/*') {
+      const fin = texto.indexOf('*/', i + 2);
+      i = fin < 0 ? texto.length : fin + 2;
+    } else if (c === "'" || c === '"' || c === '`') {
+      let j = i + 1;
+      while (j < texto.length && texto[j] !== c) {
+        if (texto[j] === '\\') j += 1;
+        else if (c !== '`' && texto[j] === '\n') break;
+        j += 1;
+      }
+      cadenas.push(texto.slice(i + 1, j));
+      codigo += texto.slice(i, j + 1);
+      fuera += c + c;
+      i = j + 1;
+    } else {
+      codigo += c;
+      fuera += c;
+      i += 1;
+    }
+  }
+  return { codigo, fuera, cadenas };
+}
+
+const FUENTES = archivos(SRC).map((p) => ({
+  ruta: relative(SRC, p).split(sep).join('/'),
+  ...leer(readFileSync(p, 'utf8')),
+}));
+
+const sin = (...rutas) => FUENTES.filter((f) => !rutas.includes(f.ruta));
+const con = (lista, re) => lista.filter((f) => re.test(f.codigo)).map((f) => f.ruta);
+
+test('la hora y la fecha se arman solo en utils/date.ts y utils/numero.ts', () => {
+  const malos = con(sin('utils/date.ts', 'utils/numero.ts'), /toLocaleTimeString|toLocaleDateString|toLocaleString\(|hour12/);
+  assert.deepEqual(malos, [], `usa formatHora/formatFecha de utils/date.ts: ${malos.join(', ')}`);
+});
+
+test('la lista de meses vive solo en utils/date.ts', () => {
+  // lib/sin-senal.ts: otro desarrollador lo reescribe; cuando lo haga, importará MESES_CORTOS y esta excepción se quita.
+  const malos = con(sin('utils/date.ts', 'lib/sin-senal.ts'), /['"]ene(ro)?['"]\s*,\s*['"]feb(rero)?['"]/i);
+  assert.deepEqual(malos, [], `importa MESES / MESES_CORTOS de utils/date.ts: ${malos.join(', ')}`);
+});
+
+test('los puertos 5001, 5002 y la IP del receptor GPS viven solo en lib/gps-alta.ts', () => {
+  const malos = con(sin('lib/gps-alta.ts'), /\b5001\b|\b5002\b|51\.81\.195\.12/);
+  assert.deepEqual(malos, [], `usa PUERTO_RECEPTOR, PUERTO_RECEPTOR_MEITRACK o IP_RECEPTOR de lib/gps-alta.ts: ${malos.join(', ')}`);
+});
+
+test('Samfor y SIRCOP no aparecen en ninguna cadena visible', () => {
+  const malos = [];
+  for (const f of FUENTES) {
+    // Un id, una clave o la ruta de un módulo (@/…) no se ven; un texto sí.
+    for (const c of f.cadenas) {
+      if (/samfor|sircop/i.test(c) && !/^[\w-]+$/.test(c) && !c.startsWith('@/')) malos.push(`${f.ruta}: "${c.slice(0, 60)}"`);
+    }
+    // Texto suelto en la pantalla: fuera de cadenas solo vale dentro de un nombre de código o como clave.
+    for (const m of f.fuera.matchAll(/samfor|sircop/gi)) {
+      const antes = f.fuera[m.index - 1] ?? '';
+      const despues = f.fuera.slice(m.index + m[0].length).match(/^\s*:|^[\w$]/);
+      if (!/[\w$]/.test(antes) && !despues) malos.push(`${f.ruta}: texto ${m[0]}`);
+    }
+  }
+  assert.deepEqual(malos, []);
+});
+
+test('formatHora: 12 horas con a. m. y p. m.', () => {
+  assert.equal(formatHora(new Date(2026, 6, 3, 8, 30)), '8:30 a. m.');
+  assert.equal(formatHora(new Date(2026, 6, 3, 0, 5)), '12:05 a. m.');
+  assert.equal(formatHora(new Date(2026, 6, 3, 12, 0)), '12:00 p. m.');
+  assert.equal(formatHora(new Date(2026, 6, 3, 21, 9, 7), true), '9:09:07 p. m.');
+});
+
+test('formatHora y las demás fechas dan «—» con una fecha inválida, nunca NaN', () => {
+  for (const malo of ['no es fecha', '', 'NaN', new Date('x'), undefined]) {
+    assert.equal(formatHora(malo), '—');
+    assert.equal(formatHora(malo, true), '—');
+    assert.equal(formatFecha(malo), '—');
+    assert.equal(formatFechaCorta(malo), '—');
+    assert.equal(formatFechaHora(malo), '—');
+    assert.equal(formatFechaHoraAnio(malo), '—');
+    assert.equal(formatVencimiento(malo), '—');
+  }
+  assert.equal(formatDuracion(Number.NaN), '—');
+  assert.equal(numero(Number.NaN), '—');
+});
+
+test('fechas como la web: 3 jul, 8:30 a. m. · Viernes 3 de julio · julio 2026', () => {
+  const d = new Date(2026, 6, 3, 8, 30);
+  assert.equal(formatFechaCorta(d), '3 jul');
+  assert.equal(formatFecha(d), '3 jul 2026');
+  assert.equal(formatFechaHora(d), '3 jul, 8:30 a. m.');
+  assert.equal(formatFechaHoraAnio(d), '3 jul 2026, 8:30 a. m.');
+  assert.equal(fechaLarga(d), 'Viernes 3 de julio');
+  assert.equal(mesAnio(d), 'julio 2026');
+  assert.equal(mesAnio(d, true), 'Julio 2026');
+  assert.equal(formatFecha('2026-07-03'), '3 jul 2026');
+  assert.equal(formatVencimiento('2034-05-18'), '05/2034');
+});
+
+test('el día local AAAA-MM-DD sale de una sola función', () => {
+  assert.equal(diaLocal(new Date(2026, 0, 5, 23, 59)), '2026-01-05');
+  assert.equal(hoyISO(new Date(2026, 11, 31)), '2026-12-31');
+  assert.equal(diaLocal('2026-07-03'), '2026-07-03');
+  assert.equal(diaLocal('no es fecha'), '');
+  assert.equal(mesLocal(new Date(2026, 8, 9)), '2026-09');
+  assert.equal(moverMes('2026-01', -1), '2025-12');
+  assert.equal(moverMes('2026-12', 1), '2027-01');
+});
+
+test('el fin de período es el último segundo del día LOCAL', () => {
+  const f = finDelDia(new Date(2026, 6, 31, 3, 0));
+  assert.deepEqual(
+    [f.getFullYear(), f.getMonth(), f.getDate(), f.getHours(), f.getMinutes(), f.getSeconds()],
+    [2026, 6, 31, 23, 59, 59],
+  );
+});
+
+test('duraciones y cronómetro', () => {
+  assert.equal(formatDuracion(55), '55 min');
+  assert.equal(formatDuracion(60), '1 h');
+  assert.equal(formatDuracion(65), '1 h 5 min');
+  assert.equal(formatDuracion(-3), '0 min');
+  assert.equal(formatReloj(3923), '1:05:23');
+});
+
+test('números: 1.234 con punto de miles y coma decimal', () => {
+  assert.equal(numero(1234), '1.234');
+  assert.equal(numero(1484), '1.484');
+  assert.equal(numero(1234.5), '1.234,5');
+  assert.equal(numero(1234.5, 2), '1.234,50');
+  assert.equal(numero(-0.0001), '0');
+  assert.equal(numero(null), '—');
+  assert.equal(miles(1406), '1.406');
+});
+
+test('roles: una etiqueta, un color y el mismo rango que la web', () => {
+  assert.equal(etiquetaRol('supervisor_personal'), 'Supervisor');
+  assert.equal(etiquetaRol('usuario_personal'), 'Usuario');
+  assert.equal(etiquetaRol('admin'), 'Administrador FOM');
+  assert.equal(colorRol('admin'), 'rojo');
+  assert.equal(colorRol('supervisor_company'), 'azul');
+  assert.equal(colorRol('supervisor_personal'), 'azul');
+  assert.equal(colorRol('conductor'), 'verde');
+  assert.equal(colorRol('usuario_personal'), 'gris');
+  assert.deepEqual(tonoDeRol('conductor'), { tone: 'success' });
+  // rangoRol de la web (roles.js): admin_fom 4, supervisor 3, conductor y usuario 1.
+  assert.equal(rangoDe('admin'), 4);
+  assert.equal(rangoDe('supervisor_company'), 3);
+  assert.equal(rangoDe('supervisor_personal'), 3);
+  assert.equal(rangoDe('conductor'), 1);
+  assert.equal(rangoDe('usuario_personal'), 1);
+});
diff --git a/test/regla-senal.test.mjs b/test/regla-senal.test.mjs
